fn test_compound() {
  let x = 10
  x += 5
  x -= 3
  x *= 4
  x /= 2
  x %= 7
  let m = {val: 100}
  m.val += 50
  let arr = [10, 20, 30]
  arr[1] += 5
  return [x, m.val, arr]
}
print(test_compound())

fn test_bitwise() {
  let a = 0x0F
  let b = 0xF0
  let c_and = a & b
  let c_or = a | b
  let c_xor = a ^ b
  let c_not = ~0
  let c_shl = 1 << 4
  let c_shr = 64 >> 2
  let x = 0x55
  x &= 0x0F
  x |= 0xA0
  x ^= 0x33
  x <<= 1
  x >>= 2
  return [c_and, c_or, c_xor, c_not, c_shl, c_shr, x]
}
print(test_bitwise())

fn test_ternary(v) {
  return v > 10 ? "greater" : "lesser"
}
print(test_ternary(15), test_ternary(5))

fn test_fstr(name, count) {
  return f"Item: {name}, total={count * 10}, status={count > 0 ? 'active' : 'idle'}"
}
print(test_fstr("sensor", 3))

fn test_functional() {
  let nums = [1, 2, 3, 4, 5]
  let squares = map(nums, fn (x) { return x * x })
  let evens = filter(nums, fn (x) { return x % 2 == 0 })
  let sum_all = reduce(nums, fn (acc, x) { return acc + x }, 0)
  let pairs = zip(nums, squares)
  return [squares, evens, sum_all, pairs]
}
print(test_functional())
