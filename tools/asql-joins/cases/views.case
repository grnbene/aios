INSERT INTO productlinepoints VALUES (1,'Line1',10,1),(2,'Line2',20,2),(3,'Line3',30,3),(4,'Line4',40,4),(5,'Line5',50,5);
CREATE VIEW stocktrans AS select debtortrans.transno AS transno, debtortrans.type AS systype, debtortrans.order_ AS orderno, debtortrans.debtorno AS debtorno, stockmoves.stockid AS stockid, stockmoves.trandate AS trandate, stockmoves.stkmoveno AS stkmoveno, stockmoves.qty AS qty, salesorders.enteredby AS enteredby, (stockmoves.price * stockmoves.qty) AS discountedlinetotal, salesman.salesmanname AS salesmanname, custbranch.brname AS brname, territory.territory_name AS territory_name, stockmaster.description AS description, stockmaster.lineid AS lineid, manufacturer.name AS BRANDNAME from stockmoves join debtortrans on (stockmoves.transno = debtortrans.transno and stockmoves.type = debtortrans.type and stockmoves.debtorno = debtortrans.debtorno and stockmoves.branchcode = debtortrans.branchcode) join custbranch on (custbranch.debtorno = debtortrans.debtorno and custbranch.branchcode = debtortrans.branchcode) join territory on (territory.territory_id = custbranch.territory_id) left join salesorders on (debtortrans.order_ = salesorders.orderno) left join salesman on (salesman.salesmancode = debtortrans.salesperson) join stockmaster on (stockmaster.stockid = stockmoves.stockid) left join product_to_manufacturer on (stockmaster.stockid = product_to_manufacturer.stockid) left join manufacturer on (manufacturer.manufacturer_id = product_to_manufacturer.manufacturer_id) where (stockmoves.type = 10 or stockmoves.type = 11) and stockmoves.stockid not like 'DWI-%';
CREATE VIEW plp AS SELECT lineid, name, dvalue, points FROM productlinepoints;

-- query
select `p`.`lineid` AS `lineid`,`p`.`name` AS `name`,`p`.`dvalue` AS `dvalue`,`p`.`points` AS `points`,sum(`s`.`discountedlinetotal` * -1) AS `total` from (`productlinepoints` `p` join `stocktrans` `s` on(`p`.`lineid` = `s`.`lineid`)) where 1 group by `p`.`lineid`
-- expect
1|Line1|10|1|-18043.1200
2|Line2|20|2|-21512.6200
3|Line3|30|3|-26964.9600
4|Line4|40|4|-23990.3800
5|Line5|50|5|-14137.8200

-- query
SELECT s.lineid, p.name, COUNT(*) FROM stocktrans s JOIN plp p ON p.lineid = s.lineid GROUP BY s.lineid, p.name
-- expect
1|Line1|68
2|Line2|88
3|Line3|112
4|Line4|90
5|Line5|75

-- query
SELECT p.name, s.stkmoveno, s.BRANDNAME FROM productlinepoints p JOIN stocktrans s ON p.lineid = s.lineid AND s.qty > 5
