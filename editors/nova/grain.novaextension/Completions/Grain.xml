<?xml version="1.0" encoding="UTF-8"?>
<completions>
	<provider>
		<syntax>grain</syntax>
		<set>grain.keywords</set>
		<set>grain.substrate.types</set>
		<set>grain.substrate.builtins</set>
		<set>grain.substrate.methods</set>
		<set>grain.builtins</set>
	</provider>

	<!-- Keywords & Snippets -->
	<set name="grain.keywords" symbol="keyword">
		<completion string="entity">
			<behavior>
				<append> $[Name] {\n\t$[body]\n}</append>
			</behavior>
		</completion>
		<completion string="on">
			<behavior>
				<append> $[event_name]($[frame]) {\n\t$[body]\n}</append>
			</behavior>
		</completion>
		<completion string="fn">
			<behavior>
				<append> $[name]($[args]) {\n\t$[body]\n}</append>
			</behavior>
		</completion>
		<completion string="let">
			<behavior>
				<append> $[name] = $[value]</append>
			</behavior>
		</completion>
		<completion string="if">
			<behavior>
				<append> ($[condition]) {\n\t$[body]\n}</append>
			</behavior>
		</completion>
		<completion string="else" />
		<completion string="while">
			<behavior>
				<append> ($[condition]) {\n\t$[body]\n}</append>
			</behavior>
		</completion>
		<completion string="for">
			<behavior>
				<append> $[item] in $[sequence] {\n\t$[body]\n}</append>
			</behavior>
		</completion>
		<completion string="return" />
		<completion string="break" />
		<completion string="continue" />
		<completion string="true" />
		<completion string="false" />
		<completion string="nil" />
		<completion string="this" />
	</set>

	<!-- Substrate Types -->
	<set name="grain.substrate.types" symbol="type">
		<completion string="Id128" />
		<completion string="Capability" />
		<completion string="StateChannel" />
		<completion string="StateFrame" />
		<completion string="MemoryObject" />
		<completion string="Entity" />
	</set>

	<!-- Substrate Builtins & Constructors -->
	<set name="grain.substrate.builtins" symbol="function">
		<completion string="id128">
			<behavior>
				<arguments prefix="(" suffix=")" separator=", " />
			</behavior>
		</completion>
		<completion string="Capability">
			<behavior>
				<arguments prefix=" { " suffix=" }" separator=", " />
			</behavior>
		</completion>
		<completion string="StateChannel">
