			</behavior>
		</completion>
		<completion string="write_only" symbol="constant" />
		<completion string="read_only" symbol="constant" />
		<completion string="read_write" symbol="constant" />
		<completion string="grant" symbol="constant" />
		<completion string="never" symbol="constant" />
		<completion string="shared_mem" symbol="constant" />
		<completion string="ram" symbol="constant" />
		<completion string="persistent" symbol="constant" />
		<completion string="current_generation" symbol="constant" />
	</set>

