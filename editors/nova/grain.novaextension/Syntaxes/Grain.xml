<?xml version="1.0" encoding="UTF-8"?>
<syntax name="grain">
	<meta>
		<name>Grain</name>
		<type>script</type>
		<preferred-file-extension>gr</preferred-file-extension>
		<scriptable shebang="#!/usr/bin/env aios grain run" />
	</meta>

	<detectors>
		<extension priority="1.0">gr</extension>
		<match-content lines="1" priority="1.0">^\#!\s*.*grain</match-content>
	</detectors>

	<indentation>
		<increase>
			<expression>(\{[^}\"']*$)|(\[[^\]\"']*$)|(\([^)\"']*$)</expression>
		</increase>
		<decrease>
			<expression>^\s*[\}\]\)]</expression>
		</decrease>
	</indentation>

	<comments>
		<single>
			<expression>//</expression>
		</single>
		<single>
			<expression>#</expression>
		</single>
	</comments>

	<brackets>
		<pair open="{" close="}" />
		<pair open="[" close="]" />
		<pair open="(" close=")" />
	</brackets>

	<surrounding-pairs>
		<pair open="{" close="}" />
		<pair open="[" close="]" />
		<pair open="(" close=")" />
		<pair open="&apos;" close="&apos;" />
		<pair open="&quot;" close="&quot;" />
	</surrounding-pairs>

	<scopes>
		<include syntax="self" collection="comments" />
		<include syntax="self" collection="definitions" />
		<include syntax="self" collection="strings" />
		<include syntax="self" collection="numbers" />
		<include syntax="self" collection="constants" />
		<include syntax="self" collection="keywords" />
		<include syntax="self" collection="substrate-types" />
		<include syntax="self" collection="builtins" />
		<include syntax="self" collection="methods" />
		<include syntax="self" collection="identifiers" />
		<include syntax="self" collection="operators" />
	</scopes>

	<collections>
		<!-- Comments -->
		<collection name="comments">
			<scope name="grain.comment.line.double-slash" spell-check="true">
				<expression>//(.*)$</expression>
				<capture number="1" name="grain.comment.content" />
			</scope>
			<scope name="grain.comment.line.hash" spell-check="true">
				<expression>\#(.*)$</expression>
				<capture number="1" name="grain.comment.content" />
			</scope>
		</collection>

		<!-- Definitions with Symbols -->
		<collection name="definitions">
			<!-- entity Name { -->
			<scope name="grain.definition.entity">
				<symbol type="class">
					<context behavior="subtree" />
				</symbol>
				<starts-with>
					<expression>\b(entity)\s+([a-zA-Z_][a-zA-Z0-9_]*)</expression>
					<capture number="1" name="grain.keyword.construct" />
					<capture number="2" name="grain.identifier.type.entity" />
				</starts-with>
				<ends-with>
					<expression>(?&lt;=\})</expression>
				</ends-with>
				<subscopes>
					<include syntax="self" />
				</subscopes>
			</scope>

			<!-- on event_name(Type param) { -->
			<scope name="grain.definition.handler">
				<symbol type="event">
					<context behavior="subtree" />
				</symbol>
				<starts-with>
					<expression>\b(on)\s+([a-zA-Z_][a-zA-Z0-9_]*)</expression>
					<capture number="1" name="grain.keyword.construct" />
					<capture number="2" name="grain.identifier.function.handler" />
				</starts-with>
				<ends-with>
					<expression>(?&lt;=\})</expression>
				</ends-with>
				<subscopes>
					<include syntax="self" />
				</subscopes>
			</scope>

			<!-- fn name(...) { -->
			<scope name="grain.definition.function">
				<symbol type="function">
					<context behavior="subtree" />
				</symbol>
				<starts-with>
					<expression>\b(fn)\s+([a-zA-Z_][a-zA-Z0-9_]*)</expression>
					<capture number="1" name="grain.keyword.construct" />
					<capture number="2" name="grain.identifier.function" />
				</starts-with>
				<ends-with>
					<expression>(?&lt;=\})</expression>
				</ends-with>
				<subscopes>
					<include syntax="self" />
				</subscopes>
			</scope>
		</collection>

		<!-- Strings -->
		<collection name="strings">
			<!-- Formatted strings f"..." -->
			<scope name="grain.string.interpolated">
				<starts-with>
					<expression>\b[fF]&quot;</expression>
					<capture number="0" name="grain.string.delimiter" />
				</starts-with>
				<ends-with>
					<expression>&quot;</expression>
					<capture number="0" name="grain.string.delimiter" />
				</ends-with>
				<subscopes>
					<scope name="grain.string.escape">
						<expression>\\(\\{|\\}|[&quot;\\/bfnrt]|u[0-9a-fA-F]{4})</expression>
					</scope>
					<scope name="grain.interpolation">
						<starts-with>
							<expression>\{</expression>
							<capture number="0" name="grain.interpolation.delimiter" />
						</starts-with>
						<ends-with>
							<expression>\}</expression>
							<capture number="0" name="grain.interpolation.delimiter" />
						</ends-with>
						<subscopes>
							<include syntax="self" />
						</subscopes>
					</scope>
				</subscopes>
			</scope>

			<!-- Double quoted string -->
			<scope name="grain.string.double-quoted">
				<starts-with>
					<expression>&quot;</expression>
					<capture number="0" name="grain.string.delimiter" />
				</starts-with>
				<ends-with>
					<expression>&quot;</expression>
					<capture number="0" name="grain.string.delimiter" />
				</ends-with>
				<subscopes>
					<scope name="grain.string.escape">
						<expression>\\([\\&quot;0abfnrtv]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})</expression>
					</scope>
				</subscopes>
			</scope>

			<!-- Single quoted string -->
			<scope name="grain.string.single-quoted">
				<starts-with>
					<expression>&apos;</expression>
					<capture number="0" name="grain.string.delimiter" />
				</starts-with>
				<ends-with>
					<expression>&apos;</expression>
					<capture number="0" name="grain.string.delimiter" />
				</ends-with>
				<subscopes>
					<scope name="grain.string.escape">
						<expression>\\([\\&apos;0abfnrtv]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})</expression>
					</scope>
				</subscopes>
			</scope>
		</collection>

		<!-- Numbers -->
		<collection name="numbers">
			<scope name="grain.value.number.hex">
				<expression>\b0x[0-9a-fA-F_]+\b</expression>
			</scope>
			<scope name="grain.value.number.binary">
				<expression>\b0b[01_]+\b</expression>
			</scope>
			<scope name="grain.value.number.decimal">
				<expression>\b[0-9][0-9_]*(\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?\b</expression>
			</scope>
		</collection>

		<!-- Constants -->
		<collection name="constants">
			<scope name="grain.value.boolean">
				<strings>
					<string>true</string>
					<string>false</string>
				</strings>
			</scope>
			<scope name="grain.value.null">
