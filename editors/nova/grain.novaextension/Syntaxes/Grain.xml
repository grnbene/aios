		<!-- Substrate & General Methods -->
		<collection name="methods">
			<scope name="grain.identifier.method.substrate">
				<expression>\.(attenuate|can|close|consume|dispatch|has_expired|listen|migrate|publish|read|recv|send|stats|write)\b</expression>
				<capture number="1" name="grain.identifier.method.substrate.name" />
			</scope>
			<scope name="grain.identifier.property">
				<expression>\.([a-zA-Z_][a-zA-Z0-9_]*)</expression>
				<capture number="1" name="grain.identifier.property.name" />
			</scope>
		</collection>

		<!-- Identifiers & Scoped Names -->
		<collection name="identifiers">
			<scope name="grain.identifier.namespace">
				<expression>\b[a-zA-Z_][a-zA-Z0-9_]*(::[a-zA-Z_][a-zA-Z0-9_]*)+\b</expression>
			</scope>
			<scope name="grain.identifier.type">
				<expression>\b[A-Z][a-zA-Z0-9_]*\b</expression>
			</scope>
			<scope name="grain.identifier.function.call">
				<expression>\b([a-zA-Z_][a-zA-Z0-9_]*)\s*(?=\()</expression>
				<capture number="1" name="grain.identifier.function.call.name" />
			</scope>
		</collection>

		<!-- Operators -->
		<collection name="operators">
			<scope name="grain.operator.scope">
				<expression>::</expression>
			</scope>
			<scope name="grain.operator.comparison">
				<expression>(==|!=|&lt;=|&gt;=|&lt;|&gt;)</expression>
			</scope>
			<scope name="grain.operator.assignment">
				<expression>(&lt;&lt;=|&gt;&gt;=|\+=|-=|\*=|/=|%=|\^=|&amp;=|\|=|=)</expression>
			</scope>
			<scope name="grain.operator.bitwise">
				<expression>(&lt;&lt;|&gt;&gt;|\^|&amp;|\||~)</expression>
			</scope>
			<scope name="grain.operator.arithmetic">
				<expression>(\+|-|\*|/|%)</expression>
			</scope>
			<scope name="grain.operator.logical">
				<expression>!</expression>
			</scope>
		</collection>
	</collections>
</syntax>
