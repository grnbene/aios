# Live Multi-User Control Center
# Showcases modern styling: ui.card, ui.divider, animated rows, sub-deltas, variants, and real-time SSE sync

let seconds = 0
let load_history = []
let spark_points = []
let board = []
let total_events = 0

every(1, fn () {
  seconds = seconds + 1
  total_events = total_events + 1
  let cur_load = (seconds * 37) % 95 + 5
  push(load_history, {"second": str(seconds) + "s", "load": str(cur_load) + "%"})
  push(spark_points, cur_load)
  if len(load_history) > 7 { load_history = slice(load_history, 1) }
  if len(spark_points) > 28 { spark_points = slice(spark_points, 1) }
})

fn say(f) {
  if f.words == "" { return nil }
  total_events = total_events + 1
  let sender = f.who == "" ? "Anonymous" : f.who
  push(board, {"time": date_format(now(), "%T", "local"), "who": sender, "said": f.words})
  if len(board) > 10 { board = slice(board, 1) }
  ui.set_field(p, "words", "")
}

let p = ui.pane({"title": "Grain Operations Center", "shared": true, "width": 980, "height": 760, "view": fn () {
  let rev_load = []
  for r in load_history { rev_load = [r] + rev_load }

  let rev_talk = []
  for m in board { rev_talk = [m] + rev_talk }

  let latest_load = len(spark_points) > 0 ? spark_points[len(spark_points) - 1] : 0
  let load_accent = latest_load > 75 ? "bad" : (latest_load > 45 ? "warn" : "ok")

  return ui.column({"gap": 20, "pad": 4}, [
    # Header Nav Bar
    ui.row({"gap": 12, "align": "center"}, [
      ui.heading("Grain Mission Control"),
      ui.badge("Live Stream", {"accent": "ok", "dot": true}),
      ui.badge("SSE Sync", {"accent": "accent"}),
      ui.text(sys.os + " • " + sys.arch, {"dim": true, "mono": true})
    ]),

    # Top Metric KPI Tiles with sub-trends
    ui.row({"gap": 14}, [
      ui.tile("System Uptime", str(seconds) + "s", {"accent": "ok", "sub": "Clock ticking"}),
      ui.tile("Telemetry Load", str(latest_load) + "%", {"accent": load_accent, "sub": latest_load > 70 ? "High activity" : "Optimal"}),
      ui.tile("Chat Messages", len(board), {"sub": "Shared across clients"}),
      ui.tile("Events Processed", total_events, {"accent": "warn", "sub": "Total broadcast stream"})
    ]),

    # Telemetry Chart Card
    ui.card([
      ui.row({"justify": "between", "align": "center"}, [
        ui.text("Live Load Telemetry", {"bold": true, "size": 15}),
        ui.badge("1s Interval", {"accent": load_accent})
      ]),
      ui.chart(spark_points, {"height": 110, "min": 0, "max": 100, "suffix": "%", "accent": load_accent})
    ]),

    # Main Content Cards (Grid)
    ui.row({"gap": 16}, [
      # Left Card: Telemetry stream
      ui.card({"grow": true, "gap": 12}, [
        ui.text("Recent Telemetry Ticks", {"bold": true, "size": 15}),
        ui.divider(),
        ui.table(rev_load, {"columns": "second:Tick, load:Load %:right", "empty": "initializing stream..."})
      ]),

      # Right Card: Collaborative Discussion
      ui.card({"grow": true, "gap": 12}, [
        ui.text("Collaborative Feed", {"bold": true, "size": 15}),
        ui.divider(),
        ui.row({"gap": 8}, [
          ui.field("who", {"placeholder": "Handle / Name", "width": 140}),
          ui.field("words", {"placeholder": "Type message and hit Enter...", "on_enter": say}),
          ui.button("Post", say, {"primary": true})
        ]),
        ui.table(rev_talk, {"columns": "time:Time, who:User, said:Message", "empty": "No messages yet. Send one to sync!"})
      ])
    ])
  ])
}})

run_panes()
