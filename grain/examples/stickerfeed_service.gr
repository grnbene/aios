// StickerFeed vendor API, read straight from ASQL.
//
// The v8 ERP's sticker feed (catalog/controller/apir/tools/stickerfeedapi.php feed(), with
// system/library/stickerfeed/feedbuilder.php building the items) ported to grain. Every read goes to
// ASQL, which the binlog keeps current with the live MariaDB, so there is no cache and nothing to
// refresh: each request reads the rows as they are now. The answer is the PHP's own, field for field,
// including PHP 7.4's arithmetic and its quirks (see the notes at getItemCost and getNextCost).
//
//   POST /feed          Authorization: Bearer <token>, body {} or {"brands": ["NAME", ...]}
//                       -> {"items": [...]}, exactly what feed() answers
//   POST /stock_check   Authorization: Bearer <token>, body {"skus": ["STOCKID", ...]} or the
//                       "lines" placeorder takes ([{"sku": ..., "qty": ...}])
//                       -> {"items": [...], "not_found": [...]}: the same rows as /feed, for those items
//   GET  /              the ops view
//
// What it does not do: getItemCost() in PHP also writes stockmaster.actualcost from inside the feed.
// ASQL takes no writes and a read path should not make them, so that write is left out.
//
// The connection log and lastsent are written where PHP writes them, the ERP's MariaDB, on a
// connection of their own (STICKERFEED_WRITE_*); the rate limit reads that log, as PHP does.
//
// Configuration (environment):
//   ASQL_HOST (127.0.0.1)  ASQL_PORT (3307)  ASQL_USER (root)  ASQL_PASSWORD or ASQL_PASSWORD_FILE  ASQL_DB (versioneight)
//   STICKERFEED_WRITE_HOST  _PORT (3306)  _USER  _PASSWORD or _PASSWORD_FILE  _DB (ASQL_DB)
//   STICKERFEED_KEY_FILE (/var/www/keyfile.txt) or STICKERFEED_ENCRYPTION_KEY: the key the tokens are sealed with

fn env(name, fallback) {
  let v = getenv(name)
  if v == nil or v == "" { return fallback }
  return v
}

fn secret(name) {
  let v = getenv(name)
  if v != nil and v != "" { return v }
  let f = getenv(name + "_FILE")
  if f != nil and f != "" { return php_trim(read_file(f)) }
  return ""
}

// ---- PHP 7.4, as the feed's arithmetic and tests use it --------------------------------------
// Numbers are decimal text (grain's dec_* functions), exact. PHP does this arithmetic in doubles and
// number_format() rounds through 15 significant digits, which gives the same digits as exact decimals
// for every value a price, cost or quantity takes.

// trim() with PHP's default characters
fn php_trim(s) {
  if s == nil { return "" }
  return trim(str(s), " \t\n\r\0\x0B")
}

// A value as PHP's (string) casts it
fn php_str(v) {
  if v == nil or v == false { return "" }
  if v == true { return "1" }
  if type(v) == "list" or type(v) == "map" { return "Array" }
  return str(v)
}

// if ($v): "", "0", 0, null, false and an empty array are false
fn php_truthy(v) {
  if v == nil { return false }
  let t = type(v)
  if t == "bool" { return v }
  if t == "int" or t == "real" { return v != 0 }
  if t == "string" { return v != "" and v != "0" }
  if t == "list" { return len(v) > 0 }
  if t == "map" { return len(keys(v)) > 0 }
  return true
}

// A value as PHP 7.4 uses it in arithmetic: a string by its leading number (0 when it has none), null as 0
fn num(v) {
  if v == nil or v == false { return "0" }
  if v == true { return "1" }
  if type(v) != "string" { return decimal(v) }
  let p = decimal_prefix(v)
  return p == nil ? "0" : p.value
}

// is_numeric(): the string is a number and nothing after it (trailing space included)
fn numeric_str(s) {
  if s == nil { return nil }
  let p = decimal_prefix(s)
  if p == nil or p.rest != "" { return nil }
  return p.value
}

// (int) $v
fn num_int(v) { return int(dec_round(num(v), 0, "down")) }

fn dec_max(a, b) { return dec_cmp(a, b) >= 0 ? a : b }

// number_format($v, $places, '.', '') on PHP 7.4: a string that is not numeric at all is refused
// (a warning and NULL); a leading-numeric one counts as its number; null and false as 0. The value is
// rounded to 15 significant digits first, then half up.
fn nf(v, places) {
  let d = "0"
  if v == true { d = "1" }
  else if v != nil and v != false {
    if type(v) == "string" {
      let p = decimal_prefix(v)
      if p == nil { return nil }
      d = p.value
    } else {
      d = decimal(v)
    }
  }
  return dec_format(dec_round_sig(d, 15), places)
}

// $v > 0 and $v == 0 on PHP 7.4: a string compares by its leading number
fn gt0(v) { return v != nil and v != false and dec_cmp(num(v), "0") > 0 }

fn eq0(v) { return v == nil or v == false or (v != true and dec_cmp(num(v), "0") == 0) }

// in_array($v, $list) for the strings the ERP keeps: two numeric strings compare as numbers ("07" == "7")
fn php_in(v, list) {
  let a = php_str(v)
  let an = numeric_str(a)
  for x in list {
    let b = php_str(x)
    if a == b { return true }
    if an != nil {
      let bn = numeric_str(b)
      if bn != nil and dec_cmp(an, bn) == 0 { return true }
    }
  }
  return false
}

// $v != '' on PHP 7.4: null, false, "", 0 and 0.0 equal ''
fn loose_empty_string(v) {
  if v == nil or v == false or v == "" { return true }
  let t = type(v)
  if t == "int" or t == "real" { return v == 0 }
  return false
}

// MariaDB compares the ERP's codes without case or trailing spaces
fn ck(s) {
  if s == nil { return "" }
  return upper(rtrim(str(s)))
}

// ---- connections ------------------------------------------------------------------------------

let ASQL = {
  "host": env("ASQL_HOST", "127.0.0.1"), "port": int(env("ASQL_PORT", "3307")),
  "user": env("ASQL_USER", "root"), "password": secret("ASQL_PASSWORD"), "db": env("ASQL_DB", "versioneight")
}
let WRITE = {
  "host": env("STICKERFEED_WRITE_HOST", ""), "port": int(env("STICKERFEED_WRITE_PORT", "3306")),
  "user": env("STICKERFEED_WRITE_USER", ""), "password": secret("STICKERFEED_WRITE_PASSWORD"),
  "db": env("STICKERFEED_WRITE_DB", ASQL.db)
}
let conns = {}

fn conn(which) {
  let c = conns[which]
  if c != nil { return c }
  let cfg = which == "read" ? ASQL : WRITE
  if cfg.host == "" { error("STICKERFEED_WRITE_HOST is not set: the connection log and lastsent have nowhere to go") }
  let r = db_connect(cfg.host, cfg.port, cfg.user, cfg.password, cfg.db)
  if not r.ok { error("cannot connect to " + which + " database " + cfg.host + ":" + str(cfg.port) + ": " + r.error) }
  conns[which] = r
  return r
}

// One statement, its ? filled from params. A read whose connection broke is tried once more on a new
// one; a write is not, since it may have been applied.
fn run(which, sql, params) {
  let r = pcall(db_query, conn(which), sql, params)
  if not r.ok {
    conns[which] = nil
    if which != "read" { error(r.error) }
    r = pcall(db_query, conn(which), sql, params)
    if not r.ok {
      conns[which] = nil
      error(r.error)
    }
  }
  if not r.value.ok { error(r.value.error + " :: " + sql) }
  return r.value
}

fn rows(sql, params) { return run("read", sql, params).rows }

fn first_row(sql, params) {
  let r = rows(sql, params)
  if len(r) == 0 { return nil }
  return r[0]
}

// ---- feedbuilder.php ----------------------------------------------------------------------------

fn today() { return date_format(now(), "%F", "local") }

// the first row for each key, as a ->row lookup gives it
fn first_by(rs, k) {
  let g = {}
  for r in rs {
    let key = ck(r[k])
    if g[key] == nil { g[key] = r }
  }
  return g
}

// numbers summed per key (a GROUP BY stockid whose groups MariaDB would have merged by collation)
fn sum_by(rs, k, v) {
  let g = {}
  for r in rs {
    let key = ck(r[k])
    let cur = g[key]
    g[key] = cur == nil ? num(r[v]) : dec_add(cur, num(r[v]))
  }
  return g
}

// rows grouped by a key column's ck(), in the order the rows came
fn group_rows(rs, k) {
  let g = {}
  for r in rs {
    let key = ck(r[k])
    if g[key] == nil { g[key] = [] }
    push(g[key], r)
  }
  return g
}

// The whole build for a set of items: what feedbuilder.php's build() reads one item at a time, read
// once per table. brands: nil or the manufacturer ids to keep; only: nil or the stockids to build.
// For some items every table is read for those items only; for the catalog, whole.
fn build(brands, levels, only) {
  let d = today()
  // " AND col IN (?)" and its parameter, when the build is for some items
  let o = fn (col) { return only == nil ? "" : " AND " + col + " IN (?)" }
  let op = fn (params) {
    if only != nil { push(params, only) }
    return params
  }

  let base_params = [d, d]
  let brandopt = ""
  if brands != nil {
    brandopt = " and product_to_manufacturer.manufacturer_id in (?) "
    push(base_params, brands)
  }
  let base = rows("select stockmaster.stockid as ITEM_NUMBER, manufacturer_id as VENDOR_1, mfgpart as VENDOR_ITEM_NO, price as PRICE_LEVEL_6, description as ITEM_DESCR, sort2 as SORT_2,additionalfee as FET_PRC_LVL_5 from stockmaster inner join product_to_manufacturer on stockmaster.stockid = product_to_manufacturer.stockid inner join prices on stockmaster.stockid = prices.stockid where stockmaster.categoryid = 'TIRE' and prices.typeabbrev = 'W' and prices.price > 0 and prices.startdate <= ? and prices.enddate >= ?  and discontinued = 0 " + brandopt + o("stockmaster.stockid") + " group by stockmaster.stockid", op(base_params))
  if len(base) == 0 { return [] }

  // quantity: getOnSalesOrder() and getOnOpenRgaByType() for warehouse 01, primarymixedinventory for the rest
  let qoh01 = sum_by(rows("SELECT stockid, SUM(quantity) AS q FROM locstock WHERE loccode IN ('01')" + o("stockid") + " GROUP BY stockid", op([])), 0, 1)
  let so_open = {}
  for r in rows("SELECT stkcode, SUM(quantity) AS q, SUM(qtyinvoiced) AS i FROM salesorderdetails WHERE completed != 1 AND orderno in (select orderno from salesorders where fromstkloc = '01')" + o("stkcode") + " GROUP BY stkcode", op([])) {
    let key = ck(r[0])
    let v = dec_sub(num(r[1]), num(r[2]))
    so_open[key] = so_open[key] == nil ? v : dec_add(so_open[key], v)
  }
  let has_rga_type = len(rows("SHOW COLUMNS FROM rgaorders LIKE 'rga_type'", nil)) > 0
  let rga = {}
  for r in rows("SELECT rgaorderdetails.itemcode, sum(quantityord) AS o, sum(quantityrecd) AS r FROM rgaorderdetails JOIN rgaorders ON rgaorderdetails.orderno = rgaorders.orderno WHERE rgaorderdetails.completed != 1 AND rgaorderdetails.quantityrecd < rgaorderdetails.quantityord" + (has_rga_type ? " AND rgaorders.rga_type = 'RT'" : "") + " AND rgaorders.intostocklocation = '01'" + o("rgaorderdetails.itemcode") + " GROUP BY rgaorderdetails.itemcode", op([])) {
    let key = ck(r[0])
    let v = dec_sub(num(r[1]), num(r[2]))
    rga[key] = rga[key] == nil ? v : dec_add(rga[key], v)
  }
  let remote = sum_by(rows("select stockid, SUM(quantity) AS q from primarymixedinventory where loccode in ('03','62','64','67')" + o("stockid") + " GROUP BY stockid", op([])), 0, 1)

  let mfg = first_by(rows("SELECT manufacturer_id, name FROM manufacturer", nil), 0)
  let specials = first_by(rows("select stockid, prices from stockspecials where ((andor = 1 and startdate <= ? and enddate >= ? ) or (andor = 2 and (qtylimit > qtysold OR qtylimit = 0)))" + o("stockid"), op([d, d])), 0)
  let sizes = first_by(rows("select stockid, size from tireinfo where 1 = 1" + o("stockid"), op([])), 0)

  let pricer = make_pricer(only)

  let out = []
  for item in base {
    let no = item[0]
    let key = ck(no)

    // $avail = QTY_ON_HAND - getOnSalesOrder() + remote: the one row a SUM without GROUP BY returns, where
    // a falsy sum counts as 0, which is the number it already is
    let onorder = dec_add(so_open[key] == nil ? "0" : so_open[key], rga[key] == nil ? "0" : rga[key])
    let avail = dec_sub(qoh01[key] == nil ? "0" : qoh01[key], onorder)
    avail = dec_add(avail, remote[key] == nil ? "0" : remote[key])

    let brand = nil
    let m = mfg[ck(item[1])]
    if m != nil { brand = m[1] }
    if not php_truthy(brand) { brand = "UNKNOWN" }

    // getSpecialPrices(): the first live special's JSON, else false
    let special = false
    let sp = specials[key]
    if sp != nil and sp[1] != nil {
      let j = pcall(json_parse, sp[1])
      special = j.ok ? j.value : nil
    }

    let prices = {}
    for level in levels {
      if php_truthy(special) and type(special) == "map" and special[level] != nil {
        prices[level] = special[level]
      } else {
        prices[level] = nf(pricer(no, level), 2)
      }
    }

    let size = nil
    let sz = sizes[ck(php_trim(no))]
    if sz != nil { size = sz[1] }
    if not php_truthy(size) { size = item[5] }

    if dec_cmp(avail, "5") >= 0 and dec_cmp(avail, "8") <= 0 { avail = "9" }

    push(out, {
      "Brand": php_trim(brand),
      "item": php_trim(item[2]),
      "prices": prices,
      "qty": nf(avail, 0),
      "vitem": php_trim(no),
      "Size": php_trim(size),
      "desc": php_trim(item[4]),
      "FET": nf(php_trim(item[6]), 2),
      "BLANK0": "", "BLANK1": "", "BLANK2": "", "BLANK3": "", "BLANK4": "",
      "manufacturer_id": item[1]
    })
  }
  return out
}

// getPLMPrice($stockid, $level): the price-level machinery, with every table it reads loaded once.
fn make_pricer(only) {
  let o = fn (col) { return only == nil ? "" : " AND " + col + " IN (?)" }
  let op = fn (params) {
    if only != nil { push(params, only) }
    return params
  }
  let salestypes = first_by(rows("SELECT typeabbrev, ispricebook, fallback FROM salestypes", nil), 0)
  let plp = {}
  for r in rows("SELECT typeabbrev, line_field, pricebasis, operator, amount FROM prodlineprice", nil) {
    let k = ck(r[0]) + "|" + ck(r[1])
    if plp[k] == nil { plp[k] = r }
  }
  let sm = first_by(rows("SELECT stockid, lineid, materialcost, lastcost FROM stockmaster WHERE 1 = 1" + o("stockid"), op([])), 0)
  let pricebooks = {}   // level -> stockid -> price row, read when a level is first asked for
  let cost_data = nil   // getItemCost()'s tables, read when a cost is first needed
  let memo = {}

  let pricebook = fn (level) {
    let pb = pricebooks[level]
    if pb != nil { return pb }
    pb = {}
    // ORDER BY startdate DESC LIMIT 1 per item; a NULL startdate sorts last
    for r in rows("SELECT stockid, price, startdate FROM prices WHERE typeabbrev = ? AND pricebook = '1' AND (startdate IS NULL OR startdate <= CURDATE()) AND (enddate IS NULL OR enddate >= CURDATE())" + o("stockid"), op([level])) {
      let key = ck(r[0])
      let cur = pb[key]
      if cur == nil or (r[2] != nil and (cur[2] == nil or r[2] > cur[2])) { pb[key] = r }
    }
    pricebooks[level] = pb
    return pb
  }

  let costs = fn () {
    if cost_data != nil { return cost_data }
    let c = {}
    // qohs: SUM(quantity) per (stockid, loccode)
    let locs = {}
    for r in rows("select stockid, loccode, sum(quantity) as qoh from locstock where 1 = 1" + o("stockid") + " group by stockid, loccode", op([])) {
      let key = ck(r[0])
      if locs[key] == nil { locs[key] = {} }
      let l = locs[key]
      let lk = ck(r[1])
      l[lk] = l[lk] == nil ? num(r[2]) : dec_add(l[lk], num(r[2]))
    }
    c.locs = locs
    c.demand = sum_by(rows("SELECT salesorderdetails.stkcode, SUM(salesorderdetails.quantity-salesorderdetails.qtyinvoiced) AS dem FROM salesorderdetails INNER JOIN salesorders ON salesorders.orderno = salesorderdetails.orderno INNER JOIN shippers on salesorders.shipvia = shipper_id WHERE salesorderdetails.completed=0 AND salesorders.quotation=0 AND shippername <> 'dropship'" + o("salesorderdetails.stkcode") + " GROUP BY salesorderdetails.stkcode", op([])), 0, 1)
    // the newest type-25 move's price per item
    let last25 = {}
    for r in rows("SELECT m.stockid, m.price, m.stkmoveno FROM stockmoves m JOIN (SELECT stockid, MAX(stkmoveno) AS mx FROM stockmoves WHERE type = 25" + o("stockid") + " GROUP BY stockid) l ON l.stockid = m.stockid AND l.mx = m.stkmoveno", op([])) {
      let key = ck(r[0])
      let cur = last25[key]
      if cur == nil or int(r[2]) > int(cur[2]) { last25[key] = r }
    }
    c.last25 = last25
    // the newest completed PO line's unit price per item
    let lastpo = {}
    for r in rows("SELECT p.itemcode, p.unitprice, p.podetailitem FROM purchorderdetails p JOIN (SELECT itemcode, MAX(podetailitem) AS mx FROM purchorderdetails WHERE completed = 1" + o("itemcode") + " GROUP BY itemcode) l ON l.itemcode = p.itemcode AND l.mx = p.podetailitem", op([])) {
      let key = ck(r[0])
      let cur = lastpo[key]
      if cur == nil or int(r[2]) > int(cur[2]) { lastpo[key] = r }
    }
    c.lastpo = lastpo
    // purchdata in preferred_sort order (a stable sort keeps the table's order for ties; NULL first)
    let pd = group_rows(rows("select stockid, supplierno, price, preferred_sort from purchdata where 1 = 1" + o("stockid"), op([])), 0)
    for k in keys(pd) {
      if len(pd[k]) > 1 { pd[k] = sort_by(pd[k], fn (r) { return r[3] == nil ? -1000000 : int(r[3]) }) }
    }
    c.purchdata = pd
    let rapi = {}
    for r in rows("select supplierno, warehouse from remoteapi inner join remotemapping on remoteapi.api_id = remotemapping.api_id", nil) {
      let key = ck(r[0])
      if rapi[key] == nil { rapi[key] = [] }
      push(rapi[key], r[1])
    }
    c.rapi = rapi
    // (loccode, stockid) is remotestock's key, so the row PHP reads is the only one, and all it asks of
    // it is qty > 0
    let rs = {}
    for r in rows("select stockid, loccode, qty from remotestock where qty > 0 and loccode in (select warehouse from remotemapping)" + o("stockid"), op([])) {
      let k = ck(r[0]) + "|" + ck(r[1])
      if rs[k] == nil { rs[k] = r }
    }
    c.remotestock = rs
    c.forced = first_by(rows("select stockid, cost from forcedcostoverride", nil), 0)
    cost_data = c
    return c
  }

  // getNextCost(): the first supplier, in preferred order, that has it in a remote warehouse, with PHP's
  // own loop. Its quirks are kept: a price read as the string "0.0000" is truthy, so it stops the search
  // only through "> 0"; an empty first supplier without a remote API ends the search.
  let next_cost = fn (stockid) {
    let c = costs()
    let key = ck(stockid)
    let nextcost = 0
    let iterator = 0
    let pd = c.purchdata[key]
    if pd == nil { pd = [] }
    for p in pd {
      let whs = c.rapi[ck(p[1])]
      if whs != nil and len(whs) > 0 {
        for w in whs {
          let rr = c.remotestock[key + "|" + ck(w)]
          if gt0(rr == nil ? nil : rr[2]) {
            nextcost = p[2]
            break
          }
        }
        if not php_truthy(nextcost) { nextcost = p[2] }
      } else {
        if iterator == 0 {
          nextcost = nf(p[2], 2)
          if php_truthy(nextcost) { break }
        }
      }
      iterator = iterator + 1
      if gt0(nextcost) { break }
    }
    if eq0(nextcost) {
      // GREATEST(lastcost, materialcost, last completed PO price or 0)
      let s = sm[key]
      if s == nil { return nil }
      let po = c.lastpo[key]
      nextcost = dec_max(dec_max(num(s[3]), num(s[2])), (po == nil or po[1] == nil) ? "0" : num(po[1]))
    }
    return nextcost
  }

  // getItemCost(): stock on hand after demand, then the moving cost or the next cost; a forced cost wins.
  // getItemDemand() is called once per location but has no location filter, so the whole demand comes
  // off once for every location the item has - PHP's own arithmetic, kept.
  let item_cost = fn (stockid) {
    let c = costs()
    let key = ck(stockid)
    let locs = c.locs[key]
    let dem = c.demand[key] == nil ? "0" : c.demand[key]
    let total = "0"
    if locs != nil {
      for lk in keys(locs) { total = dec_sub(dec_add(total, locs[lk]), dem) }
    }
    let s = sm[key]
    let ac = nil
    if s != nil {
      let l = c.last25[key]
      ac = dec_max(num(s[2]), (l == nil or l[1] == nil) ? "0" : num(l[1]))
    }
    let cost = dec_cmp(total, "0") > 0 ? ac : next_cost(stockid)
    let f = c.forced[key]
    if f != nil and php_truthy(f[1]) { cost = f[1] }
    return nf(cost, 2)
  }

  let plm = nil
  plm = fn (stockid, level, visited) {
    if php_in(level, visited) { return nil }
    visited = visited + [level]
    let st = salestypes[ck(level)]
    if st == nil { return nil }
    if php_in(st[1], ["1"]) {
      let r = pricebook(level)[ck(stockid)]
      if r != nil and php_truthy(r[1]) { return nf(r[1], 2) }
      level = st[2]
    }
    let s = sm[ck(stockid)]
    if s == nil { return nil }
    let row = plp[ck(level) + "|" + ck(s[1])]
    if row == nil { return nil }
    let basis = row[2] == nil ? "Cost" : row[2]
    let start = nil
    if lower(basis) == "cost" {
      start = num(item_cost(stockid))
    } else {
      let b = plm(stockid, basis, visited)
      if b == nil { return nil }
      start = num(b)
    }
    let calc = num_int(row[3]) == 1 ? dec_add(start, num(row[4])) : dec_mul(start, num(row[4]))
    return nf(calc, 2)
  }

  return fn (stockid, level) {
    let k = ck(stockid) + "|" + ck(level)
    if has(memo, k) { return memo[k] }
    let p = plm(stockid, level, [])
    memo[k] = p
    return p
  }
}

// filterForVendor(): drop the client's brands and items, keep the price of its level
fn filter_for_vendor(items, excluded_brands, excluded_skus, level) {
  let out = []
  for item in items {
    if php_in(item.manufacturer_id, excluded_brands) { continue }
    if php_in(item.vitem, excluded_skus) { continue }
    let price = item.prices[level]
    if price == nil {
      for k in keys(item.prices) {
        price = item.prices[k]
        break
      }
    }
    push(out, {
      "Brand": item.Brand, "item": item.item, "qty": item.qty, "vitem": item.vitem, "Size": item.Size,
      "desc": item.desc, "FET": item.FET, "BLANK0": "", "BLANK1": "", "BLANK2": "", "BLANK3": "", "BLANK4": "",
      "price": price
    })
  }
  return out
}

// resolvePriceLevel(): the branch's level, then the debtor's, then W
fn resolve_price_level(debtorno, branchcode) {
  if not php_truthy(debtorno) { return "W" }
  if php_truthy(branchcode) and lower(php_str(branchcode)) != "all" {
    let b = first_row("select pricelevel from custbranch where debtorno = ? and branchcode = ?", [php_str(debtorno), php_str(branchcode)])
    if b != nil and php_truthy(b[0]) { return b[0] }
  }
  let dm = first_row("select salestype from debtorsmaster where debtorno = ?", [php_str(debtorno)])
  if dm != nil and php_truthy(dm[0]) { return dm[0] }
  return "W"
}

// ---- credentials.php and the controller's checks ----------------------------------------------

let enc_key = nil

// StickerFeedEncryption::key(): sha256 of the key file's text, else of STICKERFEED_ENCRYPTION_KEY
fn sealing_key() {
  if enc_key != nil { return enc_key }
  let raw = ""
  let f = env("STICKERFEED_KEY_FILE", "/var/www/keyfile.txt")
  if file_exists(f) {
    let r = pcall(read_file, f)
    if r.ok { raw = php_trim(r.value) }
  }
  if raw == "" { raw = env("STICKERFEED_ENCRYPTION_KEY", "") }
  if raw == "" { error("Missing sticker feed encryption key (set /var/www/keyfile.txt or STICKERFEED_ENCRYPTION_KEY)") }
  enc_key = hex_decode(sha256(raw))
  return enc_key
}

// StickerFeedEncryption::decrypt(): 'enc:' + base64(iv | AES-256-CBC ciphertext); anything else as it is
fn unseal(v) {
  if v == nil or not starts_with(v, "enc:") { return v }
  let p = pcall(base64_decode, slice(v, 4))
  if not p.ok or len(p.value) < 17 { return nil }
  return aes_cbc_decrypt(sealing_key(), slice(p.value, 0, 16), slice(p.value, 16))
}

// StickerFeedCredentials::validateBearer(): the API vendor whose token this is, unless it has expired
fn validate_bearer(token) {
  if not php_truthy(token) { return nil }
  let r = run("read", "SELECT * FROM sticker_feed_exclusions WHERE connection_type = 'api' AND access_token_enc IS NOT NULL AND access_token_enc != ''", nil)
  let now_s = date_format(now(), "%F %T", "local")
  for v in r.records {
    let stored = unseal(v.access_token_enc)
    if not php_truthy(stored) or not hash_equals(stored, token) { continue }
    if v.auth_type == "oauth2_client_credentials" {
      if not php_truthy(v.token_expires_at) or v.token_expires_at < now_s { return nil }
    }
    return v
  }
  return nil
}

fn log_event(vendor_id, action, result, status, detail) {
  run("write", "INSERT INTO sticker_feed_connection_log (vendor_id, action, result, http_status, error_detail, actor_userid, created_at) VALUES (?, ?, ?, ?, ?, NULL, NOW())",
      [num_int(vendor_id), action, result, status, detail == nil ? nil : slice(php_str(detail), 0, 2000)])
}

// checkRateLimit(): PHP counts the log's rows for this action, and it logs a successful feed as "send",
// so only failed calls count against a vendor - kept as it is.
fn rate_limited(action, vendor_id, limit, window) {
  let r = run("write", "SELECT COUNT(*) as count FROM sticker_feed_connection_log WHERE vendor_id = ? AND action = ? AND created_at >= FROM_UNIXTIME(?)",
              [php_str(vendor_id), action, int(now()) - window])
  return num_int(r.rows[0][0]) >= limit
}

fn reply(status, body) { return {"status": status, "json": body} }

// getBearerTokenAndValidate($function): {client} or {fail: the response PHP set}
fn authenticate(req, function) {
  let h = req.headers.authorization
  let m = regex_match("^Bearer\\s+(.+)$", php_trim(h == nil ? "" : h), "i")
  let token = m == nil ? nil : php_trim(m.groups[0])
  if not php_truthy(token) {
    return {"fail": reply(401, {"error": "invalid_request", "error_description": "Missing Authorization: Bearer header"})}
  }
  let client = validate_bearer(token)
  if client == nil {
    log_event(0, "getBearerTokenAndValidate", "fail", 401, "Invalid or expired token")
    return {"fail": reply(401, {"error": "invalid_token", "error_description": "Invalid or expired token"})}
  }
  let id = num_int(client.id)
  if not php_truthy(client.debtorno) {
    log_event(id, "getBearerTokenAndValidate", "fail", 403, "No debtor assigned to client")
    return {"fail": reply(403, {"error": "invalid_request", "error_description": "No debtor assigned to client"})}
  }
  let access = first_row("select sticker_feed_endpoints.function from sticker_feed_access join sticker_feed_endpoints on sticker_feed_access.function_id = sticker_feed_endpoints.function_id where sticker_feed_access.id = ? and sticker_feed_endpoints.function = ?", [str(id), function])
  if access == nil or not php_truthy(access[0]) {
    log_event(id, "getBearerTokenAndValidate", "fail", 403, "Client access to " + function + " denied")
    return {"fail": reply(403, {"error": "invalid_request", "error_description": "Endpoint not accessable"})}
  }
  return {"client": client}
}

// ---- the endpoints ----------------------------------------------------------------------------

let stats = {"feed": 0, "stock_check": 0, "errors": 0}
let recent = []
let last_error = ""

fn note(endpoint, status, items, ms) {
  push(recent, {
    "time": date_format(now(), "%T", "local"), "endpoint": endpoint, "status": str(status),
    "items": str(items), "ms": str(round(ms))
  })
  if len(recent) > 12 { recent = slice(recent, len(recent) - 12) }
}

fn client_exclusions(client_id) {
  let brands = []
  for r in rows("select mfg_id from sticker_feed_brands where id = ?", [client_id]) { push(brands, r[0]) }
  let skus = []
  for r in rows("select stockid from sticker_feed_skus where id = ?", [client_id]) { push(skus, r[0]) }
  return {"brands": brands, "skus": skus}
}

// json_decode(php://input, true), with is_array(): nil when the body is not a JSON object or list
fn body_json(req) {
  let r = pcall(json_parse, req.body == nil ? "" : req.body)
  if not r.ok { return nil }
  let t = type(r.value)
  if t != "map" and t != "list" { return nil }
  return r.value
}

// feed(), in PHP's order: authenticate, rate limit, payload, brands, build, filter, log
fn feed(req) {
  let auth = authenticate(req, "feed")
  let client = auth.client
  let vid = client == nil ? "" : php_str(client.id)
  if rate_limited("feed", vid, 10, 120) {
    log_event(vid, "feed", "fail", 400, "")
    return reply(400, {"error": "invalid_request", "error_description": "Rate limit exceeded. Please try again later."})
  }
  if client == nil { return auth.fail }

  let client_id = num_int(client.id)
  let ex = client_exclusions(client_id)

  let body = body_json(req)
  if body == nil {
    log_event(client_id, "feed", "fail", 404, "Invalid payload JSON")
    return reply(404, {"error": "JSON FORMAT", "error_description": "Invalid JSON in payload"})
  }

  // brand names -> manufacturer ids, less the client's excluded brands
  let has_brands = type(body) == "map" and has(body, "brands")
  let limited = nil
  let b = has_brands ? body.brands : nil
  if b != nil and not loose_empty_string(b) {
    let names = type(b) == "list" ? b : (type(b) == "map" ? values(b) : [b])
    if len(names) > 0 {
      let given = []
      for n in names { push(given, php_str(n)) }
      let ids = []
      for r in rows("select manufacturer_id from manufacturer where name in (?)", [given]) {
        if not php_in(r[0], ex.brands) { push(ids, r[0]) }
      }
      if len(ids) > 0 { limited = ids }
    }
  }
  if has_brands and limited == nil {
    log_event(client_id, "feed", "fail", 404, "No items found for supplied brands")
    return reply(404, {"error": "not_found", "error_description": "No items found for supplied brands"})
  }

  let level = resolve_price_level(client.debtorno, client.branchcode)
  let items = build(limited, [level], nil)
  let out = filter_for_vendor(items, ex.brands, ex.skus, level)

  // date('Y-m-d G:i:s'): the hour without a leading zero
  let t = now()
  let lastsent = date_format(t, "%Y-%m-%d ", "local") + str(int(date_format(t, "%H", "local"))) + date_format(t, ":%M:%S", "local")
  run("write", "update sticker_feed_exclusions set lastsent = ?, lastfile = ? where id = ?", [lastsent, str(len(out)) + " items", client_id])
  log_event(client_id, "send", "success", 200, "feed pulled")
  return reply(200, {"items": out})
}

// stock_check: the feed's own rows for the items asked about, read now - the check a vendor makes
// before it places an order. Same token, same access to "feed", same exclusions and price level.
let STOCK_CHECK_MAX = 500

fn stock_check(req) {
  let auth = authenticate(req, "feed")
  if auth.client == nil { return auth.fail }
  let client = auth.client
  let client_id = num_int(client.id)
  let body = body_json(req)
  let asked = []
  if body != nil and type(body) == "map" {
    if type(body.skus) == "list" {
      for s in body.skus { push(asked, s) }
    } else if type(body.lines) == "list" {
      for l in body.lines { if type(l) == "map" and l.sku != nil { push(asked, l.sku) } }
    } else if body.sku != nil {
      push(asked, body.sku)
    }
  }
  // placeorder reads a sku as trim(strtoupper())
  let skus = []
  let seen = {}
  for s in asked {
    let k = php_trim(upper(php_str(s)))
    if k != "" and seen[k] == nil {
      seen[k] = true
      push(skus, k)
    }
  }
  if len(skus) == 0 {
    log_event(client_id, "stock_check", "fail", 400, "No skus in payload")
    return reply(400, {"error": "invalid_request", "error_description": "Send {\"skus\": [\"STOCKID\", ...]} or {\"lines\": [{\"sku\": ...}]}"})
  }
  if len(skus) > STOCK_CHECK_MAX {
    log_event(client_id, "stock_check", "fail", 400, "Too many skus")
    return reply(400, {"error": "invalid_request", "error_description": "At most " + str(STOCK_CHECK_MAX) + " skus per call"})
  }
  let ex = client_exclusions(client_id)
  let level = resolve_price_level(client.debtorno, client.branchcode)
  let out = filter_for_vendor(build(nil, [level], skus), ex.brands, ex.skus, level)
  let found = {}
  for it in out { found[ck(it.vitem)] = true }
  let missing = []
  for s in skus { if found[ck(s)] == nil { push(missing, s) } }
  log_event(client_id, "stock_check", "success", 200, str(len(out)) + " of " + str(len(skus)) + " found")
  return reply(200, {"items": out, "not_found": missing})
}

// One request; anything unexpected is answered as PHP's catch answers it, and the cause is kept.
// Like the PHP, the method is not checked: a GET has no JSON body and is told so.
fn guarded(endpoint, handler) {
  return fn (req) {
    let t0 = now()
    let r = pcall(handler, req)
    let ms = (now() - t0) * 1000.0
    if not r.ok {
      stats.errors = stats.errors + 1
      last_error = date_format(now(), "%T", "local") + " " + endpoint + ": " + r.error
      print("stickerfeed: " + endpoint + ": " + r.error)
      note(endpoint, 500, 0, ms)
      return reply(500, {"error": "server_error", "error_description": "Unexpected error"})
    }
    stats[slice(endpoint, 1)] = stats[slice(endpoint, 1)] + 1
    let j = r.value.json
    let n = (j != nil and type(j.items) == "list") ? len(j.items) : 0
    note(endpoint, r.value.status, n, ms)
    return r.value
  }
}

// ---- the ops view ---------------------------------------------------------------------------

fn mirror_state() {
  let r = pcall(run, "read", "SHOW SLAVE STATUS", nil)
  if not r.ok { return "ASQL unreachable: " + r.error }
  if len(r.value.records) == 0 { return "ASQL is not replicating" }
  let s = r.value.records[0]
  return "replicating: io " + php_str(s.Slave_IO_Running) + ", sql " + php_str(s.Slave_SQL_Running) + ", " + php_str(s.Seconds_Behind_Master) + " s behind"
}

let mirror = mirror_state()
every(10, fn () { mirror = mirror_state() })

fn view() {
  let rev = []
  for r in recent { rev = [r] + rev }
  return ui.column({"gap": 14, "pad": 12}, [
    ui.heading("StickerFeed vendor API", {"size": 24}),
    ui.text("Reads ASQL at " + ASQL.host + ":" + str(ASQL.port) + " (" + mirror + "). Writes the log to " + (WRITE.host == "" ? "nowhere: STICKERFEED_WRITE_HOST is not set" : WRITE.host + ":" + str(WRITE.port)) + ".", {"dim": true}),
    ui.row({"gap": 12}, [
      ui.tile("Feeds served", stats.feed),
      ui.tile("Stock checks", stats.stock_check),
      ui.tile("Errors", stats.errors, {"accent": stats.errors > 0 ? "bad" : "ok"})
    ]),
    last_error == "" ? ui.text("No errors.", {"dim": true}) : ui.text(last_error, {"color": "bad"}),
    ui.table(rev, {"columns": "time:Time, endpoint:Endpoint, status:Status, items:Items:right, ms:ms:right", "empty": "No requests yet."})
  ])
}

ui.pane({
  "title": "StickerFeed",
  "width": 900,
  "height": 600,
  "shared": true,
  "refresh": 5,
  "routes": {
    "/feed": guarded("/feed", feed),
    "/stock_check": guarded("/stock_check", stock_check)
  },
  "view": view
})
