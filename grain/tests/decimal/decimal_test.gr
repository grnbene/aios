# Decimals: exact base-10 arithmetic on text, for money and quantities.

test("reads numbers into one form", fn () {
  expect_eq(decimal("12.50"), "12.5")
  expect_eq(decimal(" -0007.000 "), "-7")
  expect_eq(decimal("-0.0"), "0")
  expect_eq(decimal(".5"), "0.5")
  expect_eq(decimal("5."), "5")
  expect_eq(decimal("1e3"), "1000")
  expect_eq(decimal("1.5E-3"), "0.0015")
  expect_eq(decimal(42), "42")
  expect_eq(decimal(0.1), "0.1")
  expect_eq(decimal(29.389999999999997), "29.389999999999997")
  expect_eq(decimal("12abc"), nil)
  expect_eq(decimal(""), nil)
  expect_eq(decimal("."), nil)
  expect_eq(decimal(nil), nil)
})

test("reads the number a string starts with", fn () {
  expect_eq(decimal_prefix("12abc"), {"value": "12", "rest": "abc"})
  expect_eq(decimal_prefix("  7.5  "), {"value": "7.5", "rest": "  "})
  expect_eq(decimal_prefix("1e3x"), {"value": "1000", "rest": "x"})
  expect_eq(decimal_prefix("1e"), {"value": "1", "rest": "e"})
  expect_eq(decimal_prefix("-.5"), {"value": "-0.5", "rest": ""})
  expect_eq(decimal_prefix("abc"), nil)
  expect_eq(decimal_prefix(""), nil)
})

test("adds, subtracts and multiplies exactly", fn () {
  expect_eq(dec_add("0.1", "0.2"), "0.3")
  expect_eq(dec_add("-5", "3.25"), "-1.75")
  expect_eq(dec_sub("1", "1.0000"), "0")
  expect_eq(dec_sub("2.5", "10"), "-7.5")
  expect_eq(dec_mul("12.3456", "1.35"), "16.66656")
  expect_eq(dec_mul("-2", "0.5"), "-1")
  expect_eq(dec_mul("99999999999999999999", "99999999999999999999"), "9999999999999999999800000000000000000001")
  expect_eq(dec_add(1, 0.5), "1.5")
})

test("divides to the places asked for", fn () {
  expect_eq(dec_div("10", "3", 4), "3.3333")
  expect_eq(dec_div("2", "3", 2), "0.67")
  expect_eq(dec_div("-2", "3", 2), "-0.67")
  expect_eq(dec_div("1", "8", 2), "0.13")
  expect_eq(dec_div("1", "8", 2, "half_even"), "0.12")
  expect_eq(dec_div("1", "8", 2, "down"), "0.12")
  expect_eq(dec_div("12.5", "0.25", 0), "50")
  expect_error(fn () { return dec_div("1", "0", 2) }, "division by zero")
})

test("compares", fn () {
  expect_eq(dec_cmp("1.50", "1.5"), 0)
  expect_eq(dec_cmp("-2", "1"), -1)
  expect_eq(dec_cmp("10", "9.999"), 1)
  expect_eq(dec_cmp("-0.1", "-0.2"), 1)
})

test("rounds in each mode", fn () {
  expect_eq(dec_round("2.675", 2), "2.68")
  expect_eq(dec_round("-2.675", 2), "-2.68")
  expect_eq(dec_round("2.665", 2, "half_even"), "2.66")
  expect_eq(dec_round("2.675", 2, "half_even"), "2.68")
  expect_eq(dec_round("2.679", 2, "down"), "2.67")
  expect_eq(dec_round("-2.671", 2, "floor"), "-2.68")
  expect_eq(dec_round("2.671", 2, "ceil"), "2.68")
  expect_eq(dec_round("1250", -2), "1300")
  expect_eq(dec_round("8.5"), "9")
  expect_eq(dec_round("-0.004", 2), "0")
  expect_error(fn () { return dec_round("1", 2, "sideways") }, "half_up, half_even")
})

test("rounds to significant digits", fn () {
  expect_eq(dec_round_sig("123456789.123456789", 15), "123456789.123457")
  expect_eq(dec_round_sig("0.00012345", 2), "0.00012")
  expect_eq(dec_round_sig("98765", 2), "99000")
  expect_eq(dec_round_sig("1.5", 15), "1.5")
})

test("formats with fixed places", fn () {
  expect_eq(dec_format("2.675", 2), "2.68")
  expect_eq(dec_format("1.005", 2), "1.01")
  expect_eq(dec_format("-0.004", 2), "0.00")
  expect_eq(dec_format("-0.005", 2), "-0.01")
  expect_eq(dec_format("12", 2), "12.00")
  expect_eq(dec_format("7.5", 0), "8")
  expect_eq(dec_format("0.5"), "1")
  expect_eq(dec_format("1234567.125", 2), "1234567.13")
})

test("refuses what is not a number", fn () {
  expect_error(fn () { return dec_add("abc", "1") }, "dec_add: \"abc\" is not a number")
  expect_error(fn () { return dec_mul("1", nil) }, "dec_mul: wants a number")
  expect_error(fn () { return decimal_prefix(5) }, "wants a string")
  expect_error(fn () { return dec_format("1", -1) }, "places is 0 or more")
})

test("reads \\x escapes as bytes", fn () {
  expect_eq(ord("\x41"), 65)
  expect_eq(len("a\x00b"), 3)
  expect_eq("\x0B", chr(11))
})
