# grain fmt: formats a copy of INPUT in the build tree and compares it with
# EXPECTED; a second run must change nothing; both must run the same.
#   cmake -DGRAIN=... -DINPUT=... -DEXPECTED=... -DWORK=... -P run_fmt.cmake
file(REMOVE_RECURSE ${WORK})
file(MAKE_DIRECTORY ${WORK})
file(COPY ${INPUT} DESTINATION ${WORK})
get_filename_component(name ${INPUT} NAME)
execute_process(COMMAND ${GRAIN} fmt ${name} WORKING_DIRECTORY ${WORK} RESULT_VARIABLE r1 OUTPUT_VARIABLE o1 ERROR_VARIABLE e1)
if(NOT r1 EQUAL 0)
  message(FATAL_ERROR "grain fmt failed (${r1}): ${o1}${e1}")
endif()
file(READ ${WORK}/${name} got)
file(READ ${EXPECTED} want)
if(NOT "${got}" STREQUAL "${want}")
  message(FATAL_ERROR "formatted as\n${got}\nexpected\n${want}")
endif()
execute_process(COMMAND ${GRAIN} fmt --check ${name} WORKING_DIRECTORY ${WORK} RESULT_VARIABLE r2 OUTPUT_VARIABLE o2)
if(NOT r2 EQUAL 0)
  message(FATAL_ERROR "a second grain fmt would change it again: ${o2}")
endif()
execute_process(COMMAND ${GRAIN} run ${INPUT} OUTPUT_VARIABLE before)
execute_process(COMMAND ${GRAIN} run ${WORK}/${name} OUTPUT_VARIABLE after)
if(NOT "${before}" STREQUAL "${after}")
  message(FATAL_ERROR "the formatted program printed\n${after}\nthe original\n${before}")
endif()
