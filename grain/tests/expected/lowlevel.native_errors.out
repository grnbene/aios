bad.gr:1:1: the two sides of an operator: i64 and f64 do not mix (convert with `as`)
native fn mix(a: i64, b: f64) -> i64 { return a + b }
^
bad.gr:2:1: wrong_return() returns f64 but this is i64
native fn wrong_return(a: i64) -> f64 { return a }
^
bad.gr:3:1: an if wants a bool, got i64 (compare it, e.g. `x != 0`)
native fn bad_if(a: i64) -> i64 { if a { return 1 } return 0 }
^
bad.gr:4:1: "nope" is not declared
native fn undeclared() -> i64 { return nope + 1 }
^
bad.gr:5:1: "add3" is not a native function (declare it above this one)
native fn bad_call() -> i64 { return add3(1, 2) }
^
bad.gr:6:1: too_many() takes 1 argument(s), got 2
native fn too_many(a: i64) -> i64 { return too_many(a, a) }
^
bad.gr:7:1: "string" is not a type (i64, f64, bool, bytes or ptr)
native fn bad_type(a: string) -> i64 { return 0 }
^
bad.gr:8:1: only a bytes variable can be indexed
native fn bad_index(a: i64) -> i64 { return a[0] }
^
bad.gr:9:1: "b" is bytes but this is i64
native fn bad_assign(b: bytes) -> i64 { b = 5 return 0 }
^
bad.gr:10:1: no_value() returns nothing, so `return` takes no value
native fn no_value() { return 1 }
^
bad.gr:11:1: break outside a loop
native fn no_break() -> i64 { break return 0 }
^
bad.gr:12:1: a native function cannot return bytes
native fn returns_bytes(b: bytes) -> bytes { return b }
^
