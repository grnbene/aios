[Unit]
Description=aios Agent Control Service (capability-scoped agent runtime, wire protocol)
After=network.target

[Service]
Type=simple
User=aios
Group=aios
WorkingDirectory=/opt/aios
Environment=AIOS_NO_ACCEL=1
Environment=AIOS_AGENT_CONTROL_MEMORY_MB=256
EnvironmentFile=-/etc/aios/agent-control.env
ExecStart=/opt/aios/bin/aios-agent-control --root /opt/aios/agent-control-root --port 7312 --auth-secret-file /etc/aios/agent-control.key
Restart=always
RestartSec=2
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/aios/agent-control-root

[Install]
WantedBy=multi-user.target
