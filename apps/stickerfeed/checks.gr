// Pre-cutover health checks.
// Verifies that the newly deployed instance serves the status dashboard (HTTP 200)
// and rejects unauthenticated requests to /feed with HTTP 401.
fn check(app) {
  let page = http_get(app.url + "/")
  if page.status != 200 { return "GET / answered " + str(page.status) }
  let feed = http_post(app.url + "/feed", "{}", {"headers": {"Content-Type": "application/json"}})
  if feed.status != 401 { return "POST /feed without a token answered " + str(feed.status) + ", not 401" }
  return true
}
