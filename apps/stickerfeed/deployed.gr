// Post-deploy hook.
// Registers or replaces the `sticker_item` ASQL Thing.
// ASQL compiles the Thing program in the background alongside any existing version,
// seamlessly swapping the pointer once the initial population pass finishes.
// The Thing bundle is assembled by app_program("things/sticker_item.gr") with lib/feed.gr embedded.

fn setting(name, fallback) {
  let v = getenv(name)
  if v != nil and v != "" { return v }
  let f = getenv(name + "_FILE")
  if f != nil and f != "" { return trim(read_file(f)) }
  return fallback
}

// Database tables observed by the sticker_item Thing for reactive change tracking.
let READS = "stockmaster, product_to_manufacturer, prices, locstock, stockmoves, purchdata, purchorderdetails, " +
            "remotestock, tireinfo, stockspecials, forcedcostoverride, salesorderdetails, rgaorderdetails, salesorders, " +
            "rgaorders, shippers, manufacturer, salestypes, prodlineprice, remoteapi, remotemapping, " +
            "sticker_feed_exclusions, custbranch, debtorsmaster"

fn deployed(app) {
  let c = db_connect(setting("ASQL_HOST", "127.0.0.1"), int(setting("ASQL_PORT", "3307")), setting("ASQL_USER", "root"),
                     setting("ASQL_PASSWORD", ""), setting("ASQL_DB", "versioneight"))
  if not c.ok { return "cannot reach ASQL: " + c.error }
  let program = app_program("things/sticker_item.gr")
  let have = db_query(c, "SHOW THINGS", [])
  let exists = false
  if have.ok { for r in have.records { if r.thing == "sticker_item" { exists = true } } }
  let verb = exists ? "CREATE OR REPLACE THING" : "CREATE THING"
  let r = db_query(c, verb + " sticker_item GRAIN KEY stockid READS " + READS + " AS ?", [program])
  db_close(c)
  if not r.ok { return "sticker_item: " + r.error }
  print("sticker_item: " + (exists ? "replaced in place" : "created") + ", " + str(r.affected_rows) + " things")
  return true
}
