// sticker_item - ASQL Reactive Materialized View (Thing) for Vendor Catalog Feeds
//
// Maintains in-memory, pre-rendered JSON payload rows for each tire SKU across all active customer
// price levels (e.g. `r_W`, `r_L`). Serves vendor catalog pulls in ~280ms via `SHOW THING sticker_item`.
//
// Projected Fields:
//   mid      Manufacturer ID (used to evaluate vendor brand exclusions)
//   vitem    Vendor item / SKU code (used to evaluate vendor SKU exclusions)
//   r_<LVL>  Pre-rendered JSON object string for customer price level <LVL>
//   wake_at  Timestamp indicating when a pricing or promotional special boundary occurs
//
// Lifecycle Hooks:
//   - enroll(): Identifies candidate tire SKUs from stockmaster (categoryid = 'TIRE').
//   - shared(): Provides global parameters across all items (distinct customer price levels).
//   - things(keys, shared): Builds and returns projected records for the requested keys.
//   - touched(table, op, before, after, shared): Event-driven CDC invalidation handler.
//     Translates table mutations into dirty SKU keys or global rebuild signals.

import "../lib/feed.gr"

// Instructs the engine that daily transitions only affect items with an active wake_at date
let DAY_SAFE = true

let BIG_BATCH = 4000

// In-memory cache for reference tables shared across all items during batch builds
KEEP_WHOLE = true
WHOLE = {}

let HAS_RGA_TYPE = pcall(read, "SELECT rga_type FROM rgaorders LIMIT 1").ok
fn has_rga_type() { return HAS_RGA_TYPE }

// Executes raw wire-format SQL queries, returning positional column arrays for high throughput
fn rows(sql, params) {
  let out = []
  for r in read_raw_with(sql, params) { push(out, values(r)) }
  return out
}

fn first_row(sql, params) {
  let r = rows(sql, params)
  if len(r) == 0 { return nil }
  return r[0]
}

fn today() { return read_raw("SELECT CURDATE() AS d")[0].d }

// Discovers the distinct set of price levels assigned to all registered API clients
fn client_levels() {
  let out = ["W"]   // W always: the feed's own level
  for c in read("SELECT debtorno, branchcode FROM sticker_feed_exclusions") { push(out, resolve_price_level(c.debtorno, c.branchcode)) }
  return sort(unique(out))
}

// enroll(): Identifies candidate stockids to track as Things
fn enroll() {
  let out = []
  for r in read("SELECT stockid FROM stockmaster WHERE categoryid = 'TIRE'") { push(out, r.stockid) }
  return out
}

// shared(): Context passed to things() and touched()
fn shared() { return {"levels": client_levels()} }

// Computes future calendar boundary dates when promotional specials or price rules activate/expire
fn next_changes(ids, levels, d) {
  let at = {}
  let note = fn (id, day) {
    if day == nil or day <= d { return nil }
    let k = ck(id)
    if at[k] == nil or day < at[k] { at[k] = day }
    return nil
  }
  let lv = []
  for l in levels { push(lv, l) }
  if not (sort(lv) == sort(["W"])) { push(lv, "W") }
  for r in rows("SELECT stockid, startdate AS s, DATE_ADD(enddate, INTERVAL 1 DAY) AS e FROM prices WHERE typeabbrev IN (?) AND (startdate > ? OR (enddate >= ? AND enddate < '9999-01-01'))" + in_ids("stockid", ids), with_ids([lv, d, d], ids)) {
    note(r[0], r[1])
    note(r[0], r[2])
  }
  for r in rows("SELECT stockid, startdate AS s, DATE_ADD(enddate, INTERVAL 1 DAY) AS e FROM stockspecials WHERE (startdate > ? OR (enddate >= ? AND enddate < '9999-01-01'))" + in_ids("stockid", ids), with_ids([d, d], ids)) {
    note(r[0], r[1])
    note(r[0], r[2])
  }
  return at
}

// Incremental cache and dirty-tracking state for table inputs
INPUTS = {}
let INPUT_DAY = nil
let DATED = ["base", "specials", "wake"]
let MARKED = {}
let FULL_EXPECTED = false
let IN_TOUCHED = false

fn drop_input(name) {
  if name == "pb_*" {
    for n in keys(INPUTS) { if starts_with(n, "pb_") { del(INPUTS, n) } }
  } else if has(INPUTS, name) { del(INPUTS, name) }
}

fn mark(id, names) {
  let k = ck(id)
  MARKED[k] = true
  for name in names {
    if name == "pb_*" {
      for n in keys(INPUTS) { if starts_with(n, "pb_") { INPUTS[n].dirty[k] = true } }
    } else if has(INPUTS, name) { INPUTS[name].dirty[k] = true }
  }
}

// Queries the base item row join (stockmaster, product_to_manufacturer, prices) for specific SKU keys
fn base_rows(sql, ids, d) {
  let pm = {}
  for r in rows("select stockid, manufacturer_id from product_to_manufacturer where stockid IN (?)", [ids]) {
    let k = ck(r[0])
    if has(pm, k) { return first_by(rows(sql + " and stockmaster.stockid IN (?) and product_to_manufacturer.stockid IN (?) and prices.stockid IN (?) group by stockmaster.stockid", [d, d, ids, ids, ids]), 0) }
    pm[k] = r[1]
  }
  let pr = first_by(rows("select stockid, price from prices where typeabbrev = 'W' and price > 0 and startdate <= ? and enddate >= ? and stockid IN (?)", [d, d, ids]), 0)
  let out = {}
  for r in rows("select stockid, mfgpart, description, sort2, additionalfee from stockmaster where categoryid = 'TIRE' and discontinued = 0 and stockid IN (?)", [ids]) {
    let k = ck(r[0])
    if not has(pm, k) or not has(pr, k) or has(out, k) { continue }
    out[k] = [r[0], pm[k], r[1], pr[k][1], r[2], r[3], r[4]]
  }
  return out
}

// things(ks, sh): Main projection batch generator. Produces precomputed JSON rows for candidate keys
fn things(ks, sh) {
  let d = today()
  let levels = sh.levels
  let big = len(ks) > BIG_BATCH
  if IN_TOUCHED or (big and not FULL_EXPECTED) {
    INPUTS = {}
    WHOLE = {}
    IN_TOUCHED = false
  }
  FULL_EXPECTED = false
  if d != INPUT_DAY {
    for n in DATED { drop_input(n) }
    drop_input("pb_*")
    INPUT_DAY = d
  }
  if not big {
    let all_names = keys(INPUTS)
    for k in ks { if not has(MARKED, ck(k)) { mark(k, all_names) } }
  }
  for k in ks { if has(MARKED, ck(k)) { del(MARKED, ck(k)) } }

  let sql = "select stockmaster.stockid as ITEM_NUMBER, manufacturer_id as VENDOR_1, mfgpart as VENDOR_ITEM_NO, price as PRICE_LEVEL_6, description as ITEM_DESCR, sort2 as SORT_2,additionalfee as FET_PRC_LVL_5 from stockmaster inner join product_to_manufacturer on stockmaster.stockid = product_to_manufacturer.stockid inner join prices on stockmaster.stockid = prices.stockid where stockmaster.categoryid = 'TIRE' and prices.typeabbrev = 'W' and prices.price > 0 and prices.startdate <= ? and prices.enddate >= ?  and discontinued = 0"
  let by_id = input("base", big ? nil : ks, fn (ids) {
    if ids == nil { return first_by(rows(sql + " group by stockmaster.stockid", [d, d]), 0) }
    return base_rows(sql, ids, d)
  })
  let base = []
  for k in ks {
    let b = by_id[ck(k)]
    if b != nil { push(base, b) }
  }
  let out = {}
  if len(base) == 0 { return out }
  let ids = nil
  if not big {
    ids = []
    for item in base { push(ids, item[0]) }
  }
  let items = build_items(base, levels, ids, d, nil, false)
  let wakes = input("wake", ids, fn (some) { return next_changes(some, levels, d) })
  let at = 0
  for rec in items {
    let id = base[at][0]
    let vals = {"mid": php_str(base[at][1]), "vitem": rec.vitem}
    if wakes[ck(id)] != nil { vals["wake_at"] = wakes[ck(id)] + " 00:00:00" }
    for level in levels {
      vals["r_" + level] = php_json({
        "Brand": rec.Brand, "item": rec.item, "qty": rec.qty, "vitem": rec.vitem, "Size": rec.Size,
        "desc": rec.desc, "FET": rec.FET, "BLANK0": "", "BLANK1": "", "BLANK2": "", "BLANK3": "", "BLANK4": "",
        "price": rec.prices[level]
      })
    }
    out[id] = vals
    at = at + 1
  }
  return out
}

// Canonicalizes stockids against stockmaster to resolve case or padding differences
let CANON = {}
fn canon(v) {
  if v == nil { return nil }
  let s = str(v)
  if has(CANON, s) { return CANON[s] }
  let r = read("SELECT stockid FROM stockmaster WHERE stockid = ?", s)
  let c = len(r) > 0 ? r[0].stockid : nil
  CANON[s] = c
  return c
}

// Maps per-item tables to their respective item-identifier column name
let ITEM_COL = {
  "stockmaster": "stockid", "product_to_manufacturer": "stockid", "prices": "stockid", "locstock": "stockid",
  "stockmoves": "stockid", "purchdata": "stockid", "purchorderdetails": "itemcode", "remotestock": "stockid",
  "tireinfo": "stockid", "stockspecials": "stockid", "forcedcostoverride": "stockid",
  "salesorderdetails": "stkcode", "rgaorderdetails": "itemcode"
}

// Global tables whose changes invalidate all items or affect customer price level sets
let EVERY_ITEM = {"salestypes": true, "prodlineprice": true, "remoteapi": true, "remotemapping": true}
let LEVELS_MOVE = {"sticker_feed_exclusions": true, "custbranch": true, "debtorsmaster": true}

// Columns that determine customer price level mappings. Updates leaving these untouched skip re-indexing.
let LEVEL_COLS = {"sticker_feed_exclusions": ["debtorno", "branchcode"], "custbranch": ["debtorno", "branchcode", "pricelevel"],
                  "debtorsmaster": ["debtorno", "salestype"]}

fn levels_unmoved(t, before, after) {
  if before == nil or after == nil { return false }
  for c in LEVEL_COLS[t] {
    if str(before[c]) != str(after[c]) { return false }
  }
  return true
}

// Reference tables cached whole and their corresponding cache keys
let WHOLE_OF = {"manufacturer": ["mfg"], "salestypes": ["salestypes"], "prodlineprice": ["plp"], "remoteapi": ["rapi"],
                "remotemapping": ["rapi"], "forcedcostoverride": ["forced"]}

// Input caches invalidated when specific tables receive writes
let TABLE_INPUTS = {
  "stockmaster": ["base", "sm"], "product_to_manufacturer": ["base"], "prices": ["base", "wake", "pb_*"],
  "locstock": ["qoh01", "remote", "locs"], "stockmoves": ["last25"], "purchdata": ["pd"],
  "purchorderdetails": ["lastpo"], "remotestock": ["remote", "rs"], "tireinfo": ["sizes"],
  "stockspecials": ["specials", "wake"], "forcedcostoverride": [], "salesorderdetails": ["so_open", "demand"],
  "rgaorderdetails": ["rga"], "salesorders": ["so_open", "demand"], "rgaorders": ["rga"], "shippers": ["demand"],
  "manufacturer": ["remote"]
}
let EVERY_INPUTS = {"remoteapi": ["remote", "rs"], "remotemapping": ["remote", "rs"]}

// Validates whether a quantity is a whole integer suitable for in-memory delta arithmetic
fn whole_qty(v) {
  if v == nil { return nil }
  let d = num(v)
  if not (decimal(int(d)) == d) { return nil }
  return decimal(int(d))
}

// Applies delta quantity adjustment to cached location sums in-place
fn move_sum(name, key, sub, by) {
  let st = INPUTS[name]
  if st == nil { return true }
  if has(st.dirty, key) { return true }
  if not (st.all or has(st.got, key)) { return true }
  let v = st.v
  if sub != nil {
    if v[key] == nil { return false }
    v = v[key]
    key = sub
  }
  let cur = whole_qty(v[key])
  if cur == nil { return false }
  v[key] = cur + by
  return true
}

let REMOTE_LOCS = {"03": true, "62": true, "64": true, "67": true}

// Fast-path handler for in-place locstock quantity updates:
// Directly adjusts cached sums for warehouse 01, remote locations, and per-location totals without disk reads.
fn stock_moved(before, after) {
  if before == nil or after == nil { return false }
  if not (ck(before.stockid) == ck(after.stockid)) or not (ck(before.loccode) == ck(after.loccode)) { return false }
  let was = whole_qty(before.quantity)
  let now = whole_qty(after.quantity)
  if was == nil or now == nil { return false }
  let id = canon(after.stockid)
  if id == nil { return true }
  if was == now { return true }
  let key = ck(id)
  let lk = ck(after.loccode)
  let by = now - was
  let ok = move_sum("locs", key, lk, by)
  if ok and lk == "01" { ok = move_sum("qoh01", key, nil, by) }
  if ok and has(REMOTE_LOCS, lk) { ok = move_sum("remote", key, nil, by) }
  if not ok { mark(id, TABLE_INPUTS["locstock"]) } else { mark(id, []) }
  return true
}

// touched(): ASQL CDC invalidation hook. Evaluates table writes and marks affected item keys dirty
fn touched(table, op, before, after, sh) {
  IN_TOUCHED = true
  let t = lower(table)
  if has(WHOLE_OF, t) { for n in WHOLE_OF[t] { if has(WHOLE, n) { del(WHOLE, n) } } }
  if t == "locstock" and stock_moved(before, after) {
    IN_TOUCHED = false
    let id = canon(after.stockid)
    if id == nil or whole_qty(before.quantity) == whole_qty(after.quantity) { return [] }
    return [id]
  }
  let r = touched_items(t, before, after)
  if type(r) == "list" {
    let names = TABLE_INPUTS[t]
    for id in r { mark(id, names == nil ? keys(INPUTS) : names) }
  } else {
    if has(EVERY_INPUTS, t) { for n in EVERY_INPUTS[t] { drop_input(n) } }
    if has(LEVELS_MOVE, t) { drop_input("wake") }
    FULL_EXPECTED = true
  }
  IN_TOUCHED = false
  return r
}

// Discovers which item SKU keys are affected by database insert/update/delete events
fn touched_items(t, before, after) {
  if has(LEVELS_MOVE, t) { return levels_unmoved(t, before, after) ? [] : {"shared": true} }
  if has(EVERY_ITEM, t) { return "all" }
  let rows_of = compact([before, after])
  let col = ITEM_COL[t]
  if col != nil {   // a per-item table: the item its row names (stock moves only for receipts, type 25)
    let ids = []
    for row in rows_of { if t != "stockmoves" or row["type"] == 25 { push(ids, canon(row[col])) } }
    return unique(compact(ids))
  }
  // Tables that name items through another: a brand's items and remote stock, a shipper's open order lines,
  // an order's or a return's lines
  let found = []
  for row in rows_of {
    match t {
      "manufacturer" => {
        if row["manufacturer_id"] != nil { push(found, ...read_raw("SELECT stockid AS k FROM product_to_manufacturer WHERE manufacturer_id = ?", row["manufacturer_id"])) }
        if row["name"] != nil { push(found, ...read_raw("SELECT DISTINCT stockid AS k FROM remotestock WHERE brand = ?", row["name"])) }
      }
      "shippers" => {
        if row["shipper_id"] != nil { push(found, ...read_raw("SELECT DISTINCT d.stkcode AS k FROM salesorderdetails d JOIN salesorders o ON o.orderno = d.orderno WHERE o.shipvia = ? AND d.completed = 0", row["shipper_id"])) }
      }
      "salesorders" => {
        if row["orderno"] != nil { push(found, ...read("SELECT DISTINCT stkcode AS k FROM salesorderdetails WHERE orderno = ?", row["orderno"])) }
      }
      "rgaorders" => {
        if row["orderno"] != nil { push(found, ...read("SELECT DISTINCT itemcode AS k FROM rgaorderdetails WHERE orderno = ?", row["orderno"])) }
      }
    }
  }
  return unique(compact(map(found, fn (l) { return canon(l.k) })))
}
