# sticker_item - the sticker feed's rows, one Thing per tire, kept current by the engine.
#
# The feed (../service.gr) built every item from the raw tables on each request: seconds of CPU a pull. Here the
# same code (../lib/feed.gr, which both import) runs once per item that a write reaches, and the finished row
# waits in memory: a pull reads rows that are already right. Nothing is cached or aged: a row is replaced the
# moment a table it was built from changes, by the same code and the same arithmetic.
#
#   mid      the manufacturer id (the feed's brand exclusions are by it)
#   vitem    the item number as the feed prints it (the sku exclusions are by it)
#   r_<L>    the item's finished JSON object for price level L, byte for byte what the feed sends
#
# Levels are the ones the feed's clients resolve to (shared()); a client on a level that is not here
# is answered the old way, by building.
#
# Which items a write reaches (touched()): a row of a per-item table names its item; an order names
# its lines' items; a brand its items, a shipper the open lines of its orders; a table every item
# is priced from (price levels, the remote warehouses) moves all of them; a client or a branch moves the set of levels.

import "../lib/feed.gr"

# The date moves an item only where a price or a special of its own starts or ends (wake_at, below), so the
# engine need not read every item again when the day turns.
let DAY_SAFE = true

let BIG_BATCH = 4000

# the tables every item reads whole are kept between refreshes (whole(), in lib/feed.gr) and dropped
# when one of them changes
KEEP_WHOLE = true
WHOLE = {}

let HAS_RGA_TYPE = pcall(read, "SELECT rga_type FROM rgaorders LIMIT 1").ok
fn has_rga_type() { return HAS_RGA_TYPE }

# The feed's code reads rows by position and its values as the wire carries them (text: a price "0.0000" is
# a string there, and what PHP does with a string is what that code keeps). read_raw() gives both.
fn rows(sql, params) {
  let rs = nil
  let n = params == nil ? 0 : len(params)
  if n == 0 { rs = read_raw(sql) }
  else if n == 1 { rs = read_raw(sql, params[0]) }
  else if n == 2 { rs = read_raw(sql, params[0], params[1]) }
  else if n == 3 { rs = read_raw(sql, params[0], params[1], params[2]) }
  else if n == 4 { rs = read_raw(sql, params[0], params[1], params[2], params[3]) }
  else if n == 5 { rs = read_raw(sql, params[0], params[1], params[2], params[3], params[4]) }
  else { rs = read_raw(sql, params[0], params[1], params[2], params[3], params[4], params[5]) }
  let out = []
  for r in rs { push(out, values(r)) }
  return out
}

fn first_row(sql, params) {
  let r = rows(sql, params)
  if len(r) == 0 { return nil }
  return r[0]
}

fn today() { return read_raw("SELECT CURDATE() AS d")[0].d }

# resolvePriceLevel(), for every client the feed has
fn client_levels() {
  let seen = {}
  let out = []
  for c in read("SELECT debtorno, branchcode FROM sticker_feed_exclusions") {
    let lv = resolve_price_level(c.debtorno, c.branchcode)
    if seen[lv] == nil {
      seen[lv] = true
      push(out, lv)
    }
  }
  if seen["W"] == nil { push(out, "W") }
  return sort(out)
}

# the stockids that may be Things: the feed's base query keeps those it wants
fn enroll() {
  let out = []
  for r in read("SELECT stockid FROM stockmaster WHERE categoryid = 'TIRE'") { push(out, r.stockid) }
  return out
}

fn shared() { return {"levels": client_levels()} }

# The next day, after today, that a price or a special of an item starts or has ended: the item is read again then
fn next_changes(ids, levels, d) {
  let at = {}
  let note = fn (id, day) {
    if day == nil or day <= d { return nil }
    let k = ck(id)
    if at[k] == nil or day < at[k] { at[k] = day }
    return nil
  }
  let lv = []
  for l in levels { push(lv, l) }
  if not (sort(lv) == sort(["W"])) { push(lv, "W") }
  for r in rows("SELECT stockid, startdate AS s, DATE_ADD(enddate, INTERVAL 1 DAY) AS e FROM prices WHERE typeabbrev IN (?) AND (startdate > ? OR (enddate >= ? AND enddate < '9999-01-01'))" + in_ids("stockid", ids), with_ids([lv, d, d], ids)) {
    note(r[0], r[1])
    note(r[0], r[2])
  }
  for r in rows("SELECT stockid, startdate AS s, DATE_ADD(enddate, INTERVAL 1 DAY) AS e FROM stockspecials WHERE (startdate > ? OR (enddate >= ? AND enddate < '9999-01-01'))" + in_ids("stockid", ids), with_ids([d, d], ids)) {
    note(r[0], r[1])
    note(r[0], r[2])
  }
  return at
}

# What each table gives each item is kept (input(), copied from the feed): a write marks, in the inputs read
# from its table, the items it reaches (touched(), below), and a refresh reads again only those - a stock
# change is three small reads, not fifteen. A pass over every item reads only what was marked or dropped.
INPUTS = {}
let INPUT_DAY = nil
# the inputs that are read with the date; a new day drops them
let DATED = ["base", "specials", "wake"]
# items touched() has marked since things() last read them; things() reads anything else it is asked about afresh
let MARKED = {}
# touched() answered "all" or that the levels moved: the full pass that follows is for what it marked
let FULL_EXPECTED = false
# a touched() that did not finish leaves this set: what it would have marked is not known
let IN_TOUCHED = false

fn drop_input(name) {
  if name == "pb_*" {
    for n in keys(INPUTS) { if starts_with(n, "pb_") { del(INPUTS, n) } }
  } else if has(INPUTS, name) { del(INPUTS, name) }
}

fn mark(id, names) {
  let k = ck(id)
  MARKED[k] = true
  for name in names {
    if name == "pb_*" {
      for n in keys(INPUTS) { if starts_with(n, "pb_") { INPUTS[n].dirty[k] = true } }
    } else if has(INPUTS, name) { INPUTS[name].dirty[k] = true }
  }
}

# The base query's rows for some items, each of its three tables read by the items' keys and put together here: the
# join itself, right after a write to prices, rebuilt what it keeps of that table (5 ms; a key read is a tenth of a ms).
# An item with two manufacturer rows is answered by the join, so which one it keeps stays the engine's choice.
fn base_rows(sql, ids, d) {
  let pm = {}
  for r in rows("select stockid, manufacturer_id from product_to_manufacturer where stockid IN (?)", [ids]) {
    let k = ck(r[0])
    if has(pm, k) { return first_by(rows(sql + " and stockmaster.stockid IN (?) and product_to_manufacturer.stockid IN (?) and prices.stockid IN (?) group by stockmaster.stockid", [d, d, ids, ids, ids]), 0) }
    pm[k] = r[1]
  }
  let pr = first_by(rows("select stockid, price from prices where typeabbrev = 'W' and price > 0 and startdate <= ? and enddate >= ? and stockid IN (?)", [d, d, ids]), 0)
  let out = {}
  for r in rows("select stockid, mfgpart, description, sort2, additionalfee from stockmaster where categoryid = 'TIRE' and discontinued = 0 and stockid IN (?)", [ids]) {
    let k = ck(r[0])
    if not has(pm, k) or not has(pr, k) or has(out, k) { continue }
    # ITEM_NUMBER, VENDOR_1, VENDOR_ITEM_NO, PRICE_LEVEL_6, ITEM_DESCR, SORT_2, FET_PRC_LVL_5
    out[k] = [r[0], pm[k], r[1], pr[k][1], r[2], r[3], r[4]]
  }
  return out
}

fn things(ks, sh) {
  let d = today()
  let levels = sh.levels
  let big = len(ks) > BIG_BATCH
  if IN_TOUCHED or (big and not FULL_EXPECTED) {
    # a pass nobody's write explained (the first, a REFRESH, a RESUME, a touched() that failed): all afresh
    INPUTS = {}
    WHOLE = {}
    IN_TOUCHED = false
  }
  FULL_EXPECTED = false
  if d != INPUT_DAY {
    for n in DATED { drop_input(n) }
    drop_input("pb_*")
    INPUT_DAY = d
  }
  if not big {
    # an item asked about that no write marked (it woke, or is new): read whole
    let all_names = keys(INPUTS)
    for k in ks { if not has(MARKED, ck(k)) { mark(k, all_names) } }
  }
  for k in ks { if has(MARKED, ck(k)) { del(MARKED, ck(k)) } }

  # (the list on each of the three tables: the engine reads each by it, instead of joining whole tables to the one)
  let sql = "select stockmaster.stockid as ITEM_NUMBER, manufacturer_id as VENDOR_1, mfgpart as VENDOR_ITEM_NO, price as PRICE_LEVEL_6, description as ITEM_DESCR, sort2 as SORT_2,additionalfee as FET_PRC_LVL_5 from stockmaster inner join product_to_manufacturer on stockmaster.stockid = product_to_manufacturer.stockid inner join prices on stockmaster.stockid = prices.stockid where stockmaster.categoryid = 'TIRE' and prices.typeabbrev = 'W' and prices.price > 0 and prices.startdate <= ? and prices.enddate >= ?  and discontinued = 0"
  let by_id = input("base", big ? nil : ks, fn (ids) {
    if ids == nil { return first_by(rows(sql + " group by stockmaster.stockid", [d, d]), 0) }
    return base_rows(sql, ids, d)
  })
  let base = []
  for k in ks {
    let b = by_id[ck(k)]
    if b != nil { push(base, b) }
  }
  let out = {}
  if len(base) == 0 { return out }
  let ids = nil
  if not big {
    ids = []
    for item in base { push(ids, item[0]) }
  }
  let items = build_items(base, levels, ids, d, nil, false)
  let wakes = input("wake", ids, fn (some) { return next_changes(some, levels, d) })
  let at = 0
  for rec in items {
    let id = base[at][0]
    let vals = {"mid": php_str(base[at][1]), "vitem": rec.vitem}
    if wakes[ck(id)] != nil { vals["wake_at"] = wakes[ck(id)] + " 00:00:00" }
    for level in levels {
      vals["r_" + level] = php_json({
        "Brand": rec.Brand, "item": rec.item, "qty": rec.qty, "vitem": rec.vitem, "Size": rec.Size,
        "desc": rec.desc, "FET": rec.FET, "BLANK0": "", "BLANK1": "", "BLANK2": "", "BLANK3": "", "BLANK4": "",
        "price": rec.prices[level]
      })
    }
    out[id] = vals
    at = at + 1
  }
  return out
}

# the Thing's own spelling of a stockid, as stockmaster keeps it: the tables are compared without case
# or trailing spaces, so a row may name an item by another spelling of it
let CANON = {}
fn canon(v) {
  if v == nil { return nil }
  let s = str(v)
  if has(CANON, s) { return CANON[s] }
  let r = read("SELECT stockid FROM stockmaster WHERE stockid = ?", s)
  let c = len(r) > 0 ? r[0].stockid : nil
  CANON[s] = c
  return c
}

# per-item tables: the column that names the item
let ITEM_COL = {
  "stockmaster": "stockid", "product_to_manufacturer": "stockid", "prices": "stockid", "locstock": "stockid",
  "stockmoves": "stockid", "purchdata": "stockid", "purchorderdetails": "itemcode", "remotestock": "stockid",
  "tireinfo": "stockid", "stockspecials": "stockid", "forcedcostoverride": "stockid",
  "salesorderdetails": "stkcode", "rgaorderdetails": "itemcode"
}

# what prices and remote stock are worked out from, for every item: a change here is a pass over all of them
let EVERY_ITEM = {"salestypes": true, "prodlineprice": true, "remoteapi": true, "remotemapping": true}
let LEVELS_MOVE = {"sticker_feed_exclusions": true, "custbranch": true, "debtorsmaster": true}
# the columns of each of those the price levels are worked out from (client_levels, resolve_price_level). An update
# that leaves them as they were moves no level: the service writes lastsent into sticker_feed_exclusions on every
# pull, and each one made the Thing work out every client's level again - under the lock every read waits on
let LEVEL_COLS = {"sticker_feed_exclusions": ["debtorno", "branchcode"], "custbranch": ["debtorno", "branchcode", "pricelevel"],
                  "debtorsmaster": ["debtorno", "salestype"]}

fn levels_unmoved(t, before, after) {
  if before == nil or after == nil { return false }   # a row added or removed may be a client, or a branch's level
  for c in LEVEL_COLS[t] {
    if str(before[c]) != str(after[c]) { return false }
  }
  return true
}

# the tables kept whole (whole(), in the feed) that each of these is read into
let WHOLE_OF = {"manufacturer": ["mfg"], "salestypes": ["salestypes"], "prodlineprice": ["plp"], "remoteapi": ["rapi"],
                "remotemapping": ["rapi"], "forcedcostoverride": ["forced"]}

# the inputs (see input()) each per-item table is read into
let TABLE_INPUTS = {
  "stockmaster": ["base", "sm"], "product_to_manufacturer": ["base"], "prices": ["base", "wake", "pb_*"],
  "locstock": ["qoh01", "remote", "locs"], "stockmoves": ["last25"], "purchdata": ["pd"],
  "purchorderdetails": ["lastpo"], "remotestock": ["remote", "rs"], "tireinfo": ["sizes"],
  "stockspecials": ["specials", "wake"], "forcedcostoverride": [], "salesorderdetails": ["so_open", "demand"],
  "rgaorderdetails": ["rga"], "salesorders": ["so_open", "demand"], "rgaorders": ["rga"], "shippers": ["demand"],
  "manufacturer": ["remote"]
}
# what every item reads from these is read again whole
let EVERY_INPUTS = {"remoteapi": ["remote", "rs"], "remotemapping": ["remote", "rs"]}

# A whole number, as a decimal, or nil: what the stock sums below can be moved by exactly. (quantity is a DOUBLE: SQL
# sums those in floating point, which is exact for whole numbers and only for them.)
fn whole_qty(v) {
  if v == nil { return nil }
  let d = num(v)
  if not (decimal(int(d)) == d) { return nil }
  return decimal(int(d))
}

# held[key] += by, where what is held for that item is current: false when it is not (never read, marked, or not a
# whole number), and the item's inputs are read again instead
fn move_sum(name, key, sub, by) {
  let st = INPUTS[name]
  if st == nil { return true }
  if has(st.dirty, key) { return true }
  if not (st.all or has(st.got, key)) { return true }
  let v = st.v
  if sub != nil {
    if v[key] == nil { return false }
    v = v[key]
    key = sub
  }
  let cur = whole_qty(v[key])
  if cur == nil { return false }
  v[key] = cur + by
  return true
}

let REMOTE_LOCS = {"03": true, "62": true, "64": true, "67": true}

# A stock quantity changed in place (the same item at the same location, whole numbers before and after): the three
# sums it is in (warehouse 01's, the remote locations', each location's) move by the change, with nothing read. True
# when that was all it took.
fn stock_moved(before, after) {
  if before == nil or after == nil { return false }
  if not (ck(before.stockid) == ck(after.stockid)) or not (ck(before.loccode) == ck(after.loccode)) { return false }
  let was = whole_qty(before.quantity)
  let now = whole_qty(after.quantity)
  if was == nil or now == nil { return false }
  let id = canon(after.stockid)
  if id == nil { return true }
  if was == now { return true }
  let key = ck(id)
  let lk = ck(after.loccode)
  let by = now - was
  let ok = move_sum("locs", key, lk, by)
  if ok and lk == "01" { ok = move_sum("qoh01", key, nil, by) }
  if ok and has(REMOTE_LOCS, lk) { ok = move_sum("remote", key, nil, by) }
  if not ok { mark(id, TABLE_INPUTS["locstock"]) } else { mark(id, []) }
  return true
}

fn touched(table, op, before, after, sh) {
  IN_TOUCHED = true
  let t = lower(table)
  if has(WHOLE_OF, t) { for n in WHOLE_OF[t] { if has(WHOLE, n) { del(WHOLE, n) } } }
  if t == "locstock" and stock_moved(before, after) {
    IN_TOUCHED = false
    let id = canon(after.stockid)
    if id == nil or whole_qty(before.quantity) == whole_qty(after.quantity) { return [] }
    return [id]
  }
  let r = touched_items(t, before, after)
  if type(r) == "list" {
    let names = TABLE_INPUTS[t]
    for id in r { mark(id, names == nil ? keys(INPUTS) : names) }
  } else {
    if has(EVERY_INPUTS, t) { for n in EVERY_INPUTS[t] { drop_input(n) } }
    if has(LEVELS_MOVE, t) { drop_input("wake") }
    FULL_EXPECTED = true
  }
  IN_TOUCHED = false
  return r
}

fn touched_items(t, before, after) {
  if has(LEVELS_MOVE, t) {
    if levels_unmoved(t, before, after) { return [] }
    return {"shared": true}
  }
  if has(EVERY_ITEM, t) { return "all" }
  let col = ITEM_COL[t]
  let out = []
  let seen = {}
  if col != nil {
    for row in [before, after] {
      if row == nil { continue }
      # only the newest type-25 move's price is read from stockmoves
      if t == "stockmoves" and row["type"] != 25 { continue }
      let c = canon(row[col])
      if c != nil and seen[c] == nil {
        seen[c] = true
        push(out, c)
      }
    }
    return out
  }
  # a brand moves its own items, and the remote stock that names it; a shipper, the open lines of its orders
  if t == "manufacturer" or t == "shippers" {
    for row in [before, after] {
      if row == nil { continue }
      let found = []
      if t == "manufacturer" {
        if row["manufacturer_id"] != nil { found = read_raw("SELECT stockid AS k FROM product_to_manufacturer WHERE manufacturer_id = ?", row["manufacturer_id"]) }
        if row["name"] != nil { for r in read_raw("SELECT DISTINCT stockid AS k FROM remotestock WHERE brand = ?", row["name"]) { push(found, r) } }
      } else if row["shipper_id"] != nil {
        found = read_raw("SELECT DISTINCT d.stkcode AS k FROM salesorderdetails d JOIN salesorders o ON o.orderno = d.orderno WHERE o.shipvia = ? AND d.completed = 0", row["shipper_id"])
      }
      for l in found {
        let c = canon(l.k)
        if c != nil and seen[c] == nil {
          seen[c] = true
          push(out, c)
        }
      }
    }
    return out
  }
  # an order's lines name the items it moves (its location, its shipper, whether it is a quote)
  let lines = nil
  for row in [before, after] {
    if row == nil { continue }
    let ono = row["orderno"]
    if ono == nil { continue }
    if t == "salesorders" { lines = read("SELECT DISTINCT stkcode AS k FROM salesorderdetails WHERE orderno = ?", ono) }
    else if t == "rgaorders" { lines = read("SELECT DISTINCT itemcode AS k FROM rgaorderdetails WHERE orderno = ?", ono) }
    if lines != nil {
      for l in lines {
        let c = canon(l.k)
        if c != nil and seen[c] == nil {
          seen[c] = true
          push(out, c)
        }
      }
    }
  }
  return out
}
