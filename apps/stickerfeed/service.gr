// StickerFeed vendor API, read straight from ASQL.
//
// The v8 ERP's sticker feed (catalog/controller/apir/tools/stickerfeedapi.php feed(), with
// system/library/stickerfeed/feedbuilder.php building the items) ported to grain. Every read goes to
// ASQL, which the binlog keeps current with the live MariaDB, so there is no cache and nothing to
// refresh: each request reads the rows as they are now. The answer is the PHP's own, field for field,
// including PHP 7.4's arithmetic and its quirks (see the notes at getItemCost and getNextCost).
//
//   POST /feed          Authorization: Bearer <token>, body {} or {"brands": ["NAME", ...]}
//                       -> {"items": [...]}, exactly what feed() answers
//   POST /getstock      Authorization: Bearer <token>, body {"sku": "VITEM"}, {"skus": ["VITEM", ...]} or the
//                       "lines" placeorder takes ([{"sku": ..., "brand": ..., "qty": ...}])
//                       -> {"items": [...], "not_found": [{"sku": ...}, ...]}: the same rows as /feed, for
//                       those items; 404 not_found when none of them is in the feed
//   POST /getbrands     Authorization: Bearer <token>, no body -> {"brands": ["NAME", ...]}, the brands the
//                       client is not excluded from, exactly what getbrands() answers
//   GET  /              the ops view
//
// What it does not do: getItemCost() in PHP also writes stockmaster.actualcost from inside the feed.
// ASQL takes no writes and a read path should not make them, so that write is left out.
//
// Speed: a feed for given brands or items reads every table for those items only. The whole catalog is built in
// slices on every core, each slice on a connection of its own, while the remote stock is read beside them
// and added in at the end; the answer is the same bytes as a build in one piece.
//
// The connection log and lastsent are written where PHP writes them, the ERP's MariaDB, on a
// connection of their own (STICKERFEED_WRITE_*); the rate limit reads that log, as PHP does.
//
// Configuration (environment):
//   ASQL_HOST (127.0.0.1)  ASQL_PORT (3307)  ASQL_USER (root)  ASQL_PASSWORD or ASQL_PASSWORD_FILE  ASQL_DB (versioneight)
//   STICKERFEED_WRITE_HOST  _PORT (3306)  _USER  _PASSWORD or _PASSWORD_FILE  _DB (ASQL_DB)
//   STICKERFEED_KEY_FILE (/var/www/keyfile.txt) or STICKERFEED_ENCRYPTION_KEY: the key the tokens are sealed with

fn env(name, fallback) {
  let v = getenv(name)
  if v == nil or v == "" { return fallback }
  return v
}

fn secret(name) {
  let v = getenv(name)
  if v != nil and v != "" { return v }
  let f = getenv(name + "_FILE")
  // trim, not php_trim: this runs while the settings are read, before lib/feed.gr (which has php_trim) is imported
  if f != nil and f != "" { return trim(read_file(f)) }
  return ""
}

// ---- PHP 7.4, as the feed's arithmetic and tests use it --------------------------------------
// Numbers are grain decimals, exact. PHP does this arithmetic in doubles and number_format() rounds
// through 15 significant digits, which gives the same digits as exact decimals for every value a price,
// cost or quantity takes.









// $v != '' on PHP 7.4: null, false, "", 0 and 0.0 equal ''
fn loose_empty_string(v) {
  if v == nil or v == false or v == "" { return true }
  let t = type(v)
  if t == "int" or t == "real" { return v == 0 }
  return false
}



// ---- connections ------------------------------------------------------------------------------

let ASQL = {
  "host": env("ASQL_HOST", "127.0.0.1"), "port": int(env("ASQL_PORT", "3307")),
  "user": env("ASQL_USER", "root"), "password": secret("ASQL_PASSWORD"), "db": env("ASQL_DB", "versioneight")
}
let WRITE = {
  "host": env("STICKERFEED_WRITE_HOST", ""), "port": int(env("STICKERFEED_WRITE_PORT", "3306")),
  "user": env("STICKERFEED_WRITE_USER", ""), "password": secret("STICKERFEED_WRITE_PASSWORD"),
  "db": env("STICKERFEED_WRITE_DB", ASQL.db)
}
let conns = {}

fn conn(which) {
  let c = conns[which]
  if c != nil { return c }
  let cfg = which == "read" ? ASQL : WRITE
  if cfg.host == "" { error("STICKERFEED_WRITE_HOST is not set: the connection log and lastsent have nowhere to go") }
  let r = db_connect(cfg.host, cfg.port, cfg.user, cfg.password, cfg.db)
  if not r.ok { error("cannot connect to " + which + " database " + cfg.host + ":" + str(cfg.port) + ": " + r.error) }
  conns[which] = r
  return r
}

// One statement, its ? filled from params. A read whose connection broke is tried once more on a new
// one; a write is not, since it may have been applied.
fn run(which, sql, params, opts) {
  let r = pcall(db_query, conn(which), sql, params, opts)
  if not r.ok {
    conns[which] = nil
    if which != "read" { error(r.error) }
    r = pcall(db_query, conn(which), sql, params, opts)
    if not r.ok {
      conns[which] = nil
      error(r.error)
    }
  }
  if not r.value.ok { error(r.value.error + " :: " + sql) }
  return r.value
}

// rows only: the feed reads a quarter of a million of them, and records would double that
let ROWS = {"records": false}
fn rows(sql, params) { return run("read", sql, params, ROWS).rows }

fn first_row(sql, params) {
  let r = rows(sql, params)
  if len(r) == 0 { return nil }
  return r[0]
}

import "lib/feed.gr"

// whether rgaorders has rga_type (asked once)
let RGA_TYPE = nil
fn has_rga_type() {
  if RGA_TYPE == nil { RGA_TYPE = len(rows("SHOW COLUMNS FROM rgaorders LIKE 'rga_type'", nil)) > 0 }
  return RGA_TYPE
}

// ---- feedbuilder.php ----------------------------------------------------------------------------

fn today() { return date_format(now(), "%F", "local") }




// The whole build for a set of items: what feedbuilder.php's build() reads one item at a time, read
// once per table. brands: nil or the manufacturer ids to keep; only: nil or the stockids to build.
// For some items every table is read for those items only; for the catalog, whole.
fn build(brands, levels, only, post) {
  let d = today()
  // the catalog will most likely be built in slices: the remote stock, which no slice can read for its items
  // alone, is read meanwhile
  let remote_task = nil
  if only == nil and brands == nil {
    close_conns()
    remote_task = spawn(fn () { return remote_stock(nil) })
  }
  // " AND col IN (?)" and its parameter, when the build is for some items
  let o = fn (col) { return only == nil ? "" : " AND " + col + " IN (?)" }
  let op = fn (params) {
    if only != nil { push(params, only) }
    return params
  }

  let base_params = [d, d]
  let brandopt = ""
  if brands != nil {
    brandopt = " and product_to_manufacturer.manufacturer_id in (?) "
    push(base_params, brands)
  }
  let base = rows("select stockmaster.stockid as ITEM_NUMBER, manufacturer_id as VENDOR_1, mfgpart as VENDOR_ITEM_NO, price as PRICE_LEVEL_6, description as ITEM_DESCR, sort2 as SORT_2,additionalfee as FET_PRC_LVL_5 from stockmaster inner join product_to_manufacturer on stockmaster.stockid = product_to_manufacturer.stockid inner join prices on stockmaster.stockid = prices.stockid where stockmaster.categoryid = 'TIRE' and prices.typeabbrev = 'W' and prices.price > 0 and prices.startdate <= ? and prices.enddate >= ?  and discontinued = 0 " + brandopt + o("stockmaster.stockid") + " group by stockmaster.stockid", op(base_params))
  if len(base) == 0 {
    if remote_task != nil { await(remote_task) }
    return []
  }

  // A feed for some brands reads every other table for those items only, as one for given items does,
  // and not the catalog's: the same rows for these items, a fraction of what is read.
  if only == nil and brands != nil and len(base) <= 20000 {
    only = []
    for item in base { push(only, item[0]) }
  }

  if only == nil and remote_task != nil and len(base) >= PARALLEL_FROM { return build_parallel(base, levels, d, remote_task, post) }
  let items = build_items(base, levels, only, d, remote_task == nil ? nil : await(remote_task), false)
  return post == nil ? items : post(items)
}

// The catalog is built in slices on every core, each a build for some items (above) that opens a
// connection of its own, and the slices go back together in the order the base query gave.
let PARALLEL_FROM = 4000
let SLICES = 8

// A slice is built without the remote stock, which arrives from its own read while the slices run: its items
// carry the stock before it as `qty` and their key as `_k`, and the last step below adds the remote stock in.
fn build_slice(slice, levels, d, post) {
  let ids = []
  for item in slice { push(ids, item[0]) }
  let items = build_items(slice, levels, ids, d, {}, true)
  return post == nil ? items : post(items)
}

// a connection cannot be copied to a worker, so the open ones go; the next read opens another
fn close_conns() {
  for k in keys(conns) {
    pcall(db_close, conns[k])
    conns[k] = nil
  }
}

fn build_parallel(base, levels, d, remote_task, post) {
  close_conns()
  let per = int((len(base) + SLICES - 1) / SLICES)
  let slices = []
  let at = 0
  while at < len(base) {
    push(slices, slice(base, at, min(at + per, len(base))))
    at = at + per
  }
  let r = pcall(parallel_map, slices, fn (sl) { return build_slice(sl, levels, d, post) })
  let remote_all = await(remote_task)
  if not r.ok {
    let items = build_items(base, levels, nil, d, remote_all, false)
    return post == nil ? items : post(items)
  }
  let out = []
  for part in r.value { for x in part { push(out, x) } }
  // $avail = QTY_ON_HAND - getOnSalesOrder() + remote, and a stock of 5 to 8 is told as 9
  for it in out {
    let avail = it.qty
    let rem = remote_all[it._k]
    if rem != nil { avail = avail + rem }
    if avail >= 5 and avail <= 8 { avail = decimal(9) }
    it["qty"] = nf(avail, 0)
    del(it, "_k")
  }
  return out
}







// in_array($v, $list) over one list many times: its strings, and the numbers among them, read once
fn php_in_set(list) {
  let strs = {}
  let nums = []
  for x in list {
    let b = php_str(x)
    strs[b] = true
    let bn = numeric_str(b)
    if bn != nil { push(nums, bn) }
  }
  return {"strs": strs, "nums": nums}
}

fn php_in_set_has(set, v) {
  let a = php_str(v)
  if set.strs[a] != nil { return true }
  if len(set.nums) == 0 { return false }
  let an = numeric_str(a)
  if an == nil { return false }
  for bn in set.nums { if an == bn { return true } }
  return false
}

// filterForVendor(): drop the client's brands and items, keep the price of its level
fn filter_for_vendor(items, excluded_brands, excluded_skus, level) {
  let brands = php_in_set(excluded_brands)
  let skus = php_in_set(excluded_skus)
  let out = []
  for item in items {
    if php_in_set_has(brands, item.manufacturer_id) { continue }
    if php_in_set_has(skus, item.vitem) { continue }
    let price = item.prices[level]
    if price == nil {
      for k in keys(item.prices) {
        price = item.prices[k]
        break
      }
    }
    let rec = {
      "Brand": item.Brand, "item": item.item, "qty": item.qty, "vitem": item.vitem, "Size": item.Size,
      "desc": item.desc, "FET": item.FET, "BLANK0": "", "BLANK1": "", "BLANK2": "", "BLANK3": "", "BLANK4": "",
      "price": price
    }
    if item._k != nil { rec["_k"] = item._k }
    push(out, rec)
  }
  return out
}


// ---- credentials.php and the controller's checks ----------------------------------------------

let enc_key = nil

// StickerFeedEncryption::key(): sha256 of the key file's text, else of STICKERFEED_ENCRYPTION_KEY
fn sealing_key() {
  if enc_key != nil { return enc_key }
  let raw = ""
  let f = env("STICKERFEED_KEY_FILE", "/var/www/keyfile.txt")
  if file_exists(f) {
    let r = pcall(read_file, f)
    if r.ok { raw = php_trim(r.value) }
  }
  if raw == "" { raw = env("STICKERFEED_ENCRYPTION_KEY", "") }
  if raw == "" { error("Missing sticker feed encryption key (set /var/www/keyfile.txt or STICKERFEED_ENCRYPTION_KEY)") }
  enc_key = hex_decode(sha256(raw))
  return enc_key
}

// StickerFeedEncryption::decrypt(): 'enc:' + base64(iv | AES-256-CBC ciphertext); anything else as it is
fn unseal(v) {
  if v == nil or not starts_with(v, "enc:") { return v }
  let p = pcall(base64_decode, slice(v, 4))
  if not p.ok or len(p.value) < 17 { return nil }
  return aes_cbc_decrypt(sealing_key(), slice(p.value, 0, 16), slice(p.value, 16))
}

// StickerFeedCredentials::validateBearer(): the API vendor whose token this is, unless it has expired
fn validate_bearer(token) {
  if not php_truthy(token) { return nil }
  let r = run("read", "SELECT * FROM sticker_feed_exclusions WHERE connection_type = 'api' AND access_token_enc IS NOT NULL AND access_token_enc != ''", nil, nil)
  let now_s = date_format(now(), "%F %T", "local")
  for v in r.records {
    let stored = unseal(v.access_token_enc)
    if not php_truthy(stored) or not hash_equals(stored, token) { continue }
    if v.auth_type == "oauth2_client_credentials" {
      if not php_truthy(v.token_expires_at) or v.token_expires_at < now_s { return nil }
    }
    return v
  }
  return nil
}

// The connection log's table. On a replica (chi) it must be a table the master never writes, or the
// replica's own rows collide with the master's and stop replication.
let COMPUTE_ON = env("STICKERFEED_COMPUTE_ON", "")
let LOG_TABLE = env("STICKERFEED_LOG_TABLE", "sticker_feed_connection_log")
// Successful calls are not logged (a load or a busy client writes a row per call: 58,000 in a day on chi); failed
// ones are, and they are what the rate limit counts. STICKERFEED_LOG_SUCCESS=1 logs every call, as the PHP did.
let LOG_SUCCESS = env("STICKERFEED_LOG_SUCCESS", "0") == "1"

fn log_event(vendor_id, action, result, status, detail) {
  if result == "success" and not LOG_SUCCESS { return nil }
  run("write", "INSERT INTO " + LOG_TABLE + " (vendor_id, action, result, http_status, error_detail, actor_userid, created_at) VALUES (?, ?, ?, ?, ?, NULL, NOW())",
      [num_int(vendor_id), action, result, status, detail == nil ? nil : slice(php_str(detail), 0, 2000)], nil)
}

// checkRateLimit(): PHP counts the log's rows for this action, and it logs a successful feed as "send",
// so only failed calls count against a vendor - kept as it is.
fn rate_limited(action, vendor_id, limit, window) {
  let r = run("write", "SELECT COUNT(*) as count FROM " + LOG_TABLE + " WHERE vendor_id = ? AND action = ? AND created_at >= FROM_UNIXTIME(?)",
              [php_str(vendor_id), action, int(now()) - window], ROWS)
  return num_int(r.rows[0][0]) >= limit
}

// Every JSON answer is written as PHP's json_encode() writes it (php_json, lib/feed.gr), so the bytes are the PHP's
fn reply(status, body) { return {"status": status, "content_type": "application/json; charset=utf-8", "body": php_json(body)} }

// getBearerTokenAndValidate($function): {client} or {fail: the response PHP set}
fn authenticate(req, function) {
  let h = req.headers.authorization
  let m = regex_match("^Bearer\\s+(.+)$", php_trim(h == nil ? "" : h), "i")
  let token = m == nil ? nil : php_trim(m.groups[0])
  if not php_truthy(token) {
    return {"fail": reply(401, {"error": "invalid_request", "error_description": "Missing Authorization: Bearer header"})}
  }
  let client = validate_bearer(token)
  if client == nil {
    log_event(0, "getBearerTokenAndValidate", "fail", 401, "Invalid or expired token")
    return {"fail": reply(401, {"error": "invalid_token", "error_description": "Invalid or expired token"})}
  }
  let id = num_int(client.id)
  if not php_truthy(client.debtorno) {
    log_event(id, "getBearerTokenAndValidate", "fail", 403, "No debtor assigned to client")
    return {"fail": reply(403, {"error": "invalid_request", "error_description": "No debtor assigned to client"})}
  }
  let access = first_row("select sticker_feed_endpoints.function from sticker_feed_access join sticker_feed_endpoints on sticker_feed_access.function_id = sticker_feed_endpoints.function_id where sticker_feed_access.id = ? and sticker_feed_endpoints.function = ?", [str(id), function])
  if access == nil or not php_truthy(access[0]) {
    log_event(id, "getBearerTokenAndValidate", "fail", 403, "Client access to " + function + " denied")
    return {"fail": reply(403, {"error": "invalid_request", "error_description": "Endpoint not accessable"})}
  }
  return {"client": client}
}

// ---- the endpoints ----------------------------------------------------------------------------
// Each request runs in a worker VM of its own (the pane's "workers"), so a full feed does not hold up a
// stock check. A worker's changes to globals stay in the worker: what happened is in the connection
// log, which the ops view reads.

fn client_exclusions(client_id) {
  let brands = []
  for r in rows("select mfg_id from sticker_feed_brands where id = ?", [client_id]) { push(brands, r[0]) }
  let skus = []
  for r in rows("select stockid from sticker_feed_skus where id = ?", [client_id]) { push(skus, r[0]) }
  return {"brands": brands, "skus": skus}
}

// json_decode(php://input, true), with is_array(): nil when the body is not a JSON object or list
fn body_json(req) {
  let r = pcall(json_parse, req.body == nil ? "" : req.body)
  if not r.ok { return nil }
  let t = type(r.value)
  if t != "map" and t != "list" { return nil }
  return r.value
}

// The sticker_item Thing (things/sticker_item.gr) holds each item's finished row for each price level, kept
// current by the engine as the tables change: a pull reads rows that are already right. {body, count}, the
// feed's whole answer, or nil where there is no Thing, or none for this level, to be built the long way.
// `mid` is the manufacturer id as php_str() prints an integer, so "in the list" (PHP's loose compare: "07" is 7)
// is a lookup in the list's own spellings plus its whole numbers as integers prints them
fn int_set(list) {
  let m = {}
  for e in list {
    let t = php_str(e)
    m[t] = true
    let n = numeric_str(t)
    if n != nil and n == int(n) { m[str(int(n))] = true }
  }
  return m
}

// The held rows of some items only (SHOW THING .. KEYS, one lookup per item, not the whole feed read and
// thrown away), filtered for the client as the feed is: their items, or nil when the Thing cannot be read.
fn held_items(level, skus, ex) {
  let r = pcall(run, "read", "SHOW THING sticker_item KEYS (?)", [skus], ROWS)
  if not r.ok { return nil }
  let mi = -1
  let vi = -1
  let ci = -1
  let at = 0
  for c in r.value.columns {
    if c == "mid" { mi = at }
    else if c == "vitem" { vi = at }
    else if c == "r_" + level { ci = at }
    at = at + 1
  }
  if mi < 0 or vi < 0 or ci < 0 { return nil }
  let by_brand = len(ex.brands) > 0 ? int_set(ex.brands) : nil
  let by_sku = len(ex.skus) > 0 ? php_in_set(ex.skus) : nil
  let out = []
  for row in r.value.rows {
    if by_brand != nil and by_brand[row[mi]] != nil { continue }
    if by_sku != nil and php_in_set_has(by_sku, row[vi]) { continue }
    push(out, json_parse(row[ci]))   // the feed's own row: parsed and written again by php_json, the same bytes
  }
  return out
}

fn held_feed(level, limited, ex) {
  let r = pcall(run, "read", "SHOW THING sticker_item", nil, ROWS)
  if not r.ok { return nil }
  let mi = -1
  let vi = -1
  let ci = -1
  let at = 0
  for c in r.value.columns {
    if c == "mid" { mi = at }
    else if c == "vitem" { vi = at }
    else if c == "r_" + level { ci = at }
    at = at + 1
  }
  if mi < 0 or vi < 0 or ci < 0 or len(r.value.rows) == 0 { return nil }
  let by_brand = len(ex.brands) > 0 ? int_set(ex.brands) : nil
  let by_sku = len(ex.skus) > 0 ? php_in_set(ex.skus) : nil
  let only = limited == nil ? nil : int_set(limited)
  let parts = []
  for row in r.value.rows {
    if only != nil and only[row[mi]] == nil { continue }
    if by_brand != nil and by_brand[row[mi]] != nil { continue }
    if by_sku != nil and php_in_set_has(by_sku, row[vi]) { continue }
    push(parts, row[ci])
  }
  return {"body": "{\"items\":[" + join(parts, ",") + "]}", "count": len(parts)}
}

// feed(), in PHP's order: authenticate, rate limit, payload, brands, build, filter, log
fn feed(req) {
  let auth = authenticate(req, "feed")
  if auth.client == nil { return auth.fail }
  let client = auth.client
  let vid = php_str(client.id)
  if rate_limited("feed", vid, 10, 120) {
    log_event(vid, "feed", "fail", 400, "")
    return reply(400, {"error": "invalid_request", "error_description": "Rate limit exceeded. Please try again later."})
  }

  let client_id = num_int(client.id)
  let ex = client_exclusions(client_id)

  let body = body_json(req)
  if body == nil {
    log_event(client_id, "feed", "fail", 404, "Invalid payload JSON")
    return reply(404, {"error": "JSON FORMAT", "error_description": "Invalid JSON in payload"})
  }

  // brand names -> manufacturer ids, less the client's excluded brands
  let has_brands = type(body) == "map" and has(body, "brands")
  let limited = nil
  let b = has_brands ? body.brands : nil
  if b != nil and not loose_empty_string(b) {
    let names = type(b) == "list" ? b : (type(b) == "map" ? values(b) : [b])
    if len(names) > 0 {
      let given = []
      for n in names { push(given, php_str(n)) }
      let ids = []
      for r in rows("select manufacturer_id from manufacturer where name in (?)", [given]) {
        if not php_in(r[0], ex.brands) { push(ids, r[0]) }
      }
      if len(ids) > 0 { limited = ids }
    }
  }
  if has_brands and limited == nil {
    log_event(client_id, "feed", "fail", 404, "No items found for supplied brands")
    return reply(404, {"error": "not_found", "error_description": "No items found for supplied brands"})
  }

  let level = resolve_price_level(client.debtorno, client.branchcode)
  let held = held_feed(level, limited, ex)
  let out = nil
  if held == nil { out = build(limited, [level], nil, fn (its) { return filter_for_vendor(its, ex.brands, ex.skus, level) }) }

  // date('Y-m-d G:i:s'): the hour without a leading zero
  let t = now()
  let lastsent = date_format(t, "%Y-%m-%d ", "local") + str(int(date_format(t, "%H", "local"))) + date_format(t, ":%M:%S", "local")
  let sent_count = held == nil ? len(out) : held.count
  run("write", "update sticker_feed_exclusions set lastsent = ?, lastfile = ? where id = ?", [lastsent, str(sent_count) + " items", client_id], nil)
  log_event(client_id, "send", "success", 200, "feed pulled")
  // already text: the worker hands back one string, not the forty thousand records to be copied out and written again
  return {"status": 200, "content_type": "application/json; charset=utf-8", "body": held == nil ? php_json({"items": out}) : held.body}
}

// getstock: the feed's own rows for the items asked about, read now - the check a vendor makes before it
// places an order. Same token, same access to "feed", same exclusions and price level. It speaks the
// stickerfeedapi's shapes: a line is placeorder's {sku, brand, qty}, a line that fails is echoed back as
// one (like cannot_fulfill's errors), and nothing found is a 404 not_found, as getorder answers.
let GETSTOCK_MAX = 500

fn getstock(req) {
  let auth = authenticate(req, "feed")
  if auth.client == nil { return auth.fail }
  let client = auth.client
  let client_id = num_int(client.id)
  let body = body_json(req)
  let asked = []
  if body != nil and type(body) == "map" {
    if type(body.skus) == "list" {
      for s in body.skus { push(asked, {"sku": s}) }
    } else if type(body.lines) == "list" {
      for l in body.lines { if type(l) == "map" and l.sku != nil { push(asked, l) } }
    } else if body.sku != nil {
      push(asked, {"sku": body.sku})
    }
  }
  // placeorder reads a sku as trim(strtoupper()); the first line for a sku is the one checked
  let lines = []
  let seen = {}
  for l in asked {
    let k = php_trim(upper(php_str(l.sku)))
    if k != "" and seen[k] == nil {
      seen[k] = true
      let line = {"sku": k}
      if l.brand != nil { line.brand = php_str(l.brand) }
      if l.qty != nil { line.qty = l.qty }
      push(lines, line)
    }
  }
  if len(lines) == 0 {
    log_event(client_id, "getstock", "fail", 400, "No skus in payload")
    return reply(400, {"error": "invalid_request", "error_description": "sku, skus or lines is required"})
  }
  if len(lines) > GETSTOCK_MAX {
    log_event(client_id, "getstock", "fail", 400, "Too many skus")
    return reply(400, {"error": "invalid_request", "error_description": "At most " + str(GETSTOCK_MAX) + " skus per request"})
  }
  let skus = []
  for l in lines { push(skus, l.sku) }
  let ex = client_exclusions(client_id)
  let level = resolve_price_level(client.debtorno, client.branchcode)
  let out = held_items(level, skus, ex)
  if out == nil { out = filter_for_vendor(build(nil, [level], skus, nil), ex.brands, ex.skus, level) }
  let by_sku = {}
  for it in out { by_sku[ck(it.vitem)] = it }
  // a line that names a brand must match the item's brand, as placeorder requires
  let items = []
  let missing = []
  for l in lines {
    let it = by_sku[ck(l.sku)]
    if it != nil and (l.brand == nil or php_trim(upper(l.brand)) == php_trim(upper(php_str(it.Brand)))) {
      push(items, it)
    } else {
      push(missing, l)
    }
  }
  if len(items) == 0 {
    log_event(client_id, "getstock", "fail", 404, "0 of " + str(len(lines)) + " found")
    return reply(404, {"error": "not_found", "error_description": "No items found for supplied skus"})
  }
  log_event(client_id, "getstock", "success", 200, str(len(items)) + " of " + str(len(lines)) + " found")
  return reply(200, {"items": items, "not_found": missing})
}

// getbrands(), in PHP's order: authenticate, rate limit, the brands the client is not excluded from. An
// empty list is a 404 with the same body, and the log says so in its result, as PHP logs it. PHP has no
// ORDER BY: MariaDB answers through the manufacturer.name index, so the list comes back in name order,
// and the order by name below keeps that order on ASQL, which has no such index.
fn getbrands(req) {
  let auth = authenticate(req, "getbrands")
  if auth.client == nil { return auth.fail }
  let client = auth.client
  let vid = php_str(client.id)
  if rate_limited("getbrands", vid, 10, 60) {
    log_event(vid, "getbrands", "fail", 400, "")
    return reply(400, {"error": "invalid_request", "error_description": "Rate limit exceeded. Please try again later."})
  }

  let client_id = num_int(client.id)
  let brands = []
  for r in rows("select upper(name) as `brand` from manufacturer where not manufacturer_id in (select mfg_id from sticker_feed_brands where id = ?) and name <> '' order by name", [str(client_id)]) {
    push(brands, r[0])
  }
  if len(brands) > 0 {
    log_event(client_id, "getbrands", "success", 200, nil)
    return reply(200, {"brands": brands})
  }
  log_event(client_id, "getbrands", "empty brand list returned", 404, nil)
  return reply(404, {"brands": brands})
}

// One request; anything unexpected is answered as PHP's catch answers it, and the cause goes to the
// server's log. Like the PHP, the method is not checked: a GET has no JSON body and is told so.
fn guarded(endpoint, handler) {
  return fn (req) {
    let r = pcall(handler, req)
    if not r.ok {
      print("stickerfeed: " + date_format(now(), "%F %T", "local") + " " + endpoint + ": " + r.error)
      return reply(500, {"error": "server_error", "error_description": "Unexpected error"})
    }
    return r.value
  }
}

// ---- the ops view ---------------------------------------------------------------------------
// The view runs in the program's own VM. It opens a connection for each look and closes it, so the
// program holds none: the workers copy the globals the routes name, and a connection cannot be copied.

fn look(cfg, sql) {
  let c = db_connect(cfg.host, cfg.port, cfg.user, cfg.password, cfg.db)
  if not c.ok { error("cannot connect to " + cfg.host + ":" + str(cfg.port) + ": " + c.error) }
  let r = pcall(db_query, c, sql)
  db_close(c)
  if not r.ok { error(r.error) }
  if not r.value.ok { error(r.value.error) }
  return r.value
}

fn mirror_state() {
  let r = pcall(look, ASQL, "SHOW SLAVE STATUS")
  if not r.ok { return "ASQL unreachable: " + r.error }
  if len(r.value.records) == 0 { return "ASQL is not replicating" }
  let s = r.value.records[0]
  return "replicating: io " + php_str(s.Slave_IO_Running) + ", sql " + php_str(s.Slave_SQL_Running) + ", " + php_str(s.Seconds_Behind_Master) + " s behind"
}

// today's calls and the latest ones, from the connection log the endpoints write
fn log_state() {
  if WRITE.host == "" { return {"error": "STICKERFEED_WRITE_HOST is not set: there is no log to read", "today": [], "recent": []} }
  let today_r = pcall(look, WRITE, "SELECT action, result, COUNT(*) AS n FROM " + LOG_TABLE + " WHERE created_at >= CURDATE() GROUP BY action, result ORDER BY action, result")
  let recent_r = pcall(look, WRITE, "SELECT l.created_at, l.vendor_id, l.action, l.result, l.http_status, l.error_detail FROM " + LOG_TABLE + " l ORDER BY l.id DESC LIMIT 12")
  if not today_r.ok or not recent_r.ok { return {"error": "cannot read the log: " + (today_r.ok ? recent_r.error : today_r.error), "today": [], "recent": []} }
  return {"error": "", "today": today_r.value.records, "recent": recent_r.value.records}
}

let mirror = mirror_state()
let calls = log_state()
every(10, fn () {
  mirror = mirror_state()
  calls = log_state()
})

fn view() {
  return ui.column({"gap": 14, "pad": 12}, [
    ui.heading("StickerFeed vendor API", {"size": 24}),
    ui.text("Reads ASQL at " + ASQL.host + ":" + str(ASQL.port) + " (" + mirror + "). Writes the log to " + (WRITE.host == "" ? "nowhere: STICKERFEED_WRITE_HOST is not set" : WRITE.host + ":" + str(WRITE.port)) + ".", {"dim": true}),
    calls.error == "" ? ui.text("Calls today, from " + LOG_TABLE + ":", {"bold": true}) : ui.text(calls.error, {"color": "bad"}),
    ui.table(calls.today, {"columns": "action:Action, result:Result:badge, n:Calls:right", "empty": "No calls today.", "badges": {"success": "ok", "fail": "warn"}}),
    ui.table(calls.recent, {"columns": "created_at:When, vendor_id:Vendor:right, action:Action, result:Result:badge, http_status:Status:right, error_detail:Detail", "empty": "No calls yet.", "badges": {"success": "ok", "fail": "warn"}})
  ])
}

ui.pane({
  "title": "StickerFeed",
  "width": 900,
  "height": 600,
  "shared": true,
  "workers": true,
  "refresh": 10,
  // STICKERFEED_COMPUTE_ON: the fleet member (its id, or a prefix) whose copy of this app answers the API - the request
  // is carried there through aios (an app.route operation on its device) and its answer given back here as it came.
  // Unset, or that member being this machine, the routes answer here.
  "routes": {
    "/feed": on_machine(COMPUTE_ON, guarded("/feed", feed)),
    "/getstock": on_machine(COMPUTE_ON, guarded("/getstock", getstock)),
    "/getbrands": on_machine(COMPUTE_ON, guarded("/getbrands", getbrands))
  },
  "view": view
})
