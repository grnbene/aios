# The vendor sticker feed: /feed, /getstock, /getbrands for API clients, its ops page at /.
# Reads the ERP through ASQL (and its sticker_item Thing); writes the connection log to MariaDB.
let app = {
  "name": "stickerfeed",
  "description": "vendor sticker feed: /feed, /getstock, /getbrands",
  "main": "service.gr",
  "kind": "web",
  "port": 8571,
  "listen": "local",
  # what each machine sets (`grain app set` / `app set`): the ASQL to read, the MariaDB to log to
  "settings": {"ASQL_HOST": "127.0.0.1", "ASQL_PORT": "3307", "ASQL_DB": "versioneight"},
  # set per machine, never packaged; each may instead be a <NAME>_FILE setting naming a file
  "secrets": ["ASQL_PASSWORD", "STICKERFEED_WRITE_PASSWORD", "STICKERFEED_ENCRYPTION_KEY"],
  "requires": ["db"],
  "health": {"path": "/", "ok": [200]},
  "check": "checks.gr",
  "deployed": "deployed.gr",
  "max_steps": 0
}
