// Stickerfeed application manifest.
// Provides /feed, /getstock, and /getbrands endpoints for vendor ERP systems, plus an ops dashboard at /.
// Reads catalog and inventory from ASQL; writes audit connection logs to MariaDB.
let app = {
  "name": "stickerfeed",
  "description": "vendor sticker feed: /feed, /getstock, /getbrands",
  "main": "service.gr",
  "kind": "web",
  "port": 8571,
  "listen": "local",
  // Host configuration overrides (configured via `grain app set` / `app set`)
  "settings": {"ASQL_HOST": "127.0.0.1", "ASQL_PORT": "3307", "ASQL_DB": "versioneight"},
  // Node-specific secrets; can also be provided via <NAME>_FILE pointing to a secret file
  "secrets": ["ASQL_PASSWORD", "STICKERFEED_WRITE_PASSWORD", "STICKERFEED_ENCRYPTION_KEY"],
  "requires": ["db"],
  "health": {"path": "/", "ok": [200]},
  "check": "checks.gr",
  "deployed": "deployed.gr",
  "max_steps": 0
}
