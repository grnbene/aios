// Bin capacity web service.
//
//   GET  /                      the page: the board of bins by fill, measuring a bin with the phone, where a size fits
//   GET  /health                200 when ASQL answers
//   GET  /marker.png            the marker to print (MARKER_MM across at 300 dpi)
//   GET  /api/board             every measured bin: size, units, items, fill (1.0 = full), unplaced units
//   GET  /api/bin?bin=B         what is in bin B: each item, how many of it the bin holds alone, its share
//   GET  /api/room?size=S       where tires of size S still fit, most room first
//   POST /api/photo?bin=B       body: a photo of B's front with the marker on it -> {photo_id, marker, w, h}
//   POST /api/measure           {photo_id, opening: [[x y] x4 clockwise from top left, photo px], back: [x y] (the
//                               floor's back corner; else depth_mm is used), focal (the lens in px from the photo's
//                               EXIF, or nil), empty (true: the bin is empty now, keep this photo to check against)}
//                               -> the bin's size, saved; then its fill
//   POST /api/frame?bin=B&focal=F  body: a small frame of the live camera -> {ready, advice, quality, marker,
//                               opening}: whether to take the photo now, and what to tell the person if not
//   POST /api/scene?focal=F        body: any photo -> {photo_id, w, h, focal, focal_from, lines}: its camera from its
//                               own straight lines (no marker needed), for measuring things in it
//   POST /api/scene/measure        {photo_id, reference: {a, b, mm}, lengths: [{name, a, b}], heights: [{name, base,
//                               top}], boxes: [{name, fl, fr, br, top}], surface: {length, depth} (names of two
//                               lengths)} -> each in mm, each box's volume, and how many of each box fit the surface
//   GET  /api/scene/model.glb?photo_id=P&box=N, /api/scene/model.png?...  a measured box as a 3D model / its preview
//   POST /api/check?bin=B&focal=F  body: a photo of B's front: what is in it against its empty photo, and the ERP's
//                               fill -> {changed, compared, erp_fill, verdict}
//   POST /api/dims              {bin, width_mm, depth_mm, height_mm}: a size entered by hand
//
// Sizes and photos are kept in ASQL (bin_dims, bin_photos); fill is the bin_fill Thing's (lib/bins.gr).

import { q, bin_cfg, setting } from "lib/db.gr"
import { measure_camera, measure_scale, measure_length, measure_height, measure_box, box_model, glb_preview, on_surface, project_pt, up_of } from "lib/measure.gr"
import { bins_install, bins_save, bins_board, bins_contents, bins_room, bins_marker_png, bins_geometry, bins_occupancy, bins_verdict, bins_frame } from "lib/bins.gr"

let PAGE = app_program("page.html")

// the tables and the Thing, when the app is run without a deploy (app run)
let started = pcall(fn () {
  let have = false
  for r in q("SHOW THINGS", []) { if get(r, "thing", "") == "bin_fill" { have = true } }
  if not have { bins_install(q, bin_cfg()) }
})
if not started.ok { print("bin_capacity: not installed yet - " + str(started.error)) }

fn api(f) {
  return fn (req) {
    let r = pcall(f, req)
    if r.ok { return r.value }
    return res_error(422, str(r.error))
  }
}

fn bin_name(v) {
  let b = trim(str(v == nil ? "" : v))
  if b == "" or len(b) > 40 { error("a bin is named by its code (1 to 40 characters)") }
  return b
}

fn photo_id() { return time_ms() * 1000 + rand(0, 999) }

// ---- measuring a scene -----------------------------------------------------------------------------------------

let scenes = {}   // photo_id -> the last measuring's boxes (their models made on asking)

fn scene_load(photo_id) {
  let rows = q("SELECT image, marker FROM bin_photos WHERE photo_id = ? AND bin = '(scene)'", [photo_id])
  if len(rows) == 0 { error("no scene photo " + str(photo_id) + ": upload it first") }
  let cam = json_parse(rows[0].marker)
  return {"photo": bytes(rows[0].image), "cam": cam}
}

fn inches(mm) { return round(mm / 25.4e0 * 10.0e0) / 10.0e0 }
// a point or a length from the request as binary floating point (JSON's 255.6 reads as an exact decimal, which the
// geometry's long products would overflow)
fn fp(p) { return [p[0] * 1.0e0, p[1] * 1.0e0] }

// a tape measure along a measured line: where each inch falls in the photo (perspective and all), from A toward B
// (3D points in the camera's frame, `len_mm` apart)
fn tape(cam, A, B, len_mm) {
  let ticks = []
  let n = floor(len_mm / 25.4e0)
  for k in 0..(n + 1) {
    let f = k * 25.4e0 / len_mm
    push(ticks, project_pt(cam, [A[0] + (B[0] - A[0]) * f, A[1] + (B[1] - A[1]) * f, A[2] + (B[2] - A[2]) * f]))
  }
  return ticks
}

fn scene_measure(j) {
  let sc = scene_load(j.photo_id)
  let cam = sc.cam
  let ref = j.reference
  if ref == nil or ref.mm == nil or to_number(ref.mm, 0) <= 0 { error("a reference is needed: two points a known distance apart on the same surface, and that distance") }
  let s = measure_scale(cam, fp(ref.a), fp(ref.b), to_number(ref.mm) * 1.0e0)
  let lengths = []
  let by_name = {}
  for l in get(j, "lengths", []) {
    let mm = measure_length(cam, s, fp(l.a), fp(l.b))
    by_name[l.name] = mm
    push(lengths, {"name": l.name, "mm": mm, "in": inches(mm), "tape": tape(cam, on_surface(cam, fp(l.a)), on_surface(cam, fp(l.b)), mm)})
  }
  let heights = []
  for h in get(j, "heights", []) {
    let mm = measure_height(cam, s, fp(h.base), fp(h.top))
    let X = on_surface(cam, fp(h.base))
    let T = [X[0] + up_of(cam)[0] * mm / s, X[1] + up_of(cam)[1] * mm / s, X[2] + up_of(cam)[2] * mm / s]
    push(heights, {"name": h.name, "mm": mm, "in": inches(mm), "tape": tape(cam, X, T, mm)})
  }
  let boxes = []
  let models = {}
  for b in get(j, "boxes", []) {
    let m = measure_box(cam, s, fp(b.fl), fp(b.fr), fp(b.br), fp(b.top))
    models[b.name] = m
    let rec = {"name": b.name, "width_mm": m.width_mm, "depth_mm": m.depth_mm, "height_mm": m.height_mm, "volume_l": m.volume_l,
               "inches": [inches(m.width_mm), inches(m.depth_mm), inches(m.height_mm)],
               "model": format("/api/scene/model.glb?photo_id={}&box={}", j.photo_id, url_encode(b.name)),
               "preview": format("/api/scene/model.png?photo_id={}&box={}", j.photo_id, url_encode(b.name))}
    // how many of it stand on the surface, side by side (either way round)
    let sf = get(j, "surface", nil)
    if sf != nil and get(by_name, sf.length, nil) != nil and get(by_name, sf.depth, nil) != nil {
      let L = by_name[sf.length]
      let D = by_name[sf.depth]
      rec.fit = max(floor(L / m.width_mm) * floor(D / m.depth_mm), floor(L / m.depth_mm) * floor(D / m.width_mm))
      rec.surface_area_m2 = L * D / 1000000.0e0
    }
    push(boxes, rec)
  }
  scenes[str(j.photo_id)] = {"boxes": models, "cam": cam}
  return {"json": {"scale_mm_per_unit": s, "focal": cam.focal, "focal_from": cam.focal_from, "lengths": lengths, "heights": heights, "boxes": boxes}}
}

fn scene_model(qp) {
  let sc = get(scenes, str(get(qp, "photo_id", "")), nil)
  if sc == nil { error("measure the scene first") }
  let name = get(qp, "box", "")
  let b = get(sc.boxes, name, nil)
  if b == nil { error("no box named " + name) }
  let photo = scene_load(to_number(qp.photo_id))
  let m = box_model(image_decode(photo.photo), sc.cam, b)
  return {"glb": m.glb, "name": name}
}

serve_routes({
  "GET /": fn (req) { return res_html(PAGE) },
  "GET /health": fn (req) {
    let r = pcall(q, "SELECT 1 AS ok", [])
    return r.ok ? res_json({"ok": true}) : res_error(503, str(r.error))
  },
  "GET /marker.png": fn (req) {
    return {"status": 200, "content_type": "image/png", "body": bins_marker_png(round(bin_cfg().marker_mm))}
  },
  "GET /api/board": api(fn (req) { return res_json({"loccode": bin_cfg().loccode, "bins": bins_board(q)}) }),
  "GET /api/bin": api(fn (req) {
    let b = bin_name(get(req.query_params, "bin", ""))
    let dims = q("SELECT width_mm, depth_mm, height_mm, source, measured_at FROM bin_dims WHERE loccode = ? AND bin = ?", [bin_cfg().loccode, b])
    return res_json({"bin": b, "dims": len(dims) > 0 ? dims[0] : nil, "items": bins_contents(q, bin_cfg(), b)})
  }),
  "GET /api/room": api(fn (req) {
    let size = trim(get(req.query_params, "size", ""))
    return res_json({"size": size, "tire": tire_size(size), "bins": bins_room(q, bin_cfg(), size)})
  }),
  "POST /api/photo": api(fn (req) {
    let b = bin_name(get(req.query_params, "bin", ""))
    let photo = bytes(req.body)
    let cv = image_decode(photo)
    let m = image_find_marker(cv)
    if m == nil { error("no marker found: print /marker.png, tape it flat on the bin's front, and get all of it in the photo") }
    let id = photo_id()
    q("INSERT INTO bin_photos (photo_id, loccode, bin, taken_at, image, marker) VALUES (?, ?, ?, NOW(), ?, ?)",
      [id, bin_cfg().loccode, b, photo, json_stringify(m)])
    return res_json({"photo_id": id, "bin": b, "marker": m, "w": canvas_width(cv), "h": canvas_height(cv),
                     "mm_per_px": bin_cfg().marker_mm / m.side_px})
  }),
  "POST /api/measure": api(fn (req) {
    let j = req.json
    let rows = q("SELECT bin, image FROM bin_photos WHERE photo_id = ?", [j.photo_id])
    if len(rows) == 0 { error("no photo " + str(j.photo_id)) }
    let b = rows[0].bin
    let photo = bytes(rows[0].image)
    let focal = get(j, "focal", nil)
    let g = bins_geometry(photo, j.opening, get(j, "back", nil), bin_cfg(), focal)
    let depth = g.depth_mm
    let depth_source = "photo"
    if depth == nil {
      depth = to_number(get(j, "depth_mm", bin_cfg().depth_mm), bin_cfg().depth_mm) * 1.0
      depth_source = "typed"
    }
    if depth <= 0 { error("the depth is a number of millimetres") }
    let rec = {"loccode": bin_cfg().loccode, "bin": b, "width_mm": g.width_mm, "depth_mm": depth, "height_mm": g.height_mm,
               "source": "photo", "photo_id": j.photo_id, "rect": g.rect, "depth_source": depth_source, "focal_px": g.camera.focal,
               "photo_w": canvas_width(image_decode(photo))}
    // the empty photo: this one when it is said to be empty, else the one kept before
    let kept = q("SELECT empty_photo_id, empty_camera FROM bin_dims WHERE loccode = ? AND bin = ?", [bin_cfg().loccode, b])
    if get(j, "empty", false) {
      rec.empty_photo_id = j.photo_id
      rec.empty_camera = g.camera
    } else if len(kept) > 0 and kept[0].empty_photo_id != nil {
      rec.empty_photo_id = kept[0].empty_photo_id
      rec.empty_camera = json_parse(kept[0].empty_camera)
    }
    bins_save(q, rec)
    q("UPDATE bin_photos SET opening = ? WHERE photo_id = ?", [json_stringify(j.opening), j.photo_id])
    let fill = nil
    for r in bins_board(q) { if r.bin == b { fill = r } }
    return res_json({"bin": b, "width_mm": g.width_mm, "height_mm": g.height_mm, "depth_mm": depth, "depth_source": depth_source,
                     "focal_from": g.focal_from, "rms_px": g.rms_px, "empty_kept": get(rec, "empty_photo_id", nil) != nil,
                     "warning": g.rms_px > 3.0 ? "the corners do not fit one rectangle on the marker's plane well: is the marker flat on the bin's front, and each corner on the opening's?" : nil,
                     "board": fill})
  }),
  "POST /api/frame": api(fn (req) {
    let b = trim(get(req.query_params, "bin", ""))
    let dims = nil
    if b != "" {
      let d = q("SELECT rect, focal_px, photo_w FROM bin_dims WHERE loccode = ? AND bin = ?", [bin_cfg().loccode, b])
      if len(d) > 0 and d[0].rect != nil {
        dims = {"rect": json_parse(d[0].rect), "focal_px": to_number(d[0].focal_px) * 1.0, "photo_w": to_number(d[0].photo_w) * 1.0}
      }
    }
    let f = get(req.query_params, "focal", "")
    return res_json(bins_frame(bytes(req.body), dims, bin_cfg(), f == "" ? nil : to_number(f) * 1.0))
  }),
  "POST /api/scene": api(fn (req) {
    let photo = bytes(req.body)
    let cv = image_decode(photo)
    let f = get(req.query_params, "focal", "")
    let lines = image_lines(cv)
    let v = vanishing_points(lines, canvas_width(cv), canvas_height(cv), f == "" ? {} : {"focal": to_number(f) * 1.0})
    if v.rot == nil { error("this photo shows too few straight upright and level lines to tell how the phone was held: take it with a wall corner, a counter or shelf edge, or a door frame in view") }
    let id = photo_id()
    let cam = {"focal": v.focal, "focal_from": v.focal_from, "rot": v.rot, "cx": canvas_width(cv) / 2.0, "cy": canvas_height(cv) / 2.0}
    q("INSERT INTO bin_photos (photo_id, loccode, bin, taken_at, image, marker) VALUES (?, ?, ?, NOW(), ?, ?)",
      [id, bin_cfg().loccode, "(scene)", photo, json_stringify(cam)])
    // each line with the direction it runs (0 the strongest level one, 1 the other level, 2 upright, -1 none)
    let group = {}
    for k in 0..len(v.points) {
      let g = k == v.vertical ? 2 : (k == v.horizontal ? 0 : 1)
      for i in v.points[k].lines { group[str(i)] = g }
    }
    let out = []
    for i in 0..len(lines) { let l = lines[i] push(out, [l[0], l[1], l[2], l[3], get(group, str(i), -1)]) }
    return res_json({"photo_id": id, "w": canvas_width(cv), "h": canvas_height(cv), "focal": v.focal, "focal_from": v.focal_from, "lines": out})
  }),
  "POST /api/scene/measure": api(fn (req) {
    let j = req.json
    let r = scene_measure(j)
    return res_json(r.json)
  }),
  "GET /api/scene/model.glb": api(fn (req) {
    let m = scene_model(req.query_params)
    return {"status": 200, "content_type": "model/gltf-binary", "headers": {"Content-Disposition": "attachment; filename=\"" + m.name + ".glb\""}, "body": m.glb}
  }),
  "GET /api/scene/model.png": api(fn (req) {
    let m = scene_model(req.query_params)
    return {"status": 200, "content_type": "image/png", "body": canvas_to_png(glb_preview(m.glb, 220))}
  }),
  "POST /api/check": api(fn (req) {
    let b = bin_name(get(req.query_params, "bin", ""))
    let d = q("SELECT width_mm, height_mm, depth_mm, rect, focal_px, photo_w, empty_photo_id, empty_camera FROM bin_dims WHERE loccode = ? AND bin = ?",
              [bin_cfg().loccode, b])
    if len(d) == 0 or d[0].rect == nil { error("measure " + b + " from a photo first") }
    if d[0].empty_photo_id == nil { error("no photo of " + b + " empty yet: measure it once when it is empty, ticking that it is") }
    let photo = bytes(req.body)
    let cv = image_decode(photo)
    let f = get(req.query_params, "focal", "")
    // the lens: this photo's EXIF, else the one the bin was measured with (the same phone), to this photo's width
    let focal = f != "" ? to_number(f) * 1.0 : to_number(d[0].focal_px) * canvas_width(cv) / to_number(d[0].photo_w)
    let empty = q("SELECT image FROM bin_photos WHERE photo_id = ?", [d[0].empty_photo_id])
    let dims = {"width_mm": to_number(d[0].width_mm) * 1.0, "height_mm": to_number(d[0].height_mm) * 1.0, "depth_mm": to_number(d[0].depth_mm) * 1.0,
                "rect": json_parse(d[0].rect)}
    let o = bins_occupancy(photo, focal, bytes(empty[0].image), json_parse(d[0].empty_camera), dims, bin_cfg())
    let erp = 0.0
    for r in bins_board(q) { if r.bin == b { erp = r.fill } }
    let verdict = bins_verdict(o.changed, o.compared, erp)
    let id = photo_id()
    q("INSERT INTO bin_photos (photo_id, loccode, bin, taken_at, image) VALUES (?, ?, ?, NOW(), ?)", [id, bin_cfg().loccode, b, photo])
    q("INSERT INTO bin_checks (check_id, loccode, bin, taken_at, photo_id, changed, compared, erp_fill, verdict) VALUES (?, ?, ?, NOW(), ?, ?, ?, ?, ?)",
      [id, bin_cfg().loccode, b, id, o.changed, o.compared, erp, verdict])
    return res_json({"bin": b, "changed": o.changed, "compared": o.compared, "erp_fill": erp, "verdict": verdict})
  }),
  "POST /api/dims": api(fn (req) {
    let j = req.json
    let b = bin_name(get(j, "bin", ""))
    let w = to_number(get(j, "width_mm", 0), 0) * 1.0
    let d = to_number(get(j, "depth_mm", 0), 0) * 1.0
    let h = to_number(get(j, "height_mm", 0), 0) * 1.0
    if w <= 0 or d <= 0 or h <= 0 { error("width, depth and height are millimetres, each more than 0") }
    bins_save(q, {"loccode": bin_cfg().loccode, "bin": b, "width_mm": w, "depth_mm": d, "height_mm": h, "source": "entered"})
    return res_json({"bin": b, "width_mm": w, "depth_mm": d, "height_mm": h})
  })
}, {"workers": false})
