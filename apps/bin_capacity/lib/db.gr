// The app's one ASQL connection (the wire, as the other warehouse apps reach it), opened on first use and again
// after it drops; q(sql, params) -> rows, or an error naming what failed.
fn secret(name) {
  let v = getenv(name)
  if v != nil and v != "" { return v }
  let f = getenv(name + "_FILE")
  if f != nil and f != "" { return trim(read_file(f)) }
  return ""
}
fn setting(name, fallback) {
  let v = getenv(name)
  return v == nil or v == "" ? fallback : v
}

let DB_CFG = {"host": setting("DB_HOST", "127.0.0.1"), "port": int(setting("DB_PORT", "3307")), "user": setting("DB_USER", "root"),
              "password": secret("DB_PASSWORD"), "db": setting("DB_NAME", "versioneight")}
let conn = {"c": nil}

fn q(sql, params) {
  for attempt in 0..2 {
    if conn.c == nil {
      let c = db_connect(DB_CFG)
      if not c.ok { error("cannot reach ASQL at " + DB_CFG.host + ":" + str(DB_CFG.port) + ": " + c.error) }
      conn.c = c
    }
    let r = db_query(conn.c, sql, params)
    if r.ok { return r.records == nil ? [] : r.records }
    // a dropped connection is made again once; anything else is the statement's own error
    if attempt == 0 and (index_of(lower(r.error), "connection") >= 0 or index_of(lower(r.error), "closed") >= 0) {
      pcall(db_close, conn.c)
      conn.c = nil
      continue
    }
    error(r.error)
  }
}

fn bin_cfg() {
  return {"loccode": setting("BIN_LOCCODE", "01"), "marker_mm": to_number(setting("MARKER_MM", "150")) * 1.0,
          "depth_mm": to_number(setting("BIN_DEPTH_MM", "1000")) * 1.0}
}
