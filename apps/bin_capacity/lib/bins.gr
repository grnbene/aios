// Bin capacity: how big each bin is (measured from a photo with a printed marker in it, or entered), what is in it
// (the ERP's locstock and tireinfo), and how full that makes it - kept live by ASQL as a Thing.
//
// Everything here takes `q`, a function (sql, params) -> list of row maps, so the same code runs over the MySQL wire
// (db_query, in the app) and in-process (sql(), in the checks).
//
//   bins_install(q, cfg)               the tables and the bin_fill Thing (made again when it is there)
//   bins_measure(photo, opening, cfg)  -> {width_mm, height_mm, marker, ...}: a bin's opening measured on a photo
//   bins_save(q, rec)                  a bin's size (and the photo it came from) written
//   bins_board(q)                      -> every measured bin with its fill, fullest first
//   bins_contents(q, cfg, bin)         -> what is in a bin: each item's quantity, how many of it the bin holds, its share
//   bins_room(q, cfg, size)            -> where `size` tires still fit: each bin with room for at least one, most first
//   bins_geometry(photo, opening, back, cfg, focal) -> width, height and depth from one photo and a tap
//   bins_occupancy(photo, focal, empty_photo, empty_cam, dims, cfg) -> how much of the opening differs from it empty
//   bins_verdict(changed, compared, erp_fill) -> "agrees" | "erp_has_more" | "photo_has_more" | "unsure"
//
// cfg: {loccode (the location whose bins these are; "01"), marker_mm (the printed marker's black square, measured
// with a ruler after printing; 150), depth_mm (a bin's depth when only its front was photographed; 1000)}
//
// How full a bin is: each item's quantity over how many of that item alone the bin would hold (TIRE_FIT: lying in
// stacks or standing, whichever holds more), summed - so 1.0 is full whatever the mix. Mixing sizes in one bin packs
// a little worse than this says; a bin at 0.9 of mixed sizes may already be full.

let BIN_TABLES = [
  "CREATE TABLE IF NOT EXISTS bin_checks (check_id BIGINT NOT NULL PRIMARY KEY, loccode VARCHAR(10) NOT NULL, bin VARCHAR(40) NOT NULL, " +
    "taken_at DATETIME NOT NULL, photo_id BIGINT NULL, changed DOUBLE NOT NULL, compared DOUBLE NOT NULL, erp_fill DOUBLE NULL, verdict VARCHAR(24) NOT NULL)",
  "CREATE TABLE IF NOT EXISTS bin_dims (loccode VARCHAR(10) NOT NULL, bin VARCHAR(40) NOT NULL, width_mm DOUBLE NOT NULL, " +
    "depth_mm DOUBLE NOT NULL, height_mm DOUBLE NOT NULL, source VARCHAR(16) NOT NULL, photo_id BIGINT NULL, " +
    "measured_by VARCHAR(64) NULL, measured_at DATETIME NOT NULL, PRIMARY KEY (loccode, bin))",
  "CREATE TABLE IF NOT EXISTS bin_photos (photo_id BIGINT NOT NULL PRIMARY KEY, loccode VARCHAR(10) NOT NULL, bin VARCHAR(40) NOT NULL, " +
    "taken_at DATETIME NOT NULL, image LONGBLOB NOT NULL, marker TEXT NULL, opening TEXT NULL)",
  // measured from a photo: the opening on the front (marker mm), where the depth came from, the lens, and the bin's
  // photo and camera when it was empty (what later photos are checked against)
  "ALTER TABLE bin_dims ADD COLUMN IF NOT EXISTS rect TEXT NULL",
  "ALTER TABLE bin_dims ADD COLUMN IF NOT EXISTS depth_source VARCHAR(16) NULL",
  "ALTER TABLE bin_dims ADD COLUMN IF NOT EXISTS focal_px DOUBLE NULL",
  "ALTER TABLE bin_dims ADD COLUMN IF NOT EXISTS photo_w INT NULL",
  "ALTER TABLE bin_dims ADD COLUMN IF NOT EXISTS empty_photo_id BIGINT NULL",
  "ALTER TABLE bin_dims ADD COLUMN IF NOT EXISTS empty_camera TEXT NULL"
]

fn fill_query(cfg) {
  return "SELECT l.bin AS bin, MAX(b.width_mm) AS width_mm, MAX(b.depth_mm) AS depth_mm, MAX(b.height_mm) AS height_mm, " +
         "SUM(l.quantity) AS units, COUNT(*) AS items, " +
         "SUM(l.quantity / TIRE_FIT(b.width_mm, b.depth_mm, b.height_mm, t.size)) AS fill, " +
         "SUM(CASE WHEN TIRE_FIT(b.width_mm, b.depth_mm, b.height_mm, t.size) IS NULL OR TIRE_FIT(b.width_mm, b.depth_mm, b.height_mm, t.size) = 0 " +
         "THEN l.quantity ELSE 0 END) AS unplaced " +
         "FROM locstock l JOIN bin_dims b ON b.loccode = l.loccode AND b.bin = l.bin " +
         "LEFT JOIN tireinfo t ON t.stockid = l.stockid " +
         "WHERE l.loccode = '" + replace(cfg.loccode, "'", "''") + "' AND l.quantity > 0 GROUP BY l.bin"
}

fn bins_install(q, cfg) {
  for t in BIN_TABLES { q(t, []) }
  let have = {}
  for r in q("SHOW THINGS", []) { have[get(r, "thing", "")] = true }
  // (CREATE OR REPLACE is for Things built by a program; a query's is dropped and made again - one pass over the bins)
  if has(have, "bin_fill") { q("DROP THING bin_fill", []) }
  q("CREATE THING bin_fill KEY l.bin PARTITION BY l.bin READS locstock, bin_dims, tireinfo AS " + fill_query(cfg), [])
  return has(have, "bin_fill") ? "replaced" : "created"
}

fn dist(a, b) { return sqrt((a[0] - b[0]) * (a[0] - b[0]) + (a[1] - b[1]) * (a[1] - b[1])) }

// A bin's opening measured on a photo: the marker found, the four corners of the opening (in the photo's pixels,
// clockwise from the top left) taken to millimetres on the marker's plane, each size the mean of its two edges.
// The marker must be flat on the bin's front, in the plane of the opening.
fn bins_measure(photo, opening, cfg) {
  let cv = image_decode(photo)
  let m = image_find_marker(cv)
  if m == nil { error("no marker in the photo: print it (GET /marker.png), tape it flat on the bin's front and photograph both") }
  let s = cfg.marker_mm * 1.0
  let to_mm = homography(m.corners, [[0, 0], [s, 0], [s, s], [0, s]])
  let mm = homography_apply(to_mm, opening)
  let top = dist(mm[0], mm[1])
  let bottom = dist(mm[3], mm[2])
  let left = dist(mm[0], mm[3])
  let right = dist(mm[1], mm[2])
  // the edges' disagreement: a large one means the corners or the marker are not in one plane
  let skew = max(abs(top - bottom) / max(top, bottom), abs(left - right) / max(left, right))
  return {"width_mm": (top + bottom) / 2.0, "height_mm": (left + right) / 2.0, "skew": skew, "marker": m,
          "marker_px": m.side_px, "mm_per_px": s / m.side_px, "w": canvas_width(cv), "h": canvas_height(cv)}
}

fn bins_save(q, rec) {
  q("REPLACE INTO bin_dims (loccode, bin, width_mm, depth_mm, height_mm, source, photo_id, measured_by, measured_at, rect, depth_source, " +
    "focal_px, photo_w, empty_photo_id, empty_camera) VALUES (?, ?, ?, ?, ?, ?, ?, ?, NOW(), ?, ?, ?, ?, ?, ?)",
    [rec.loccode, rec.bin, rec.width_mm * 1.0, rec.depth_mm * 1.0, rec.height_mm * 1.0, rec.source, get(rec, "photo_id", nil), get(rec, "by", nil),
     get(rec, "rect", nil) == nil ? nil : json_stringify(rec.rect), get(rec, "depth_source", nil), get(rec, "focal_px", nil),
     get(rec, "photo_w", nil), get(rec, "empty_photo_id", nil), get(rec, "empty_camera", nil) == nil ? nil : json_stringify(rec.empty_camera)])
}

// What a check of a bin says, from what the photo shows (changed: the share of the opening that differs from the
// empty bin) and what the ERP says (fill): "agrees", "erp_has_more" (the ERP has stock in it, the photo an empty
// bin), "photo_has_more" (the photo shows stock the ERP does not have there), "unsure" (too little of the opening
// could be compared). The photo sees the front, the ERP counts the volume, so only a clear contradiction is flagged.
fn bins_verdict(changed, compared, erp_fill) {
  if compared < 0.5 { return "unsure" }
  if erp_fill >= 0.25 and changed < 0.05 { return "erp_has_more" }
  if erp_fill <= 0.0 and changed > 0.15 { return "photo_has_more" }
  return "agrees"
}

fn num(v) { return v == nil ? 0.0 : to_number(v, 0) * 1.0 }

fn bins_board(q) {
  let out = []
  for r in q("SHOW THING bin_fill", []) {
    push(out, {"bin": r.bin, "width_mm": num(r.width_mm), "depth_mm": num(r.depth_mm), "height_mm": num(r.height_mm),
               "units": num(r.units), "items": int(num(r.items)), "fill": num(r.fill), "unplaced": num(r.unplaced)})
  }
  // measured bins with nothing in them are on the board too, empty
  let seen = {}
  for b in out { seen[b.bin] = true }
  for r in q("SELECT bin, width_mm, depth_mm, height_mm FROM bin_dims", []) {
    if not has(seen, r.bin) {
      push(out, {"bin": r.bin, "width_mm": num(r.width_mm), "depth_mm": num(r.depth_mm), "height_mm": num(r.height_mm),
                 "units": 0.0, "items": 0, "fill": 0.0, "unplaced": 0.0})
    }
  }
  return sort_by(out, fn (b) { return -b.fill })
}

fn bins_contents(q, cfg, bin) {
  return q("SELECT l.stockid AS stockid, t.size AS size, l.quantity AS quantity, " +
           "TIRE_FIT(b.width_mm, b.depth_mm, b.height_mm, t.size) AS holds, TIRE_FIT_MODE(b.width_mm, b.depth_mm, b.height_mm, t.size) AS mode, " +
           "l.quantity / TIRE_FIT(b.width_mm, b.depth_mm, b.height_mm, t.size) AS share " +
           "FROM locstock l JOIN bin_dims b ON b.loccode = l.loccode AND b.bin = l.bin LEFT JOIN tireinfo t ON t.stockid = l.stockid " +
           "WHERE l.loccode = ? AND l.bin = ? AND l.quantity > 0 ORDER BY share DESC", [cfg.loccode, bin])
}

// Where tires of `size` still fit: each measured bin's free share times how many of that size it holds alone.
fn bins_room(q, cfg, size) {
  if tire_size(size) == nil { error(format("\"{}\" is not a tire size", size)) }
  let fill = {}
  for b in bins_board(q) { fill[b.bin] = b.fill }
  let out = []
  for r in q("SELECT bin, width_mm, depth_mm, height_mm FROM bin_dims WHERE loccode = ?", [cfg.loccode]) {
    let f = tire_fit(num(r.width_mm), num(r.depth_mm), num(r.height_mm), size)
    let free = max(0.0, 1.0 - get(fill, r.bin, 0.0))
    let room = floor(f.count * free + 1e-9)
    if room >= 1 { push(out, {"bin": r.bin, "room": int(room), "holds": f.count, "mode": f.mode, "fill": get(fill, r.bin, 0.0)}) }
  }
  return sort_by(out, fn (b) { return -b.room })
}

// The marker to print: a black square with a white square half its side in the middle, on white, at 300 dots an
// inch so it prints `mm` millimetres across at 100% (measure it after printing and set MARKER_MM to what it is).
fn bins_marker_png(mm) {
  let dots = round(mm / 25.4 * 300)
  let margin = idiv(dots, 4)
  let cv = canvas_create(dots + 2 * margin, dots + 2 * margin + 120)
  canvas_set_fill_color(cv, "#ffffff")
  canvas_fill_rect(cv, 0, 0, dots + 2 * margin, dots + 2 * margin + 120)
  canvas_set_fill_color(cv, "#000000")
  canvas_fill_rect(cv, margin, margin, dots, dots)
  canvas_set_fill_color(cv, "#ffffff")
  canvas_fill_rect(cv, margin + idiv(dots, 4), margin + idiv(dots, 4), idiv(dots, 2), idiv(dots, 2))
  canvas_set_fill_color(cv, "#000000")
  canvas_set_font(cv, "ui", 40)
  canvas_fill_text(cv, format("bin marker - the black square is {} mm: print at 100%, check with a ruler", mm), margin, dots + 2 * margin + 60)
  return canvas_to_png(cv)
}

// ---- from the photo alone: depth, and what is really in the bin --------------------------------------------------
//
// One photo of the bin's front with the marker on it: the camera and the opening found together
// (camera_pose_rect: the marker gives the scale, the opening's right angles the lens and the tilt; the lens from
// the photo's EXIF when the phone gave one). The bin's floor is the plane through the opening's bottom edge square
// to the front, so a tap on the floor's back corner is the depth. The opening is kept on the front in the marker's
// millimetres, so any later photo with the marker in it finds the bin by itself; with the bin's photo when it was
// empty, the view of the empty bin from the later photo's camera is made (box_face_views: the box's walls, floor and
// back are planes), and what differs is what is in it.

fn v3sub(a, b) { return [a[0] - b[0], a[1] - b[1], a[2] - b[2]] }
fn v3dot(a, b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2] }

// the marker's corners on the front (mm: x right, y up, the front z = 0), as image_find_marker orders them
fn marker_world(cfg) {
  let s = cfg.marker_mm * 1.0
  return [[0.0, s], [s, s], [s, 0.0], [0.0, 0.0]]
}

fn find_marker(cv) {
  let m = image_find_marker(cv)
  if m == nil { error("no marker found: print it, tape it flat on the bin's front, and get all of it in the photo") }
  return m
}

// a camera in the marker's frame turned into the bin's: its origin the opening's bottom-left corner, x along the
// bottom edge, y up the front, z out toward the camera (a marker point is o + M p for bin point p: R' = R M,
// t' = R o + t)
fn to_bin_frame(cam, rect) {
  let a = rect.angle * PI / 180.0
  let c = cos(a)
  let s = sin(a)
  let R = cam.rot
  let RM = [R[0] * c + R[1] * s, -R[0] * s + R[1] * c, R[2],
            R[3] * c + R[4] * s, -R[3] * s + R[4] * c, R[5],
            R[6] * c + R[7] * s, -R[6] * s + R[7] * c, R[8]]
  let t = [R[0] * rect.x + R[1] * rect.y + cam.t[0], R[3] * rect.x + R[4] * rect.y + cam.t[1], R[6] * rect.x + R[7] * rect.y + cam.t[2]]
  return {"focal": cam.focal, "cx": cam.cx, "cy": cam.cy, "rot": RM, "t": t}
}

// A bin measured from one photo: the opening's corners (picture, clockwise from the top left) and, optionally, the
// back corner of its floor (picture). focal: the lens from the photo's EXIF (pixels at this photo's size), or nil.
// -> {width_mm, height_mm, depth_mm (nil without the tap), rect (the opening on the front, marker mm), camera (in
// the bin's frame), rms_px, focal_from}
fn bins_geometry(photo, opening, back, cfg, focal) {
  let cv = image_decode(photo)
  let m = find_marker(cv)
  let r = camera_pose_rect(marker_world(cfg), m.corners, opening, canvas_width(cv), canvas_height(cv), focal == nil ? {} : {"focal": focal * 1.0})
  let cam = to_bin_frame(r.camera, r.rect)
  let depth = nil
  if back != nil {
    // the floor is y = 0 in the bin's frame; its inside z < 0
    let ray = camera_ray(cam, back)
    if abs(ray.dir[1]) < 1e-9 { error("the tapped point's ray runs along the floor: tap the back corner of the bin's floor") }
    let t = -ray.from[1] / ray.dir[1]
    let z = ray.from[2] + ray.dir[2] * t
    if t <= 0 or z >= 0 { error("the tapped point is not inside the bin: tap the back corner of its floor") }
    depth = -z
  }
  return {"width_mm": r.rect.width, "height_mm": r.rect.height, "depth_mm": depth, "rect": r.rect, "camera": cam,
          "rms_px": r.rms_px, "focal_from": focal == nil ? "rectangle" : "photo"}
}

// A later photo's camera in the bin's frame: from the marker, with the lens given - the photo's EXIF, or the one
// the bin was measured with (the same phone; scale it to this photo's width).
fn bins_camera(cv, rect, cfg, focal) {
  let m = find_marker(cv)
  let cam = camera_pose(marker_world(cfg), m.corners, canvas_width(cv), canvas_height(cv), focal == nil ? {} : {"focal": focal * 1.0})
  return to_bin_frame(cam, rect)
}

// What is in a bin, from a photo now and its photo when empty (each with its EXIF lens or nil): {changed (the share
// of the opening that differs from the empty bin seen from here), compared (the share both photos could show),
// actual, expected (the flattened faces)}
fn bins_occupancy(photo, focal, empty_photo, empty_cam, dims, cfg) {
  let cv = image_decode(photo)
  let cam = bins_camera(cv, dims.rect, cfg, focal)
  let v = box_face_views(cv, cam, image_decode(empty_photo), empty_cam, {"w": dims.width_mm, "h": dims.height_mm, "d": dims.depth_mm}, 5.0)
  let d = image_difference(v.expected, v.actual)
  return {"changed": d.changed, "compared": d.compared * v.known, "actual": v.actual, "expected": v.expected, "camera": cam}
}

// ---- guiding the camera ---------------------------------------------------------------------------------------------
//
// A frame of the live camera (small: 640 or so across) judged for whether to take the photo, and what to tell the
// person holding the phone if not. With the bin's measuring known (dims: its rect and lens), where its opening falls
// in the frame is worked out from the marker, so the advice can say which way to move.
// -> {ready, advice: [text ...], quality (image_quality's), marker (its corners in the frame, or nil), opening
//    (the opening's corners in the frame, or nil)}
fn bins_frame(photo, dims, cfg, focal) {
  let cv = image_decode(photo)
  let w = canvas_width(cv)
  let h = canvas_height(cv)
  let q = image_quality(cv)
  let advice = []
  # (grain past 0.02 at this size is where a dark scene the phone has brightened starts to cost accuracy)
  if q.brightness < 0.12 or q.noise > 0.02 { push(advice, "Too dark: turn the light on, or the phone's torch") }
  if q.clipped > 0.05 { push(advice, "Glare: tilt the phone a little, or move the light off the marker") }
  let m = image_find_marker(cv)
  let opening = nil
  if m == nil {
    push(advice, "Can't see the marker: get all of it in view")
  } else {
    if m.side_px < 0.035 * w { push(advice, "Closer: the marker is too small to read") }
    if dims != nil and dims.rect != nil {
      let f = focal != nil ? focal * 1.0 : dims.focal_px * w / dims.photo_w
      let cam = camera_pose(marker_world(cfg), m.corners, w, h, {"focal": f})
      let pts = []
      for c in dims.rect.corners { push(pts, [c[0], c[1], 0.0]) }
      opening = camera_project(cam, pts)
      let mx = 0.03 * w
      let my = 0.03 * h
      let left = false
      let right = false
      let up = false
      let down = false
      for p in opening {
        if p == nil { continue }
        if p[0] < mx { left = true }
        if p[0] > w - mx { right = true }
        if p[1] < my { up = true }
        if p[1] > h - my { down = true }
      }
      if (left and right) or (up and down) { push(advice, "Step back: the whole opening isn't in view") }
      else if left { push(advice, "Aim left: the opening runs off the left") }
      else if right { push(advice, "Aim right: the opening runs off the right") }
      else if up { push(advice, "Aim up: the opening runs off the top") }
      else if down { push(advice, "Aim down: the opening runs off the bottom") }
      else if dist(opening[0], opening[1]) < 0.35 * w { push(advice, "Closer: let the opening fill more of the frame") }
    }
  }
  return {"ready": len(advice) == 0, "advice": advice, "quality": q, "marker": m == nil ? nil : m.corners, "opening": opening}
}
