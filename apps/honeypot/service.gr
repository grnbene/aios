// Reads the edge server's honeypot feed (one JSON grab per line, appended as they happen) and serves a live page.
// The feed is a projection; the authoritative, tamper-evident record is the object store the edge server also writes.
fn setting(n, d) { let v = getenv(n) return v == nil or v == "" ? d : v }
let FEED = setting("HONEYPOT_FEED", "/var/log/aios/honeypot.jsonl")
let NODE = setting("AIOS_NODE", setting("HOSTNAME", "node"))
let PAGE = app_program("page.html")

fn now_iso() { return date_format(now(), "%Y-%m-%dT%H:%M:%SZ", "utc") }

// --- access control. The app listens on all interfaces (other nodes must reach /ingest), so:
//   /ingest  needs X-Fleet-Token == FLEET_TOKEN (the edge server's env_honeypot_token); with no FLEET_TOKEN set
//            it takes events from this machine only.
//   the dashboard, exports, report and whois need HTTP Basic auth with DASH_PASSWORD (any username); with no
//            DASH_PASSWORD set they answer this machine only.
// Secrets are compared as sha256 digests, so the comparison's timing says nothing about the secret.
let FLEET_TOKEN = setting("FLEET_TOKEN", "")
let DASH_PASSWORD = setting("DASH_PASSWORD", "")
fn is_loopback(req) {
  let r = get(req, "remote", "")
  return starts_with(r, "127.") or starts_with(r, "[::1]") or starts_with(r, "::1") or r == "localhost"
}
fn same_secret(a, b) { return a != "" and sha256(a) == sha256(b) }
fn fleet_ok(req) {
  if FLEET_TOKEN == "" { return is_loopback(req) }
  return same_secret(get(req.headers, "x-fleet-token", ""), FLEET_TOKEN)
}
fn basic_password(req) {
  let h = get(req.headers, "authorization", "")
  if not starts_with(lower(h), "basic ") { return "" }
  let d = pcall(base64_decode, trim(slice(h, 6, len(h))))
  if not d.ok { return "" }
  let i = index_of(d.value, ":")
  return i >= 0 ? slice(d.value, i + 1, len(d.value)) : ""
}
// nil when the request may see the dashboard; otherwise the response to send instead
fn dash_guard(req) {
  if DASH_PASSWORD == "" {
    if is_loopback(req) { return nil }
    return res_text("Dashboard is local-only: set DASH_PASSWORD on this app to open it to other machines.\n", 403)
  }
  if same_secret(basic_password(req), DASH_PASSWORD) { return nil }
  return res_text("Login required.\n", 401, {"WWW-Authenticate": "Basic realm=\"honeypot\", charset=\"UTF-8\""})
}

// the most recent `limit` grabs, newest first
fn grabs(limit) {
  let r = pcall(read_file, FEED)
  if not r.ok { return [] }
  let lines = split(r.value, "\n")
  let out = []
  let i = len(lines) - 1
  while i >= 0 and len(out) < limit {
    let ln = trim(lines[i])
    if ln != "" { let p = pcall(json_parse, ln) if p.ok { push(out, p.value) } }
    i = i - 1
  }
  return out
}

// every event ever recorded, oldest first - the full record, for export/report (not the capped live feed)
fn all_events() {
  let r = pcall(read_file, FEED)
  if not r.ok { return [] }
  let out = []
  for ln in split(r.value, "\n") {
    let t = trim(ln)
    if t != "" { let p = pcall(json_parse, t) if p.ok { push(out, p.value) } }
  }
  return out
}

// has this event id already landed (fleet fan-out can deliver the same event to a node more than once in a full
// mesh - A forwards to B and C, B also forwards to C)? Checked against recent history only; a duplicate landing
// outside that window is harmless (the report groups by id anyway), this just keeps the common case clean.
fn have_id(id) {
  if id == "" { return false }
  for e in grabs(3000) { if get(e, "id", "") == id { return true } }
  return false
}

// --- fleet roster: "they all need to report back to the hub" - this tracks whether they actually are. The edge
// server sends a heartbeat every 60s to every env_honeypot_forward URL (independent of whether anything has
// probed it); this is where those - and every real event - land, one line per node, overwritten in place so the
// roster stays the size of the fleet, not an ever-growing log.
let FLEET_STATUS = "fleet_status.jsonl"
fn record_fleet_seen(node, t, kind) {
  if node == "" { return }
  let r = pcall(read_file, FLEET_STATUS)
  let roster = {}
  if r.ok {
    for ln in split(r.value, "\n") {
      let tl = trim(ln)
      if tl != "" { let p = pcall(json_parse, tl) if p.ok { roster[get(p.value, "node", "")] = p.value } }
    }
  }
  let prev = get(roster, node, {})
  roster[node] = {
    "node": node, "last_seen": t, "last_kind": kind,
    "last_heartbeat": kind == "honeypot.heartbeat" ? t : get(prev, "last_heartbeat", "")
  }
  let lines = []
  for k in keys(roster) { push(lines, json_stringify(roster[k])) }
  pcall(write_file, FLEET_STATUS, join(lines, "\n") + "\n")
}
fn fleet_roster() {
  let r = pcall(read_file, FLEET_STATUS)
  if not r.ok { return [] }
  let out = []
  for ln in split(r.value, "\n") {
    let t = trim(ln)
    if t != "" { let p = pcall(json_parse, t) if p.ok { push(out, p.value) } }
  }
  return out
}

fn csv_field(v) { return "\"" + replace(str(v), "\"", "\"\"") + "\"" }

// --- real identification: who actually owns this address, passively (RDAP + reverse DNS, no probe-back) --------
let WHOIS_CACHE = "whois_cache.jsonl"
// a UA claiming to be a known crawler is expected to run from that vendor's own published infrastructure; if its
// reverse DNS doesn't land in any of these domains, the UA is very likely spoofed (a scanner borrowing a trusted
// name to slip past naive user-agent allowlists) rather than genuinely being that crawler.
let CRAWLER_CLAIMS = [
  {"needle": "googlebot", "domains": ["googlebot.com", "google.com"]},
  {"needle": "bingbot", "domains": ["search.msn.com"]},
  {"needle": "gptbot", "domains": ["openai.com"]},
  {"needle": "chatgpt-user", "domains": ["openai.com"]},
  {"needle": "oai-searchbot", "domains": ["openai.com"]},
  {"needle": "claudebot", "domains": ["anthropic.com"]},
  {"needle": "claude-web", "domains": ["anthropic.com"]},
  {"needle": "ccbot", "domains": ["commoncrawl.org"]},
  {"needle": "bytespider", "domains": ["bytedance.com", "zijieapi.com"]},
  {"needle": "petalbot", "domains": ["huawei.com", "petalsearch.com"]},
  {"needle": "yandexbot", "domains": ["yandex.com", "yandex.ru", "yandex.net"]},
  {"needle": "grokbot", "domains": ["x.ai"]},
  {"needle": "applebot", "domains": ["apple.com"]},
  {"needle": "amazonbot", "domains": ["amazon.com", "amazonaws.com"]}
]
fn crawler_claim(ua) {
  let u = lower(ua)
  let found = nil
  for c in CRAWLER_CLAIMS { if found == nil and contains(u, c.needle) { found = c } }
  return found
}
fn ptr_matches_claim(ptr, claim) {
  if ptr == "" or claim == nil { return true }   // nothing to check against - don't flag
  let p = lower(ptr)
  let ok = false
  for d in claim.domains { if ends_with(p, d) { ok = true } }
  return ok
}
fn reverse_octets(ip) {
  let parts = split(ip, ".")
  if len(parts) != 4 { return "" }
  return parts[3] + "." + parts[2] + "." + parts[1] + "." + parts[0]
}
fn ipv4_ptr_name(ip) {
  let r = reverse_octets(ip)
  return r == "" ? "" : r + ".in-addr.arpa"
}
// one DNS-over-HTTPS TXT/PTR lookup (Cloudflare's resolver) - works from inside a sandboxed app host that has no
// raw UDP/53 socket; a real edge server with normal DNS can do these with plain DNS queries instead.
fn doh(name, type) {
  let r = pcall(http_get, "https://cloudflare-dns.com/dns-query?name=" + name + "&type=" + type,
                {"headers": {"accept": "application/dns-json"}, "timeout_ms": 6000})
  if not r.ok or not r.value.ok { return "" }
  let p = pcall(json_parse, r.value.body)
  if not p.ok { return "" }
  let answers = get(p.value, "Answer", [])
  if len(answers) == 0 { return "" }
  let d = get(answers[0], "data", "")
  return (starts_with(d, "\"") and ends_with(d, "\"")) ? slice(d, 1, len(d) - 1) : d
}
// which Autonomous System actually announces this address, via Team Cymru's public DNS whois (no key, no rate
// limit beyond politeness) - the real network operator, independent of whatever RDAP's registration data says
// (a block can be registered to one org and routed/operated by a very different one).
fn asn_lookup(ip) {
  let rev = reverse_octets(ip)
  if rev == "" { return {} }
  let txt = doh(rev + ".origin.asn.cymru.com", "TXT")
  if txt == "" { return {} }
  let parts = map(split(txt, "|"), fn(s){ return trim(s) })
  if len(parts) < 2 { return {} }
  let asn = parts[0]
  let asname = ""
  let txt2 = doh("AS" + asn + ".asn.cymru.com", "TXT")
  if txt2 != "" {
    let p2 = map(split(txt2, "|"), fn(s){ return trim(s) })
    if len(p2) >= 5 { asname = p2[4] }
  }
  return {"asn": asn, "bgp_prefix": parts[1], "cc": len(parts) > 2 ? parts[2] : "", "asname": asname}
}
// reverse DNS over HTTPS. See doh() above for why not a plain PTR call.
fn reverse_dns(ip) {
  let name = ipv4_ptr_name(ip)
  if name == "" { return "" }
  let d = doh(name, "PTR")
  return (d != "" and ends_with(d, ".")) ? slice(d, 0, len(d) - 1) : d
}
// --- public reputation feeds: free, no key, no probe of the origin - just checking its address against lists
// other defenders already publish. Cached to disk, refreshed at most once a day (these lists change slowly and
// the publishers ask to be polled politely, not on every dashboard click).
fn today() { return slice(now_iso(), 0, 10) }
fn ensure_blocklist(name, url) {
  let path = "bl_" + name + ".txt"
  let cached = pcall(read_file, path)
  if cached.ok {
    let lines = split(cached.value, "\n")
    if len(lines) > 0 and lines[0] == "# " + today() { return cached.value }
  }
  let resp = pcall(http_get, url, {"timeout_ms": 20000})
  if not resp.ok or not resp.value.ok or resp.value.status >= 400 {
    return cached.ok ? cached.value : ""   // fetch failed - fall back to whatever's cached, even if stale
  }
  let content = "# " + today() + "\n" + resp.value.body
  pcall(write_file, path, content)
  return content
}
fn ip_to_u32(ip) {
  let p = split(ip, ".")
  if len(p) != 4 { return -1 }
  return int(p[0]) * 16777216 + int(p[1]) * 65536 + int(p[2]) * 256 + int(p[3])
}
fn cidr_contains(ip_u32, cidr) {
  let parts = split(trim(cidr), "/")
  if len(parts) != 2 { return false }
  let base = ip_to_u32(trim(parts[0]))
  let bits = int(trim(parts[1]))
  if base < 0 or bits < 0 or bits > 32 { return false }
  if bits == 0 { return true }
  let block = pow(2, 32 - bits)
  return idiv(ip_u32, block) == idiv(base, block)
}
// Spamhaus DROP/EDROP: netblocks hijacked or entirely controlled by professional cybercrime operations - not a
// spam list, a "this block should not be routed at all" list. A hit here is a strong signal on its own.
fn check_spamhaus(ip) {
  let ip_u32 = ip_to_u32(ip)
  if ip_u32 < 0 { return "" }
  let text = ensure_blocklist("spamhaus_drop", "https://www.spamhaus.org/drop/drop.txt") + "\n" +
            ensure_blocklist("spamhaus_edrop", "https://www.spamhaus.org/drop/edrop.txt")
  let hit = ""
  for ln in split(text, "\n") {
    if hit == "" {
      let t = trim(ln)
      if t != "" and not starts_with(t, "#") and not starts_with(t, ";") {
        let semi = index_of(t, ";")
        let cidr = trim(semi >= 0 ? slice(t, 0, semi) : t)
        if index_of(cidr, "/") >= 0 and cidr_contains(ip_u32, cidr) {
          hit = cidr + (semi >= 0 ? " (" + trim(slice(t, semi + 1, len(t))) + ")" : "")
        }
      }
    }
  }
  return hit
}
// the Tor Project's own bulk exit-node list - if this address is in it, anything it sends could be any Tor user,
// not a fixed identity; worth knowing before you spend effort trying to attribute one.
fn check_tor(ip) {
  let text = ensure_blocklist("tor_exits", "https://check.torproject.org/torbulkexitlist")
  let hit = false
  for ln in split(text, "\n") { if not hit and trim(ln) == ip { hit = true } }
  return hit
}
fn vcard_email(e) {
  let va = get(e, "vcardArray", [])
  if len(va) < 2 { return "" }
  let found = ""
  for v in va[1] { if found == "" and len(v) > 0 and v[0] == "email" { found = v[3] } }
  return found
}
// RDAP's entity tree is a couple of levels deep (a registrant entity holding abuse/noc/tech sub-entities); walk
// the common two levels rather than recursing, since that's what every RIR's response actually looks like.
fn find_abuse_email(entities) {
  let found = ""
  for e in entities {
    if found == "" {
      for r in get(e, "roles", []) { if found == "" and r == "abuse" { found = vcard_email(e) } }
      if found == "" {
        for e2 in get(e, "entities", []) {
          for r in get(e2, "roles", []) { if found == "" and r == "abuse" { found = vcard_email(e2) } }
        }
      }
    }
  }
  return found
}
fn org_name(entities) {
  let found = ""
  for e in entities {
    if found == "" { found = vcard_fn(e) }
  }
  return found
}
fn vcard_fn(e) {
  let va = get(e, "vcardArray", [])
  if len(va) < 2 { return "" }
  let found = ""
  for v in va[1] { if found == "" and len(v) > 0 and v[0] == "fn" { found = v[3] } }
  return found
}
// RDAP lookup (ownership, allocation, abuse contact) via rdap.org, which redirects to whichever RIR is
// authoritative for the address - no API key, no probe against the origin itself, just public registry data.
fn rdap_lookup(ip) {
  let r = pcall(http_get, "https://rdap.org/ip/" + ip, {"timeout_ms": 8000})
  if not r.ok or not r.value.ok or r.value.status >= 400 { return {} }
  let p = pcall(json_parse, r.value.body)
  if not p.ok { return {} }
  let d = p.value
  let cidrs = get(d, "cidr0_cidrs", [])
  let cidr = ""
  for c in cidrs { if cidr == "" and has(c, "v4prefix") { cidr = get(c, "v4prefix", "") + "/" + str(get(c, "length", "")) } }
  return {
    "name": get(d, "name", ""),
    "handle": get(d, "handle", ""),
    "country": get(d, "country", ""),
    "range": get(d, "startAddress", "") + " - " + get(d, "endAddress", ""),
    "cidr": cidr,
    "org": org_name(get(d, "entities", [])),
    "abuse_email": find_abuse_email(get(d, "entities", []))
  }
}
fn cache_get(ip) {
  let r = pcall(read_file, WHOIS_CACHE)
  if not r.ok { return nil }
  let found = nil
  for ln in split(r.value, "\n") {
    let t = trim(ln)
    if t != "" and found == nil {
      let p = pcall(json_parse, t)
      if p.ok and get(p.value, "ip", "") == ip { found = p.value }
    }
  }
  return found
}
// one real identification of an origin: who registered the block it's in, their abuse contact, and what it
// actually resolves to - checked against any crawler identity its user-agent claims. Cached (RDAP/DoH are public,
// best treated politely) so re-opening the same origin in the dashboard doesn't re-query every time.
fn whois_lookup(ip, ua) {
  let cached = cache_get(ip)
  if cached != nil { return cached }
  let rdap = rdap_lookup(ip)
  let asn = asn_lookup(ip)
  let ptr = reverse_dns(ip)
  let claim = crawler_claim(ua)
  let matches = ptr_matches_claim(ptr, claim)
  let spamhaus = check_spamhaus(ip)
  let tor = check_tor(ip)
  let rec = {
    "ip": ip, "looked_up": now_iso(), "ptr": ptr,
    "org": get(rdap, "org", ""), "name": get(rdap, "name", ""), "handle": get(rdap, "handle", ""),
    "country": get(rdap, "country", ""), "range": get(rdap, "range", ""), "cidr": get(rdap, "cidr", ""),
    "abuse_email": get(rdap, "abuse_email", ""),
    "asn": get(asn, "asn", ""), "asname": get(asn, "asname", ""), "asn_cc": get(asn, "cc", ""),
    "claimed_crawler": claim == nil ? "" : claim.needle,
    "spoof_suspected": claim != nil and not matches,
    "spamhaus_hit": spamhaus,
    "tor_exit": tor
  }
  append_file(WHOIS_CACHE, json_stringify(rec) + "\n")
  return rec
}

// a clean, factual incident report: every grab and callback this node knows about (its own, and whatever the
// fleet forwarded), grouped by origin, nothing editorialized or inferred beyond what the edge server itself
// recorded. Meant to be handed to someone else - a provider's abuse desk, counsel, or filed at ic3.gov - as the
// record of what was sent to a trap, not an accusation about who sent it.
fn build_report() {
  let all = all_events()
  let by_origin = {}
  let order = []
  for e in all {
    let o = get(e, "origin", "unknown")
    if not has(by_origin, o) { by_origin[o] = [] push(order, o) }
    push(by_origin[o], e)
  }
  let lines = []
  push(lines, "AIOS HONEYPOT INCIDENT REPORT")
  push(lines, "generated " + now_iso() + " by node " + NODE)
  push(lines, repeat("=", 78))
  push(lines, "")
  push(lines, "What this is: every request this trap recorded against a decoy .env file, or against a bait")
  push(lines, "URL that appears only inside that decoy file's own contents. Every credential in the decoy is")
  push(lines, "fake - a random token minted fresh per visitor, so a later connection using that token traces")
  push(lines, "straight back to the probe that received it. Nothing below reflects access performed by this")
  push(lines, "system's operator: each row is a request this system received and traced, unsolicited.")
  push(lines, "")
  push(lines, str(len(all)) + " total event(s) across " + str(len(order)) + " distinct origin(s).")
  push(lines, repeat("=", 78))
  for o in order {
    let evs = by_origin[o]
    let first = evs[0]
    let n_grab = 0
    let n_cb = 0
    for e in evs { if get(e, "kind", "") == "honeypot.callback" { n_cb = n_cb + 1 } else { n_grab = n_grab + 1 } }
    push(lines, "")
    push(lines, "ORIGIN " + o + "  (" + get(first, "scope", "") + ", " + get(first, "net_type", "") + ")")
    push(lines, "  location (offline, coarse): " + get(first, "geo", "-"))
    push(lines, "  " + str(n_grab) + " decoy grab(s), " + str(n_cb) + " bait callback(s)")
    push(lines, repeat("-", 78))
    for e in evs {
      let tag = get(e, "kind", "") == "honeypot.callback" ? "CALLBACK" : "GRAB    "
      push(lines, "  [" + tag + "] " + get(e, "t", "") + "  id=" + get(e, "id", "-") + "  fp=" + get(e, "fp", "-"))
      push(lines, "    " + get(e, "method", "") + " " + get(e, "host", "") + get(e, "path", "") + "  via " + get(e, "via", "direct"))
      push(lines, "    user-agent: " + get(e, "ua", "-"))
      push(lines, "    canary: " + get(e, "canary", "-") + "   node: " + get(e, "node", "-"))
      let hops = get(e, "hops", [])
      if len(hops) > 0 {
        let chain = []
        for h in hops { for k in keys(h) { push(chain, k + "=" + h[k]) } }
        push(lines, "    proxy chain: " + join(chain, " -> "))
      }
    }
  }
  push(lines, "")
  push(lines, repeat("=", 78))
  push(lines, "To report this to law enforcement (United States): file at https://www.ic3.gov (FBI Internet")
  push(lines, "Crime Complaint Center). Include this report and, if your provider requires it, the raw JSON")
  push(lines, "export (/api/export?format=json) as supporting evidence.")
  return join(lines, "\n") + "\n"
}

serve_routes({
  "GET /": fn (req) { let g = dash_guard(req) if g != nil { return g }  return res_html(PAGE) },
  "GET /health": fn (req) { return res_json({"ok": true}) },
  // the fleet collector: other edge nodes POST each event's JSON line here, so this node's feed is the whole fleet
  "POST /ingest": fn (req) {
    if not fleet_ok(req) { return res_error(401, "bad or missing fleet token") }
    let line = trim(req.body)
    if line == "" { return res_error(400, "empty") }
    let p = pcall(json_parse, line)
    if not p.ok { return res_error(400, "not json") }
    let kind = get(p.value, "kind", "")
    let node = get(p.value, "node", "")
    record_fleet_seen(node, get(p.value, "t", now_iso()), kind)
    // a heartbeat proves the node is alive and forwarding works; it isn't an event, so it never joins the feed
    // (one every 60s per node would otherwise drown real grabs out of the recent-history window over time).
    if kind == "honeypot.heartbeat" { return res_json({"ok": true, "heartbeat": true}) }
    if have_id(get(p.value, "id", "")) { return res_json({"ok": true, "dup": true}) }
    append_file(FEED, line + "\n")
    return res_json({"ok": true})
  },
  // the fleet roster: every node that has ever reported in, when it was last heard from, and whether it's still
  // sending heartbeats (client decides "stale" from last_heartbeat; see stale_after_seconds).
  "GET /api/fleet": fn (req) { let g = dash_guard(req) if g != nil { return g }  return res_json({"nodes": fleet_roster(), "stale_after_seconds": 150}) },
  "GET /api/grabs": fn (req) { let g = dash_guard(req) if g != nil { return g } 
    let limit = int(get(req.query_params, "limit", "400"))
    let all = grabs(limit)
    let g = []
    let cb = []
    for e in all {
      if get(e, "kind", "honeypot.env_grab") == "honeypot.callback" { push(cb, e) } else { push(g, e) }
    }
    return res_json({"grabs": g, "callbacks": cb, "count": len(all)})
  },
  // the full record, for handing to someone else - a provider's abuse desk, your own counsel, or law enforcement.
  "GET /api/export": fn (req) { let g = dash_guard(req) if g != nil { return g } 
    let fmt = lower(get(req.query_params, "format", "json"))
    let all = all_events()
    if fmt == "csv" {
      let cols = ["t", "kind", "id", "fp", "canary", "origin", "scope", "family", "net_type", "geo", "lat", "lon",
                 "via", "node", "scheme", "method", "host", "path", "ua"]
      let out = [join(cols, ",")]
      for e in all {
        let row = []
        for c in cols { push(row, csv_field(get(e, c, ""))) }
        push(out, join(row, ","))
      }
      return res_download(join(out, "\n") + "\n", "honeypot-evidence.csv")
    }
    return res_download(json_stringify({"node": NODE, "generated": now_iso(), "count": len(all), "events": all}),
                        "honeypot-evidence.json")
  },
  "GET /api/report": fn (req) { let g = dash_guard(req) if g != nil { return g }  return res_download(build_report(), "honeypot-incident-report.txt") },
  // real identification, on demand: who registered this address's block, their abuse contact, what it actually
  // resolves to, and whether that matches any crawler identity its user-agent claims. Passive (RDAP + reverse
  // DNS only, nothing sent to the origin itself), and cached so re-opening an origin doesn't re-query every time.
  "GET /api/whois": fn (req) { let g = dash_guard(req) if g != nil { return g } 
    let ip = trim(get(req.query_params, "ip", ""))
    if ip == "" { return res_error(400, "ip required") }
    if ip_family(ip) != "ipv4" or not ip_is_public(ip) { return res_error(400, "a public IPv4 address is required") }
    let ua = ""
    for e in grabs(2000) { if ua == "" and get(e, "origin", "") == ip { ua = get(e, "ua", "") } }
    return res_json(whois_lookup(ip, ua))
  }
}, {"workers": false})
