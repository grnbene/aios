#!/usr/bin/env bash
# aios honeypot - join this server to your fleet. Generated by your hub; safe to re-run.
#
#   curl -fsSL -H "X-Fleet-Token: <token>" <hub>/join.sh | sudo bash -s -- [--name NAME] [--collect-url URL]
#   ... | sudo bash -s -- --uninstall
#
# Finds nginx or Apache, puts a small aios-webserver "sidecar" on 127.0.0.1 next to it, and hands it ONLY bait
# requests (.env, wp-config.php, .git/config, ../ traversal, /px/ callbacks). Your sites keep serving as before.
# Every config file it touches is backed up first, checked with nginx -t / apachectl configtest, and restored
# automatically if the check fails.
set -euo pipefail

HUB="__HUB__"
TOKEN="__TOKEN__"
NAME="$(hostname -s 2>/dev/null || hostname)"
COLLECT_URL=""
PORT=8899
UNINSTALL=0
FRONT=auto
while [ $# -gt 0 ]; do
  case "$1" in
    --name) NAME="$2"; shift 2 ;;
    --collect-url) COLLECT_URL="$2"; shift 2 ;;
    --front) FRONT="$2"; shift 2 ;;
    --uninstall) UNINSTALL=1; shift ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

MARK="# aios-honeypot (added by join.sh; remove with --uninstall)"
BACKUP_DIR="/var/lib/aios/backup/$(date +%Y%m%d-%H%M%S)"
say()  { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || die "run as root: ... | sudo bash"
[ "$(uname -s)" = Linux ] || die "Linux only"
[ "$(uname -m)" = x86_64 ] || die "your hub serves an x86_64 build and this machine is $(uname -m): build aios-webserver from source here, then use apps/honeypot/deploy/sidecar.conf"
command -v curl >/dev/null || die "curl is required"
case "$NAME" in *[!A-Za-z0-9._-]*|"") die "--name may use letters, digits, '.', '_' and '-' only" ;; esac

detect_front() {
  if [ "$FRONT" != auto ]; then echo "$FRONT"; return; fi
  if command -v nginx >/dev/null 2>&1 && pgrep -x nginx >/dev/null 2>&1; then echo nginx; return; fi
  if pgrep -x apache2 >/dev/null 2>&1; then echo apache; return; fi
  if pgrep -x httpd >/dev/null 2>&1; then echo apache; return; fi
  echo none
}

# every file under these globs that defines a server/vhost, resolved through symlinks (sites-enabled entries are
# usually links into sites-available - edit the real file, never replace the link)
site_files() {
  local f
  for f in "$@"; do
    [ -e "$f" ] || continue
    readlink -f "$f"
  done | sort -u
}

backup() { mkdir -p "$BACKUP_DIR"; cp -a "$1" "$BACKUP_DIR/$(echo "$1" | tr / _)"; echo "$1" >> "$BACKUP_DIR/files"; }
restore_all() {
  [ -f "$BACKUP_DIR/files" ] || return 0
  while read -r f; do cp -a "$BACKUP_DIR/$(echo "$f" | tr / _)" "$f"; done < "$BACKUP_DIR/files"
}

# insert "$MARK" + "$2" after every line of file $1 matching the extended regex $3, once per file
patch_file() {
  local file="$1" line="$2" re="$3"
  grep -qF "$MARK" "$file" && return 0
  grep -qE "$re" "$file" || return 0
  backup "$file"
  awk -v re="$re" -v mark="    $MARK" -v add="    $line" '{ print } $0 ~ re { print mark; print add }' "$file" > "$file.aios-tmp"
  cat "$file.aios-tmp" > "$file" && rm -f "$file.aios-tmp"
  PATCHED=$((PATCHED + 1))
  say "  wired: $file"
}
unpatch_file() {
  local file="$1"
  grep -qF "$MARK" "$file" || return 0
  backup "$file"
  awk -v mark="$MARK" 'index($0, mark) { skip = 1; next } skip { skip = 0; next } { print }' "$file" > "$file.aios-tmp"
  cat "$file.aios-tmp" > "$file" && rm -f "$file.aios-tmp"
  say "  unwired: $file"
}

# tell the hub this server is leaving, so its dashboard drops it instead of showing it "NOT REPORTING" forever
say_leave() {
  local n="$1"
  [ -n "$n" ] || return 0
  curl -s -o /dev/null --max-time 10 -X POST -H "X-Fleet-Token: $TOKEN" -H "Content-Type: application/json" \
    -d "{\"kind\":\"honeypot.leave\",\"node\":\"$n\",\"t\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" "$HUB/ingest" || true
}

# a failed install leaves nothing behind: config files restored, sidecar stopped (so the hub never shows a
# "reporting" node that isn't actually wired), snippet removed
abort_install() {
  restore_all
  if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    systemctl disable --now aios-honeypot >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/aios-honeypot.service; systemctl daemon-reload || true
  fi
  pkill -f "aios-webserver /etc/aios/sidecar.conf" 2>/dev/null || true
  rm -f /etc/nginx/snippets/aios-honeypot.conf /etc/nginx/aios-honeypot.conf /etc/apache2/aios-honeypot.inc /etc/httpd/aios-honeypot.inc
  say_leave "$NAME"
  die "$1"
}

nginx_snippet() { cat <<EOF
# aios honeypot: send ONLY bait requests to the sidecar on 127.0.0.1:$PORT. Managed by join.sh.
set \$aios_bait 0;
if (\$uri ~* "(^|/)\\.env([._-][^/]*)?\$")             { set \$aios_bait 1; }
if (\$uri ~* "/(wp-config\\.php|\\.git/config)\$")     { set \$aios_bait 1; }
if (\$request_uri ~* "\\.\\./|%2e%2e")                 { set \$aios_bait 1; }
if (\$uri ~ "^/px/")                                 { set \$aios_bait 1; }
if (\$aios_bait) { rewrite ^ /__aios_honeypot__ last; }
location = /__aios_honeypot__ {
    internal;
    proxy_pass http://127.0.0.1:$PORT\$request_uri;
    proxy_set_header Host \$host;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
}
EOF
}
apache_snippet() { cat <<EOF
# aios honeypot: send ONLY bait requests to the sidecar on 127.0.0.1:$PORT. Managed by join.sh.
RewriteEngine On
RewriteCond %{REQUEST_URI} (^|/)\\.env([._-][^/]*)?\$ [NC,OR]
RewriteCond %{REQUEST_URI} /(wp-config\\.php|\\.git/config)\$ [NC,OR]
RewriteCond %{THE_REQUEST} \\.\\./|%2e%2e [NC,OR]
RewriteCond %{REQUEST_URI} ^/px/
RewriteRule ^ http://127.0.0.1:$PORT%{REQUEST_URI} [P,L]
RequestHeader set X-Real-IP "expr=%{REMOTE_ADDR}"
ProxyPreserveHost On
EOF
}

nginx_files() { site_files /etc/nginx/sites-enabled/* /etc/nginx/conf.d/*.conf; }
apache_layout() {
  if [ -d /etc/apache2 ]; then
    APACHE_SNIPPET=/etc/apache2/aios-honeypot.inc
    APACHE_TEST="apachectl configtest"; APACHE_RELOAD="apachectl graceful"
    APACHE_FILES="$(site_files /etc/apache2/sites-enabled/*)"
  elif [ -d /etc/httpd ]; then
    APACHE_SNIPPET=/etc/httpd/aios-honeypot.inc
    APACHE_TEST="apachectl configtest"; APACHE_RELOAD="apachectl graceful"
    APACHE_FILES="$(site_files /etc/httpd/conf.d/*.conf)"
  else
    die "Apache is running but neither /etc/apache2 nor /etc/httpd exists"
  fi
}

# ---- uninstall ------------------------------------------------------------------------------------------------
if [ "$UNINSTALL" = 1 ]; then
  say "Removing the aios honeypot from this server"
  for f in $(nginx_files 2>/dev/null); do unpatch_file "$f"; done
  if [ -d /etc/apache2 ] || [ -d /etc/httpd ]; then
    apache_layout || true
    for f in $APACHE_FILES; do unpatch_file "$f"; done
  fi
  if pgrep -x nginx >/dev/null 2>&1; then nginx -t >/dev/null 2>&1 && nginx -s reload && sleep 1; fi
  if pgrep -x apache2 >/dev/null 2>&1 || pgrep -x httpd >/dev/null 2>&1; then $APACHE_TEST >/dev/null 2>&1 && $APACHE_RELOAD; fi
  rm -f /etc/nginx/snippets/aios-honeypot.conf /etc/nginx/aios-honeypot.conf /etc/apache2/aios-honeypot.inc /etc/httpd/aios-honeypot.inc
  if command -v systemctl >/dev/null 2>&1; then systemctl disable --now aios-honeypot >/dev/null 2>&1 || true; rm -f /etc/systemd/system/aios-honeypot.service; systemctl daemon-reload || true; fi
  pkill -f "aios-webserver /etc/aios/sidecar.conf" 2>/dev/null || true
  # the name it was installed under (not necessarily this run's --name default)
  say_leave "$(awk '$1=="env_honeypot_node"{print $2}' /etc/aios/sidecar.conf 2>/dev/null)"
  rm -f /etc/aios/sidecar.conf
  say "Done. Kept: the evidence in /var/lib/aios/honeypot-store and /var/log/aios, backups in /var/lib/aios/backup."
  exit 0
fi

# ---- install --------------------------------------------------------------------------------------------------
FRONT="$(detect_front)"
case "$FRONT" in
  nginx|apache) say "Found $FRONT - your sites keep serving; only bait requests go to the honeypot" ;;
  none) die "no running nginx or Apache found. If this server runs aios-webserver itself, add the env_honeypot lines from apps/honeypot/deploy/node.conf instead (or pass --front nginx|apache)." ;;
  *) die "--front must be nginx or apache" ;;
esac

say "Downloading aios-webserver from your hub"
mkdir -p /usr/local/bin /etc/aios /var/lib/aios/sidecar-empty /var/lib/aios/honeypot-store /var/log/aios
curl -fsSL -H "X-Fleet-Token: $TOKEN" "$HUB/dl/aios-webserver" -o /usr/local/bin/aios-webserver.new \
  || die "could not download from $HUB - is the hub reachable from here?"
chmod 755 /usr/local/bin/aios-webserver.new
case "$(/usr/local/bin/aios-webserver.new --help 2>&1 || true)" in
  *vhost-aware*) ;;
  *) die "the downloaded binary does not run on this machine" ;;
esac
mv -f /usr/local/bin/aios-webserver.new /usr/local/bin/aios-webserver

umask 077
printf '%s\n' "$TOKEN" > /etc/aios/fleet.token
umask 022
{
  echo "# aios honeypot sidecar - written by join.sh. Re-run join.sh to regenerate."
  echo "vhost honeypot-sidecar {"
  echo "  listen $PORT loopback"
  echo "  root /var/lib/aios/sidecar-empty"
  echo "  env_honeypot on"
  echo "  env_honeypot_node $NAME"
  echo "  env_honeypot_real_ip_header X-Real-IP"
  echo "  env_honeypot_store /var/lib/aios/honeypot-store"
  echo "  env_honeypot_feed /var/log/aios/honeypot.jsonl"
  [ -f /etc/aios/geo.csv ] && echo "  env_honeypot_geo /etc/aios/geo.csv"
  echo "  env_honeypot_forward $HUB/ingest"
  echo "  env_honeypot_token_file /etc/aios/fleet.token"
  if [ -n "$COLLECT_URL" ]; then echo "  env_honeypot_collect_url $COLLECT_URL"; fi
  echo "  env_honeypot_collect /px/"
  echo "  honeypot_path /wp-config\\.php"
  echo "  honeypot_path /\\.git/config"
  echo "  honeypot_path \\.\\./|%2[eE]%2[eE]"
  echo "}"
} > /etc/aios/sidecar.conf

say "Starting the sidecar (127.0.0.1:$PORT only) as \"$NAME\""
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  cat > /etc/systemd/system/aios-honeypot.service <<EOF
[Unit]
Description=aios honeypot sidecar ($NAME)
After=network-online.target
[Service]
Environment=AIOS_NODE=$NAME
ExecStart=/usr/local/bin/aios-webserver /etc/aios/sidecar.conf
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable aios-honeypot >/dev/null 2>&1
  systemctl restart aios-honeypot
else
  warn "no systemd: starting in the background now; add it to your init system to survive reboots"
  pkill -f "aios-webserver /etc/aios/sidecar.conf" 2>/dev/null || true
  AIOS_NODE="$NAME" nohup /usr/local/bin/aios-webserver /etc/aios/sidecar.conf >> /var/log/aios/sidecar.log 2>&1 &
fi
for _ in $(seq 1 30); do curl -s -o /dev/null "http://127.0.0.1:$PORT/" && break; sleep 0.2; done
curl -s -o /dev/null "http://127.0.0.1:$PORT/" || die "the sidecar did not start - see: journalctl -u aios-honeypot"

PATCHED=0
if [ "$FRONT" = nginx ]; then
  if [ -d /etc/nginx/snippets ]; then SNIPPET=/etc/nginx/snippets/aios-honeypot.conf; else SNIPPET=/etc/nginx/aios-honeypot.conf; fi
  nginx_snippet > "$SNIPPET"
  say "Wiring nginx server blocks"
  for f in $(nginx_files); do patch_file "$f" "include $SNIPPET;" '^[[:space:]]*server[[:space:]]*\{'; done
  if ! why="$(nginx -t 2>&1)"; then
    printf '%s\n' "$why" | grep -E "emerg|error" >&2 || true
    abort_install "nginx rejected the change (above). Nothing was left changed: every file was restored from $BACKUP_DIR and the sidecar was stopped."
  fi
  nginx -s reload
else
  apache_layout
  if [ -d /etc/apache2 ]; then a2enmod -q proxy proxy_http rewrite headers >/dev/null; fi
  apache_snippet > "$APACHE_SNIPPET"
  say "Wiring Apache virtual hosts"
  for f in $APACHE_FILES; do patch_file "$f" "Include $APACHE_SNIPPET" '^[[:space:]]*<VirtualHost[[:space:]>]'; done
  if ! why="$($APACHE_TEST 2>&1)"; then
    printf '%s\n' "$why" | grep -vE "AH00558|^Syntax OK" >&2 || true
    abort_install "Apache rejected the change (above; it needs mod_proxy, mod_proxy_http, mod_rewrite, mod_headers). Nothing was left changed: every file was restored from $BACKUP_DIR and the sidecar was stopped."
  fi
  $APACHE_RELOAD
fi
[ "$PATCHED" -gt 0 ] || grep -rqsF "$MARK" /etc/nginx /etc/apache2 /etc/httpd || abort_install "found no server blocks / virtual hosts to wire"

say "Self-test: a fake .env request through $FRONT"
sleep 1
ok=0
for url in "http://127.0.0.1/.env" "https://127.0.0.1/.env"; do
  case "$(curl -sk --max-time 5 -A "aios-honeypot-selftest" "$url" 2>/dev/null || true)" in
    "# aios runtime environment"*) ok=1; break ;;
  esac
done
if [ "$ok" = 1 ]; then
  say "Done. \"$NAME\" is trapping and reporting to $HUB - it shows on the dashboard's Fleet panel within a minute."
else
  warn "installed, but a test request to 127.0.0.1/.env did not reach the decoy (a site that only answers its own hostname?)."
  warn "try:  curl -k https://<this-server's-domain>/.env   - it should start with '# aios runtime environment'."
fi
say "Undo any time:  curl -fsSL -H \"X-Fleet-Token: ...\" $HUB/join.sh | sudo bash -s -- --uninstall"
