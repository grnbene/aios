# Doom's sound and music lumps: DMX sound effects as WAV files, MUS scores as standard MIDI. A port of SQLDoom's
# load_sounds and mus_to_midi (github.com/cedardb/sqldoom, wad_loader.py, GPL-2.0).

# A list of byte values as bytes.
fn bytes_of(list) { return bytes(list) }

# A DMX sound lump (format 3: rate, count, unsigned 8-bit mono samples) as a WAV file's bytes, or nil.
fn dmx_to_wav(raw) {
  if len(raw) < 8 { return nil }
  let format = bytes_get(raw, 0, "u16le")
  let rate = bytes_get(raw, 2, "u16le")
  let count = min(bytes_get(raw, 4, "u32le"), len(raw) - 8)
  if format != 3 or rate <= 0 { return nil }
  let head = pack("<4sI4s4sIHHIIHH4sI", "RIFF", 36 + count, "WAVE", "fmt ", 16, 1, 1, rate, rate, 1, 8, "data", count)
  let samples = bytes(count)
  bytes_copy(samples, 0, raw, 8, count)
  return bytes_concat([head, samples])
}

let MUS_CONTROLLER_TO_MIDI = [0, 32, 1, 7, 10, 11, 91, 93, 64, 67, 120, 123, 126, 127, 121]

fn midi_varlen(value, out) {
  let v = max(0, value)
  let groups = [v & 127]
  v = v >> 7
  while v > 0 {
    push(groups, 128 | (v & 127))
    v = v >> 7
  }
  let i = len(groups) - 1
  while i >= 0 {
    push(out, groups[i])
    i = i - 1
  }
}

fn mus_channel(ch) {
  if ch == 15 { return 9 }
  return ch < 9 ? ch : ch + 1
}

# A MUS lump as a format-0 MIDI file (division 70 at 500,000 us a quarter: MUS's 140 ticks a second), or nil when
# the lump is not one.
fn mus_to_midi(data) {
  if len(data) < 16 or bytes_str(data, 0, 3) != "MUS" or bytes_get(data, 3, "u8") != 26 { return nil }
  let score_len = bytes_get(data, 4, "u16le")
  let score_start = bytes_get(data, 6, "u16le")
  let end = min(len(data), score_start + score_len)
  let pos = score_start
  let velocity = []
  for i in range(0, 16) { push(velocity, 127) }
  let pending = 0
  let track = [0, 255, 81, 3, 7, 161, 32]   # tempo: 500,000 us a quarter
  while pos < end {
    let d = bytes_get(data, pos, "u8")
    pos = pos + 1
    let ch = d & 15
    let kind = (d >> 4) & 7
    let last = (d & 128) != 0
    let mc = mus_channel(ch)
    let ev = nil
    if kind == 0 {   # release a note
      if pos >= end { break }
      ev = [128 | mc, bytes_get(data, pos, "u8") & 127, 0]
      pos = pos + 1
    } else if kind == 1 {   # play a note, maybe at a new velocity
      if pos >= end { break }
      let note = bytes_get(data, pos, "u8")
      pos = pos + 1
      if (note & 128) != 0 {
        if pos >= end { break }
        velocity[ch] = bytes_get(data, pos, "u8") & 127
        pos = pos + 1
      }
      ev = [144 | mc, note & 127, velocity[ch]]
    } else if kind == 2 {   # pitch wheel: MUS 0..255 -> MIDI 0..16320
      if pos >= end { break }
      let pitch = bytes_get(data, pos, "u8") << 6
      pos = pos + 1
      ev = [224 | mc, pitch & 127, (pitch >> 7) & 127]
    } else if kind == 3 {   # system controller
      if pos >= end { break }
      let c = bytes_get(data, pos, "u8")
      pos = pos + 1
      if c >= len(MUS_CONTROLLER_TO_MIDI) { return nil }
      ev = [176 | mc, MUS_CONTROLLER_TO_MIDI[c], 0]
    } else if kind == 4 {   # controller, or a patch change
      if pos + 1 >= end { break }
      let c = bytes_get(data, pos, "u8")
      let v = bytes_get(data, pos + 1, "u8")
      pos = pos + 2
      if c == 0 {
        ev = [192 | mc, v & 127]
      } else {
        if c >= len(MUS_CONTROLLER_TO_MIDI) { return nil }
        ev = [176 | mc, MUS_CONTROLLER_TO_MIDI[c], v & 127]
      }
    } else if kind == 6 {   # the end of the score
      break
    } else {
      return nil
    }
    if ev != nil {
      midi_varlen(pending, track)
      for b in ev { push(track, b) }
      pending = 0
    }
    if last {
      let delay = 0
      while pos < end {
        let v = bytes_get(data, pos, "u8")
        pos = pos + 1
        delay = (delay << 7) | (v & 127)
        if (v & 128) == 0 { break }
      }
      pending = pending + delay
    }
  }
  midi_varlen(pending, track)
  push(track, 255, 47, 0)
  return bytes_concat([pack(">4sIHHH", "MThd", 6, 0, 1, 70), pack(">4sI", "MTrk", len(track)), bytes_of(track)])
}

let E4_MUSIC = ["E3M4", "E3M2", "E3M3", "E1M5", "E2M7", "E2M4", "E2M6", "E2M5", "E1M9"]
let DOOM2_MUSIC = ["RUNNIN", "STALKS", "COUNTD", "BETWEE", "DOOM", "THE_DA", "SHAWN", "DDTBLU", "IN_CIT", "DEAD",
                   "STLKS2", "THEDA2", "DOOM2", "DDTBL2", "RUNNI2", "DEAD2", "STLKS3", "ROMERO", "SHAWN2", "MESSAG",
                   "COUNT2", "DDTBL3", "AMPIE", "THEDA3", "ADRIAN", "MESSG2", "ROMER2", "TENSE", "SHAWN3", "OPENIN",
                   "EVIL", "ULTIMA"]

# The music lump a map plays, or nil.
fn music_for(name) {
  if regex_test("^E[1-3]M[1-9]$", name) { return "D_" + name }
  let e4 = regex_match("^E4M([1-9])$", name)
  if e4 != nil { return "D_" + E4_MUSIC[int(e4.groups[0]) - 1] }
  let d2 = regex_match("^MAP([0-9][0-9])$", name)
  if d2 != nil {
    let i = int(d2.groups[0]) - 1
    if i >= 0 and i < len(DOOM2_MUSIC) { return "D_" + DOOM2_MUSIC[i] }
  }
  return nil
}
