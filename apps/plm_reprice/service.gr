// plm_reprice - reprices the tires whose price inputs changed, as they change.
//
// Waits on the plm_input Thing (WAIT THING), which wakes only for tires whose inputs actually moved. Gathers those
// stockids for BATCH_SECONDS, then hands them to v8 (apir/inventory/prices/repriceitems), which runs the same PHP
// reprice() the item screen and the nightly cron run. Nothing is priced here.
//
// MODE "dry" (the default) only logs what it would send, one JSON line a batch, so a day of it says how many
// reprices the triggers would cause. MODE "live" calls v8 and logs how many price rows v8 actually wrote.
//
// It starts from the Thing's clock now: changes from before it ran, and a rebuilt Thing (whole), are left to the
// nightly auto.php plm_reprice cron, which stays as the fallback.

fn setting(name, fallback) {
  let v = getenv(name)
  if v != nil and v != "" { return v }
  let f = getenv(name + "_FILE")
  if f != nil and f != "" { return trim(read_file(f)) }
  return fallback
}

let THING = "plm_input"
let MODE = setting("MODE", "dry")
let BATCH_SECONDS = int(setting("BATCH_SECONDS", "30"))
let MAX_BATCH = 500   // repriceitems takes at most 500
let WAIT_SECONDS = 8   // one WAIT THING stays under the db client's 10 s read timeout (sql_wire.hpp read_timeout_ms_)
let LOG_FILE = setting("LOG_FILE", "")
let V8_URL = setting("V8_URL", "")       // .../index.php?route=apir/inventory/prices/repriceitems
let V8_TOKEN = setting("V8_TOKEN", "")   // Bearer {apikey}_{userid}

fn log(entry) {
  entry["at"] = date_format(now(), "%F %T", "local")
  let line = json_stringify(entry)
  print(line)
  if LOG_FILE != "" { append_file(LOG_FILE, line + "\n") }
}

fn connect() {
  let c = db_connect(setting("DB_HOST", "127.0.0.1"), int(setting("DB_PORT", "3307")), setting("DB_USER", "root"),
                     setting("DB_PASSWORD", ""), setting("DB_NAME", "versioneight"))
  if not c.ok {
    log({"event": "error", "message": "cannot reach ASQL: " + str(c.error)})
    return nil
  }
  return c
}

// One batch to v8. True when v8 took it (or, dry, when it was logged).
fn send(ids) {
  if MODE != "live" {
    log({"event": "would_reprice", "items": len(ids), "stockids": ids})
    return true
  }
  let t0 = now()
  let r = pcall(http_request, {
    "url": V8_URL, "method": "POST", "timeout_ms": 300000,
    "headers": {"Authorization": "Bearer " + V8_TOKEN, "Content-Type": "application/json"},
    "body": json_stringify({"stockids": ids})
  })
  let secs = round(now() - t0, 1)
  if not r.ok {
    log({"event": "error", "items": len(ids), "seconds": secs, "message": str(r.error)})
    return false
  }
  let res = r.value
  let body = pcall(json_parse, res.body ?? "")
  let b = body.ok and body.value != nil ? body.value : {}
  if not res.ok or b.status != true {
    log({"event": "error", "items": len(ids), "seconds": secs, "status": res.status, "message": str(b.error ?? res.body)})
    return false
  }
  log({"event": "repriced", "items": len(ids), "repriced": b.repriced, "rows_written": b.rows_written, "seconds": secs})
  return true
}

if MODE == "live" and (V8_URL == "" or V8_TOKEN == "") {
  log({"event": "error", "message": "MODE live needs V8_URL and V8_TOKEN"})
  error("MODE live needs V8_URL and V8_TOKEN")
}

let c = nil
let at = nil          // the Thing's clock this has caught up to
let pending = []      // stockids waiting for the batch, in the order they changed
let queued = {}
let since = nil       // when the oldest pending one arrived
log({"event": "start", "mode": MODE, "batch_seconds": BATCH_SECONDS})

while true {
  if c == nil {
    c = connect()
    if c == nil { sleep(5000); continue }
    if at == nil {
      let p0 = pcall(db_query, c, "WAIT THING " + THING + " SINCE 0", [])
      let w0 = p0.ok ? p0.value : {"ok": false, "error": p0.error, "records": []}
      if not w0.ok or len(w0.records) == 0 {
        log({"event": "error", "message": "no " + THING + " Thing: " + str(w0.error)})
        db_close(c)
        c = nil
        sleep(30000)
        continue
      }
      at = int(w0.records[0].clock)
      log({"event": "watching", "clock": at})
    }
  }

  let wait = WAIT_SECONDS
  if since != nil { wait = max(1, min(WAIT_SECONDS, BATCH_SECONDS - int(now() - since))) }
  // db_query throws, rather than answering not ok, when the connection has gone
  let p = pcall(db_query, c, "WAIT THING " + THING + " SINCE " + str(at) + " TIMEOUT " + str(wait), [])
  let w = p.ok ? p.value : {"ok": false, "error": p.error, "records": []}
  if not w.ok or len(w.records) == 0 {
    log({"event": "error", "message": w.ok ? "WAIT THING gave no answer" : str(w.error)})
    db_close(c)
    c = nil
    sleep(5000)
    continue
  }
  let r = w.records[0]
  let next = int(r.clock)
  if next != at {
    at = next
    if str(r.whole) == "1" {
      log({"event": "whole", "clock": at, "note": "Thing rebuilt; left to the nightly cron"})
    } else {
      for k in json_parse(str(r.changed ?? "[]")) ?? [] {
        let id = str(k)
        if has(queued, id) { continue }
        queued[id] = true
        push(pending, id)
      }
      if since == nil and len(pending) > 0 { since = now() }
    }
  }

  if since != nil and (now() - since >= BATCH_SECONDS or len(pending) >= MAX_BATCH) {
    let left = []
    let i = 0
    while i < len(pending) {
      let part = slice(pending, i, min(i + MAX_BATCH, len(pending)))
      if not send(part) { for id in part { push(left, id) } }
      i = i + MAX_BATCH
    }
    // what v8 did not take waits for the next batch
    pending = left
    queued = {}
    for id in left { queued[id] = true }
    since = len(left) > 0 ? now() : nil
  }
}
