// Warehouse Touches Views: Production PDF, XLSX, CSV, and Responsive Dashboard
//
// Matches and exceeds catalog/controller/apir/warehouse/touches.php in fidelity,
// typography, responsive layout, and document generation.

fn html_escape(s) {
  if s == nil { return "" }
  let str_val = str(s)
  let out = ""
  for i in range(0, len(str_val)) {
    let c = str_val[i]
    if c == "&" { out = out + "&amp;" }
    else if c == "<" { out = out + "&lt;" }
    else if c == ">" { out = out + "&gt;" }
    else if c == "\"" { out = out + "&quot;" }
    else if c == "'" { out = out + "&#39;" }
    else { out = out + c }
  }
  return out
}

fn fmt_num(n, decimals) {
  if n == nil { return "0" }
  let r = real(n)
  if decimals == 0 {
    let int_part = int(r)
    let s = str(int_part)
    let neg = false
    if len(s) > 0 and s[0] == "-" {
      neg = true
      s = slice(s, 1, len(s))
    }
    let res = ""
    let cnt = 0
    let idx = len(s) - 1
    while idx >= 0 {
      if cnt > 0 and cnt % 3 == 0 { res = "," + res }
      res = s[idx] + res
      cnt += 1
      idx -= 1
    }
    return neg ? "-" + res : res
  }
  let s = str(round(r, decimals))
  let dot = -1
  for i in range(0, len(s)) {
    if s[i] == "." { dot = i }
  }
  if dot == -1 {
    return fmt_num(int(r), 0) + ".0"
  }
  let int_str = fmt_num(int(slice(s, 0, dot)), 0)
  let dec_str = slice(s, dot + 1, len(s))
  while len(dec_str) < decimals { dec_str = dec_str + "0" }
  if len(dec_str) > decimals { dec_str = slice(dec_str, 0, decimals) }
  return int_str + "." + dec_str
}

fn fmt_pct(val) {
  if val == nil { return "0.0%" }
  return fmt_num(val, 1) + "%"
}

fn fmt_time(ts) {
  if ts == nil or ts == "" { return "" }
  let s = str(ts)
  if len(s) < 16 { return s }
  let m_str = slice(s, 5, 7)
  let d_str = slice(s, 8, 10)
  let hr_str = slice(s, 11, 13)
  let min_str = slice(s, 14, 16)
  let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
  let m_idx = int(m_str) - 1
  let m_name = (m_idx >= 0 and m_idx < 12) ? months[m_idx] : m_str
  let d_num = int(d_str)
  let hr = int(hr_str)
  let ampm = hr >= 12 ? "pm" : "am"
  let hr12 = hr % 12
  if hr12 == 0 { hr12 = 12 }
  return m_name + " " + str(d_num) + " " + str(hr12) + ":" + min_str + ampm
}

fn fmt_short_date(ts) {
  if ts == nil or ts == "" { return "" }
  let s = str(ts)
  if len(s) < 16 { return s }
  return slice(s, 5, 16)
}

// ---- Native 31-Column PDF Report --------------------------------------------

fn render_pdf_report(report) {
  let css = join([
    "body { color: #111111; font-family: Helvetica, Arial, sans-serif; margin: 0; padding: 0; }",
    "div.header { font-size: 10pt; font-weight: bold; margin-bottom: 2mm; color: #111111; }",
    "div.key { font-size: 7pt; margin-bottom: 2.5mm; color: #444444; }",
    "span.swatch { display: inline-block; width: 12px; height: 8px; background-color: #ffd966; border: 0.2mm solid #888888; vertical-align: middle; margin-right: 3px; }",
    "table.touches { border-collapse: collapse; width: 100%; font-size: 5pt; }",
    "table.touches th { background-color: #e5e7eb; border: 0.2mm solid #9ca3af; padding: 0.6mm 0.3mm; text-align: center; color: #111827; font-weight: bold; }",
    "table.touches th.contrib { background-color: #ffd966; color: #78350f; }",
    "table.touches td { border: 0.2mm solid #d1d5db; padding: 0.5mm 0.3mm; text-align: right; color: #1f2937; }",
    "table.touches td.l { text-align: left; font-weight: 500; }",
    "table.touches td.t { white-space: nowrap; font-size: 4.5pt; color: #4b5563; }",
    "table.touches td.contrib { background-color: #fff2cc; font-weight: 600; }",
    "table.touches tr:nth-child(even) td { background-color: #f9fafb; }",
    "table.touches tr:nth-child(even) td.contrib { background-color: #fef9c3; }",
    "table.touches tr.total td { background-color: #e5e7eb; font-weight: bold; border-top: 0.4mm solid #4b5563; }",
    "table.touches tr.total td.contrib { background-color: #fde68a; font-weight: bold; }",
    "div.footer { font-size: 6.5pt; text-align: right; color: #6b7280; margin-top: 2mm; }"
  ], " ")

  let grand = report.totals.touches > 0 ? report.totals.touches : 1.0

  let parts = [
    "<div class=\"header\">Warehouse Touches " + html_escape(report.start) + " to " + html_escape(report.stop) + "</div>",
    "<div class=\"key\"><span class=\"swatch\"></span> Highlighted columns count toward total touches (units)</div>",
    "<table class=\"touches\"><thead><tr><th rowspan=\"2\">User</th>",
    "<th colspan=\"3\">Receiving</th>",
    "<th colspan=\"3\">Picking</th>",
    "<th colspan=\"5\">Bin Movements</th>",
    "<th colspan=\"8\">Loads</th>",
    "<th colspan=\"5\">Sticker Scan Out</th>",
    "<th colspan=\"6\">Overall</th></tr><tr>",
    "<th class=\"contrib\">Qty In</th><th class=\"contrib\">Qty Out</th><th>Scans</th>",
    "<th class=\"contrib\">Units</th><th>Orders</th><th>Lines</th>",
    "<th class=\"contrib\">Qty</th><th>Moves</th><th>Item Qty</th><th>Dolly Qty</th><th>Merge Qty</th>",
    "<th class=\"contrib\">Units</th><th>Orders</th><th>Disp.</th><th>Avg Disp. Units</th><th>Avg Disp. Min</th><th>Skipped</th><th>Skipped %</th><th>Force Comp.</th>",
    "<th class=\"contrib\">Staged Units</th><th>Staged Orders</th><th>Packed Orders</th><th>Packed Units</th><th>Bound Orders</th>",
    "<th>Touches</th><th>Days</th><th>Per Day</th><th>%</th><th>First</th><th>Last</th>",
    "</tr></thead><tbody>"
  ]

  for u in report.users {
    let r = u.receiving
    let p = u.picking
    let m = u.movements
    let l = u.loads
    let s = u.sticker
    let mi = m.by_type["item move"] != nil ? m.by_type["item move"].qty : 0
    let md = m.by_type["dolly move"] != nil ? m.by_type["dolly move"].qty : 0
    let mm = m.by_type["merge"] != nil ? m.by_type["merge"].qty : 0
    let u_pct = fmt_num((100.0 * real(u.touches)) / real(grand), 1)

    push(parts, join([
      "<tr>",
      "<td class=\"l\">" + html_escape(u.userid) + "</td>",
      "<td class=\"contrib\">" + fmt_num(r.qty_in, 0) + "</td>",
      "<td class=\"contrib\">" + fmt_num(r.qty_out, 0) + "</td>",
      "<td>" + fmt_num(r.scans, 0) + "</td>",
      "<td class=\"contrib\">" + fmt_num(p.qty, 0) + "</td>",
      "<td>" + fmt_num(p.orders, 0) + "</td>",
      "<td>" + fmt_num(p.lines, 0) + "</td>",
      "<td class=\"contrib\">" + fmt_num(m.qty, 0) + "</td>",
      "<td>" + fmt_num(m.moves, 0) + "</td>",
      "<td>" + fmt_num(mi, 0) + "</td>",
      "<td>" + fmt_num(md, 0) + "</td>",
      "<td>" + fmt_num(mm, 0) + "</td>",
      "<td class=\"contrib\">" + fmt_num(l.scans, 0) + "</td>",
      "<td>" + fmt_num(l.orders, 0) + "</td>",
      "<td>" + fmt_num(l.dispatches, 0) + "</td>",
      "<td>" + fmt_num(l.avgdispatchunits, 1) + "</td>",
      "<td>" + fmt_num(l.avgloadtime, 1) + "</td>",
      "<td>" + fmt_num(l.manual, 0) + "</td>",
      "<td>" + fmt_num(l.manualpct, 1) + "%</td>",
      "<td>" + fmt_num(l.forced, 0) + "</td>",
      "<td class=\"contrib\">" + fmt_num(s.stagedunits, 0) + "</td>",
      "<td>" + fmt_num(s.staged, 0) + "</td>",
      "<td>" + fmt_num(s.packed, 0) + "</td>",
      "<td>" + fmt_num(s.packedunits, 0) + "</td>",
      "<td>" + fmt_num(s.binds, 0) + "</td>",
      "<td><b>" + fmt_num(u.touches, 0) + "</b></td>",
      "<td>" + fmt_num(u.active_days, 0) + "</td>",
      "<td>" + fmt_num(u.touches_per_day, 1) + "</td>",
      "<td>" + u_pct + "%</td>",
      "<td class=\"t\">" + fmt_short_date(u.first_touch) + "</td>",
      "<td class=\"t\">" + fmt_short_date(u.last_touch) + "</td>",
      "</tr>"
    ], ""))
  }

  // Grand Totals Row
  let t = report.totals
  let tr = t.receiving
  let tp = t.picking
  let tm = t.movements
  let tl = t.loads
  let ts = t.sticker
  let tmi = tm.by_type["item move"] != nil ? tm.by_type["item move"].qty : 0
  let tmd = tm.by_type["dolly move"] != nil ? tm.by_type["dolly move"].qty : 0
  let tmm = tm.by_type["merge"] != nil ? tm.by_type["merge"].qty : 0

  push(parts, join([
    "<tr class=\"total\">",
    "<td class=\"l\">All users</td>",
    "<td class=\"contrib\">" + fmt_num(tr.qty_in, 0) + "</td>",
    "<td class=\"contrib\">" + fmt_num(tr.qty_out, 0) + "</td>",
    "<td>" + fmt_num(tr.scans, 0) + "</td>",
    "<td class=\"contrib\">" + fmt_num(tp.qty, 0) + "</td>",
    "<td>" + fmt_num(tp.orders, 0) + "</td>",
    "<td>" + fmt_num(tp.lines, 0) + "</td>",
    "<td class=\"contrib\">" + fmt_num(tm.qty, 0) + "</td>",
    "<td>" + fmt_num(tm.moves, 0) + "</td>",
    "<td>" + fmt_num(tmi, 0) + "</td>",
    "<td>" + fmt_num(tmd, 0) + "</td>",
    "<td>" + fmt_num(tmm, 0) + "</td>",
    "<td class=\"contrib\">" + fmt_num(tl.scans, 0) + "</td>",
    "<td>" + fmt_num(tl.orders, 0) + "</td>",
    "<td>" + fmt_num(tl.dispatches, 0) + "</td>",
    "<td>" + fmt_num(tl.avgdispatchunits, 1) + "</td>",
    "<td>" + fmt_num(tl.avgloadtime, 1) + "</td>",
    "<td>" + fmt_num(tl.manual, 0) + "</td>",
    "<td>" + fmt_num(tl.manualpct, 1) + "%</td>",
    "<td>" + fmt_num(tl.forced, 0) + "</td>",
    "<td class=\"contrib\">" + fmt_num(ts.stagedunits, 0) + "</td>",
    "<td>" + fmt_num(ts.staged, 0) + "</td>",
    "<td>" + fmt_num(ts.packed, 0) + "</td>",
    "<td>" + fmt_num(ts.packedunits, 0) + "</td>",
    "<td>" + fmt_num(ts.binds, 0) + "</td>",
    "<td><b>" + fmt_num(t.touches, 0) + "</b></td>",
    "<td>" + fmt_num(t.active_days, 0) + "</td>",
    "<td>" + fmt_num(t.touches_per_day, 1) + "</td>",
    "<td>100.0%</td>",
    "<td class=\"t\">" + fmt_short_date(t.first_touch) + "</td>",
    "<td class=\"t\">" + fmt_short_date(t.last_touch) + "</td>",
    "</tr>"
  ], ""))

  push(parts, "</tbody></table>")
  let html = join(parts, "")

  let options = {
    "page_size": "letter",
    "orientation": "landscape",
    "margin": 18,
    "header": "Warehouse Touches " + report.start + " to " + report.stop,
    "footer": "Printed " + report.stop + "   Page {PAGENO} of {nbpg}"
  }

  return doc.pdf(html, css, options)
}

// ---- Native 31-Column OpenXML XLSX Package ----------------------------------

fn render_xlsx_report(report) {
  let rows = []
  let grand = report.totals.touches > 0 ? report.totals.touches : 1.0

  // Row 1: Title Banner
  push(rows, [
    {"v": "Warehouse Touches " + report.start + " to " + report.stop + " (highlighted columns count toward total touches)", "s": "title"}
  ])
  // Row 2: Spacer
  push(rows, [])

  // Row 3: Section Headers
  push(rows, [
    {"v": "User", "s": "section"},
    {"v": "Receiving", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"},
    {"v": "Picking", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"},
    {"v": "Bin Movements", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"},
    {"v": "Loads", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"},
    {"v": "Sticker Scan Out", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"},
    {"v": "Overall", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"}, {"v": "", "s": "section"}
  ])

  // Row 4: Column Subheaders
  push(rows, [
    {"v": "User", "s": "header"},
    {"v": "Qty In", "s": "contrib_header"}, {"v": "Qty Out", "s": "contrib_header"}, {"v": "Scan Rows", "s": "header"},
    {"v": "Units", "s": "contrib_header"}, {"v": "Orders", "s": "header"}, {"v": "Lines", "s": "header"},
    {"v": "Qty", "s": "contrib_header"}, {"v": "Moves", "s": "header"}, {"v": "Item Qty", "s": "header"}, {"v": "Dolly Qty", "s": "header"}, {"v": "Merge Qty", "s": "header"},
    {"v": "Units", "s": "contrib_header"}, {"v": "Orders", "s": "header"}, {"v": "Dispatches", "s": "header"}, {"v": "Avg Disp. Units", "s": "header"}, {"v": "Avg Disp. Min", "s": "header"}, {"v": "Skipped", "s": "header"}, {"v": "Skipped %", "s": "header"}, {"v": "Force Comp.", "s": "header"},
    {"v": "Staged Units", "s": "contrib_header"}, {"v": "Staged Orders", "s": "header"}, {"v": "Packed Orders", "s": "header"}, {"v": "Packed Units", "s": "header"}, {"v": "Bound Orders", "s": "header"},
    {"v": "Touches", "s": "header"}, {"v": "Days", "s": "header"}, {"v": "Per Day", "s": "header"}, {"v": "%", "s": "header"}, {"v": "First", "s": "header"}, {"v": "Last", "s": "header"}
  ])

  // Data rows
  for u in report.users {
    let r = u.receiving
    let p = u.picking
    let m = u.movements
    let l = u.loads
    let s = u.sticker
    let mi = m.by_type["item move"] != nil ? m.by_type["item move"].qty : 0
    let md = m.by_type["dolly move"] != nil ? m.by_type["dolly move"].qty : 0
    let mm = m.by_type["merge"] != nil ? m.by_type["merge"].qty : 0
    let u_pct = round((100.0 * real(u.touches)) / real(grand), 1)

    push(rows, [
      {"v": u.userid, "s": "plain"},
      {"v": r.qty_in, "s": "contrib_int"}, {"v": r.qty_out, "s": "contrib_int"}, {"v": r.scans, "s": "int"},
      {"v": p.qty, "s": "contrib_int"}, {"v": p.orders, "s": "int"}, {"v": p.lines, "s": "int"},
      {"v": m.qty, "s": "contrib_int"}, {"v": m.moves, "s": "int"}, {"v": mi, "s": "int"}, {"v": md, "s": "int"}, {"v": mm, "s": "int"},
      {"v": l.scans, "s": "contrib_int"}, {"v": l.orders, "s": "int"}, {"v": l.dispatches, "s": "int"}, {"v": l.avgdispatchunits, "s": "dec"}, {"v": l.avgloadtime, "s": "dec"}, {"v": l.manual, "s": "int"}, {"v": l.manualpct, "s": "dec"}, {"v": l.forced, "s": "int"},
      {"v": s.stagedunits, "s": "contrib_int"}, {"v": s.staged, "s": "int"}, {"v": s.packed, "s": "int"}, {"v": s.packedunits, "s": "int"}, {"v": s.binds, "s": "int"},
      {"v": u.touches, "s": "int"}, {"v": u.active_days, "s": "int"}, {"v": u.touches_per_day, "s": "dec"},
      {"v": u_pct, "s": "dec"},
      {"v": fmt_short_date(u.first_touch), "s": "plain"},
      {"v": fmt_short_date(u.last_touch), "s": "plain"}
    ])
  }

  // Totals Row
  let t = report.totals
  let tr = t.receiving
  let tp = t.picking
  let tm = t.movements
  let tl = t.loads
  let ts = t.sticker
  let tmi = tm.by_type["item move"] != nil ? tm.by_type["item move"].qty : 0
  let tmd = tm.by_type["dolly move"] != nil ? tm.by_type["dolly move"].qty : 0
  let tmm = tm.by_type["merge"] != nil ? tm.by_type["merge"].qty : 0

  push(rows, [
    {"v": "All users", "s": "total_text"},
    {"v": tr.qty_in, "s": "total_contrib_int"}, {"v": tr.qty_out, "s": "total_contrib_int"}, {"v": tr.scans, "s": "total_int"},
    {"v": tp.qty, "s": "total_contrib_int"}, {"v": tp.orders, "s": "total_int"}, {"v": tp.lines, "s": "total_int"},
    {"v": tm.qty, "s": "total_contrib_int"}, {"v": tm.moves, "s": "total_int"}, {"v": tmi, "s": "total_int"}, {"v": tmd, "s": "total_int"}, {"v": tmm, "s": "total_int"},
    {"v": tl.scans, "s": "total_contrib_int"}, {"v": tl.orders, "s": "total_int"}, {"v": tl.dispatches, "s": "total_int"}, {"v": tl.avgdispatchunits, "s": "total_dec"}, {"v": tl.avgloadtime, "s": "total_dec"}, {"v": tl.manual, "s": "total_int"}, {"v": tl.manualpct, "s": "total_dec"}, {"v": tl.forced, "s": "total_int"},
    {"v": ts.stagedunits, "s": "total_contrib_int"}, {"v": ts.staged, "s": "total_int"}, {"v": ts.packed, "s": "total_int"}, {"v": ts.packedunits, "s": "total_int"}, {"v": ts.binds, "s": "total_int"},
    {"v": t.touches, "s": "total_int"}, {"v": t.active_days, "s": "total_int"}, {"v": t.touches_per_day, "s": "total_dec"},
    {"v": 100.0, "s": "total_dec"},
    {"v": fmt_short_date(t.first_touch), "s": "total_text"},
    {"v": fmt_short_date(t.last_touch), "s": "total_text"}
  ])

  let spec = {
    "sheet": "Touches",
    "freeze_pane": "B5",
    "merges": [
      "A1:AE1",
      "A3:A4",
      "B3:D3",
      "E3:G3",
      "H3:L3",
      "M3:T3",
      "U3:Y3",
      "Z3:AE3"
    ],
    "col_widths": [
      16.0,
      10.0, 10.0, 10.0,
      10.0, 10.0, 10.0,
      10.0, 10.0, 10.0, 10.0, 10.0,
      10.0, 10.0, 10.0, 12.0, 12.0, 10.0, 10.0, 10.0,
      11.0, 11.0, 11.0, 11.0, 11.0,
      11.0, 9.0, 10.0, 8.0, 12.0, 12.0
    ],
    "rows": rows
  }

  return doc.xlsx(spec)
}

// ---- Native 31-Column CSV Export --------------------------------------------

fn render_csv_report(report) {
  let cols = [
    "User", "Name",
    "Rec Qty In", "Rec Qty Out", "Rec Scans",
    "Pick Units", "Pick Orders", "Pick Lines",
    "Move Qty", "Move Count", "Item Move Qty", "Dolly Move Qty", "Merge Qty",
    "Load Units", "Load Orders", "Dispatches", "Avg Units/Disp", "Avg Load Min", "Skipped Scans", "Skipped Pct", "Force Comp",
    "Staged Units", "Staged Orders", "Packed Orders", "Packed Units", "Bound Orders",
    "Total Touches", "Active Days", "Touches/Day", "Pct of Total", "First Touch", "Last Touch"
  ]

  let grand = report.totals.touches > 0 ? report.totals.touches : 1.0
  let rows = []

  for u in report.users {
    let r = u.receiving
    let p = u.picking
    let m = u.movements
    let l = u.loads
    let s = u.sticker
    let mi = m.by_type["item move"] != nil ? m.by_type["item move"].qty : 0
    let md = m.by_type["dolly move"] != nil ? m.by_type["dolly move"].qty : 0
    let mm = m.by_type["merge"] != nil ? m.by_type["merge"].qty : 0
    let u_pct = round((100.0 * real(u.touches)) / real(grand), 1)

    let u_name = u.name != nil and u.name != "" ? u.name : (u.realname != nil and u.realname != "" ? u.realname : u.userid)

    push(rows, [
      u.userid, u_name,
      r.qty_in, r.qty_out, r.scans,
      p.qty, p.orders, p.lines,
      m.qty, m.moves, mi, md, mm,
      l.scans, l.orders, l.dispatches, l.avgdispatchunits, l.avgloadtime, l.manual, l.manualpct, l.forced,
      s.stagedunits, s.staged, s.packed, s.packedunits, s.binds,
      u.touches, u.active_days, u.touches_per_day, u_pct,
      fmt_short_date(u.first_touch), fmt_short_date(u.last_touch)
    ])
  }

  let t = report.totals
  let tr = t.receiving
  let tp = t.picking
  let tm = t.movements
  let tl = t.loads
  let ts = t.sticker
  let tmi = tm.by_type["item move"] != nil ? tm.by_type["item move"].qty : 0
  let tmd = tm.by_type["dolly move"] != nil ? tm.by_type["dolly move"].qty : 0
  let tmm = tm.by_type["merge"] != nil ? tm.by_type["merge"].qty : 0

  push(rows, [
    "ALL USERS", "All Warehouse Operators",
    tr.qty_in, tr.qty_out, tr.scans,
    tp.qty, tp.orders, tp.lines,
    tm.qty, tm.moves, tmi, tmd, tmm,
    tl.scans, tl.orders, tl.dispatches, tl.avgdispatchunits, tl.avgloadtime, tl.manual, tl.manualpct, tl.forced,
    ts.stagedunits, ts.staged, ts.packed, ts.packedunits, ts.binds,
    t.touches, t.active_days, t.touches_per_day, 100.0,
    fmt_short_date(t.first_touch), fmt_short_date(t.last_touch)
  ])

  return doc.csv(cols, rows)
}

// ---- Responsive Operator Dashboard View --------------------------------------

// The page: the same page as apir/warehouse/touches/quickreportview in the PHP report (catalog/controller/apir/
// warehouse/touches.php) - its markup, styles and sort - with the figures kept live: /quickreportevents pushes a new
// <div id="live"> whenever a day of the range changes (WAIT THING on touch_day), and the page swaps it in.

// The five sources that make up touches, in column order: key, label, colour variable.
let SOURCES = [["receiving", "Receiving", "--rec"], ["picking", "Picking", "--pick"], ["movements", "Bin moves", "--move"],
               ["loads", "Loads", "--load"], ["sticker", "Sticker scan out", "--stick"]]
let UNITS_TAG = "<span style=\"font-style: italic; font-size: 10px\">&nbsp;units</span>"

fn n0(v) { return fmt_num(v == nil ? 0 : v, 0) }
fn n1(v) { return fmt_num(v == nil ? 0 : v, 1) }
fn dot(var) { return "<i class=\"dot\" style=\"background:var(" + var + ")\"></i>" }
// the number that counts toward touches
fn main_num(var, value) { return "<b class=\"c\" style=\"--c:var(" + var + ")\">" + n0(value) + UNITS_TAG + "</b>" }
fn small(text) { return "<small>" + text + "</small>" }

// 'Oct 27, 2026', as PHP's date('M j, Y')
fn fmt_day(d) {
  let s = str(d)
  if len(s) < 10 { return s }
  let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
  let m = int(slice(s, 5, 7)) - 1
  return (m >= 0 and m < 12 ? months[m] : slice(s, 5, 7)) + " " + str(int(slice(s, 8, 10))) + ", " + slice(s, 0, 4)
}

// The line under the title: the range.
fn render_badge(report) { return html_escape(fmt_day(report.start) + " – " + fmt_day(report.stop)) }

// the counted part of each source for a user (or the totals)
fn source_parts(u) {
  return {"receiving": u.receiving.qty_in + u.receiving.qty_out, "picking": u.picking.qty, "movements": u.movements.qty,
          "loads": u.loads.scans, "sticker": u.sticker.stagedunits}
}

// the context lines under each counted number, for a user row and for the totals row
fn source_cells(u) {
  let l = u.loads
  let st = u.sticker
  let rec_extra = u.receiving.qty_out > 0 ? " &middot; " + n0(u.receiving.qty_in) + " in / " + n0(u.receiving.qty_out) + " out" : ""
  return {
    "receiving": small(n0(u.receiving.scans) + " scan rows" + rec_extra),
    "picking": small(n0(u.picking.orders) + " orders &middot; " + n0(u.picking.lines) + " lines"),
    "movements": small(n0(u.movements.moves) + " moves"),
    "loads": small(n0(l.dispatches) + " disp &middot; avg " + n1(l.avgloadtime) + " min &middot; avg " + n1(l.avgdispatchunits) + " units") +
             small(n1(l.manualpct) + "% skipped (" + n0(l.manual) + ") &middot; " + n0(l.forced) + " force completed"),
    "sticker": small(n0(st.staged) + " staged orders") +
               small("packed " + n0(st.packed) + " ord &middot; " + n0(st.packedunits) + " units &middot; " + n0(st.binds) + " bound")
  }
}

// What changes with the data: the cards, the note and the "By person" panel.
fn render_live(report) {
  let t = report.totals
  let pt = source_parts(t)
  let card = fn(src, value, sub) {
    return "<div class=\"card\"><div class=\"label\">" + dot(src[2]) + html_escape(src[1]) + "</div><div class=\"value\">" + value +
           "</div><div class=\"sub\">" + sub + "</div></div>"
  }
  let out = []
  push(out, "<div class=\"cards\">")
  push(out, "<div class=\"card total\"><div class=\"label\">Total touches</div><div class=\"value\">" + n0(t.touches) +
            "</div><div class=\"sub\">units &middot; " + n0(len(report.users)) + " people &middot; " + n0(t.active_days) + " active days</div></div>")
  push(out, card(SOURCES[0], n0(pt.receiving) + UNITS_TAG, n0(t.receiving.qty_in) + " in / " + n0(t.receiving.qty_out) + " out &middot; " +
                 n0(t.receiving.scans) + " scan rows &middot; under " + n0(t.receiving.vendors) + " vendors"))
  push(out, card(SOURCES[1], n0(pt.picking) + UNITS_TAG, n0(t.picking.orders) + " orders &middot; " + n0(t.picking.lines) + " lines"))
  push(out, card(SOURCES[2], n0(pt.movements) + UNITS_TAG, n0(t.movements.moves) + " moves"))
  push(out, card(SOURCES[3], n0(pt.loads) + UNITS_TAG, n0(t.loads.dispatches) + " dispatches &middot; " + n1(t.loads.manualpct) + "% skipped (" + n0(t.loads.manual) + ")"))
  push(out, card(SOURCES[4], n0(pt.sticker) + UNITS_TAG, n0(t.sticker.staged) + " staged orders &middot; " + n0(t.sticker.stagedunits) + " units staged"))
  push(out, "</div>")
  push(out, "<p class=\"note\">Touches are units. The bold colored number in each column is what counts toward touches: units received (in + out), units picked, units moved and units staged. The lines under it are context only.</p>")

  let nil_cell = "<span class=\"nil\">&ndash;</span>"
  let top = 1.0
  for u in report.users { if real(u.touches) > top { top = real(u.touches) } }
  let rows = []
  let rank = 0
  for u in report.users {
    rank += 1
    let p = source_parts(u)
    let sub = source_cells(u)
    let name = u.name != nil and u.name != "" ? u.name : u.userid
    let title = []
    let bar = ""
    for src in SOURCES {
      push(title, src[1] + " " + n0(p[src[0]]))
      bar = bar + "<span style=\"background:var(" + src[2] + ");width:" + str(round(100.0 * real(p[src[0]]) / top, 2)) + "%\"></span>"
    }
    let row = "<tr><td class=\"rank\" data-v=\"" + str(rank) + "\">" + str(rank) + "</td>" +
              "<td class=\"who\" data-v=\"" + html_escape(lower(name)) + "\"><b>" + html_escape(name) + "</b><small>" + html_escape(u.userid) + "</small></td>" +
              "<td data-v=\"" + str(u.touches) + "\"><b>" + n0(u.touches) + "</b><div class=\"bar\" title=\"" + html_escape(join(title, " / ")) + "\">" + bar + "</div></td>"
    for src in SOURCES {
      let v = p[src[0]]
      row = row + "<td data-v=\"" + str(v) + "\">" + (v > 0 ? main_num(src[2], v) + sub[src[0]] : nil_cell) + "</td>"
    }
    row = row + "<td data-v=\"" + str(u.active_days) + "\">" + n0(u.active_days) + "</td>" +
          "<td data-v=\"" + str(u.touches_per_day) + "\">" + n1(u.touches_per_day) + "</td>" +
          "<td class=\"when\" data-v=\"" + html_escape(u.first_touch) + "\">" + html_escape(fmt_time(u.first_touch)) + "<small>to " + html_escape(fmt_time(u.last_touch)) + "</small></td></tr>"
    push(rows, row)
  }
  if len(rows) == 0 { push(rows, "<tr><td colspan=\"11\" class=\"empty\">No warehouse activity in this range.</td></tr>") }

  let headrow = "<th class=\"l\" data-col=\"0\">#</th><th class=\"l\" data-col=\"1\">Person</th><th data-col=\"2\" data-dir=\"desc\">Touches</th>"
  let foot = "<td></td><td class=\"who\">All users</td><td>" + n0(t.touches) + "</td>"
  let tsub = source_cells(t)
  let col = 3
  let legend = ""
  for src in SOURCES {
    headrow = headrow + "<th class=\"contrib\" style=\"--c:var(" + src[2] + ")\" data-col=\"" + str(col) + "\" title=\"Counts toward touches\">" + html_escape(src[1]) + "</th>"
    foot = foot + "<td>" + main_num(src[2], pt[src[0]]) + tsub[src[0]] + "</td>"
    legend = legend + "<span>" + dot(src[2]) + html_escape(src[1]) + "</span>"
    col += 1
  }
  headrow = headrow + "<th data-col=\"8\">Days</th><th data-col=\"9\">Per day</th><th data-col=\"10\">First / last</th>"
  foot = foot + "<td>" + n0(t.active_days) + "</td><td>" + n1(t.touches_per_day) + "</td><td class=\"when\">" + html_escape(fmt_time(t.first_touch)) +
         "<small>to " + html_escape(fmt_time(t.last_touch)) + "</small></td>"

  push(out, "<div class=\"panel\"><div class=\"panel-head\"><h2>By person</h2><div class=\"legend\">" + legend + "</div></div>" +
            "<div class=\"scroll\"><table><thead><tr>" + headrow + "</tr></thead><tbody>" + join(rows, "") + "</tbody><tfoot><tr>" + foot +
            "</tr></tfoot></table></div></div>")
  return join(out, "")
}

let PAGE_CSS = join([
  ":root { --bg: #f5f6f8; --panel: #ffffff; --line: #e3e6ea; --text: #1d2228; --muted: #6b7480; --rec: #2f7de1; --pick: #e8912d; --move: #3aa776; --load: #8a63d2; --stick: #d6477f; --head: #fafbfc; }",
  "@media (prefers-color-scheme: dark) { :root { --bg: #111418; --panel: #1a1f25; --line: #2b323a; --text: #e8ebee; --muted: #98a2ad; --head: #20262d; } }",
  "* { box-sizing: border-box; }",
  "body { margin: 0; background: var(--bg); color: var(--text); font: 14px/1.4 -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif; }",
  ".page { max-width: 1400px; margin: 0 auto; padding: 24px 16px 40px; }",
  "header { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 20px; }",
  "h1 { margin: 0; font-size: 22px; } .range { color: var(--muted); margin-top: 4px; }",
  "form { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }",
  "form label { color: var(--muted); font-size: 12px; }",
  "input[type=date] { padding: 6px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--panel); color: var(--text); font: inherit; }",
  ".btn { padding: 7px 14px; border-radius: 6px; border: 1px solid var(--line); background: var(--panel); color: var(--text); font: inherit; text-decoration: none; cursor: pointer; }",
  ".btn.primary { background: var(--rec); border-color: var(--rec); color: #ffffff; }",
  ".cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 8px; }",
  ".card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }",
  ".card.total { border-width: 2px; }",
  ".card .label { color: var(--muted); font-size: 13px; } .card .value { font-size: 28px; font-weight: 600; margin: 2px 0; } .card .sub { color: var(--muted); font-size: 12px; }",
  ".note { color: var(--muted); font-size: 12px; margin: 0 0 20px; }",
  ".dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; vertical-align: 0; }",
  ".panel { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }",
  ".panel-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; padding: 12px 16px; border-bottom: 1px solid var(--line); }",
  ".panel-head h2 { margin: 0; font-size: 15px; }",
  ".legend { display: flex; flex-wrap: wrap; gap: 14px; color: var(--muted); font-size: 12px; }",
  ".scroll { overflow-x: auto; }",
  "table { width: 100%; border-collapse: collapse; min-width: 1150px; }",
  "th { background: var(--head); color: var(--muted); font-size: 12px; font-weight: 600; text-align: right; padding: 9px 12px; border-bottom: 1px solid var(--line); cursor: pointer; user-select: none; white-space: nowrap; }",
  "th.contrib { color: var(--text); border-top: 3px solid var(--c); }",
  "th.l, td.who, td.rank { text-align: left; } th[data-dir=asc]::after { content: \" \\25B2\"; } th[data-dir=desc]::after { content: \" \\25BC\"; }",
  "td { text-align: right; padding: 9px 12px; border-bottom: 1px solid var(--line); vertical-align: top; white-space: nowrap; }",
  "td small { display: block; color: var(--muted); font-size: 11px; }",
  "td.rank { color: var(--muted); width: 36px; } td.when { font-size: 12px; }",
  ".c { color: var(--c); } .c::before { content: \"\"; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--c); margin-right: 5px; }",
  ".bar { display: flex; height: 6px; margin-top: 5px; border-radius: 3px; overflow: hidden; background: var(--line); min-width: 140px; }",
  ".bar span { display: block; height: 100%; }",
  "tfoot td { font-weight: 600; background: var(--head); border-bottom: 0; }",
  ".nil { color: var(--muted); }",
  "td.empty { text-align: center; color: var(--muted); padding: 30px; }",
  "#live.pulse .card.total { animation: pulse 1.2s ease-out; }",
  "@keyframes pulse { from { border-color: var(--rec); } to { border-color: var(--line); } }",
  "@media print { body { background: #ffffff; } form, .btn { display: none; } .card, .panel { break-inside: avoid; } }"
], chr(10))

// The PHP page's table sort, bound again after each pushed update (the sort kept), and the event stream.
let PAGE_JS = join([
  "var sortCol = null, sortDir = null;",
  "function sortBy(th, dir) {",
  "    var col = +th.dataset.col;",
  "    document.querySelectorAll('th[data-col]').forEach(function (h) { h.removeAttribute('data-dir'); });",
  "    th.dataset.dir = dir;",
  "    var body = th.closest('table').tBodies[0], rows = Array.prototype.slice.call(body.rows);",
  "    rows.sort(function (a, b) {",
  "        var x = a.cells[col].dataset.v, y = b.cells[col].dataset.v, nx = parseFloat(x), ny = parseFloat(y);",
  "        var c = (!isNaN(nx) && !isNaN(ny)) ? nx - ny : String(x).localeCompare(String(y));",
  "        return dir === 'asc' ? c : -c;",
  "    });",
  "    rows.forEach(function (r) { body.appendChild(r); });",
  "}",
  "function bindSort() {",
  "    document.querySelectorAll('th[data-col]').forEach(function (th) {",
  "        th.addEventListener('click', function () {",
  "            sortCol = th.dataset.col; sortDir = th.dataset.dir === 'desc' ? 'asc' : 'desc';",
  "            sortBy(th, sortDir);",
  "        });",
  "    });",
  "    if (sortCol !== null) { var th = document.querySelector('th[data-col=\"' + sortCol + '\"]'); if (th) sortBy(th, sortDir); }",
  "}",
  "bindSort();",
  "if (window.EventSource) {",
  "    var es = new EventSource('/quickreportevents' + location.search);",
  "    es.addEventListener('report', function (m) {",
  "        try {",
  "            var d = JSON.parse(m.data), live = document.getElementById('live');",
  "            live.innerHTML = d.live;",
  "            document.getElementById('range').innerHTML = d.badge;",
  "            bindSort();",
  "            live.classList.remove('pulse'); void live.offsetWidth; live.classList.add('pulse');",
  "        } catch (e) {}",
  "    });",
  "}"
], chr(10))

fn render_html_dashboard(report, input) {
  let q = "?start=" + html_escape(report.start) + "&amp;stop=" + html_escape(report.stop)
  return join([
    "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
    "<title>Warehouse Activity " + html_escape(report.start) + " to " + html_escape(report.stop) + "</title><style>" + PAGE_CSS + "</style></head><body><div class=\"page\">",
    "<header>",
    "<div><h1>Warehouse Activity</h1><div class=\"range\" id=\"range\">" + render_badge(report) + "</div></div>",
    "<form method=\"get\" action=\"/quickreportview\">",
    "<label>From</label><input type=\"date\" name=\"start\" value=\"" + html_escape(report.start) + "\">",
    "<label>To</label><input type=\"date\" name=\"stop\" value=\"" + html_escape(report.stop) + "\">",
    "<button type=\"submit\" class=\"btn primary\">Run</button>",
    "<a class=\"btn\" href=\"/quickreportpdf" + q + "\">Export PDF</a>",
    "<a class=\"btn\" href=\"/quickreportxlsx" + q + "\">Export Excel</a>",
    "</form>",
    "</header>",
    "<div id=\"live\">" + render_live(report) + "</div>",
    "</div>",
    "<script>" + PAGE_JS + "</script></body></html>"
  ], "")
}
