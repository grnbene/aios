// Warehouse Touches views: the page, its live part, and the PDF, XLSX and CSV exports.
//
// The page and the PDF follow catalog/controller/apir/warehouse/touches.php (quickreportview, quickReportHtml,
// quickReportCss). Markup is built as nodes (el, html_stringify), so every value is escaped in one place.

let MID = " \u{b7} "        // the PHP page's " &middot; "
let NBSP = "\u{a0}"

fn n0(v) { return number_format(v, 0) }
fn n1(v) { return number_format(v, 1) }

// '2026-10-27 08:20:11' as 'Oct 27 8:20am'; text that is not a date (0000-00-00) as it is
fn when(ts) {
  let s = str(ts ?? "")
  return date_parse(s, {"or": nil}) == nil ? s : date_format(s, "%b %-d %-I:%M%P")
}

// '2026-10-27' as 'Oct 27, 2026', as PHP's date('M j, Y')
fn day_text(d) {
  let s = str(d ?? "")
  return date_parse(s, {"or": nil}) == nil ? s : date_format(s, "%b %-d, %Y")
}


// ---- The exports: the PDF, the Excel and the CSV --------------------------------------------------------------
//
// One page: Summary (the page's cards), By Month and By Person - every figure a touch count, each row's areas adding
// up to its Total and each Total row the cards' figures. The Excel adds Person by Month and Detail by Person.

// The five areas a touch comes from, in column order: [source key, name].
let AREAS = [["receiving", "Receiving"], ["picking", "Picking"], ["movements", "Bin Moves"], ["loads", "Loads"], ["sticker", "Sticker Scan Out"]]

// "Sep 29 – Oct 28, 2026 · All hours" / "· 7:00am – 11:59am"
fn filter_text(report) {
  let a = report.start
  let b = report.stop
  let days = a == b ? date_format(a, "%b %-d, %Y")
                    : date_format(a, slice(a, 0, 4) == slice(b, 0, 4) ? "%b %-d" : "%b %-d, %Y") + " \u{2013} " + date_format(b, "%b %-d, %Y")
  return days + MID + (report.hours == nil ? "All hours" : span_label(report.hours))
}
fn as_of_text(report) { return "As of " + date_format(report.as_of, "%b %-d, %Y %-I:%M %p") }

// "Oct 2026", or "Sep 2026 (29–30)" for a month the range covers only part of.
fn month_text(m) {
  let first = slice(m.from, 0, 8) + "01"
  let whole = m.from == first and day_add(m.to, 1) == date_format(day_add(first, 32), "%Y-%m") + "-01"
  let name = date_format(m.from, "%b %Y")
  return whole ? name : name + " (" + date_format(m.from, "%-d") + "\u{2013}" + date_format(m.to, "%-d") + ")"
}

// The cards (the page's and the Summary's): area, touches, detail, last touch. rep: a report.
fn card_lines(rep) {
  let t = rep.totals
  let pt = source_parts(t)
  let lasts = rep.lasts ?? {}
  let last = fn(src) {
    let at = src != nil ? lasts[src] : (len(lasts) == 0 ? nil : max(values(lasts)))
    return at == nil ? "" : when(at)
  }
  let l = t.loads
  return [
    {"key": nil, "label": "Total", "touches": t.touches,
     "detail": n0(len(rep.users)) + " people" + MID + n0(t.active_days) + " active days", "last": last(nil)},
    {"key": "receiving", "label": "Receiving", "touches": pt.receiving,
     "detail": n0(t.receiving.qty_in) + " in / " + n0(t.receiving.qty_out) + " out" + MID + n0(t.receiving.scans) + " scans" + MID +
               n0(t.receiving.vendors) + " vendors", "last": last("receiving")},
    {"key": "picking", "label": "Picking", "touches": pt.picking,
     "detail": n0(t.picking.orders) + " orders" + MID + n0(t.picking.lines) + " lines", "last": last("picking")},
    {"key": "movements", "label": "Bin Moves", "touches": pt.movements, "detail": n0(t.movements.moves) + " moves", "last": last("movements")},
    {"key": "loads", "label": "Loads", "touches": pt.loads,
     "detail": n0(l.dispatches) + " dispatches" + MID + n0(l.pickuporders) + " pickups (" + n0(l.pickupunits) + " units)" + MID +
               (l.clearedorders > 0 ? n0(l.clearedorders) + " cleared from run (" + n0(l.clearedunits) + " units)" + MID : "") +
               n1(l.manualpct) + "% skipped", "last": last("loads")},
    {"key": "sticker", "label": "Sticker Scan Out", "touches": pt.sticker, "detail": n0(t.sticker.staged) + " orders staged", "last": last("sticker")}
  ]
}

// A row's figures, as the By Month and By Person tables show them: Total, each area, Days, Per Day.
fn touch_figures(rec) {
  let p = source_parts(rec)
  return concat([rec.touches], map(AREAS, fn(a) { return p[a[0]] }), [rec.active_days, rec.touches_per_day])
}
let FIGURE_HEADS = concat(["Total"], map(AREAS, fn(a) { return a[1] }), ["Days", "Per Day"])

// "–" for nothing, as the PDF prints a count
fn count_text(v) { return v == nil or real(v) == 0.0 ? "\u{2013}" : n0(v) }

// The Detail by Person columns, by area: [area, header, value of a user (or the totals), format, counts toward Total
// Touches]. Each area's Touches column is what it adds to Total Touches; the columns after it are the work behind it.
fn detail_cols() {
  let part = fn(k) { return fn(u) { return source_parts(u)[k] } }
  return [
    ["Total", "Total Touches", fn(u) { return u.touches }, "int", true],
    ["Receiving", "Touches", part("receiving"), "int", true],
    ["Receiving", "In", fn(u) { return u.receiving.qty_in }, "int", false],
    ["Receiving", "Out", fn(u) { return u.receiving.qty_out }, "int", false],
    ["Receiving", "Scans", fn(u) { return u.receiving.scans }, "int", false],
    ["Receiving", "Vendors", fn(u) { return u.receiving.vendors }, "int", false],
    ["Picking", "Touches", part("picking"), "int", true],
    ["Picking", "Orders", fn(u) { return u.picking.orders }, "int", false],
    ["Picking", "Lines", fn(u) { return u.picking.lines }, "int", false],
    ["Bin Moves", "Touches", part("movements"), "int", true],
    ["Bin Moves", "Moves", fn(u) { return u.movements.moves }, "int", false],
    ["Loads", "Touches", part("loads"), "int", true],
    ["Loads", "Dispatches", fn(u) { return u.loads.dispatches }, "int", false],
    ["Loads", "Units per Dispatch", fn(u) { return u.loads.avgdispatchunits }, "dec", false],
    ["Loads", "Minutes per Dispatch", fn(u) { return u.loads.avgloadtime }, "dec", false],
    ["Loads", "Skipped Scans", fn(u) { return u.loads.manual }, "int", false],
    ["Loads", "Skipped %", fn(u) { return u.loads.manualpct }, "dec", false],
    ["Loads", "Force Completed", fn(u) { return u.loads.forced }, "int", false],
    ["Loads", "Pickup Orders", fn(u) { return u.loads.pickuporders }, "int", false],
    ["Loads", "Pickup Units", fn(u) { return u.loads.pickupunits }, "int", false],
    ["Loads", "Cleared Orders", fn(u) { return u.loads.clearedorders }, "int", false],
    ["Loads", "Cleared Units", fn(u) { return u.loads.clearedunits }, "int", false],
    ["Sticker Scan Out", "Touches", part("sticker"), "int", true],
    ["Sticker Scan Out", "Orders Staged", fn(u) { return u.sticker.staged }, "int", false],
    ["Sticker Scan Out", "Orders Packed", fn(u) { return u.sticker.packed }, "int", false],
    ["Sticker Scan Out", "Units Packed", fn(u) { return u.sticker.packedunits }, "int", false],
    ["Sticker Scan Out", "Bound Orders", fn(u) { return u.sticker.binds }, "int", false],
    ["Time", "First Touch", fn(u) { return when(u.first_touch) }, "text", false],
    ["Time", "Last Touch", fn(u) { return when(u.last_touch) }, "text", false]
  ]
}

fn person_name(u) { return first_present(u.name, u.userid) }

// ---- PDF ----------------------------------------------------------------------------------------------------

fn render_pdf_report(report) {
  let css = join([
    "body { font-family: Helvetica; color: #1d2228; }",
    "h1 { font-size: 17pt; margin: 0 0 1mm 0; }",
    "div.range { font-size: 10pt; color: #1d2228; margin-bottom: 0.5mm; }",
    "div.asof { font-size: 8pt; color: #6b7480; margin-bottom: 3mm; }",
    "h2 { font-size: 9pt; text-transform: uppercase; letter-spacing: 0.6pt; color: #1e3a5f; margin: 5mm 0 1.5mm 0; padding-bottom: 0.8mm; border-bottom: 0.4mm solid #1e3a5f; }",
    "table { border-collapse: collapse; width: 100%; font-size: 8pt; }",
    "th { background-color: #eef1f5; color: #1d2228; font-weight: bold; padding: 1.4mm 2mm; text-align: right; border-bottom: 0.3mm solid #1e3a5f; }",
    "td { padding: 1.1mm 2mm; text-align: right; border-bottom: 0.15mm solid #dde1e7; }",
    "th.l, td.l { text-align: left; }",
    "td.rank { color: #6b7480; width: 6mm; }",
    "td.muted { color: #6b7480; }",
    "tr.alt td { background-color: #f7f8fa; }",
    "tr.total td { font-weight: bold; background-color: #eef1f5; border-top: 0.3mm solid #1e3a5f; border-bottom: 0.3mm solid #1e3a5f; }"
  ], " ")
  let head = fn(cells) { return el("tr", map(cells, fn(c) { return el("th", {"class": c[1] ? "l" : nil}, c[0]) })) }
  let figure_cells = fn(rec) {
    let f = touch_figures(rec)
    return map(enumerate(f), fn(pair) { return el("td", pair[0] == len(f) - 1 ? n1(pair[1]) : count_text(pair[1])) })
  }
  let alt = fn(i) { return i % 2 == 1 ? "alt" : nil }
  let lines = card_lines(report)
  let summary = el("table",
    head([["Area", true], ["Touches", false], ["Detail", true], ["Last Touch", true]]),
    map(enumerate(filter(lines, fn(x) { return x.key != nil })), fn(pair) {
      let line = pair[1]
      return el("tr", {"class": alt(pair[0])}, el("td", {"class": "l"}, line.label), el("td", n0(line.touches)),
                el("td", {"class": "l"}, line.detail), el("td", {"class": "l muted"}, line.last))
    }),
    map(filter(lines, fn(x) { return x.key == nil }), fn(line) {
      return el("tr", {"class": "total"}, el("td", {"class": "l"}, "Total"), el("td", n0(line.touches)),
                el("td", {"class": "l"}, line.detail), el("td", {"class": "l"}, line.last))
    }))
  let months = el("table",
    head(concat([["Month", true]], map(FIGURE_HEADS, fn(h) { return [h, false] }))),
    map(enumerate(report.months), fn(pair) { return el("tr", {"class": alt(pair[0])}, el("td", {"class": "l"}, month_text(pair[1])), figure_cells(pair[1].totals)) }),
    el("tr", {"class": "total"}, el("td", {"class": "l"}, "Total"), figure_cells(report.totals)))
  let people = el("table",
    head(concat([["#", true], ["Name", true]], map(FIGURE_HEADS, fn(h) { return [h, false] }))),
    map(enumerate(report.users), fn(pair) {
      let u = pair[1]
      return el("tr", {"class": alt(pair[0])}, el("td", {"class": "l rank"}, str(u.rank)), el("td", {"class": "l"}, person_name(u)), figure_cells(u))
    }),
    el("tr", {"class": "total"}, el("td"), el("td", {"class": "l"}, "Total"), figure_cells(report.totals)))
  let page = [el("h1", "Warehouse Touches"), el("div", {"class": "range"}, filter_text(report)), el("div", {"class": "asof"}, as_of_text(report)),
              el("h2", "Summary"), summary, el("h2", "By Month"), months, el("h2", "By Person"), people]
  // Letter landscape, margins in mm, as points
  let mm = fn(v) { return int(v * 72.0 / 25.4 + 0.5) }
  return doc.pdf(html_stringify(page), css, {
    "page_size": "letter", "orientation": "landscape",
    "margin_left": mm(12), "margin_right": mm(12), "margin_top": mm(16), "margin_bottom": mm(18),
    "header": "Warehouse Touches" + MID + filter_text(report),
    "footer": "Printed " + date_format(now(), "%b %-d, %Y %-I:%M %p") + "   Page {PAGENO} of {nbpg}"
  })
}

// ---- XLSX ---------------------------------------------------------------------------------------------------

// A whole-number cell ("–" for zero, still a number), a decimal or text; bold on a Total row.
fn xcount(v, total) { return {"v": v ?? 0, "s": total ? "total_count" : "count"} }
fn xdec(v, total) { return {"v": round(real(v ?? 0), 1), "s": total ? "total_dec" : "dec"} }
fn xtext(v, total) { return {"v": v ?? "", "s": total ? "total_text" : "plain"} }
fn xhead(v) { return {"v": v, "s": "header"} }

// Report: the PDF's page - Summary, By Month, By Person - in columns A (#), B (name), C (Total), D-H (areas),
// I (Days), J (Per Day).
fn xlsx_report(report) {
  let rows = [[{"v": "Warehouse Touches", "s": "title"}], [{"v": filter_text(report), "s": "bold"}], [{"v": as_of_text(report), "s": "note"}], []]
  let merges = []
  let figures = fn(rec, total) {
    let f = touch_figures(rec)
    return map(enumerate(f), fn(pair) { return pair[0] == len(f) - 1 ? xdec(pair[1], total) : xcount(pair[1], total) })
  }
  let heads = map(FIGURE_HEADS, fn(h) { return xhead(h) })

  push(rows, [{"v": "Summary", "s": "bold"}])
  push(rows, [xhead(""), xhead("Area"), xhead("Touches"), xhead("Detail"), xhead(""), xhead(""), xhead(""), xhead(""), xhead("Last Touch"), xhead("")])
  push(merges, [len(rows), 4, len(rows), 8])
  push(merges, [len(rows), 9, len(rows), 10])
  for line in card_lines(report) {
    let total = line.key == nil
    push(rows, [xtext("", total), xtext(line.label, total), xcount(line.touches, total), xtext(line.detail, total), xtext("", total), xtext("", total),
                xtext("", total), xtext("", total), xtext(line.last, total), xtext("", total)])
    push(merges, [len(rows), 4, len(rows), 8])
    push(merges, [len(rows), 9, len(rows), 10])
  }
  push(rows, [])

  push(rows, [{"v": "By Month", "s": "bold"}])
  push(rows, concat([xhead(""), xhead("Month")], heads))
  for m in report.months { push(rows, concat([xtext("", false), xtext(month_text(m), false)], figures(m.totals, false))) }
  push(rows, concat([xtext("", true), xtext("Total", true)], figures(report.totals, true)))
  push(rows, [])

  push(rows, [{"v": "By Person", "s": "bold"}])
  push(rows, concat([xhead("#"), xhead("Name")], heads))
  for u in report.users { push(rows, concat([xcount(u.rank, false), xtext(person_name(u), false)], figures(u, false))) }
  push(rows, concat([xtext("", true), xtext("Total", true)], figures(report.totals, true)))
  return {"sheet": "Report", "rows": rows, "merges": merges,
          "col_widths": [5.0, 24.0, 11.0, 11.0, 11.0, 11.0, 11.0, 15.0, 11.0, 11.0]}
}

// Person by Month: each person's touches in each month, and over the range.
fn xlsx_person_by_month(report) {
  let rows = [[{"v": "Warehouse Touches \u{2013} Person by Month", "s": "title"}], [{"v": filter_text(report), "s": "bold"}],
              [{"v": as_of_text(report), "s": "note"}], []]
  let by_month = map(report.months, fn(m) {
    let of = {}
    for u in m.users { of[lower(u.userid)] = u.touches }
    return of
  })
  push(rows, concat([xhead("#"), xhead("Name")], map(report.months, fn(m) { return xhead(month_text(m)) }), [xhead("Total")]))
  for u in report.users {
    push(rows, concat([xcount(u.rank, false), xtext(person_name(u), false)],
                      map(by_month, fn(of) { return xcount(of[lower(u.userid)] ?? 0, false) }), [xcount(u.touches, false)]))
  }
  push(rows, concat([xtext("", true), xtext("Total", true)], map(report.months, fn(m) { return xcount(m.totals.touches, true) }),
                    [xcount(report.totals.touches, true)]))
  return {"sheet": "Person by Month", "rows": rows, "freeze_pane": "C6",
          "col_widths": concat([5.0, 24.0], map(range(0, len(report.months) + 1), fn(i) { return 16.0 }))}
}

// Detail by Person: the activity behind each person's touches, grouped by area.
fn xlsx_detail(report) {
  let cols = detail_cols()
  let rows = [[{"v": "Warehouse Touches \u{2013} Detail by Person", "s": "title"}], [{"v": filter_text(report), "s": "bold"}],
              [{"v": as_of_text(report), "s": "note"}], [{"v": "Highlighted columns count toward Total Touches.", "s": "note"}], []]
  let band_at = len(rows) + 1
  let band = [{"v": "", "s": "section"}]
  let heads = [xhead("Name")]
  let merges = []
  for pair in enumerate(cols) {
    let c = pair[1]
    let starts = pair[0] == 0 or c[0] != cols[pair[0] - 1][0]
    push(band, {"v": starts ? c[0] : "", "s": starts ? "section_edge" : "section"})
    push(heads, {"v": c[1], "s": (c[4] ? "contrib_header" : "header") + (starts ? "_edge" : "")})
    let n = len(filter(cols, fn(x) { return x[0] == c[0] }))
    if starts and n > 1 { push(merges, [band_at, pair[0] + 2, band_at, pair[0] + 1 + n]) }
  }
  push(rows, band)
  push(rows, heads)
  let line = fn(u, name, total) {
    let cells = [xtext(name, total)]
    for pair in enumerate(cols) {
      let c = pair[1]
      let starts = pair[0] == 0 or c[0] != cols[pair[0] - 1][0]
      let cell = c[4] ? {"v": c[2](u) ?? 0, "s": total ? "total_contrib_count" : "contrib_count"}
                      : (c[3] == "int" ? xcount(c[2](u), total) : (c[3] == "dec" ? xdec(c[2](u), total) : xtext(c[2](u), total)))
      if starts { cell.s = cell.s + "_edge" }
      push(cells, cell)
    }
    return cells
  }
  for u in report.users { push(rows, line(u, person_name(u), false)) }
  push(rows, line(report.totals, "Total", true))
  return {"sheet": "Detail by Person", "rows": rows, "merges": merges, "freeze_pane": "B" + str(band_at + 2),
          "col_widths": concat([24.0], map(cols, fn(c) { return c[3] == "text" ? 16.0 : 11.0 }))}
}

fn render_xlsx_report(report) {
  return doc.xlsx({"sheets": [xlsx_report(report), xlsx_person_by_month(report), xlsx_detail(report)]})
}

// ---- CSV ----------------------------------------------------------------------------------------------------

// By Person, as the Report sheet has it.
fn render_csv_report(report) {
  let rows = map(report.users, fn(u) { return concat([u.rank, person_name(u), u.userid], touch_figures(u)) })
  push(rows, concat(["", "Total", ""], touch_figures(report.totals)))
  return doc.csv(concat(["#", "Name", "User ID"], FIGURE_HEADS), rows)
}

// ---- The page -----------------------------------------------------------------------------------------------

// The page: apir/warehouse/touches/quickreportview of the PHP report (catalog/controller/apir/warehouse/touches.php) -
// its markup and styles - as the pane's view (dashboard_node): its range, sort and hours the viewer's own, kept live by
// the pane's watch on touch_hour.

// The five sources that make up touches, in column order: key, label, colour variable.
let SOURCES = [["receiving", "Receiving", "--rec"], ["picking", "Picking", "--pick"], ["movements", "Bin moves", "--move"],
               ["loads", "Loads", "--load"], ["sticker", "Sticker scan out", "--stick"]]

fn dot(var) { return el("i", {"class": "dot", "style": "background:var(" + var + ")"}) }

// The line under the title: the range.
fn render_badge(report) { return html_escape(day_text(report.start) + " \u{2013} " + day_text(report.stop)) }

// the counted part of each source for a user (or the totals)
fn source_parts(u) {
  return {"receiving": u.receiving.qty_in + u.receiving.qty_out, "picking": u.picking.qty, "movements": u.movements.qty,
          "loads": u.loads.scans, "sticker": u.sticker.stagedunits}
}


// The table's columns, for a server-side sort (the pane): what each one sorts by.
fn sort_value(u, col) {
  let p = source_parts(u)
  if col == 1 { return lower(first_present(u.name, u.userid)) }
  if col >= 3 and col <= 7 { return real(p[SOURCES[col - 3][0]]) }
  if col == 8 { return u.active_days }
  if col == 9 { return real(u.touches_per_day) }
  if col == 10 { return str(u.first_touch ?? "") }
  return real(u.touches)   // 0 (rank) and 2: the busiest first
}



// What changes with the data: the cards and the "By person" panel. sorter nil: the rows in rank order
// and headers for the page script to sort; a sorter {col, dir}: the rows sorted here (ties by user id, every time)
// and each header an action that sorts by it (the same column again turns the order).
// "7am", "12pm"
fn hour_label(h) { return str(h % 12 == 0 ? 12 : h % 12) + (h < 12 ? "am" : "pm") }

// The span picked on the timeline, in words: "All hours", "9:00am - 9:59am", "7:00am - 11:59am".
fn span_label(span) {
  if span == nil { return "All hours" }
  let at = fn(h, m) { return str(h % 12 == 0 ? 12 : h % 12) + ":" + m + (h < 12 ? "am" : "pm") }
  return at(span.from, "00") + " \u{2013} " + at(span.to, "59")
}

// The days picked on the timeline, in words: "All days", "Oct 5", "Oct 5 - Oct 12".
fn days_label(sel) {
  if sel == nil { return "All days" }
  let d = fn(x) { return date_format(x, "%b %-d") }
  return sel.from == sel.to ? d(sel.from) : d(sel.from) + " \u{2013} " + d(sel.to)
}

// Columns of stacked bars (one per hour, or per day) and a two-handle slider under them, as the Hours and Days tabs
// draw them. items: [{touches, parts}]; picked(i): in the selection; none: nothing selected (all); labels(i): [from
// label, to label]; on_click(i): a column's click; apply(f): the slider let go (f.tl_from, f.tl_to: indexes); axis(i):
// the label under column i ("" for none); all_text: the label when all are picked; label_class: the label it updates.
fn bars_node(items, picked, none, lo, hi, labels, on_click, apply, axis, all_text, label_class, extra_class) {
  let n = len(items)
  let top = max(1.0, max(concat([0.0], map(items, fn(p) { return real(p.touches) }))))
  let cols = map(enumerate(items), fn(pair) {
    let i = pair[0]
    let p = pair[1]
    let total = real(p.touches)
    let segs = map(SOURCES, fn(src) {
      let v = real(p.parts[src[0]])
      return v > 0 ? el("i", {"style": "height:" + str(round(100.0 * v / max(total, 1.0), 2)) + "%;background:var(" + src[2] + ")"}) : nil
    })
    let title = labels(i)[0] + ": " + n0(total) + " touches" + join(map(SOURCES, fn(src) { return MID + src[1] + " " + n0(p.parts[src[0]]) }), "")
    return el("button", {"type": "button", "class": ["tl-col", picked(i) ? (none ? nil : "on") : "out", extra_class(i)], "data-i": i,
                         "data-fl": labels(i)[0], "data-tl": labels(i)[1], "title": title, "on_click": fn() { on_click(i) }},
              el("span", {"class": "tl-bar", "style": "height:" + str(round(100.0 * total / top, 2)) + "%"}, segs))
  })
  let last = max(1, n - 1)
  return [
    el("div", {"class": "tl-cols", "style": "grid-template-columns:repeat(" + str(n) + ", minmax(0, 1fr))"}, cols),
    el("div", {"class": "tl-slider", "data-max": n - 1, "data-all": all_text, "data-label": label_class,
               "style": "margin-left:calc(100% / " + str(2 * n) + " - 8px);margin-right:calc(100% / " + str(2 * n) + " - 8px)"},
      el("div", {"class": "tl-track"}, el("div", {"class": "tl-fill", "style": "left:" + str(round(100.0 * lo / last, 3)) + "%;width:" +
                                                                       str(round(100.0 * (hi - lo) / last, 3)) + "%"})),
      el("input", {"type": "range", "class": "tl-range tl-from", "min": 0, "max": n - 1, "step": 1, "bind": "tl_from", "value": lo,
                   "aria-label": "From", "on_change": apply}),
      el("input", {"type": "range", "class": "tl-range tl-to", "min": 0, "max": n - 1, "step": 1, "bind": "tl_to", "value": hi,
                   "aria-label": "To", "on_change": apply})),
    el("div", {"class": "tl-axis", "style": "grid-template-columns:repeat(" + str(n) + ", minmax(0, 1fr))"}, map(range(0, n), fn(i) { return el("span", axis(i)) }))
  ]
}

// The slider's let-go, as two indexes in 0..last: the pick, or nil for all of them.
fn slider_pick(f, last) {
  if not is_digit(str(f.tl_from ?? "")) or not is_digit(str(f.tl_to ?? "")) { return {"ok": false} }
  let lo = max(0, min(int(f.tl_from), int(f.tl_to)))
  let hi = min(last, max(int(f.tl_from), int(f.tl_to)))
  return {"ok": true, "all": lo == 0 and hi == last, "lo": lo, "hi": hi}
}

// The timeline: tabs (pills) for three ways to see the range, and what is picked in them.
//   Hours (the default): a column per hour of the day over the days picked; a slider (and a click) picks hours.
//   Days: a column per day of the form's range over the hours picked; a slider (and a click) picks days - the
//     report narrows to them, the strip keeps the whole range.
//   Heatmap: each hour of each day, shaded by its touches; a click picks that day and that hour.
// state: {view, span, days} (the page's); report: fetch_for_page's.
fn timeline_node(report, state) {
  let view = state.view ?? "hours"
  let tab = fn(id, text) {
    return el("button", {"type": "button", "class": ["pill", view == id ? "on" : nil], "on_click": fn() { state.view = id }}, text)
  }
  let span = state.span
  let sel = report.sel_days
  let head = el("div", {"class": "panel-head"},
    el("div", {"class": "tl-title"}, el("h2", "Through the day"),
      el("div", {"class": "pills"}, tab("hours", "Hours"), tab("days", "Days"), tab("heat", "Heatmap"))),
    el("div", {"class": "tl-sel"},
      el("b", {"class": "tl-lab-days"}, days_label(sel)), el("b", {"class": "tl-lab-hours"}, span_label(span)),
      el("span", n0(report.totals.touches) + " touches"),
      sel != nil ? el("button", {"type": "button", "class": "btn", "on_click": fn() { state.days = nil }}, "All days") : nil,
      span != nil ? el("button", {"type": "button", "class": "btn", "on_click": fn() { state.span = nil }}, "All hours") : nil))
  let body = nil
  if view == "days" {
    let days = report.days ?? []
    let ds = map(days, fn(d) { return d.day })
    let n = len(ds)
    let idx = fn(day) { let i = index_of(join(ds, ","), day) return i < 0 ? 0 : i / 11 }   // 11 = len("YYYY-MM-DD,")
    let lo = sel == nil ? 0 : idx(sel.from)
    let hi = sel == nil ? max(0, n - 1) : idx(sel.to)
    let short = fn(d) { return date_format(d, "%b %-d") }
    let every = max(1, int(ceil(real(n) / 10.0)))
    body = bars_node(days, fn(i) { return in_days(sel, ds[i]) }, sel == nil, lo, hi,
      fn(i) { return [date_format(ds[i], "%a %b %-d"), short(ds[i])] },
      fn(i) { state.days = sel != nil and sel.from == ds[i] and sel.to == ds[i] ? nil : {"from": ds[i], "to": ds[i]} },
      fn(f) { let k = slider_pick(f, n - 1) if k.ok { state.days = k.all ? nil : {"from": ds[k.lo], "to": ds[k.hi]} } },
      fn(i) { return i % every == 0 ? short(ds[i]) : "" }, "All days", "tl-lab-days",
      fn(i) { let wd = date_format(ds[i], "%a") return wd == "Sat" or wd == "Sun" ? "we" : nil })
  } else if view == "heat" {
    let heat = report.heat ?? []
    let top = max(1.0, max(concat([0.0], flatten(map(heat, fn(r) { return map(r.hours, fn(v) { return real(v) }) })))))
    let rows = map(heat, fn(r) {
      let cells = map(range(0, 24), fn(h) {
        let v = real(r.hours[h])
        let a = v <= 0 ? 0.0 : 0.12 + 0.88 * pow(v / top, 0.6)
        let hit = (sel != nil or span != nil) and in_days(sel, r.day) and in_span(span, h)
        return el("button", {"type": "button", "class": ["hm-cell", hit ? "on" : nil], "style": "--a:" + str(round(a, 3)),
                             "title": date_format(r.day, "%a %b %-d") + ", " + hour_label(h) + ": " + n0(v) + " touches",
                             "on_click": fn() { state.days = {"from": r.day, "to": r.day} state.span = {"from": h, "to": h} }})
      })
      let wd = date_format(r.day, "%a")
      return el("div", {"class": ["hm-row", wd == "Sat" or wd == "Sun" ? "we" : nil]}, el("span", {"class": "hm-day"}, date_format(r.day, "%a %-m/%-d")), cells)
    })
    body = el("div", {"class": "hm"},
      el("div", {"class": "hm-rows"}, rows),
      el("div", {"class": "hm-row hm-axis"}, el("span", {"class": "hm-day"}, ""), map(range(0, 24), fn(h) { return el("span", h % 3 == 0 ? hour_label(h) : "") })))
  } else {
    let profile = report.profile ?? []
    body = bars_node(profile, fn(h) { return in_span(span, h) }, span == nil, span == nil ? 0 : span.from, span == nil ? 23 : span.to,
      fn(h) { let at = fn(m) { return str(h % 12 == 0 ? 12 : h % 12) + ":" + m + (h < 12 ? "am" : "pm") } return [at("00"), at("59")] },
      fn(h) { state.span = span != nil and span.from == h and span.to == h ? nil : {"from": h, "to": h} },
      fn(f) { let k = slider_pick(f, 23) if k.ok { state.span = k.all ? nil : {"from": k.lo, "to": k.hi} } },
      fn(h) { return h % 3 == 0 ? hour_label(h) : "" }, "All hours", "tl-lab-hours", fn(h) { return nil })
  }
  return el("div", {"class": "panel tl-panel"}, head, el("div", {"class": "tl"}, body))
}

// The slider as it is dragged: the handles never cross, and the band, the label and the dimmed columns follow the
// handles before the page asks the server (which it does when a handle is let go - its change). The labels come from
// the columns (data-fl, data-tl), so one script serves hours and days.
let SLIDER_JS = join([
  "(function () {",
  "  document.addEventListener('input', function (e) {",
  "    var t = e.target;",
  "    if (!t.classList || !t.classList.contains('tl-range')) return;",
  "    var box = t.closest('.tl-slider'), lo = box.querySelector('.tl-from'), hi = box.querySelector('.tl-to');",
  "    var max = +box.dataset.max || 1, a = +lo.value, b = +hi.value;",
  "    if (a > b) { if (t === lo) { hi.value = a; b = a; } else { lo.value = b; a = b; } }",
  "    lo.style.zIndex = a > max / 2 ? 3 : 2;   // at the far end the lower handle has to be the one on top",
  "    var fill = box.querySelector('.tl-fill');",
  "    fill.style.left = (a / max * 100) + '%'; fill.style.width = ((b - a) / max * 100) + '%';",
  "    var all = a === 0 && b === max, cols = box.parentElement.querySelectorAll('.tl-cols .tl-col');",
  "    cols.forEach(function (c) {",
  "      var i = +c.dataset.i;",
  "      c.classList.toggle('out', i < a || i > b); c.classList.toggle('on', !all && i >= a && i <= b);",
  "    });",
  "    var label = document.querySelector('.' + box.dataset.label);",
  "    if (label && cols[a] && cols[b]) label.textContent = all ? box.dataset.all : (a === b && cols[a].dataset.fl === cols[a].dataset.tl ? cols[a].dataset.fl : cols[a].dataset.fl + ' \u{2013} ' + cols[b].dataset.tl);",
  "  });",
  "})();"
], chr(10))

// By Month (the panel's other table): the Excel's By Month - a row per month of the range over the hours picked, a
// Total row of the months added up (the cards' figures when no days are picked); a month's button narrows the report
// to its days.
fn months_node(report, state) {
  let sel = report.sel_days
  let months = report.months ?? []
  let top = max(1.0, max(concat([0.0], map(months, fn(m) { return real(m.touches) }))))
  let cells = fn(touches, parts, days, per_day) {
    return concat([el("td", el("b", count_text(touches)))], map(AREAS, fn(a) { return el("td", count_text(parts[a[0]])) }),
                  [el("td", n0(days)), el("td", n1(per_day))])
  }
  let rows = map(months, fn(m) {
    let picked = sel != nil and sel.from == m.from and sel.to == m.to
    return el("tr", {"class": picked ? "on" : nil}, el("td", {"class": "who"}, el("b", month_text(m))),
      cells(m.touches, m.parts, m.active_days, m.touches_per_day),
      el("td", el("button", {"type": "button", "class": "btn", "on_click": fn() { state.days = picked ? nil : {"from": m.from, "to": m.to} }},
                  picked ? "All days" : "Show month")))
  })
  let sum_of = fn(f) { let t = 0.0 for m in months { t = t + real(f(m)) } return t }
  let parts = {}
  for a in AREAS { parts[a[0]] = sum_of(fn(m) { return m.parts[a[0]] }) }
  let touches = sum_of(fn(m) { return m.touches })
  let days = sum_of(fn(m) { return m.active_days })
  return el("div", {"class": "scroll"}, el("table", {"class": "months"},
    el("thead", el("tr", el("th", {"class": "l"}, "Month"), map(FIGURE_HEADS, fn(h) { return el("th", h) }), el("th", ""))),
    el("tbody", rows),
    el("tfoot", el("tr", el("td", {"class": "who"}, "Total"), cells(touches, parts, days, days > 0 ? touches / days : 0.0), el("td")))))
}

fn live_node(report, state, hours) {
  let sorter = state.sorter
  let t = report.totals
  let pt = source_parts(t)
  let src_of = {}
  for src in SOURCES { src_of[src[0]] = src }
  // the cards: card_lines, as the Excel's Summary says them
  let cards = el("div", {"class": "cards"}, map(card_lines(report), fn(line) {
    let src = line.key == nil ? nil : src_of[line.key]
    return el("div", {"class": ["card", src == nil ? "total" : nil]},
              el("div", {"class": "label"}, src == nil ? nil : dot(src[2]), line.label == "Total" ? "Total touches" : line.label),
              el("div", {"class": "value"}, n0(line.touches)),
              el("div", {"class": "sub"}, line.detail), el("div", {"class": "last"}, line.last == "" ? "no touches" : "last touch " + line.last))
  }))

  let nil_cell = el("span", {"class": "nil"}, "\u{2013}")
  let top = max(1.0, max(concat([0.0], map(report.users, fn(u) { return real(u.touches) }))))
  let ranked = enumerate(report.users)
  if sorter != nil {
    ranked = sort_by(sort_by(ranked, fn(pr) { return lower(pr[1].userid) }), fn(pr) { return sort_value(pr[1], sorter.col) }, sorter.dir)
  }
  let rows = []
  for pair in ranked {
    let rank = pair[0] + 1
    let u = pair[1]
    let p = source_parts(u)
    let name = first_present(u.name, u.userid)
    let title = join(map(SOURCES, fn(src) { return src[1] + " " + n0(p[src[0]]) }), " / ")
    let bar = map(SOURCES, fn(src) { return el("span", {"style": "background:var(" + src[2] + ");width:" + str(round(100.0 * real(p[src[0]]) / top, 2)) + "%"}) })
    push(rows, el("tr", {"data-key": lower(u.userid)},   // the row is this user's: an update moves it rather than rewriting it
      el("td", {"class": "rank", "data-v": rank}, rank),
      el("td", {"class": "who", "data-v": lower(name)}, el("b", name)),
      el("td", {"data-v": str(u.touches)}, el("b", n0(u.touches)), el("div", {"class": "bar", "title": title}, bar)),
      map(SOURCES, fn(src) { let v = p[src[0]]; return el("td", {"data-v": str(v)}, v > 0 ? n0(v) : nil_cell) }),
      el("td", {"data-v": str(u.active_days)}, n0(u.active_days)),
      el("td", {"data-v": str(u.touches_per_day)}, n1(u.touches_per_day))))
  }
  if len(rows) == 0 { push(rows, el("tr", el("td", {"colspan": 10, "class": "empty"}, "No warehouse activity in this range."))) }

  // A sortable header: its label is a button (the page's script only answers clicks on buttons), whose click sorts
  // by the column, or turns the order when it is the column sorted by.
  let th = fn(col, attrs, label) {
    if sorter == nil {
      attrs["data-col"] = col
      if col == 2 { attrs["data-dir"] = "desc" }
      return el("th", attrs, label)
    }
    let btn = {"type": "button", "class": "th-btn", "on_click": fn() {
      if sorter.col == col { sorter.dir = sorter.dir == "desc" ? "asc" : "desc" } else { sorter.col = col; sorter.dir = "desc" }
    }}
    if sorter.col == col { btn["data-dir"] = sorter.dir }
    return el("th", attrs, el("button", btn, label))
  }
  let head = [th(0, {"class": "l"}, "#"), th(1, {"class": "l"}, "Name"), th(2, {}, "Total")]
  let foot = [el("td"), el("td", {"class": "who"}, "Total"), el("td", n0(t.touches))]
  for pair in enumerate(SOURCES) {
    let src = pair[1]
    push(head, th(pair[0] + 3, {"class": "contrib", "style": "--c:var(" + src[2] + ")"}, AREAS[pair[0]][1]))
    push(foot, el("td", count_text(pt[src[0]])))
  }
  push(head, th(8, {}, "Days"), th(9, {}, "Per Day"))
  push(foot, el("td", n0(t.active_days)), el("td", n1(t.touches_per_day)))
  let pickups = t.loads.pickuporders > 0 or t.loads.pickupunits > 0
  let legend = map(SOURCES, fn(src) {
    return el("span", dot(src[2]), src[1], src[0] == "loads" and pickups ? [" ", el("small", "(incl. pickups)")] : nil)
  })

  let by_month = state.table == "month"
  let pick = fn(id, text) {
    return el("button", {"type": "button", "class": ["pill", (state.table ?? "person") == id ? "on" : nil], "on_click": fn() { state.table = id }}, text)
  }
  let panel = el("div", {"class": "panel"},
    el("div", {"class": "panel-head"}, el("div", {"class": "pills"}, pick("person", "By Person"), pick("month", "By Month")),
       el("div", {"class": "legend"}, legend)),
    by_month ? months_node(report, state)
             : el("div", {"class": "scroll"}, el("table", el("thead", el("tr", head)), el("tbody", rows), el("tfoot", el("tr", foot)))))
  return [cards, hours, panel]
}

let PAGE_CSS = join([
  ":root, [data-theme=\"light\"] {",
  "  --bg: #f4f6f8; --panel: #ffffff; --line: #dfe3e8; --line-strong: #c4cdd5; --text: #161c24; --text-strong: #090c0f;",
  "  --muted: #5c6877; --rec: #1e6ac7; --pick: #c76a14; --move: #238555; --load: #6b44a8; --stick: #b3295c;",
  "  --head: #eff2f6; --hover: #f1f4f8; --shadow-sm: 0 1px 3px rgba(0, 0, 0, .06), 0 1px 2px rgba(0, 0, 0, .04);",
  "  color-scheme: light;",
  "}",
  "[data-theme=\"dark\"] {",
  "  --bg: #111418; --panel: #1a1f25; --line: #2b323a; --line-strong: #3d4652; --text: #e8ebee; --text-strong: #ffffff;",
  "  --muted: #98a2ad; --rec: #2f7de1; --pick: #e8912d; --move: #3aa776; --load: #8a63d2; --stick: #d6477f;",
  "  --head: #20262d; --hover: #232a32; --shadow-sm: 0 1px 3px rgba(0, 0, 0, .35);",
  "  color-scheme: dark;",
  "}",
  "@media (prefers-color-scheme: dark) {",
  "  :root:not([data-theme=\"light\"]) {",
  "    --bg: #111418; --panel: #1a1f25; --line: #2b323a; --line-strong: #3d4652; --text: #e8ebee; --text-strong: #ffffff;",
  "    --muted: #98a2ad; --rec: #2f7de1; --pick: #e8912d; --move: #3aa776; --load: #8a63d2; --stick: #d6477f;",
  "    --head: #20262d; --hover: #232a32; --shadow-sm: 0 1px 3px rgba(0, 0, 0, .35);",
  "    color-scheme: dark;",
  "  }",
  "}",
  "* { box-sizing: border-box; }",
  "body { margin: 0; background: var(--bg); color: var(--text); font: 14px/1.4 -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif; transition: background .15s, color .15s; }",
  ".page { max-width: 1400px; margin: 0 auto; padding: 24px 16px 40px; }",
  "header { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 20px; }",
  "h1 { margin: 0; font-size: 22px; color: var(--text-strong); } .range { color: var(--muted); margin-top: 4px; }",
  "form { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }",
  "form label { color: var(--muted); font-size: 12px; font-weight: 500; }",
  "input[type=date] { padding: 6px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--panel); color: var(--text); font: inherit; }",
  "input[type=date]:focus { outline: none; border-color: var(--rec); box-shadow: 0 0 0 2px rgba(47, 125, 225, .25); }",
  ".btn { padding: 7px 14px; border-radius: 6px; border: 1px solid var(--line); background: var(--panel); color: var(--text); font: inherit; text-decoration: none; cursor: pointer; transition: background .15s, border-color .15s; box-shadow: var(--shadow-sm); }",
  ".btn:hover { background: var(--head); border-color: var(--line-strong); }",
  ".btn.primary { background: var(--rec); border-color: var(--rec); color: #ffffff; box-shadow: 0 1px 2px rgba(0,0,0,.15); }",
  ".btn.primary:hover { filter: brightness(1.08); }",
  ".theme-toggle { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 500; padding: 6px 11px; margin-right: 4px; cursor: pointer; user-select: none; }",
  ".theme-svg { display: none; }",
  ":root .theme-svg.moon, [data-theme=\"light\"] .theme-svg.moon { display: inline-block; }",
  ":root .theme-svg.sun, [data-theme=\"light\"] .theme-svg.sun { display: none; }",
  "[data-theme=\"dark\"] .theme-svg.sun { display: inline-block; }",
  "[data-theme=\"dark\"] .theme-svg.moon { display: none; }",
  "@media (prefers-color-scheme: dark) {",
  "  :root:not([data-theme=\"light\"]) .theme-svg.sun { display: inline-block; }",
  "  :root:not([data-theme=\"light\"]) .theme-svg.moon { display: none; }",
  "}",
  ".hours { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 16px; }",
  ".btn.hour { padding: 4px 10px; font-size: 12px; } .btn.hour.on { background: var(--rec); border-color: var(--rec); color: #ffffff; }",
  ".tl-panel { margin-bottom: 20px; }",
  ".tl-title { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }",
  ".pills { display: inline-flex; gap: 2px; padding: 2px; border-radius: 999px; background: var(--head); border: 1px solid var(--line); }",
  ".pill { padding: 3px 12px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font: inherit; font-size: 12px; cursor: pointer; }",
  ".pill:hover { color: var(--text); } .pill.on { background: var(--rec); color: #ffffff; }",
  ".tl-sel b + b::before { content: \"\\00b7\"; margin: 0 6px; color: var(--muted); font-weight: 400; }",
  ".tl-col.we .tl-bar { box-shadow: inset 0 -2px 0 var(--muted); }",
  ".hm { padding: 2px 0 0; }",
  ".hm-rows { max-height: 330px; overflow-y: auto; }",
  ".hm-row { display: grid; grid-template-columns: 64px repeat(24, minmax(0, 1fr)); gap: 2px; margin-bottom: 2px; }",
  ".hm-day { color: var(--muted); font-size: 10px; line-height: 12px; white-space: nowrap; } .hm-row.we .hm-day { color: var(--text); }",
  ".hm-cell { height: 12px; padding: 0; border: 0; border-radius: 2px; cursor: pointer; background: rgba(47, 125, 225, var(--a)); box-shadow: inset 0 0 0 1px var(--line); }",
  ".hm-cell:hover { box-shadow: inset 0 0 0 1px var(--text); } .hm-cell.on { box-shadow: inset 0 0 0 2px var(--text); }",
  ".hm-axis span { color: var(--muted); font-size: 10px; text-align: center; white-space: nowrap; } .hm-axis { margin-top: 4px; }",
  ".tl-sel { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; color: var(--muted); font-size: 13px; } .tl-sel b { color: var(--text); font-weight: 600; }",
  ".tl-sel .btn { padding: 4px 10px; font-size: 12px; } .tl-hint { font-size: 12px; opacity: .8; }",
  ".tl { padding: 12px 16px 8px; user-select: none; -webkit-user-select: none; }",
  ".tl-cols { display: grid; gap: 3px; height: 84px; align-items: end; }",
  ".tl-col { height: 100%; display: flex; align-items: flex-end; padding: 0 1px; border: 0; border-radius: 4px; background: transparent; cursor: pointer; transition: background .15s; }",
  ".tl-col:hover { background: var(--head); box-shadow: inset 0 0 0 1px var(--line); }",
  ".tl-slider { position: relative; height: 22px; margin-top: 8px; }",
  ".tl-track { position: absolute; left: 0; right: 0; top: 9px; height: 4px; border-radius: 2px; background: var(--line); }",
  ".tl-fill { position: absolute; top: 0; bottom: 0; min-width: 2px; border-radius: 2px; background: var(--rec); transition: left .15s, width .15s; }",
  ".tl-range { position: absolute; left: 0; top: 0; width: 100%; height: 22px; margin: 0; background: none; pointer-events: none; -webkit-appearance: none; appearance: none; z-index: 2; }",
  ".tl-range.tl-to { z-index: 2; } .tl-range:focus { outline: none; }",
  ".tl-range::-webkit-slider-runnable-track { height: 22px; background: none; }",
  ".tl-range::-moz-range-track { height: 22px; background: none; }",
  ".tl-range::-webkit-slider-thumb { -webkit-appearance: none; pointer-events: auto; width: 16px; height: 16px; margin-top: 3px; border-radius: 50%; background: var(--panel); border: 2px solid var(--rec); box-shadow: 0 1px 3px rgba(0, 0, 0, .35); cursor: grab; }",
  ".tl-range::-moz-range-thumb { pointer-events: auto; width: 12px; height: 12px; border-radius: 50%; background: var(--panel); border: 2px solid var(--rec); box-shadow: 0 1px 3px rgba(0, 0, 0, .35); cursor: grab; }",
  ".tl-range:active::-webkit-slider-thumb { cursor: grabbing; transform: scale(1.15); } .tl-range:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 4px rgba(47, 125, 225, .35); }",
  ".tl-col.on { background: var(--head); box-shadow: inset 0 0 0 1px var(--rec); }",
  ".tl-bar { width: 100%; min-height: 2px; display: flex; flex-direction: column-reverse; border-radius: 4px 4px 1px 1px; overflow: hidden; background: var(--line); transition: height .5s ease, opacity .2s; }",
  ".tl-bar i { display: block; width: 100%; transition: height .5s ease; }",
  ".tl-col.out .tl-bar { opacity: .28; }",
  ".tl-axis { display: grid; gap: 3px; margin-top: 2px; color: var(--muted); font-size: 11px; }",
  ".tl-axis span { text-align: center; white-space: nowrap; overflow: visible; }",
  "@media (max-width: 700px) { .tl-cols { gap: 2px; height: 64px; } .tl-axis { gap: 2px; font-size: 10px; } }",
  ".status { display: inline-flex; align-items: center; gap: 10px; margin: -6px 0 16px; padding: 5px 12px; border-radius: 999px; font-size: 13px; border: 1px solid; }",
  ".status b { letter-spacing: .06em; } .status .btn { padding: 4px 12px; font-size: 13px; }",
  ".status.live { background: rgba(58, 167, 118, .12); border-color: var(--move); }",
  ".tl-tip { position: fixed; z-index: 50; display: none; pointer-events: none; min-width: 170px; padding: 8px 10px; border-radius: 8px; background: var(--panel); border: 1px solid var(--line); box-shadow: 0 6px 20px rgba(0,0,0,.18); font-size: 12px; }",
  ".tl-tip .tip-head { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 4px; } .tl-tip .tip-head span { opacity: .75; }",
  ".tl-tip .tip-row { display: flex; align-items: center; gap: 6px; } .tl-tip .tip-row b { margin-left: auto; font-variant-numeric: tabular-nums; }",
  "header .status { margin: 0; } button.status { font: inherit; font-size: 13px; color: inherit; cursor: pointer; }",
  "button.status small { opacity: .65; } button.status:hover { background: rgba(58, 167, 118, .22); }",
  ".status.paused { background: rgba(232, 145, 45, .16); border-color: var(--pick); } .status.paused { padding-right: 6px; }",
  ".pulse-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--move); animation: live 1.6s ease-in-out infinite; }",
  "@keyframes live { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }",
  "table.months tr.on td { background: var(--head); } table.months td.who small { display: block; }",
  ".cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 20px; }",
  ".card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }",
  ".card.total { border-width: 2px; }",
  ".card .label { color: var(--muted); font-size: 13px; } .card .value { font-size: 28px; font-weight: 600; margin: 2px 0; } .card .sub { color: var(--muted); font-size: 12px; }",
  ".card .last { color: var(--muted); font-size: 11px; margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--line); }",
  ".clock { text-align: center; font-variant-numeric: tabular-nums; } .clock .time { font-size: 22px; font-weight: 600; } .clock .day { color: var(--muted); font-size: 12px; }",
  ".dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; vertical-align: 0; }",
  ".panel { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }",
  ".panel-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; padding: 12px 16px; border-bottom: 1px solid var(--line); }",
  ".panel-head h2 { margin: 0; font-size: 15px; }",
  ".legend { display: flex; flex-wrap: wrap; gap: 14px; color: var(--muted); font-size: 12px; }",
  ".scroll { overflow-x: auto; }",
  "table { width: 100%; border-collapse: collapse; min-width: 880px; }",
  "th { background: var(--head); color: var(--muted); font-size: 12px; font-weight: 600; text-align: right; padding: 8px 10px; border-bottom: 1px solid var(--line); cursor: pointer; user-select: none; white-space: nowrap; }",
  "th.contrib { color: var(--text); border-top: 3px solid var(--c); white-space: normal; }",
  "th.l, td.who, td.rank { text-align: left; } th[data-dir=asc]::after { content: \" \\25B2\"; } th[data-dir=desc]::after { content: \" \\25BC\"; }",
  ".th-btn { all: unset; display: block; box-sizing: border-box; margin: -8px -10px; padding: 8px 10px; cursor: pointer; text-align: inherit; }",
  ".th-btn:focus-visible { outline: 2px solid var(--rec); outline-offset: -2px; }",
  ".th-btn[data-dir=asc]::after { content: \" \\25B2\"; } .th-btn[data-dir=desc]::after { content: \" \\25BC\"; }",
  "td { text-align: right; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; white-space: nowrap; }",
  "td.src { white-space: normal; min-width: 110px; max-width: 170px; } td.src small { line-height: 1.35; margin-top: 1px; }",
  "td small { display: block; color: var(--muted); font-size: 11px; }",
  "td.rank { color: var(--muted); width: 36px; } td.when { font-size: 12px; }",
  ".bar { display: flex; height: 6px; margin-top: 5px; border-radius: 3px; overflow: hidden; background: var(--line); min-width: 100px; }",
  ".bar span { display: block; height: 100%; }",
  "tfoot td { font-weight: 600; background: var(--head); border-bottom: 0; }",
  ".nil { color: var(--muted); }",
  "td.empty { text-align: center; color: var(--muted); padding: 30px; }",
  "#live.pulse .card.total { animation: pulse 1.2s ease-out; }",
  "@keyframes pulse { from { border-color: var(--rec); } to { border-color: var(--line); } }",
  "@media print { body { background: #ffffff; } form, .btn, .hours, .tl-hint { display: none; } .card, .panel { break-inside: avoid; } }"
], chr(10))






// The clock in the header, filled in by the page (the time is the viewer's).
// Hover on a timeline column or a heatmap cell: its figures at once, in a box over it (the browser's own title
// tooltip comes late and plain). The figures are the element's title - "label: N touches · Source n · ..." -
// moved to data-tip so the browser does not show it as well; a source at 0 is left out.
let TIP_JS = join([
  "(function () {",
  "  if (window.__wtTip) return; window.__wtTip = 1;",
  "  var colors = {" + join(map(SOURCES, fn(src) { return "'" + src[1] + "': 'var(" + src[2] + ")'" }), ", ") + "};",
  "  var tip = document.createElement('div'); tip.className = 'tl-tip'; document.body.appendChild(tip);",
  "  function hide() { tip.style.display = 'none'; }",
  "  function add(parent, tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; parent.appendChild(e); return e; }",
  "  document.addEventListener('mouseover', function (e) {",
  "    var b = e.target.closest ? e.target.closest('.tl-col, .hm-cell') : null;",
  "    if (!b) { hide(); return; }",
  "    if (b.hasAttribute('title')) { b.dataset.tip = b.getAttribute('title'); b.removeAttribute('title'); }",
  "    var t = b.dataset.tip; if (!t) { hide(); return; }",
  "    var parts = t.split(" + json_stringify(MID) + "), head = parts[0], at = head.lastIndexOf(': ');",
  "    tip.textContent = '';",
  "    var h = add(tip, 'div', 'tip-head');",
  "    add(h, 'b', null, at > 0 ? head.slice(0, at) : head);",
  "    if (at > 0) add(h, 'span', null, head.slice(at + 2));",
  "    for (var i = 1; i < parts.length; i++) {",
  "      var sp = parts[i].lastIndexOf(' '), name = parts[i].slice(0, sp), val = parts[i].slice(sp + 1);",
  "      if (val === '0') continue;",
  "      var row = add(tip, 'div', 'tip-row'), d = add(row, 'i', 'dot');",
  "      d.style.background = colors[name] || 'var(--muted)';",
  "      add(row, 'span', null, name); add(row, 'b', null, val);",
  "    }",
  "    tip.style.display = 'block';",
  "    var r = b.getBoundingClientRect(), w = tip.offsetWidth, ht = tip.offsetHeight;",
  "    var x = Math.max(8, Math.min(window.innerWidth - w - 8, r.left + r.width / 2 - w / 2));",
  "    var y = r.top - ht - 8; if (y < 8) y = r.bottom + 8;",
  "    tip.style.left = x + 'px'; tip.style.top = y + 'px';",
  "  });",
  "  document.addEventListener('scroll', hide, true);",
  "  document.addEventListener('mouseleave', hide);",
  "})();"
], chr(10))

let CLOCK_JS = join([
  "(function () {",
  "  function tick() {",
  "    var d = new Date(), t = document.getElementById('clock-time'), y = document.getElementById('clock-day');",
  "    if (t) t.textContent = d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit', second: '2-digit' });",
  "    if (y) y.textContent = d.toLocaleDateString([], { weekday: 'long', month: 'short', day: 'numeric' });",
  "  }",
  "  tick(); setInterval(tick, 1000);",
  "})();"
], chr(10))

// The export links behind a proxy that picks the app by ?route= (atl's nginx: ?route=apir/warehouse/touches/
// quickreportlive&key=..&userid=..): the same URL with export=pdf|xlsx and the range, so the key goes along. Reached
// directly (no route), the links are the app's own paths.
let EXPORT_JS = join([
  "document.addEventListener('click', function (e) {",
  "  var a = e.target.closest && e.target.closest('a[data-export]');",
  "  var p = new URLSearchParams(location.search);",
  "  if (!a || !p.get('route')) return;",
  "  e.preventDefault();",
  "  p.set('export', a.dataset.export); p.set('start', a.dataset.start); p.set('stop', a.dataset.stop); p.set('hours', a.dataset.hour || ''); p.delete('hour_wanted');",
  "  location.href = location.pathname + '?' + p.toString();",
  "});"
], chr(10))

// Theme switcher: Light or Dark, kept in localStorage; until one is picked, the system's. It only sets data-theme on
// <html>, which pushed updates never touch; the icon and the label follow it in CSS, so nothing here has to run again
// when the page changes.
let THEME_JS = join([
  "(function () {",
  "  var KEY = 'warehouse_touches_theme';",
  "  function saved() { try { var s = localStorage.getItem(KEY); return s === 'light' || s === 'dark' ? s : null; } catch (e) { return null; } }",
  "  function system() { return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }",
  "  var root = document.documentElement;",
  "  root.setAttribute('data-theme', saved() || system());",
  "  document.addEventListener('click', function (e) {",
  "    if (!e.target.closest || !e.target.closest('#theme-toggle')) return;",
  "    var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';",
  "    try { localStorage.setItem(KEY, next); } catch (err) {}",
  "    root.setAttribute('data-theme', next);",
  "  });",
  "})();"
], chr(10))

fn theme_toggle_node() {
  let sun = "<svg class=\"theme-svg sun\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"5\"/><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"3\"/><line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"23\"/><line x1=\"4.22\" y1=\"4.22\" x2=\"5.64\" y2=\"5.64\"/><line x1=\"18.36\" y1=\"18.36\" x2=\"19.78\" y2=\"19.78\"/><line x1=\"1\" y1=\"12\" x2=\"3\" y2=\"12\"/><line x1=\"21\" y1=\"12\" x2=\"23\" y2=\"12\"/><line x1=\"4.22\" y1=\"19.78\" x2=\"5.64\" y2=\"18.36\"/><line x1=\"18.36\" y1=\"5.64\" x2=\"19.78\" y2=\"4.22\"/></svg>"
  let moon = "<svg class=\"theme-svg moon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z\"/></svg>"
  return el("button", {"type": "button", "class": "btn theme-toggle", "id": "theme-toggle", "title": "Switch between light and dark", "aria-label": "Switch between light and dark"},
    html_raw(sun), html_raw(moon), el("span", {"class": "theme-svg sun"}, "Light"), el("span", {"class": "theme-svg moon"}, "Dark"))
}

// Live or paused (service.gr's view): live, the page follows the Thing, and clicking LIVE pauses it; paused - by the
// viewer, hours or days picked, or a range that ended before today - it keeps the figures it read until the viewer
// resumes, changes what is picked or presses Refresh.
fn status_node(report, state) {
  if not state.paused {
    return el("button", {"type": "button", "class": "status live", "title": "Pause: keep these figures still",
                         "on_click": fn() { state.hold = true; state.held = nil }},
              el("i", {"class": "pulse-dot"}), el("b", "LIVE"), el("small", "Pause"))
  }
  if state.hold {
    return el("div", {"class": "status paused"}, el("b", "PAUSED"), "As of " + when(report.as_of),
      el("button", {"type": "button", "class": "btn primary", "on_click": fn() { state.hold = false; state.held = nil }}, "Resume"))
  }
  return el("div", {"class": "status paused"}, el("b", "PAUSED"), "Showing figures as of " + when(report.as_of),
    el("button", {"type": "button", "class": "btn", "on_click": fn() { state.held = nil }}, "Refresh"),
    el("button", {"type": "button", "class": "btn primary", "on_click": fn() {
      // the last 30 days to today, every hour and day: live again
      let r = report_range(nil, nil)
      state.start = r[0]
      state.stop = r[1]
      state.span = nil
      state.days = nil
      state.hold = false
      state.held = nil
    }}, "Back to live"))
}

// The page as a ui.pane view (service.gr): the same markup as the PHP page, its range a form whose Run is an
// action, its sort done here and its hours picked on the timeline (state: {start, stop, span, sorter}, the viewer's
// own).
fn dashboard_node(report, state) {
  let hour = state.span == nil ? "" : str(state.span.from) + "-" + str(state.span.to)
  let q = "?start=" + report.start + "&stop=" + report.stop + "&hours=" + hour
  return el("div", {"class": "page"},
    el("header",
      el("div", el("h1", "Warehouse Activity"), el("div", {"class": "range", "id": "range"}, html_raw(render_badge(report)))),
      status_node(report, state),
      el("div", {"class": "clock", "aria-live": "off", "data-ui-keep": true}, el("div", {"class": "time", "id": "clock-time"}), el("div", {"class": "day", "id": "clock-day"})),
      el("form", {"onsubmit": "return false"},
        theme_toggle_node(),
        el("label", "From"), el("input", {"type": "date", "bind": "start", "value": report.range_start ?? report.start}),
        el("label", "To"), el("input", {"type": "date", "bind": "stop", "value": report.range_stop ?? report.stop}),
        el("button", {"type": "button", "class": "btn primary", "on_click": fn(f) {
          let r = report_range(f.start, f.stop)
          state.start = r[0]
          state.stop = r[1]
          state.days = nil   // a new range: all of its days
          state.held = nil   // and read again, even when it is the same range
        }}, "Run"),
        el("a", {"class": "btn", "href": "/quickreportpdf" + q, "data-export": "pdf", "data-start": report.start, "data-stop": report.stop, "data-hour": hour}, "Export PDF"),
        el("a", {"class": "btn", "href": "/quickreportxlsx" + q, "data-export": "xlsx", "data-start": report.start, "data-stop": report.stop, "data-hour": hour}, "Export Excel"))),
    el("div", {"id": "live"}, live_node(report, state, timeline_node(report, state))),
    el("script", CLOCK_JS), el("script", EXPORT_JS), el("script", SLIDER_JS), el("script", THEME_JS), el("script", TIP_JS))
}
