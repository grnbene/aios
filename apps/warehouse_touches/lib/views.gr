// Warehouse Touches views: the page, its live part, and the PDF, XLSX and CSV exports.
//
// The page and the PDF follow catalog/controller/apir/warehouse/touches.php (quickreportview, quickReportHtml,
// quickReportCss). Markup is built as nodes (el, html_stringify), so every value is escaped in one place.

let MID = " \u{b7} "        // the PHP page's " &middot; "
let NBSP = "\u{a0}"

fn n0(v) { return number_format(v, 0) }
fn n1(v) { return number_format(v, 1) }

// '2026-10-27 08:20:11' as 'Oct 27 8:20am'
fn when(ts) {
  if is_blank(ts) { return "" }
  let s = str(ts)
  if len(s) < 16 or s < "1971" { return s }
  return date_format(date_parse(slice(s, 0, 16)), "%b %-d %-I:%M%P", "utc")
}

// '2026-10-27' as 'Oct 27, 2026', as PHP's date('M j, Y')
fn day_text(d) {
  let s = str(d)
  if len(s) < 10 or s < "1971" { return s }
  return date_format(date_parse(slice(s, 0, 10)), "%b %-d, %Y", "utc")
}

// '2026-10-27 08:20:11' as '10-27 08:20', the exports' first / last columns
fn short_time(ts) { return is_blank(ts) ? "" : slice(str(ts), 5, 16) }

// ---- The report's columns: the PDF and the XLSX -------------------------------------------------------------

// The PHP report's sections (quickReportColumns): the first column of each section counts toward touches.
// Each column: [header, counts toward touches, value of a user (or the totals), format "int" | "dec" | "text", width
// in the XLSX].
fn report_columns(report) {
  let grand = report.totals.touches > 0 ? real(report.totals.touches) : 1.0
  let mv = fn(u, t) { return get_in(u.movements.by_type, [t, "qty"], 0) }
  return [
    ["Receiving", [["Qty In", true, fn(u) { return u.receiving.qty_in }, "int", 10.0],
                   ["Qty Out", true, fn(u) { return u.receiving.qty_out }, "int", 10.0],
                   ["Scan Rows", false, fn(u) { return u.receiving.scans }, "int", 10.0]]],
    ["Picking", [["Units", true, fn(u) { return u.picking.qty }, "int", 10.0],
                 ["Orders", false, fn(u) { return u.picking.orders }, "int", 10.0],
                 ["Lines", false, fn(u) { return u.picking.lines }, "int", 10.0]]],
    ["Bin Movements", [["Qty", true, fn(u) { return u.movements.qty }, "int", 10.0],
                       ["Moves", false, fn(u) { return u.movements.moves }, "int", 10.0],
                       ["Item Qty", false, fn(u) { return mv(u, "item move") }, "int", 10.0],
                       ["Dolly Qty", false, fn(u) { return mv(u, "dolly move") }, "int", 10.0],
                       ["Merge Qty", false, fn(u) { return mv(u, "merge") }, "int", 10.0]]],
    ["Loads", [["Units", true, fn(u) { return u.loads.scans }, "int", 10.0],
               ["Orders", false, fn(u) { return u.loads.orders }, "int", 10.0],
               ["Dispatches", false, fn(u) { return u.loads.dispatches }, "int", 10.0],
               ["Avg Disp. Units", false, fn(u) { return u.loads.avgdispatchunits }, "dec", 12.0],
               ["Avg Disp. Min", false, fn(u) { return u.loads.avgloadtime }, "dec", 12.0],
               ["Skipped", false, fn(u) { return u.loads.manual }, "int", 10.0],
               ["Skipped %", false, fn(u) { return u.loads.manualpct }, "dec", 10.0],
               ["Force Comp.", false, fn(u) { return u.loads.forced }, "int", 10.0]]],
    ["Sticker Scan Out", [["Staged Units", true, fn(u) { return u.sticker.stagedunits }, "int", 11.0],
                          ["Staged Orders", false, fn(u) { return u.sticker.staged }, "int", 11.0],
                          ["Packed Orders", false, fn(u) { return u.sticker.packed }, "int", 11.0],
                          ["Packed Units", false, fn(u) { return u.sticker.packedunits }, "int", 11.0],
                          ["Bound Orders", false, fn(u) { return u.sticker.binds }, "int", 11.0]]],
    ["Overall", [["Touches", false, fn(u) { return u.touches }, "int", 11.0],
                 ["Days", false, fn(u) { return u.active_days }, "int", 9.0],
                 ["Per Day", false, fn(u) { return u.touches_per_day }, "dec", 10.0],
                 ["%", false, fn(u) { return 100.0 * real(u.touches) / grand }, "dec", 8.0],
                 ["First", false, fn(u) { return short_time(u.first_touch) }, "text", 12.0],
                 ["Last", false, fn(u) { return short_time(u.last_touch) }, "text", 12.0]]]
  ]
}

// A value as the PHP report prints it: whole numbers with thousands, one decimal (blank when zero), or text.
fn column_text(value, format) {
  if format == "text" { return value }
  if format == "dec" { return value == nil or real(value) == 0.0 ? "" : n1(value) }
  return n0(value)
}

// The PDF: the PHP report's quickReportHtml table and quickReportCss, Letter landscape, title in the page header.
fn render_pdf_report(report) {
  let css = join([
    "table.touches { border-collapse: collapse; width: 100%; font-size: 6.5pt; }",
    "table.touches th { background-color: #dddddd; border: 0.2mm solid #888888; padding: 0.8mm; text-align: center; }",
    "table.touches th.contrib { background-color: #ffd966; }",
    "table.touches td { border: 0.2mm solid #888888; padding: 0.8mm; text-align: right; }",
    "table.touches td.l { text-align: left; }",
    "table.touches td.t { white-space: nowrap; font-size: 6pt; }",
    "table.touches td.contrib { background-color: #fff2cc; }",
    "table.touches tr.total td { background-color: #eeeeee; font-weight: bold; }",
    "table.touches tr.total td.contrib { background-color: #ffe699; }",
    "div.key { font-size: 8pt; margin-bottom: 2mm; }",
    "span.swatch { display: inline-block; width: 4mm; height: 2.5mm; vertical-align: middle; background-color: #ffd966; border: 0.2mm solid #888888; }"
  ], " ")
  let sections = report_columns(report)
  let row = fn(u, cls, name) {
    let cells = [el("td", {"class": "l"}, name)]
    for sec in sections {
      for col in sec[1] {
        push(cells, el("td", {"class": [col[3] == "text" ? "t" : nil, col[1] ? "contrib" : nil]}, column_text(col[2](u), col[3])))
      }
    }
    return el("tr", {"class": cls}, cells)
  }
  let body = map(report.users, fn(u) { return row(u, nil, u.userid) })
  push(body, row(report.totals, "total", "All users"))
  let page = [
    el("div", {"class": "key"}, el("span", {"class": "swatch"}, NBSP + NBSP + NBSP), " Highlighted columns count toward total touches (units)"),
    el("table", {"class": "touches"},
       el("thead",
          el("tr", el("th", {"rowspan": 2}, "User"),
             map(sections, fn(sec) { return el("th", {"colspan": len(sec[1])}, sec[0]) })),
          el("tr", map(flatten(map(sections, fn(sec) { return sec[1] })),
                       fn(col) { return el("th", {"class": col[1] ? "contrib" : nil}, col[0]) }))),
       el("tbody", body))
  ]
  // mPDF('', 'Letter-L', 0, '', 8, 8, 18, 12, 6, 6): margins in mm, as points
  let mm = fn(v) { return int(v * 72.0 / 25.4 + 0.5) }
  return doc.pdf(html_stringify(page), css, {
    "page_size": "letter", "orientation": "landscape",
    "margin_left": mm(8), "margin_right": mm(8), "margin_top": mm(18), "margin_bottom": mm(12),
    "header": "Warehouse Touches " + report.start + " to " + report.stop,
    "footer": "Printed " + date_format(now(), "%Y-%m-%d %H:%M") + "   {PAGENO} / {nbpg}"
  })
}

// The XLSX: the same columns, a title row, the sections over their columns, the user rows and the totals.
fn render_xlsx_report(report) {
  let sections = report_columns(report)
  let cols = flatten(map(sections, fn(sec) { return sec[1] }))
  let ncol = len(cols) + 1
  let section_row = [{"v": "User", "s": "section"}]
  let merges = [[1, 1, 1, ncol], [3, 1, 4, 1]]
  let at = 2
  for sec in sections {
    push(section_row, {"v": sec[0], "s": "section"})
    for i in range(1, len(sec[1])) { push(section_row, {"v": "", "s": "section"}) }
    push(merges, [3, at, 3, at + len(sec[1]) - 1])
    at += len(sec[1])
  }
  let style = fn(col, total) {
    let base = col[3] == "text" ? "text" : (col[3] == "dec" ? "dec" : (col[1] ? "contrib_int" : "int"))
    if total { return "total_" + base }
    return base == "text" ? "plain" : base
  }
  let row = fn(u, name, total) {
    let cells = [{"v": name, "s": total ? "total_text" : "plain"}]
    for col in cols {
      let v = col[2](u)
      push(cells, {"v": col[3] == "dec" and v != nil ? round(real(v), 1) : v, "s": style(col, total)})   // decimals to one place
    }
    return cells
  }
  let rows = [
    [{"v": "Warehouse Touches " + report.start + " to " + report.stop + " (highlighted columns count toward total touches)", "s": "title"}],
    [],
    section_row,
    concat([{"v": "User", "s": "header"}], map(cols, fn(col) { return {"v": col[0], "s": col[1] ? "contrib_header" : "header"} }))
  ]
  for u in report.users { push(rows, row(u, u.userid, false)) }
  push(rows, row(report.totals, "All users", true))
  return doc.xlsx({
    "sheet": "Touches",
    "freeze_pane": "B5",
    "merges": merges,
    "col_widths": concat([16.0], map(cols, fn(col) { return col[4] })),
    "rows": rows
  })
}

// ---- CSV ----------------------------------------------------------------------------------------------------

fn render_csv_report(report) {
  let grand = report.totals.touches > 0 ? report.totals.touches : 1.0
  let mv = fn(u, t) { return get_in(u.movements.by_type, [t, "qty"], 0) }
  let line = fn(u, id, name, pct) {
    let r = u.receiving
    let p = u.picking
    let m = u.movements
    let l = u.loads
    let s = u.sticker
    return [id, name,
            r.qty_in, r.qty_out, r.scans,
            p.qty, p.orders, p.lines,
            m.qty, m.moves, mv(u, "item move"), mv(u, "dolly move"), mv(u, "merge"),
            l.scans, l.orders, l.dispatches, l.avgdispatchunits, l.avgloadtime, l.manual, l.manualpct, l.forced,
            s.stagedunits, s.staged, s.packed, s.packedunits, s.binds,
            u.touches, u.active_days, u.touches_per_day, pct,
            short_time(u.first_touch), short_time(u.last_touch)]
  }
  let rows = map(report.users, fn(u) {
    return line(u, u.userid, first_present(u.name, u.realname, u.userid), round((100.0 * real(u.touches)) / real(grand), 1))
  })
  push(rows, line(report.totals, "ALL USERS", "All Warehouse Operators", 100.0))
  return doc.csv([
    "User", "Name",
    "Rec Qty In", "Rec Qty Out", "Rec Scans",
    "Pick Units", "Pick Orders", "Pick Lines",
    "Move Qty", "Move Count", "Item Move Qty", "Dolly Move Qty", "Merge Qty",
    "Load Units", "Load Orders", "Dispatches", "Avg Units/Disp", "Avg Load Min", "Skipped Scans", "Skipped Pct", "Force Comp",
    "Staged Units", "Staged Orders", "Packed Orders", "Packed Units", "Bound Orders",
    "Total Touches", "Active Days", "Touches/Day", "Pct of Total", "First Touch", "Last Touch"
  ], rows)
}

// ---- The page -----------------------------------------------------------------------------------------------

// The page: the same page as apir/warehouse/touches/quickreportview in the PHP report (catalog/controller/apir/
// warehouse/touches.php) - its markup, styles and sort - with the figures kept live: /quickreportevents pushes a new
// <div id="live"> whenever a day of the range changes (WAIT THING on touch_day), and the page swaps it in.

// The five sources that make up touches, in column order: key, label, colour variable.
let SOURCES = [["receiving", "Receiving", "--rec"], ["picking", "Picking", "--pick"], ["movements", "Bin moves", "--move"],
               ["loads", "Loads", "--load"], ["sticker", "Sticker scan out", "--stick"]]
let UNITS_TAG = el("span", {"style": "font-style: italic; font-size: 10px"}, NBSP + "units")

fn dot(var) { return el("i", {"class": "dot", "style": "background:var(" + var + ")"}) }
// the number that counts toward touches
fn main_num(var, value) { return el("b", {"class": "c", "style": "--c:var(" + var + ")"}, n0(value), UNITS_TAG) }
fn small(text) { return el("small", text) }

// The line under the title: the range.
fn render_badge(report) { return html_escape(day_text(report.start) + " \u{2013} " + day_text(report.stop)) }

// the counted part of each source for a user (or the totals)
fn source_parts(u) {
  return {"receiving": u.receiving.qty_in + u.receiving.qty_out, "picking": u.picking.qty, "movements": u.movements.qty,
          "loads": u.loads.scans, "sticker": u.sticker.stagedunits}
}

// the context lines under each counted number, for a user row and for the totals row
fn source_cells(u) {
  let l = u.loads
  let st = u.sticker
  let rec_extra = u.receiving.qty_out > 0 ? MID + n0(u.receiving.qty_in) + " in / " + n0(u.receiving.qty_out) + " out" : ""
  return {
    "receiving": small(n0(u.receiving.scans) + " scan rows" + rec_extra),
    "picking": small(n0(u.picking.orders) + " orders" + MID + n0(u.picking.lines) + " lines"),
    "movements": small(n0(u.movements.moves) + " moves"),
    "loads": [small(n0(l.dispatches) + " disp" + MID + "avg " + n1(l.avgloadtime) + " min" + MID + "avg " + n1(l.avgdispatchunits) + " units"),
              small(n1(l.manualpct) + "% skipped (" + n0(l.manual) + ")" + MID + n0(l.forced) + " force completed")],
    "sticker": [small(n0(st.staged) + " staged orders"),
                small("packed " + n0(st.packed) + " ord" + MID + n0(st.packedunits) + " units" + MID + n0(st.binds) + " bound")]
  }
}

// What changes with the data: the cards, the note and the "By person" panel.
fn render_live(report) {
  let t = report.totals
  let pt = source_parts(t)
  let lasts = report.lasts == nil ? {} : report.lasts
  let last_line = fn(src) {
    let at = src != nil ? lasts[src] : (len(lasts) == 0 ? nil : max(values(lasts)))
    return el("div", {"class": "last"}, at == nil ? "no touches" : "last touch " + when(at))
  }
  let card = fn(src, value, sub) {
    return el("div", {"class": "card"}, el("div", {"class": "label"}, dot(src[2]), src[1]), el("div", {"class": "value"}, value, UNITS_TAG),
              el("div", {"class": "sub"}, sub), last_line(src[0]))
  }
  let cards = el("div", {"class": "cards"},
    el("div", {"class": "card total"}, el("div", {"class": "label"}, "Total touches"), el("div", {"class": "value"}, n0(t.touches)),
       el("div", {"class": "sub"}, "units" + MID + n0(len(report.users)) + " people" + MID + n0(t.active_days) + " active days"), last_line(nil)),
    card(SOURCES[0], n0(pt.receiving), n0(t.receiving.qty_in) + " in / " + n0(t.receiving.qty_out) + " out" + MID +
                                       n0(t.receiving.scans) + " scan rows" + MID + "under " + n0(t.receiving.vendors) + " vendors"),
    card(SOURCES[1], n0(pt.picking), n0(t.picking.orders) + " orders" + MID + n0(t.picking.lines) + " lines"),
    card(SOURCES[2], n0(pt.movements), n0(t.movements.moves) + " moves"),
    card(SOURCES[3], n0(pt.loads), n0(t.loads.dispatches) + " dispatches" + MID + n1(t.loads.manualpct) + "% skipped (" + n0(t.loads.manual) + ")"),
    card(SOURCES[4], n0(pt.sticker), n0(t.sticker.staged) + " staged orders" + MID + n0(t.sticker.stagedunits) + " units staged"))
  let note = el("p", {"class": "note"}, "Touches are units. The bold colored number in each column is what counts toward touches: units received " +
                "(in + out), units picked, units moved and units staged. The lines under it are context only.")

  let nil_cell = el("span", {"class": "nil"}, "\u{2013}")
  let top = max(1.0, max(concat([0.0], map(report.users, fn(u) { return real(u.touches) }))))
  let rows = []
  for pair in enumerate(report.users) {
    let rank = pair[0] + 1
    let u = pair[1]
    let p = source_parts(u)
    let sub = source_cells(u)
    let name = first_present(u.name, u.userid)
    let title = join(map(SOURCES, fn(src) { return src[1] + " " + n0(p[src[0]]) }), " / ")
    let bar = map(SOURCES, fn(src) { return el("span", {"style": "background:var(" + src[2] + ");width:" + str(round(100.0 * real(p[src[0]]) / top, 2)) + "%"}) })
    push(rows, el("tr",
      el("td", {"class": "rank", "data-v": rank}, rank),
      el("td", {"class": "who", "data-v": lower(name)}, el("b", name), el("small", u.userid)),
      el("td", {"data-v": str(u.touches)}, el("b", n0(u.touches)), el("div", {"class": "bar", "title": title}, bar)),
      map(SOURCES, fn(src) { let v = p[src[0]]; return el("td", {"data-v": str(v)}, v > 0 ? [main_num(src[2], v), sub[src[0]]] : nil_cell) }),
      el("td", {"data-v": str(u.active_days)}, n0(u.active_days)),
      el("td", {"data-v": str(u.touches_per_day)}, n1(u.touches_per_day)),
      el("td", {"class": "when", "data-v": u.first_touch}, when(u.first_touch), el("small", "to " + when(u.last_touch)))))
  }
  if len(rows) == 0 { push(rows, el("tr", el("td", {"colspan": 11, "class": "empty"}, "No warehouse activity in this range."))) }

  let tsub = source_cells(t)
  let head = [el("th", {"class": "l", "data-col": 0}, "#"), el("th", {"class": "l", "data-col": 1}, "Person"),
              el("th", {"data-col": 2, "data-dir": "desc"}, "Touches")]
  let foot = [el("td"), el("td", {"class": "who"}, "All users"), el("td", n0(t.touches))]
  for pair in enumerate(SOURCES) {
    let src = pair[1]
    push(head, el("th", {"class": "contrib", "style": "--c:var(" + src[2] + ")", "data-col": pair[0] + 3, "title": "Counts toward touches"}, src[1]))
    push(foot, el("td", main_num(src[2], pt[src[0]]), tsub[src[0]]))
  }
  push(head, el("th", {"data-col": 8}, "Days"), el("th", {"data-col": 9}, "Per day"), el("th", {"data-col": 10}, "First / last"))
  push(foot, el("td", n0(t.active_days)), el("td", n1(t.touches_per_day)),
       el("td", {"class": "when"}, when(t.first_touch), el("small", "to " + when(t.last_touch))))
  let legend = map(SOURCES, fn(src) { return el("span", dot(src[2]), src[1]) })

  let panel = el("div", {"class": "panel"},
    el("div", {"class": "panel-head"}, el("h2", "By person"), el("div", {"class": "legend"}, legend)),
    el("div", {"class": "scroll"}, el("table", el("thead", el("tr", head)), el("tbody", rows), el("tfoot", el("tr", foot)))))
  return html_stringify([cards, note, panel])
}

let PAGE_CSS = join([
  ":root { --bg: #f5f6f8; --panel: #ffffff; --line: #e3e6ea; --text: #1d2228; --muted: #6b7480; --rec: #2f7de1; --pick: #e8912d; --move: #3aa776; --load: #8a63d2; --stick: #d6477f; --head: #fafbfc; }",
  "@media (prefers-color-scheme: dark) { :root { --bg: #111418; --panel: #1a1f25; --line: #2b323a; --text: #e8ebee; --muted: #98a2ad; --head: #20262d; } }",
  "* { box-sizing: border-box; }",
  "body { margin: 0; background: var(--bg); color: var(--text); font: 14px/1.4 -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif; }",
  ".page { max-width: 1400px; margin: 0 auto; padding: 24px 16px 40px; }",
  "header { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 20px; }",
  "h1 { margin: 0; font-size: 22px; } .range { color: var(--muted); margin-top: 4px; }",
  "form { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }",
  "form label { color: var(--muted); font-size: 12px; }",
  "input[type=date] { padding: 6px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--panel); color: var(--text); font: inherit; }",
  ".btn { padding: 7px 14px; border-radius: 6px; border: 1px solid var(--line); background: var(--panel); color: var(--text); font: inherit; text-decoration: none; cursor: pointer; }",
  ".btn.primary { background: var(--rec); border-color: var(--rec); color: #ffffff; }",
  ".cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 8px; }",
  ".card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }",
  ".card.total { border-width: 2px; }",
  ".card .label { color: var(--muted); font-size: 13px; } .card .value { font-size: 28px; font-weight: 600; margin: 2px 0; } .card .sub { color: var(--muted); font-size: 12px; }",
  ".note { color: var(--muted); font-size: 12px; margin: 0 0 20px; }",
  ".card .last { color: var(--muted); font-size: 11px; margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--line); }",
  ".clock { text-align: center; font-variant-numeric: tabular-nums; } .clock .time { font-size: 22px; font-weight: 600; } .clock .day { color: var(--muted); font-size: 12px; }",
  ".dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; vertical-align: 0; }",
  ".panel { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }",
  ".panel-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; padding: 12px 16px; border-bottom: 1px solid var(--line); }",
  ".panel-head h2 { margin: 0; font-size: 15px; }",
  ".legend { display: flex; flex-wrap: wrap; gap: 14px; color: var(--muted); font-size: 12px; }",
  ".scroll { overflow-x: auto; }",
  "table { width: 100%; border-collapse: collapse; min-width: 1150px; }",
  "th { background: var(--head); color: var(--muted); font-size: 12px; font-weight: 600; text-align: right; padding: 9px 12px; border-bottom: 1px solid var(--line); cursor: pointer; user-select: none; white-space: nowrap; }",
  "th.contrib { color: var(--text); border-top: 3px solid var(--c); }",
  "th.l, td.who, td.rank { text-align: left; } th[data-dir=asc]::after { content: \" \\25B2\"; } th[data-dir=desc]::after { content: \" \\25BC\"; }",
  "td { text-align: right; padding: 9px 12px; border-bottom: 1px solid var(--line); vertical-align: top; white-space: nowrap; }",
  "td small { display: block; color: var(--muted); font-size: 11px; }",
  "td.rank { color: var(--muted); width: 36px; } td.when { font-size: 12px; }",
  ".c { color: var(--c); } .c::before { content: \"\"; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--c); margin-right: 5px; }",
  ".bar { display: flex; height: 6px; margin-top: 5px; border-radius: 3px; overflow: hidden; background: var(--line); min-width: 140px; }",
  ".bar span { display: block; height: 100%; }",
  "tfoot td { font-weight: 600; background: var(--head); border-bottom: 0; }",
  ".nil { color: var(--muted); }",
  "td.empty { text-align: center; color: var(--muted); padding: 30px; }",
  "#live.pulse .card.total { animation: pulse 1.2s ease-out; }",
  "@keyframes pulse { from { border-color: var(--rec); } to { border-color: var(--line); } }",
  "@media print { body { background: #ffffff; } form, .btn { display: none; } .card, .panel { break-inside: avoid; } }"
], chr(10))

// The PHP page's table sort, bound again after each pushed update (the sort kept), and the event stream.
let PAGE_JS = join([
  "var sortCol = null, sortDir = null;",
  "function sortBy(th, dir) {",
  "    var col = +th.dataset.col;",
  "    document.querySelectorAll('th[data-col]').forEach(function (h) { h.removeAttribute('data-dir'); });",
  "    th.dataset.dir = dir;",
  "    var body = th.closest('table').tBodies[0], rows = Array.prototype.slice.call(body.rows);",
  "    rows.sort(function (a, b) {",
  "        var x = a.cells[col].dataset.v || '', y = b.cells[col].dataset.v || '';",
  "        // a number only when the whole value is one: parseFloat('2026-09-28 08:20') is 2026 for every row",
  "        var nx = x.trim() === '' ? NaN : Number(x), ny = y.trim() === '' ? NaN : Number(y);",
  "        var c = (!isNaN(nx) && !isNaN(ny)) ? nx - ny : x.localeCompare(y);",
  "        if (c === 0) c = (a.cells[1].dataset.v || '').localeCompare(b.cells[1].dataset.v || '');   // ties: by name, every time",
  "        return dir === 'asc' ? c : -c;",
  "    });",
  "    rows.forEach(function (r) { body.appendChild(r); });",
  "}",
  "function bindSort() {",
  "    document.querySelectorAll('th[data-col]').forEach(function (th) {",
  "        th.addEventListener('click', function () {",
  "            sortCol = th.dataset.col; sortDir = th.dataset.dir === 'desc' ? 'asc' : 'desc';",
  "            sortBy(th, sortDir);",
  "        });",
  "    });",
  "    if (sortCol !== null) { var th = document.querySelector('th[data-col=\"' + sortCol + '\"]'); if (th) sortBy(th, sortDir); }",
  "}",
  "bindSort();",
  "function tick() {",
  "    var d = new Date();",
  "    document.getElementById('clock-time').textContent = d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit', second: '2-digit' });",
  "    document.getElementById('clock-day').textContent = d.toLocaleDateString([], { weekday: 'long', month: 'short', day: 'numeric' });",
  "}",
  "tick(); setInterval(tick, 1000);",
  "if (window.EventSource) {",
  "    var es = new EventSource('/quickreportevents' + location.search);",
  "    es.addEventListener('report', function (m) {",
  "        try {",
  "            var d = JSON.parse(m.data), live = document.getElementById('live');",
  "            var sc = live.querySelector('.scroll'), left = sc ? sc.scrollLeft : 0, top = window.scrollY;",
  "            live.innerHTML = d.live;",
  "            sc = live.querySelector('.scroll'); if (sc) sc.scrollLeft = left;",
  "            window.scrollTo(window.scrollX, top);",
  "            document.getElementById('range').innerHTML = d.badge;",
  "            bindSort();",
  "            live.classList.remove('pulse'); void live.offsetWidth; live.classList.add('pulse');",
  "        } catch (e) {}",
  "    });",
  "}"
], chr(10))

fn render_html_dashboard(report, input) {
  let q = "?start=" + report.start + "&stop=" + report.stop
  return "<!doctype html>" + html_stringify(el("html",
    el("head", el("meta", {"charset": "utf-8"}), el("meta", {"name": "viewport", "content": "width=device-width, initial-scale=1"}),
       el("title", "Warehouse Activity " + report.start + " to " + report.stop), el("style", PAGE_CSS)),
    el("body",
      el("div", {"class": "page"},
        el("header",
          el("div", el("h1", "Warehouse Activity"), el("div", {"class": "range", "id": "range"}, html_raw(render_badge(report)))),
          el("div", {"class": "clock", "aria-live": "off"}, el("div", {"class": "time", "id": "clock-time"}), el("div", {"class": "day", "id": "clock-day"})),
          el("form", {"method": "get", "action": "/quickreportview"},
            el("label", "From"), el("input", {"type": "date", "name": "start", "value": report.start}),
            el("label", "To"), el("input", {"type": "date", "name": "stop", "value": report.stop}),
            el("button", {"type": "submit", "class": "btn primary"}, "Run"),
            el("a", {"class": "btn", "href": "/quickreportpdf" + q}, "Export PDF"),
            el("a", {"class": "btn", "href": "/quickreportxlsx" + q}, "Export Excel"))),
        el("div", {"id": "live"}, html_raw(render_live(report)))),
      el("script", PAGE_JS))))
}
