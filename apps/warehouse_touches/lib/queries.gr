// Warehouse touches: the report the PHP touches report gives (catalog/controller/apir/warehouse/touches.php,
// quickReportData), read from the touch_day Thing the engine keeps current (things/touch_day.gr).
//
// The Thing holds one day per key: every user's sums and the distinct sets (items, vendors, orders, moves, sticker
// orders, binds, load runs) a range has to union rather than add. A report reads the days of its range and merges
// them into the same user records and totals the PHP report builds.

fn blank_user(userid) {
  return {
    "userid": userid,
    "name": "",
    "receiving": {"scans": 0, "qty_in": 0.0, "qty_out": 0.0, "items": 0, "vendors": 0},
    "picking": {"lines": 0, "qty": 0.0, "orders": 0},
    "movements": {
      "moves": 0, "qty": 0.0,
      "by_type": {
        "item move": {"moves": 0, "qty": 0.0},
        "dolly move": {"moves": 0, "qty": 0.0},
        "merge": {"moves": 0, "qty": 0.0}
      }
    },
    "loads": {"scans": 0.0, "orders": 0, "dispatches": 0, "avgloadtime": 0.0, "avgdispatchunits": 0.0, "manual": 0, "manualpct": 0.0, "forced": 0},
    "sticker": {"packed": 0, "packedunits": 0.0, "staged": 0, "stagedunits": 0.0, "binds": 0},
    "touches": 0.0,
    "parts": {"receiving": 0.0, "picking": 0.0, "movements": 0.0, "loads": 0.0, "sticker": 0.0},
    "active_days": 0,
    "first_touch": nil,
    "last_touch": nil,
    "touches_per_day": 0.0
  }
}

fn stamp_touch(user, first, last) {
  if first != nil and first != "" and (user.first_touch == nil or first < user.first_touch) { user.first_touch = first }
  if last != nil and last != "" and (user.last_touch == nil or last > user.last_touch) { user.last_touch = last }
}

fn is_day(d) { return d != nil and regex_test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$", str(d)) }

// Every day from start to stop, both included.
fn days_between(start_date, stop_date) {
  if not is_day(start_date) or not is_day(stop_date) { return [] }
  let out = []
  let t = date_parse(start_date)
  let end = date_parse(stop_date)
  while t <= end and len(out) < 4000 {
    push(out, date_format(t, "%Y-%m-%d", "utc"))
    t = t + 86400
  }
  return out
}

// The PHP report's range: stop defaults to today, start to 29 days before stop (30 days, today included).
fn report_range(start, stop) {
  let today = date_format(now(), "%Y-%m-%d")
  let b = is_day(stop) ? str(stop) : today
  let a = is_day(start) ? str(start) : date_format(date_parse(b) - 29 * 86400, "%Y-%m-%d", "utc")
  return [a, b]
}

// 'YYYY-MM-DD HH:MM:SS' as seconds (for a load's length), nil when it is not one
fn secs_of(ts) {
  if ts == nil { return nil }
  let s = str(ts)
  if len(s) < 19 or slice(s, 0, 4) < "1971" { return nil }
  return date_make(int(slice(s, 0, 4)), int(slice(s, 5, 7)), int(slice(s, 8, 10)), int(slice(s, 11, 13)), int(slice(s, 14, 16)), int(slice(s, 17, 19)), "utc")
}

fn touch_days(db, start_date, stop_date) {
  let ds = days_between(start_date, stop_date)
  if len(ds) == 0 { return [] }
  let quoted = []
  for d in ds { push(quoted, "'" + d + "'") }
  let r = db_query(db, "SHOW THING touch_day KEYS (" + join(quoted, ", ") + ")", [])
  if not r.ok { error("touch_day: " + r.error) }
  let out = []
  for row in r.records { push(out, {"day": str(row.day), "users": json_parse(row.users), "runs": row.runs == nil ? [] : json_parse(row.runs)}) }
  return out
}

fn r1(v) { return round(real(v), 1) }

fn fetch_warehouse_touches(db, start_in, stop_in, userids) {
  let range = report_range(start_in, stop_in)
  let start_date = range[0]
  let stop_date = range[1]
  let rows = touch_days(db, start_date, stop_date)

  let users = {}
  let days = {}
  let get_user = fn(key, uid) {
    if users[key] == nil { users[key] = blank_user(uid) }
    if days[key] == nil { days[key] = {} }
    return users[key]
  }
  let add_all = fn(m, list) { for v in list { m[v] = true } }
  let sets = {}   // key -> the distinct sets merged across the days
  let set_of = fn(key) {
    if sets[key] == nil { sets[key] = {"items": {}, "vendors": {}, "orders": {}, "moves": {}, "packed": {}, "staged": {}, "binds": {}} }
    return sets[key]
  }
  let all_items = {}
  let all_vendors = {}
  let all_orders = {}
  let load_secs = {}
  let load_timed = {}

  // In the PHP report's order (receiving, picking, moves, loads, sticker): a user's id is shown as the first source has it.
  for part in ["rec", "pick", "moves", "loads", "sticker"] {
    if part == "loads" {
      // a run over several days is one run: its rows combined, then counted once per name on its dispatch
      let runs = {}
      let units = {}
      // the trucks of every run in the range: a dispatch row counts when its truck is one of them (the PHP report's
      // d.truckid IN (...))
      let range_trucks = {}
      for dayrow in rows { for id in dayrow.runs { range_trucks[split(str(id), "-")[1]] = true } }
      for dayrow in rows {
        for key in keys(dayrow.users) {
          let d = dayrow.users[key]
          for id in keys(d.runs) {
            let r = d.runs[id]
            if runs[key] == nil { runs[key] = {"uid": d.userid, "dname": d.dname, "runs": {}} }
            let c = runs[key].runs[id]
            if c == nil {
              runs[key].runs[id] = {"k": r.k, "manual": r.manual, "forced": r.forced, "untimed": r.untimed, "assigned": r.assigned, "started": r.started, "stopped": r.stopped}
            } else {
              c.manual = c.manual + r.manual
              c.forced = c.forced or r.forced
              c.untimed = c.untimed or r.untimed
              if r.assigned != nil and (c.assigned == nil or r.assigned < c.assigned) { c.assigned = r.assigned }
              if r.started != nil and (c.started == nil or r.started < c.started) { c.started = r.started }
              if r.stopped != nil and (c.stopped == nil or r.stopped > c.stopped) { c.stopped = r.stopped }
            }
          }
          for id in keys(d.units) {
            if not range_trucks[split(id, "-")[1]] { continue }
            if units[key] == nil { units[key] = {"uid": d.userid, "dname": d.dname, "runs": {}} }
            if units[key].runs[id] == nil { units[key].runs[id] = d.units[id] }   // the same on every day the run is on
          }
        }
      }
      for key in keys(runs) {
        let u = get_user(key, runs[key].uid)
        if (u.name == nil or u.name == "") and runs[key].dname != nil { u.name = runs[key].dname }
        for id in keys(runs[key].runs) {
          let run = runs[key].runs[id]
          u.loads.dispatches = u.loads.dispatches + run.k
          u.loads.manual = u.loads.manual + run.manual * run.k
          if run.forced { u.loads.forced = u.loads.forced + run.k }
          let a = secs_of(run.started)
          let b = secs_of(run.stopped)
          if not run.untimed and a != nil and b != nil and b >= a {
            load_secs[key] = (load_secs[key] == nil ? 0 : load_secs[key]) + (b - a) * run.k
            load_timed[key] = (load_timed[key] == nil ? 0 : load_timed[key]) + run.k
          }
          let last_t = run.stopped != nil ? run.stopped : run.assigned
          stamp_touch(u, run.started != nil ? run.started : run.assigned, last_t)
          if last_t != nil and len(last_t) >= 10 { days[key][slice(last_t, 0, 10)] = true }
        }
      }
      for key in keys(units) {
        let by_name = {}
        for id in keys(units[key].runs) {
          for dv in keys(units[key].runs[id]) {
            if by_name[dv] == nil { by_name[dv] = {"units": 0.0, "orders": {}} }
            by_name[dv].units = by_name[dv].units + real(units[key].runs[id][dv].units)
            add_all(by_name[dv].orders, units[key].runs[id][dv].orders)
          }
        }
        let u = get_user(key, units[key].uid)
        if (u.name == nil or u.name == "") and units[key].dname != nil { u.name = units[key].dname }
        for dv in keys(by_name) {
          u.loads.scans = u.loads.scans + by_name[dv].units
          u.loads.orders = u.loads.orders + len(keys(by_name[dv].orders))
        }
      }
      continue
    }
    for dayrow in rows {
      for key in keys(dayrow.users) {
        let d = dayrow.users[key]
        if part == "rec" {
          if d.rec.scans > 0 {
            let u = get_user(key, d.userid)
            u.receiving.scans = u.receiving.scans + d.rec.scans
            u.receiving.qty_in = u.receiving.qty_in + real(d.rec.qty_in)
            u.receiving.qty_out = u.receiving.qty_out + real(d.rec.qty_out)
            add_all(set_of(key).items, d.rec.items)
            add_all(set_of(key).vendors, d.rec.vendors)
            add_all(all_items, d.rec.items)
            add_all(all_vendors, d.rec.vendors)
          }
          if d.active {   // a receiving, pick, move or sticker touch that day
            if days[key] == nil { days[key] = {} }
            days[key][dayrow.day] = true
          }
        } else if part == "pick" and d.pick.lines > 0 {
          let u = get_user(key, d.userid)
          u.picking.lines = u.picking.lines + d.pick.lines
          u.picking.qty = u.picking.qty + real(d.pick.qty)
          add_all(set_of(key).orders, d.pick.orders)
          add_all(all_orders, d.pick.orders)
        } else if part == "moves" and len(keys(d.moves)) > 0 {
          let u = get_user(key, d.userid)
          let s = set_of(key)
          for t in keys(d.moves) {
            if u.movements.by_type[t] == nil { u.movements.by_type[t] = {"moves": 0, "qty": 0.0} }
            u.movements.by_type[t].qty = u.movements.by_type[t].qty + real(d.moves[t].qty)
            u.movements.qty = u.movements.qty + real(d.moves[t].qty)
            if s.moves[t] == nil { s.moves[t] = {} }
            add_all(s.moves[t], d.moves[t].pairs)
          }
        } else if part == "sticker" and (len(keys(d.packed)) > 0 or len(keys(d.staged)) > 0 or len(d.binds) > 0) {
          get_user(key, d.userid)
          let s = set_of(key)
          for side in ["packed", "staged"] {
            for o in keys(d[side]) {
              let have = s[side][o]
              let mine = d[side][o]
              if have == nil { s[side][o] = {"t": mine.t, "f": real(mine.f)} }
              else if real(mine.f) > have.f { have.f = real(mine.f) }
            }
          }
          add_all(s.binds, d.binds)
        }
      }
    }
  }
  // first and last touch of receiving, picking, moves and sticker (loads were stamped above); and each source's
  // latest touch over everyone, for its stat card
  let lasts = {}
  let later = fn(src, t) { if t != nil and t != "" and (lasts[src] == nil or t > lasts[src]) { lasts[src] = t } }
  for dayrow in rows {
    for key in keys(dayrow.users) {
      let d = dayrow.users[key]
      if users[key] != nil and (d.first != nil or d.last != nil) { stamp_touch(users[key], d.first, d.last) }
      if d.lasts != nil { for src in keys(d.lasts) { later(src, d.lasts[src]) } }
      for id in keys(d.runs) { later("loads", d.runs[id].stopped != nil ? d.runs[id].stopped : d.runs[id].assigned) }
    }
  }
  for key in keys(sets) {
    let u = users[key]
    let s = sets[key]
    u.receiving.items = len(keys(s.items))
    u.receiving.vendors = len(keys(s.vendors))
    u.picking.orders = len(keys(s.orders))
    for t in keys(s.moves) {
      let n = len(keys(s.moves[t]))
      u.movements.by_type[t].moves = u.movements.by_type[t].moves + n
      u.movements.moves = u.movements.moves + n
    }
    for side in ["packed", "staged"] {
      let units = 0.0
      for o in keys(s[side]) { units = units + (s[side][o].t != nil ? real(s[side][o].t) : s[side][o].f) }
      u.sticker[side] = len(keys(s[side]))
      u.sticker[side + "units"] = units
    }
    u.sticker.binds = len(keys(s.binds))
  }
  // real names (www_users holds password hashes too: only the name columns are read)
  let n_res = pcall(db_query, db, "SELECT userid, realname FROM www_users")
  if n_res.ok and n_res.value.records != nil {
    for row in n_res.value.records {
      let k = lower(row.userid)
      if users[k] != nil and row.realname != nil { users[k].name = trim(row.realname) }
    }
  }
  let report = rollup(users, days, start_date, stop_date, {"items": len(keys(all_items)), "vendors": len(keys(all_vendors)),
                      "orders": len(keys(all_orders)), "secs": load_secs, "timed": load_timed})
  report.lasts = lasts
  return report
}

// Touches, rates and totals, as the PHP report works them out. users: lower(userid) -> record; days: lower(userid) ->
// {day: true}; distinct: the totals that are distinct across users (items, vendors, orders) and the load timings.
fn rollup(users, days, start_date, stop_date, distinct) {
  let totals = blank_user("TOTAL")
  totals.name = "All users"
  totals.receiving.items = distinct.items
  totals.receiving.vendors = distinct.vendors
  totals.picking.orders = distinct.orders
  let all_days = {}
  let user_list = []
  let secs_all = 0
  let timed_all = 0
  for k in keys(users) {
    let u = users[k]
    let timed = distinct.timed[k]
    u.loads.avgloadtime = timed != nil and timed > 0 ? r1(distinct.secs[k] / timed / 60.0) : 0.0
    if timed != nil { secs_all = secs_all + distinct.secs[k]; timed_all = timed_all + timed }
    u.loads.avgdispatchunits = u.loads.dispatches > 0 ? r1(u.loads.scans / real(u.loads.dispatches)) : 0.0
    u.loads.manualpct = u.loads.scans > 0 ? r1(100.0 * real(u.loads.manual) / u.loads.scans) : 0.0
    u.parts = {"receiving": u.receiving.qty_in + u.receiving.qty_out, "picking": u.picking.qty, "movements": u.movements.qty,
               "loads": u.loads.scans, "sticker": u.sticker.stagedunits}
    u.touches = u.parts.receiving + u.parts.picking + u.parts.movements + u.parts.loads + u.parts.sticker
    let u_days = days[k] != nil ? keys(days[k]) : []
    u.active_days = len(u_days)
    u.touches_per_day = u.active_days > 0 ? r1(u.touches / real(u.active_days)) : 0.0
    for d in u_days { all_days[d] = true }
    stamp_touch(totals, u.first_touch, u.last_touch)
    totals.touches = totals.touches + u.touches
    for f in ["scans", "qty_in", "qty_out"] { totals.receiving[f] = totals.receiving[f] + u.receiving[f] }
    for f in ["lines", "qty"] { totals.picking[f] = totals.picking[f] + u.picking[f] }
    for f in ["scans", "orders", "dispatches", "manual", "forced"] { totals.loads[f] = totals.loads[f] + u.loads[f] }
    for f in ["packed", "packedunits", "staged", "stagedunits", "binds"] { totals.sticker[f] = totals.sticker[f] + u.sticker[f] }
    for p in keys(u.parts) { totals.parts[p] = totals.parts[p] + u.parts[p] }
    for f in ["moves", "qty"] {
      totals.movements[f] = totals.movements[f] + u.movements[f]
      for t in keys(u.movements.by_type) {
        if totals.movements.by_type[t] == nil { totals.movements.by_type[t] = {"moves": 0, "qty": 0.0} }
        totals.movements.by_type[t][f] = totals.movements.by_type[t][f] + u.movements.by_type[t][f]
      }
    }
    push(user_list, u)
  }
  totals.loads.avgloadtime = timed_all > 0 ? r1(secs_all / timed_all / 60.0) : 0.0
  totals.loads.avgdispatchunits = totals.loads.dispatches > 0 ? r1(totals.loads.scans / real(totals.loads.dispatches)) : 0.0
  totals.loads.manualpct = totals.loads.scans > 0 ? r1(100.0 * real(totals.loads.manual) / totals.loads.scans) : 0.0
  totals.active_days = len(keys(all_days))
  totals.touches_per_day = totals.active_days > 0 ? r1(totals.touches / real(totals.active_days)) : 0.0
  // busiest first
  user_list = sort_by(user_list, fn(u) { return -u.touches })
  let i = 0
  while i < len(user_list) {
    user_list[i].rank = i + 1
    i += 1
  }
  return {"start": start_date, "stop": stop_date, "users": user_list, "totals": totals}
}
