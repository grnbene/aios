// Warehouse Touches Reporting Service
//
// Serves warehouse touch metrics, PDF reports, Excel exports and interactive dashboard.
//
// Endpoints:
//   GET /quickreport       JSON API
//   GET /quickreportview   HTML interactive dashboard
//   GET /quickreportpdf    Native vector PDF report
//   GET /quickreportxlsx   Native OpenXML spreadsheet (.xlsx) export
//   GET /health            Health check

import "lib/queries.gr"
import "lib/views.gr"

let DB_CFG = {
  "host": env("DB_HOST", env("ASQL_HOST", "127.0.0.1")),
  "port": int(env("DB_PORT", env("ASQL_PORT", "3307"))),
  "user": env("DB_USER", env("ASQL_USER", "root")),
  "password": secret("DB_PASSWORD"),
  "db": env("DB_NAME", env("ASQL_DB", "versioneight"))
}

let db_conn = nil

fn get_db() {
  if db_conn != nil { return db_conn }
  let c = db_connect(DB_CFG)
  db_conn = c
  return c
}

fn report(db, p) { return fetch_warehouse_touches(db, p.start, p.stop, p.userid) }

// start / stop from the query (or a range "a..b"); missing or not a date, the PHP report's defaults: the last 30
// days, today included (report_range in lib/queries.gr).
fn parse_date_params(req) {
  let q = req.query_params ?? {}
  let start = q.start
  let stop = q.stop
  if q.range != nil and contains(str(q.range), "..") {
    let rparts = split(str(q.range), "..")
    if len(rparts) >= 2 { start = rparts[0]; stop = rparts[1] }
  }
  let r = report_range(start, stop)
  return {"start": r[0], "stop": r[1], "userid": q.userid}
}

// ---- Route Handlers ----------------------------------------------------------

fn handle_health(req) {
  return {"status": 200, "content_type": "application/json", "body": "{\"status\":\"ok\"}"}
}

fn handle_quickreport(req) {
  let p = parse_date_params(req)
  let db = get_db()
  let data = report(db, p)
  return {"status": 200, "content_type": "application/json; charset=utf-8", "json": data}
}

fn handle_quickreportview(req) {
  let p = parse_date_params(req)
  let db = get_db()
  let data = report(db, p)
  let html = render_html_dashboard(data, p)
  return {"status": 200, "content_type": "text/html; charset=utf-8", "body": html}
}

// The exports: the report as a file to save, named for its range.
fn export(req, ext, render) {
  let data = report(get_db(), parse_date_params(req))
  return res_download(render(data), "warehouse-touches-" + data.start + "-to-" + data.stop + "." + ext, {"Access-Control-Allow-Origin": "*"})
}

fn handle_quickreportpdf(req) { return export(req, "pdf", render_pdf_report) }
fn handle_quickreportxlsx(req) { return export(req, "xlsx", render_xlsx_report) }
fn handle_quickreportcsv(req) { return export(req, "csv", render_csv_report) }

// GET /quickreportevents?start&stop: server-sent events for an open dashboard. The engine wakes this route when the
// touch_day Thing changes (WAIT THING - nothing here polls); when a day of the range is among the changed ones, the
// report is read again and pushed as `report` {badge, live}, which the page swaps in. A comment goes out when a wait
// times out with nothing new, so a closed page is noticed and the route ends.
fn handle_events(req, writer) {
  let p = parse_date_params(req)
  let in_range = add_keys({}, date_range(p.start, p.stop))
  // WAIT holds its connection while it waits, so this stream has one of its own
  let w = db_connect(DB_CFG)
  writer.write_head(200, {"Content-Type": "text/event-stream", "Cache-Control": "no-cache", "X-Accel-Buffering": "no"})
  let clock = "0"
  while not writer.is_closed() {
    let r = db_query(w, "WAIT THING touch_day SINCE " + clock + " TIMEOUT 25", [])
    if not r.ok {
      writer.event("failed", r.error)
      break
    }
    let row = r.records[0]
    let now_clock = str(row.clock)
    if now_clock == clock {
      if not writer.write(": nothing new" + chr(10) + chr(10)) { break }
    } else {
      let first = clock == "0"
      clock = now_clock
      let hit = first or str(row.whole) == "1"
      if not hit {
        for d in json_parse(row.changed) { if in_range[str(d)] { hit = true } }
      }
      if hit {
        let data = report(get_db(), p)
        if not writer.event("report", json_stringify({"badge": render_badge(data), "live": render_live(data)})) { break }
      }
    }
  }
  db_close(w)
  return nil
}

// ---- The pane --------------------------------------------------------------------------------------------

// WAREHOUSE_COMPUTE_ON: the fleet member (its id, or a prefix) whose copy of this app answers - the page, its
// actions and the exports cross the substrate to that member, its copy reads its own ASQL, and the answers come
// back here. Empty, or this machine: answered here, from DB_HOST.
let COMPUTE_ON = env("WAREHOUSE_COMPUTE_ON", "")

// The viewer's own page: the range (the PHP report's default, the last 30 days) and the table's sort.
let default_range = report_range(nil, nil)
let state = {"start": default_range[0], "stop": default_range[1], "sorter": {"col": 2, "dir": "desc"}}

ui.pane({
  "title": "Warehouse Activity",
  "width": 1400,
  "css": PAGE_CSS,
  "machine": COMPUTE_ON,
  "workers": true,
  // a connection of the render's own, closed after: the routes run in worker VMs copied from this program's
  // globals, and a connection kept in a global (get_db's db_conn) cannot be copied to them
  "view": fn() {
    let c = db_connect(DB_CFG)
    let data = report(c, {"start": state.start, "stop": state.stop, "userid": nil})
    db_close(c)
    return dashboard_node(data, state)
  },
  // Live: the engine wakes the pane when the touch_day Thing changes (WAIT THING, on a connection of its own);
  // every open page then looks again, and gets a frame when its own range's figures moved.
  "watch": {"thing": "touch_day", "db": DB_CFG},
  "routes": {
    "/health": handle_health,
    "/quickreport": handle_quickreport,
    "/quickreportview": handle_quickreportview,     // the PHP page as it was (its own script sorts and follows the events)
    "/quickreportpdf": handle_quickreportpdf,
    "/quickreportxlsx": handle_quickreportxlsx,
    "/quickreportcsv": handle_quickreportcsv,
    "/quickreportevents": handle_events
  }
})
