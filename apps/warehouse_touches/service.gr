// Warehouse Touches Reporting Service
//
// Serves warehouse touch metrics, PDF reports, Excel exports and interactive dashboard.
//
// Endpoints:
//   GET /quickreport       JSON API
//   GET /quickreportview   HTML interactive dashboard
//   GET /quickreportpdf    Native vector PDF report
//   GET /quickreportxlsx   Native OpenXML spreadsheet (.xlsx) export
//   GET /health            Health check

import "lib/queries.gr"
import "lib/views.gr"

fn env(name, fallback) {
  let v = getenv(name)
  if v == nil or v == "" { return fallback }
  return v
}

fn secret(name) {
  let v = getenv(name)
  if v != nil and v != "" { return v }
  let f = getenv(name + "_FILE")
  if f != nil and f != "" { return trim(read_file(f)) }
  return ""
}

let DB_CFG = {
  "host": env("DB_HOST", env("ASQL_HOST", "127.0.0.1")),
  "port": int(env("DB_PORT", env("ASQL_PORT", "3307"))),
  "user": env("DB_USER", env("ASQL_USER", "root")),
  "password": secret("DB_PASSWORD"),
  "db": env("DB_NAME", env("ASQL_DB", "versioneight"))
}

let db_conn = nil

fn get_db() {
  if db_conn != nil { return db_conn }
  let c = db_connect(DB_CFG.host, DB_CFG.port, DB_CFG.user, DB_CFG.password, DB_CFG.db)
  db_conn = c
  return c
}

// WAREHOUSE_SOURCE: "thing" (default) reads the touch_day Thing the engine keeps current; "sql" runs the report's
// queries against the tables, as it did before the Thing - what the Thing is checked against.
let SOURCE = env("WAREHOUSE_SOURCE", "thing")

fn report(db, p) {
  if SOURCE == "sql" { return fetch_warehouse_touches_sql(db, p.start, p.stop, p.userid) }
  return fetch_warehouse_touches(db, p.start, p.stop, p.userid)
}

fn parse_date_params(req) {
  let q = {}
  if req.query_params != nil and type(req.query_params) == "map" {
    q = req.query_params
  } else if req.query != nil and type(req.query) == "map" {
    q = req.query
  }
  let today_str = date_format(now(), "%Y-%m-%d")
  let thirty_days_ago = date_format(now() - 30 * 86400, "%Y-%m-%d")

  if q.range != nil and contains(str(q.range), "..") {
    let rparts = split(str(q.range), "..")
    if len(rparts) >= 2 {
      return {"start": rparts[0], "stop": rparts[1], "userid": q.userid}
    }
  }

  let stop_date = q.stop != nil and q.stop != "" ? q.stop : today_str
  let start_date = q.start != nil and q.start != "" ? q.start : thirty_days_ago
  return {"start": start_date, "stop": stop_date, "userid": q.userid}
}

// ---- Route Handlers ----------------------------------------------------------

fn handle_health(req) {
  return {"status": 200, "content_type": "application/json", "body": "{\"status\":\"ok\"}"}
}

fn handle_quickreport(req) {
  let p = parse_date_params(req)
  let db = get_db()
  let data = report(db, p)
  return {"status": 200, "content_type": "application/json; charset=utf-8", "json": data}
}

fn handle_quickreportview(req) {
  let p = parse_date_params(req)
  let db = get_db()
  let data = report(db, p)
  let html = render_html_dashboard(data, p)
  return {"status": 200, "content_type": "text/html; charset=utf-8", "body": html}
}

fn handle_quickreportpdf(req) {
  let p = parse_date_params(req)
  let db = get_db()
  let data = report(db, p)
  let pdf_bytes = render_pdf_report(data)
  let filename = "warehouse-touches-" + data.start + "-to-" + data.stop + ".pdf"

  return {
    "status": 200,
    "content_type": "application/pdf",
    "headers": {
      "Content-Disposition": "attachment; filename=\"" + filename + "\"",
      "Cache-Control": "no-cache, no-store, must-revalidate",
      "Access-Control-Allow-Origin": "*"
    },
    "body": pdf_bytes
  }
}

fn handle_quickreportxlsx(req) {
  let p = parse_date_params(req)
  let db = get_db()
  let data = report(db, p)
  let xlsx_bytes = render_xlsx_report(data)
  let filename = "warehouse-touches-" + data.start + "-to-" + data.stop + ".xlsx"

  return {
    "status": 200,
    "content_type": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    "headers": {
      "Content-Disposition": "attachment; filename=\"" + filename + "\"",
      "Cache-Control": "no-cache, no-store, must-revalidate",
      "Access-Control-Allow-Origin": "*"
    },
    "body": xlsx_bytes
  }
}

fn handle_quickreportcsv(req) {
  let p = parse_date_params(req)
  let db = get_db()
  let data = report(db, p)
  let csv_str = render_csv_report(data)
  let filename = "warehouse-touches-" + data.start + "-to-" + data.stop + ".csv"

  return {
    "status": 200,
    "content_type": "text/csv; charset=utf-8",
    "headers": {
      "Content-Disposition": "attachment; filename=\"" + filename + "\"",
      "Cache-Control": "no-cache, no-store, must-revalidate",
      "Access-Control-Allow-Origin": "*"
    },
    "body": csv_str
  }
}

// GET /quickreportevents?start&stop: server-sent events for an open dashboard. The engine wakes this route when the
// touch_day Thing changes (WAIT THING - nothing here polls); when a day of the range is among the changed ones, the
// report is read again and pushed as `report` {badge, live}, which the page swaps in. A comment goes out when a wait
// times out with nothing new, so a closed page is noticed and the route ends.
fn handle_events(req, writer) {
  let p = parse_date_params(req)
  let in_range = {}
  for d in days_between(p.start, p.stop) { in_range[d] = true }
  // WAIT holds its connection while it waits, so this stream has one of its own
  let w = db_connect(DB_CFG.host, DB_CFG.port, DB_CFG.user, DB_CFG.password, DB_CFG.db)
  writer.write_head(200, {"Content-Type": "text/event-stream", "Cache-Control": "no-cache", "X-Accel-Buffering": "no"})
  let clock = "0"
  while not writer.is_closed() {
    let r = db_query(w, "WAIT THING touch_day SINCE " + clock + " TIMEOUT 25", [])
    if not r.ok {
      writer.event("failed", r.error)
      break
    }
    let row = r.records[0]
    let now_clock = str(row.clock)
    if now_clock == clock {
      if not writer.write(": nothing new" + chr(10) + chr(10)) { break }
    } else {
      let first = clock == "0"
      clock = now_clock
      let hit = first or str(row.whole) == "1"
      if not hit {
        for d in json_parse(row.changed) { if in_range[str(d)] { hit = true } }
      }
      if hit {
        let data = report(get_db(), p)
        if not writer.event("report", json_stringify({"badge": render_badge(data), "live": render_live(data)})) { break }
      }
    }
  }
  db_close(w)
  return nil
}

// ---- UI Pane & HTTP Routes ---------------------------------------------------

// WAREHOUSE_COMPUTE_ON: the fleet member (its id, or a prefix) whose copy of this app answers the reports - the
// request crosses the substrate to that member, its copy reads its own ASQL, and the answer comes back here.
// Empty, or this machine: answered here, from DB_HOST.
let COMPUTE_ON = env("WAREHOUSE_COMPUTE_ON", "")

ui.pane({
  "title": "Warehouse Touches",
  "width": 1000,
  "height": 700,
  "shared": true,
  "workers": true,
  "routes": {
    "/": on_machine(COMPUTE_ON, handle_quickreportview),
    "/health": handle_health,
    "/quickreport": on_machine(COMPUTE_ON, handle_quickreport),
    "/quickreportview": on_machine(COMPUTE_ON, handle_quickreportview),
    "/quickreportpdf": on_machine(COMPUTE_ON, handle_quickreportpdf),
    "/quickreportxlsx": on_machine(COMPUTE_ON, handle_quickreportxlsx),
    "/quickreportcsv": on_machine(COMPUTE_ON, handle_quickreportcsv),
    "/quickreportevents": on_machine(COMPUTE_ON, handle_events)
  }
})
