// Post-deploy hook: creates or replaces the touch_day Thing in this machine's ASQL (things/touch_day.gr, built beside
// the old version and swapped in when its first pass is done). A copy whose reports run on another member
// (WAREHOUSE_COMPUTE_ON) leaves the Thing to that member.

fn setting(name, fallback) {
  let v = getenv(name)
  if v != nil and v != "" { return v }
  let f = getenv(name + "_FILE")
  if f != nil and f != "" { return trim(read_file(f)) }
  return fallback
}

let READS = "recscan, pickingfreeze, stockmaster, product_types, binmovements_details, www_users, loadingbays, dispatch, stickerscanout"

fn deployed(app) {
  let elsewhere = setting("WAREHOUSE_COMPUTE_ON", "")
  if elsewhere != "" {
    print("touch_day: kept on " + elsewhere + ", where this app's reports run")
    return true
  }
  let c = db_connect(setting("DB_HOST", "127.0.0.1"), int(setting("DB_PORT", "3307")), setting("DB_USER", "root"),
                     setting("DB_PASSWORD", ""), setting("DB_NAME", "versioneight"))
  if not c.ok { return "cannot reach ASQL: " + c.error }
  let have = db_query(c, "SHOW THINGS", [])
  let exists = false
  if have.ok { for r in have.records { if r.thing == "touch_day" { exists = true } } }
  let verb = exists ? "CREATE OR REPLACE THING" : "CREATE THING"
  let r = db_query(c, verb + " touch_day GRAIN KEY day READS " + READS + " AS ?", [app_program("things/touch_day.gr")])
  db_close(c)
  if not r.ok { return "touch_day: " + r.error }
  print("touch_day: " + (exists ? "replaced in place" : "created") + ", " + str(r.affected_rows) + " days")
  return true
}
