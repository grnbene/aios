// touch_hour - an ASQL Thing: one warehouse hour's touches, per user, kept current by the engine.
//
// Key: the hour ("YYYY-MM-DD HH", 24 to a day). Value: `users`, a JSON map of lower(userid) to that user's raw figures
// for the hour - sums, and the distinct sets (items, vendors, orders, moves, pickup orders) a report over several
// hours has to union rather than add (lib/queries.gr merges them). A row that changes names the hour(s) it falls on in
// touched(), and the engine rebuilds only those; a report reads the hours of its range - every hour, or the one hour
// the page asks for (hour_wanted) - with thing_rows(db, "touch_hour", [...]).
//
// It counts what the PHP report counts (catalog/controller/apir/warehouse/touches.php, quickReportData), row for row:
// the same tables, filters and joins, split by the hour of each source's own time (as its hour_wanted filter is).

let DAY_SAFE = true   // an hour's answer depends on that hour's rows only, never on the clock

// the line deliveries cleared from their run are counted on (section 7): no driver is known for them
let CLEARED = "CLEARED"
let CLEARED_NAME = "Cleared from run (no driver)"

let MERCH = " AND ((sm.categoryid = 'TIRE' OR pf.stockid = 'FET') OR (sm.categoryid IN ('O','OT')) OR " +
            "(sm.categoryid NOT IN ('TIRE','O','F','E','X','L') AND pf.stockid NOT IN ('LAB-STORAGE','LAB-T11','LAB-T26')))"
let PICKED = " FROM pickingfreeze pf INNER JOIN stockmaster sm ON sm.stockid = pf.stockid " +
             "INNER JOIN product_types pt ON pt.label = sm.mbflag AND pt.requirespick = 1 "

// "2026-10-27 08:20:11" -> "2026-10-27 08"; a date alone is its 00 hour
fn hour_of(t) {
  if is_blank(t) { return nil }
  let s = str(t)
  if len(s) < 10 or s < "1970" { return nil }
  return len(s) >= 13 ? slice(s, 0, 13) : slice(s, 0, 10) + " 00"
}
// An invoice's hour: its trandate's day (as the PHP report dates it) and its inputdate's hour (trandate holds the
// date only; inputdate is when it was put in).
fn invoice_hour(trandate, inputdate) {
  let d = hour_of(trandate)
  let h = hour_of(inputdate)
  if d == nil { return nil }
  return slice(d, 0, 10) + (h == nil ? " 00" : slice(h, 10, 13))
}
fn num(v) { return v == nil ? 0.0 : real(v) }
fn ival(v) { return v == nil or str(v) == "" ? 0 : int(v) }

// The receiving scans of days lo..hi (YYYY-MM-DD), for receive_hour: user|day|stockid|side and user|day -> the
// first hour scanned, and day|stockid|side -> the first hour anyone scanned it. side: "in", or "out" (in_out 1).
fn receive_scans(lo, hi) {
  let m = {}
  let first = fn(k, h) { if m[k] == nil or h < m[k] { m[k] = h } }
  for r in read_raw("SELECT userid, stockid, COALESCE(in_out, 0) AS io, MIN(date_rec) AS t FROM recscan " +
                    "WHERE date_rec >= ? AND date_rec <= ? AND userid IS NOT NULL AND userid <> '' " +
                    "GROUP BY userid, stockid, COALESCE(in_out, 0), DATE(date_rec)", lo + " 00:00:00", hi + " 23:59:59") {
    let h = hour_of(r.t)
    if h != nil {
      let day = slice(h, 0, 10)
      let side = str(r.io) == "1" ? "out" : "in"
      first(lower(str(r.userid)) + "|" + day + "|" + str(r.stockid) + "|" + side, h)
      first(lower(str(r.userid)) + "|" + day, h)
      first(day + "|" + str(r.stockid) + "|" + side, h)
    }
  }
  return m
}
// The hour a stock move counts in: its receiver's scan of the item that day, else their first receiving scan that
// day, else anyone's scan of the item that day, else the day's 00 hour.
fn receive_hour(scans, userid, day, stockid, out) {
  let side = out ? "out" : "in"
  let u = lower(str(userid))
  return scans[u + "|" + day + "|" + str(stockid) + "|" + side] ?? scans[u + "|" + day] ?? scans[day + "|" + str(stockid) + "|" + side] ?? day + " 00"
}

// The hours a day's receiving can fall in: every hour with a receiving scan that day, and its 00 hour.
fn receive_day_hours(day) {
  if is_blank(day) or len(day) < 10 { return [] }
  let hs = [day + " 00"]
  for r in read_raw("SELECT DISTINCT DATE_FORMAT(date_rec, '%Y-%m-%d %H') AS h FROM recscan WHERE date_rec >= ? AND date_rec <= ?",
                    day + " 00:00:00", day + " 23:59:59") { push(hs, str(r.h)) }
  return hs
}

// Every hour any of the tables has a touch in.
fn enroll() {
  let hours = {}
  for sql in [
    "SELECT DISTINCT DATE_FORMAT(date_rec, '%Y-%m-%d %H') AS d FROM recscan WHERE date_rec IS NOT NULL",
    "SELECT DISTINCT CONCAT(trandate, ' 00') AS d FROM stockmoves WHERE type IN (25, 85) AND trandate IS NOT NULL",
    "SELECT DISTINCT DATE_FORMAT(date_pickupdate, '%Y-%m-%d %H') AS d FROM pickingfreeze WHERE date_pickupdate IS NOT NULL",
    "SELECT DISTINCT DATE_FORMAT(date_created, '%Y-%m-%d %H') AS d FROM binmovements_details WHERE date_created IS NOT NULL",
    "SELECT DISTINCT DATE_FORMAT(packedtime, '%Y-%m-%d %H') AS d FROM stickerscanout WHERE packedtime IS NOT NULL",
    "SELECT DISTINCT DATE_FORMAT(stagedtime, '%Y-%m-%d %H') AS d FROM stickerscanout WHERE stagedtime IS NOT NULL",
    "SELECT DISTINCT DATE_FORMAT(timestopped, '%Y-%m-%d %H') AS d FROM loadingbays WHERE timestopped IS NOT NULL",
    "SELECT DISTINCT DATE_FORMAT(timeassigned, '%Y-%m-%d %H') AS d FROM loadingbays WHERE timeassigned IS NOT NULL",
    "SELECT DISTINCT CONCAT(DATE(dt.trandate), ' ', DATE_FORMAT(dt.inputdate, '%H')) AS d FROM debtortrans dt INNER JOIN salesorders so ON so.orderno = dt.order_ " +
      "WHERE dt.type = 10 AND so.shipvia IN (1, 2) AND dt.trandate IS NOT NULL"
  ] {
    for r in read_raw(sql) {
      let h = hour_of(r.d)
      if h != nil { hours[h] = true }
    }
  }
  return sort(keys(hours))
}

// A driver's name on a dispatch is mapped to the user whose real name it is (www_users).
fn shared() {
  let m = {}
  for r in read_raw("SELECT userid, realname FROM www_users") {
    if not is_blank(r.realname) { m[lower(trim(r.realname))] = r.userid }
  }
  return {"drivers": m}
}

fn things(ks, sh) {
  let want = {}
  let lo = nil
  let hi = nil
  for k in ks {
    let d = str(k)
    want[d] = true
    lo = min(lo, d)
    hi = max(hi, d)
  }
  if lo == nil { return {} }
  let a = lo + ":00:00"
  let b = hi + ":59:59"
  let out_hours = {}

  // the user record of an hour, made on first use; `uid` is the userid as the row has it
  let user = fn(hour, uid) {
    if hour == nil or not has(want, hour) or is_blank(uid) { return nil }
    let of_hour = get_or_put(out_hours, hour, {})
    let key = lower(uid)
    let u = of_hour[key]
    if u == nil {
      u = {"userid": uid, "active": false, "first": nil, "last": nil,
           "rec": {"scans": 0, "qty_in": 0.0, "qty_out": 0.0, "items": [], "vendors": []},
           "pick": {"lines": 0, "qty": 0.0, "orders": []},
           "moves": {}, "runs": {}, "units": {},
           "packed": {}, "staged": {}, "binds": [], "pickups": {}, "cleared": {}, "dname": nil, "lasts": {}}
      of_hour[key] = u
    }
    return u
  }
  let stamp = fn(u, first, last) {
    if not is_blank(first) { u.first = min(u.first, str(first)) }
    if not is_blank(last) { u.last = max(u.last, str(last)) }
  }
  // the latest touch of one source (each stat card shows its own)
  let late = fn(u, src, t) {
    if not is_blank(t) { u.lasts[src] = max(u.lasts[src], str(t)) }
  }

  // 1. Receiving. Who scanned what, and when, is recscan's; how many is not: the receiving screen adds each new
  // quantity to every row of the item, vendor and bin, closed ones too, so an old row holds the item's running total
  // (GYR-183934470: received 2 to 10 at a time, 17 rows of 2025 each saying 148). The quantities are the stock moves
  // instead - received (type 25, Purchase Order Delivery) and returned to the vendor (type 85, Vendor RGA) - each
  // placed by receive_hour (below) in the hour its receiver scanned it.
  for r in read_raw("SELECT userid, DATE_FORMAT(date_rec, '%Y-%m-%d %H') AS day, COUNT(*) AS scans, " +
                    "MIN(date_rec) AS first_touch, MAX(date_rec) AS last_touch FROM recscan " +
                    "WHERE date_rec >= ? AND date_rec <= ? AND userid IS NOT NULL AND userid <> '' " +
                    "GROUP BY userid, DATE_FORMAT(date_rec, '%Y-%m-%d %H')", a, b) {
    let u = user(hour_of(r.day), r.userid)
    if u != nil {
      u.active = true
      u.rec.scans = u.rec.scans + int(r.scans)
      stamp(u, r.first_touch, r.last_touch)
      late(u, "receiving", r.last_touch)
    }
  }
  let d_lo = slice(a, 0, 10)
  let d_hi = slice(b, 0, 10)
  let scans_of = receive_scans(d_lo, d_hi)
  for r in read_raw("SELECT userid, trandate, stockid, type, SUM(qty) AS qty FROM stockmoves " +
                    "WHERE type IN (25, 85) AND trandate >= ? AND trandate <= ? AND userid IS NOT NULL AND userid <> '' " +
                    "GROUP BY userid, trandate, stockid, type", d_lo, d_hi) {
    let out = str(r.type) == "85"
    let u = user(receive_hour(scans_of, r.userid, slice(str(r.trandate), 0, 10), r.stockid, out), r.userid)
    if u != nil {
      u.active = true
      if out { u.rec.qty_out = u.rec.qty_out - num(r.qty) } else { u.rec.qty_in = u.rec.qty_in + num(r.qty) }
    }
  }
  for r in read_raw("SELECT DISTINCT userid, DATE_FORMAT(date_rec, '%Y-%m-%d %H') AS day, stockid FROM recscan " +
                    "WHERE date_rec >= ? AND date_rec <= ? AND userid IS NOT NULL AND userid <> '' AND stockid IS NOT NULL", a, b) {
    let u = user(hour_of(r.day), r.userid)
    if u != nil { push(u.rec.items, str(r.stockid)) }
  }
  for r in read_raw("SELECT DISTINCT userid, DATE_FORMAT(date_rec, '%Y-%m-%d %H') AS day, vendor FROM recscan " +
                    "WHERE date_rec >= ? AND date_rec <= ? AND userid IS NOT NULL AND userid <> '' AND vendor IS NOT NULL", a, b) {
    let u = user(hour_of(r.day), r.userid)
    if u != nil { push(u.rec.vendors, str(r.vendor)) }
  }

  // 2. Picking
  let pick_where = "WHERE pf.bin <> 'STAGING' AND pf.picked > 0 AND pf.date_pickupdate >= ? AND pf.date_pickupdate <= ? " +
                   "AND pf.userid IS NOT NULL AND pf.userid <> '' " + MERCH
  for r in read_raw("SELECT pf.userid, DATE_FORMAT(pf.date_pickupdate, '%Y-%m-%d %H') AS day, COUNT(*) AS line_count, SUM(pf.picked) AS qty, " +
                    "MIN(pf.date_pickupdate) AS first_touch, MAX(pf.date_pickupdate) AS last_touch" + PICKED + pick_where +
                    " GROUP BY pf.userid, DATE_FORMAT(pf.date_pickupdate, '%Y-%m-%d %H')", a, b) {
    let u = user(hour_of(r.day), r.userid)
    if u != nil {
      u.active = true
      u.pick.lines = u.pick.lines + int(r.line_count)
      u.pick.qty = u.pick.qty + num(r.qty)
      stamp(u, r.first_touch, r.last_touch)
      late(u, "picking", r.last_touch)
    }
  }
  for r in read_raw("SELECT DISTINCT pf.userid, DATE_FORMAT(pf.date_pickupdate, '%Y-%m-%d %H') AS day, pf.orderno" + PICKED + pick_where +
                    " AND pf.orderno IS NOT NULL", a, b) {
    let u = user(hour_of(r.day), r.userid)
    if u != nil { push(u.pick.orders, str(r.orderno)) }
  }

  // 3. Bin movements (a move is a distinct (binmoveid, stockid) of its type)
  let move_where = "WHERE date_created >= ? AND date_created <= ? AND `from` <> `to` AND qty > 0 AND user IS NOT NULL AND user <> '' "
  for r in read_raw("SELECT user AS userid, DATE_FORMAT(date_created, '%Y-%m-%d %H') AS day, LOWER(TRIM(type)) AS movetype, SUM(qty) AS qty, " +
                    "MIN(date_created) AS first_touch, MAX(date_created) AS last_touch FROM binmovements_details " + move_where +
                    "GROUP BY user, DATE_FORMAT(date_created, '%Y-%m-%d %H'), LOWER(TRIM(type))", a, b) {
    let u = user(hour_of(r.day), r.userid)
    if u != nil {
      u.active = true
      let t = is_blank(r.movetype) ? "other" : str(r.movetype)
      let mt = get_or_put(u.moves, t, {"pairs": [], "qty": 0.0})
      mt.qty = mt.qty + num(r.qty)
      stamp(u, r.first_touch, r.last_touch)
      late(u, "movements", r.last_touch)
    }
  }
  for r in read_raw("SELECT DISTINCT user AS userid, DATE_FORMAT(date_created, '%Y-%m-%d %H') AS day, LOWER(TRIM(type)) AS movetype, binmoveid, stockid " +
                    "FROM binmovements_details " + move_where + "AND binmoveid IS NOT NULL AND stockid IS NOT NULL", a, b) {
    let u = user(hour_of(r.day), r.userid)
    if u != nil {
      let t = is_blank(r.movetype) ? "other" : str(r.movetype)
      push(get_or_put(u.moves, t, {"pairs": [], "qty": 0.0}).pairs, str(r.binmoveid) + "|" + str(r.stockid))
    }
  }

  // 4. Loads: a run (dispnumber, truckid) falls on the day its row was stopped, or assigned when it was forced
  // complete without a stop time; each of its drivers gets it.
  let runs = {}
  for r in read_raw("SELECT dispnumber, truckid, timeassigned, timestarted, timestopped, manual_pick, completed, force_complete, " +
                    "(COALESCE(force_complete, 0) = 1 OR COALESCE(run_moved, 0) = 1) AS untimed FROM loadingbays " +
                    "WHERE COALESCE(run_deleted, 0) = 0 AND dispnumber IS NOT NULL AND dispnumber <> '' " +
                    "AND ((completed = 1 AND timestopped >= ? AND timestopped <= ?) " +
                    "  OR (force_complete = 1 AND COALESCE(timestopped, '') = '' AND timeassigned >= ? AND timeassigned <= ?))", a, b, a, b) {
    let stopped_in = ival(r.completed) == 1 and not is_blank(r.timestopped) and str(r.timestopped) >= a and str(r.timestopped) <= b
    let hour = stopped_in ? hour_of(r.timestopped) : hour_of(r.timeassigned)
    if hour != nil and has(want, hour) {
      let id = str(int(r.dispnumber)) + "-" + str(int(r.truckid))
      let rk = id + "@" + hour
      let run = runs[rk] ?? get_or_put(runs, rk, {"id": id, "hour": hour, "disp": int(r.dispnumber), "truck": int(r.truckid),
                                                  "manual": 0, "forced": false, "untimed": false, "assigned": nil, "started": nil, "stopped": nil})
      run.manual = run.manual + ival(r.manual_pick)
      run.untimed = run.untimed or ival(r.untimed) == 1
      run.forced = run.forced or ival(r.force_complete) == 1
      if not is_blank(r.timeassigned) { run.assigned = min(run.assigned, str(r.timeassigned)) }
      if not is_blank(r.timestarted) { run.started = min(run.started, str(r.timestarted)) }
      if not is_blank(r.timestopped) { run.stopped = max(run.stopped, str(r.timestopped)) }
    }
  }
  let hour_runs = {}   // hour -> the runs that fall on it (their trucks are the range's truck list)
  if len(runs) > 0 {
    let disps = []
    let trucks = []
    let is_run = {}
    for rk in keys(runs) {
      push(disps, runs[rk].disp)
      push(trucks, runs[rk].truck)
      is_run[runs[rk].id] = true
    }
    disps = unique(disps)
    trucks = unique(trucks)
    let drivers = {}
    for r in read_raw("SELECT DISTINCT d.dispnumber, d.truckid, d.driveruserid FROM dispatch d " +
                      "WHERE d.driveruserid IS NOT NULL AND d.driveruserid <> '' AND d.dispnumber IN (?) AND d.truckid IN (?)", disps, trucks) {
      let id = str(int(r.dispnumber)) + "-" + str(int(r.truckid))
      push(get_or_put(drivers, id, []), r.driveruserid)
    }
    let mapped = fn(driver) {
      let m = sh.drivers[lower(trim(driver))]
      return m == nil ? trim(driver) : m
    }
    // a driver www_users does not know is shown by the name on the dispatch (as the PHP report does)
    let driver_user = fn(hour, driver) {
      let u = user(hour, mapped(driver))
      if u != nil and sh.drivers[lower(trim(driver))] == nil { u.dname = trim(driver) }
      return u
    }
    for rk in keys(runs) {
      let run = runs[rk]
      let ds = drivers[run.id]
      if ds != nil {
        for driver in unique(ds) {
          let u = driver_user(run.hour, driver)
          if u != nil {
            let mine = u.runs[run.id] ?? get_or_put(u.runs, run.id, {"k": 0, "manual": run.manual, "forced": run.forced, "untimed": run.untimed,
                                                                      "assigned": run.assigned, "started": run.started, "stopped": run.stopped})
            mine.k = mine.k + 1   // one count per name on the dispatch, as the PHP report counts it
          }
        }
      }
    }
    // Units loaded, by the name on the dispatch row and the orders they were for. The PHP report takes the dispatch
    // rows whose number is a run's and whose truck is any run's in the range (two IN lists, not pairs), so a
    // dispatch whose rows are on another truck than its loading bay row counts when that truck also ran. Every
    // dispatch row of a run's number is kept here, by its own number and truck; the report applies the range's trucks.
    let per_disp = {}   // dispnumber -> "disp-truck" -> name -> {units, orders}
    for r in read_raw("SELECT d.dispnumber, d.truckid, d.driveruserid AS driver, pf.orderno, SUM(pf.loaded) AS units" + PICKED +
                      "INNER JOIN dispatch d ON d.invoice = pf.orderno " +
                      "WHERE pf.loaded > 0 AND d.dispnumber IN (?) AND d.driveruserid IS NOT NULL AND d.driveruserid <> '' " + MERCH +
                      " GROUP BY d.dispnumber, d.truckid, d.driveruserid, pf.orderno", disps) {
      let dn = str(int(r.dispnumber))
      let id = dn + "-" + str(int(r.truckid))
      let dv = str(r.driver)
      let pd = get_or_put(get_or_put(get_or_put(per_disp, dn, {}), id, {}), dv, {"units": 0.0, "orders": []})
      pd.units = pd.units + num(r.units)
      if r.orderno != nil { push(pd.orders, str(r.orderno)) }
    }
    for rk in keys(runs) {
      let run = runs[rk]
      push(get_or_put(hour_runs, run.hour, []), run.id)
      let rows_of = per_disp[str(run.disp)]
      if rows_of != nil {
        for id in keys(rows_of) {
          for dv in keys(rows_of[id]) {
            let u = driver_user(run.hour, dv)
            if u != nil {
              get_or_put(u.units, id, {})[dv] = rows_of[id][dv]
            }
          }
        }
      }
    }
  }

  // 5. Sticker scan out. One row per order and user (statusid 99 is a hidden trail); units are every tire line on the
  // order (salesorderdetails), stickerscanout.quantity only for an order with none. A packed order with a trackinginfo
  // bind is a bind, credited to whoever packed it. Each order is kept by number, so a range counts it once.
  for side in [["packed", "packeduserid", "packedtime"], ["staged", "stageduserid", "stagedtime"]] {
    let who = side[1]
    let at = side[2]
    let where = "statusid <> '99' AND " + at + " >= ? AND " + at + " <= ? AND " + who + " IS NOT NULL AND " + who + " <> ''"
    let tire = {}
    for r in read_raw("SELECT sod.orderno, SUM(sod.quantity) AS units FROM salesorderdetails sod " +
                      "INNER JOIN stockmaster sm ON sm.stockid = sod.stkcode AND sm.categoryid = 'TIRE' " +
                      "WHERE sod.orderno IN (SELECT orderno FROM stickerscanout WHERE " + where + ") GROUP BY sod.orderno", a, b) {
      tire[str(r.orderno)] = num(r.units)
    }
    for r in read_raw("SELECT orderno, " + who + " AS userid, DATE_FORMAT(" + at + ", '%Y-%m-%d %H') AS day, MAX(CAST(quantity AS DECIMAL(12,2))) AS fallback, " +
                      "MIN(" + at + ") AS first_touch, MAX(" + at + ") AS last_touch FROM stickerscanout WHERE " + where +
                      " GROUP BY orderno, " + who + ", DATE_FORMAT(" + at + ", '%Y-%m-%d %H')", a, b) {
      let u = user(hour_of(r.day), r.userid)
      if u != nil {
        u.active = true
        let o = str(r.orderno)
        u[side[0]][o] = {"t": has(tire, o) ? tire[o] : nil, "f": num(r.fallback)}
        stamp(u, r.first_touch, r.last_touch)
        late(u, "sticker", r.last_touch)
      }
    }
  }
  for r in read_raw("SELECT DISTINCT p.orderno, p.packeduserid AS userid, DATE_FORMAT(p.packedtime, '%Y-%m-%d %H') AS day FROM stickerscanout p " +
                    "INNER JOIN trackinginfo ti ON ti.transno = p.orderno AND ti.bind = 1 " +
                    "WHERE p.statusid <> '99' AND p.packedtime >= ? AND p.packedtime <= ? AND p.packeduserid IS NOT NULL AND p.packeduserid <> ''", a, b) {
    let u = user(hour_of(r.day), r.userid)
    if u != nil { push(u.binds, str(r.orderno)) }
  }

  // 6. Pickup orders (salesorders.shipvia = 2): loaded onto the customer's vehicle, never scanned out, so no driver
  // and no loaded quantity - they count as loads for whoever took the order (takenby). An order counts on its
  // invoice's day (debtortrans type 10, trandate, as the PHP report does) in the hour it was put in (inputdate:
  // trandate holds the date only), its units the merchandise lines' qtyinvoiced. Kept by order number, so a range
  // with two of its invoices counts it once.
  let pick_orders = {}
  let inv_key = "CONCAT(DATE(dt.trandate), ' ', DATE_FORMAT(dt.inputdate, '%H'))"
  let inv = read_raw("SELECT so.orderno, so.takenby AS userid, " + inv_key + " AS day, " +
                     "MIN(dt.inputdate) AS first_touch, MAX(dt.inputdate) AS last_touch FROM debtortrans dt " +
                     "INNER JOIN salesorders so ON so.orderno = dt.order_ " +
                     "WHERE dt.type = 10 AND dt.trandate >= ? AND dt.trandate <= ? AND so.shipvia = 2 " +
                     "AND so.takenby IS NOT NULL AND so.takenby <> '' " +
                     "GROUP BY so.orderno, so.takenby, " + inv_key, slice(a, 0, 10) + " 00:00:00", slice(b, 0, 10) + " 23:59:59")
  for r in inv { pick_orders[str(r.orderno)] = true }
  if len(pick_orders) > 0 {
    let units = {}
    for r in read_raw("SELECT sod.orderno, SUM(sod.qtyinvoiced) AS units FROM salesorderdetails sod " +
                      "INNER JOIN stockmaster sm ON sm.stockid = sod.stkcode " +
                      "INNER JOIN product_types pt ON pt.label = sm.mbflag AND pt.requirespick = 1 " +
                      "WHERE sod.orderno IN (?) AND sod.qtyinvoiced > 0" + replace(MERCH, "pf.stockid", "sod.stkcode") +
                      " GROUP BY sod.orderno", keys(pick_orders)) {
      units[str(r.orderno)] = num(r.units)
    }
    for r in inv {
      let o = str(r.orderno)
      if not has(units, o) { continue }   // no merchandise invoiced: not a load
      let u = user(hour_of(r.day), r.userid)
      if u != nil {
        let have = u.pickups[o]
        u.pickups[o] = {"u": units[o], "t": max(have == nil ? nil : have.t, str(r.last_touch)), "d": slice(str(r.day), 0, 10)}   // d: trandate's day
        stamp(u, r.first_touch, r.last_touch)
        late(u, "loads", r.last_touch)
      }
    }
  }

  // 7. Deliveries cleared from their run to be invoiced later (salesorders.shipvia = 1): loaded onto a truck
  // (pickingfreeze.loaded), but the order's dispatch row - the run and the driver - is gone, so section 4 cannot see
  // them. They count as loads on their invoice's hour, on one line of their own (CLEARED), with no driver or run.
  // An order with any dispatch row left counts there instead, never here. Kept by order number, as pickups are.
  let del = read_raw("SELECT so.orderno, " + inv_key + " AS day FROM debtortrans dt " +
                     "INNER JOIN salesorders so ON so.orderno = dt.order_ " +
                     "WHERE dt.type = 10 AND dt.trandate >= ? AND dt.trandate <= ? AND so.shipvia = 1 " +
                     "GROUP BY so.orderno, " + inv_key, slice(a, 0, 10) + " 00:00:00", slice(b, 0, 10) + " 23:59:59")
  if len(del) > 0 {
    let on_run = {}
    let orders = unique(map(del, fn(r) { return str(r.orderno) }))
    for r in read_raw("SELECT DISTINCT invoice FROM dispatch WHERE invoice IN (?)", orders) { on_run[str(r.invoice)] = true }
    let off = []
    for o in orders { if not has(on_run, o) { push(off, o) } }
    let units = {}
    if len(off) > 0 {
      for r in read_raw("SELECT pf.orderno, SUM(pf.loaded) AS units" + PICKED + "WHERE pf.loaded > 0 AND pf.orderno IN (?)" + MERCH +
                        " GROUP BY pf.orderno", off) {
        units[str(r.orderno)] = num(r.units)
      }
    }
    for r in del {
      let o = str(r.orderno)
      if not has(units, o) { continue }   // nothing loaded: not a load
      let u = user(hour_of(r.day), CLEARED)
      if u != nil {
        u.dname = CLEARED_NAME
        u.cleared[o] = {"u": units[o], "d": slice(str(r.day), 0, 10)}
      }
    }
  }

  let out = {}
  for hour in unique(concat(keys(out_hours), keys(hour_runs))) {
    let us = out_hours[hour] ?? {}
    out[hour] = {"users": json_stringify(us), "people": len(us), "runs": json_stringify(hour_runs[hour] ?? [])}
  }
  return out
}

// What a change means: the hour(s) the row falls in, before and after.
fn row_days(t, row) {
  if row == nil { return [] }
  match t {
    "recscan" => { return [hour_of(row.date_rec)] }
    "binmovements_details" => { return [hour_of(row.date_created)] }
    "stickerscanout" => { return [hour_of(row.packedtime), hour_of(row.stagedtime)] }
    "loadingbays" => { return [hour_of(row.timestopped), hour_of(row.timeassigned)] }
    "debtortrans" => { return str(row.type) == "10" and not is_blank(row.order_) and str(row.order_) != "0" ? [invoice_hour(row.trandate, row.inputdate)] : [] }
  }
  return []
}

// The hours of the runs a dispatch row, or the order a picking line is on, belongs to; of a pickup order's invoices.
fn run_days(disp, truck) {
  let ds = []
  for r in read_raw("SELECT timestopped, timeassigned FROM loadingbays WHERE dispnumber = ?", disp) {
    push(ds, hour_of(r.timestopped))
    push(ds, hour_of(r.timeassigned))
  }
  return ds
}
fn sticker_days(orderno) {
  let ds = []
  for r in read_raw("SELECT packedtime, stagedtime FROM stickerscanout WHERE orderno = ?", orderno) {
    push(ds, hour_of(r.packedtime))
    push(ds, hour_of(r.stagedtime))
  }
  return ds
}
fn pickup_hours(orderno) {
  let so = read_raw("SELECT shipvia FROM salesorders WHERE orderno = ?", orderno)
  if len(so) == 0 or str(so[0].shipvia) != "2" { return [] }
  return map(read_raw("SELECT DISTINCT trandate, inputdate FROM debtortrans WHERE type = 10 AND order_ = ?", orderno), fn(r) { return invoice_hour(r.trandate, r.inputdate) })
}
// A delivery order's invoice hours: where it counts once it is cleared from its run (section 7).
fn delivery_hours(orderno) {
  let so = read_raw("SELECT shipvia FROM salesorders WHERE orderno = ?", orderno)
  if len(so) == 0 or str(so[0].shipvia) != "1" { return [] }
  return map(read_raw("SELECT DISTINCT trandate, inputdate FROM debtortrans WHERE type = 10 AND order_ = ?", orderno), fn(r) { return invoice_hour(r.trandate, r.inputdate) })
}
fn order_run_days(orderno) {
  let ds = []
  for r in read_raw("SELECT DISTINCT dispnumber, truckid FROM dispatch WHERE invoice = ?", orderno) {
    for d in run_days(r.dispnumber, r.truckid) { push(ds, d) }
  }
  return ds
}

fn touched(table, op, before, after, sh) {
  let t = lower(table)
  let rows = compact([before, after])
  if t == "www_users" {
    if before != nil and after != nil and before.realname == after.realname and before.userid == after.userid { return nil }
    return {"keys": [], "shared": true}
  }
  if t == "product_types" { return "all" }
  if t == "stockmaster" {
    // only what decides whether a pick counts (its category and its kind) matters, and rarely moves
    if before != nil and after != nil and before.categoryid == after.categoryid and before.mbflag == after.mbflag { return nil }
    if before == nil { return nil }   // a new item has no picks yet
    return "all"
  }
  if t == "stockmoves" {
    // only receipts and vendor returns are read here (every sale is a stock move too)
    let ours = filter(rows, fn(r) { return str(r.type) == "25" or str(r.type) == "85" })
    if len(ours) == 0 { return nil }
    let hs = []
    for r in ours { for h in receive_day_hours(slice(str(r.trandate), 0, 10)) { push(hs, h) } }
    return unique(compact(hs))
  }
  if t == "recscan" {
    // the receiving screen rewrites old rows' qty all day; only who, what and when are read from recscan now
    if before != nil and after != nil and before.date_rec == after.date_rec and before.userid == after.userid and
       before.stockid == after.stockid and before.in_out == after.in_out and before.vendor == after.vendor { return nil }
    // a scan can move the day's receipts to its hour (receive_hour), so the day's receiving hours are read again
    let hs = []
    for r in rows { if not is_blank(r.date_rec) { for h in receive_day_hours(slice(str(r.date_rec), 0, 10)) { push(hs, h) } } }
    return unique(compact(hs))
  }
  let ds = []
  for row in rows {
    if t == "pickingfreeze" {
      push(ds, hour_of(row.date_pickupdate))
      if row.orderno != nil {
        for d in order_run_days(row.orderno) { push(ds, d) }
        for d in delivery_hours(row.orderno) { push(ds, d) }
      }
    } else if t == "salesorderdetails" {
      if row.orderno != nil {
        for d in sticker_days(row.orderno) { push(ds, d) }
        for d in pickup_hours(row.orderno) { push(ds, d) }
      }
    } else if t == "salesorders" {
      // only whether it is a pickup and who took it matter here; a new order has no invoice yet
      if before == nil or after == nil or before.shipvia != after.shipvia or before.takenby != after.takenby {
        for r in read_raw("SELECT DISTINCT trandate, inputdate FROM debtortrans WHERE type = 10 AND order_ = ?", row.orderno) { push(ds, invoice_hour(r.trandate, r.inputdate)) }
      }
    } else if t == "trackinginfo" {
      if row.transno != nil { for d in sticker_days(row.transno) { push(ds, d) } }
    } else if t == "dispatch" {
      if row.dispnumber != nil and row.truckid != nil { for d in run_days(row.dispnumber, row.truckid) { push(ds, d) } }
      // a row gone (cleared from the run) or come back moves the order between its run and section 7
      if row.invoice != nil { for d in delivery_hours(row.invoice) { push(ds, d) } }
    } else {
      for d in row_days(t, row) { push(ds, d) }
    }
  }
  return unique(compact(ds))
}
