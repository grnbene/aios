// deploywatch: what the deploy machines spend their CPU, memory and disk on.
//
// One app, deployed everywhere. On a Linux machine its copy samples that machine (/proc, and ASQL's own SHOW GLOBAL
// STATUS when an engine runs there) every SAMPLE_S seconds into its data directory, and notes the spikes as they
// happen, so a spike at 3 a.m. is there in the morning. The copy on the workstation draws the page and asks each
// machine's copy for its figures over the fleet (on_machine), or over a direct node link for a machine outside it.
let app = {
  "name": "deploywatch",
  "description": "CPU, memory, ASQL and disk of the deploy machines, and their spikes",
  "main": "service.gr",
  "kind": "web",
  "port": 8590,
  "listen": "local",
  "settings": {
    // what this copy measures (on a Linux machine)
    "SAMPLE_S": "10",
    "KEEP_HOURS": "48",
    "ASQL_HOST": "127.0.0.1",
    "ASQL_PORT": "3307",
    "ASQL_USER": "erp",
    // folders whose size is walked every DISK_EVERY_MIN minutes, and what a walk may cover
    "DISK_PATHS": "/opt/aios,/opt/aos,/var/lib/mysql,/var/log,/var/www,/home",
    "DISK_EVERY_MIN": "30",
    "DISK_MAX_ENTRIES": "300000",
    // The machines the page shows: name=kernel id, comma separated. Every copy needs the same list - a route given to
    // a machine (on_machine) is answered there by that machine's copy under the same path. The three app hosts are
    // reached through the fleet (hub on atl-ga-1); st, in no fleet, over a direct node link the workstation makes.
    "WATCH": "cleve-ny-1=7f29593a5057,chi-il-1=7c513d4f845a,atl-ga-1=1127294d54b8,st=9ca3301e258e"
  },
  "secrets": ["ASQL_PASSWORD"],
  "health": {"path": "/health", "ok": [200]},
  "check": "check.gr",
  "max_steps": 0
}
