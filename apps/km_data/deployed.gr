// Post-deploy hook: the ASQL Thing kmdata_customer_balance keeps each customer's balance and invoice dates,
// recomputed for just that customer whenever a debtortrans row of theirs changes (service.gr reads it
// for /v1/customers, and reads debtortrans directly while it is missing). Rebuilt when its definition changes.

fn setting(name, fallback) {
  let v = getenv(name)
  if v != nil and v != "" { return v }
  let f = getenv(name + "_FILE")
  if f != nil and f != "" { return trim(read_file(f)) }
  return fallback
}

let THING = "kmdata_customer_balance"
let QUERY = "SELECT debtorno, " +
  "SUM(ovamount + ovgst + ovfee + ovfreight + ovdiscount - alloc) AS balance, " +
  "SUM(CASE WHEN pt.termsindicator IS NOT NULL THEN ovamount + ovgst + ovfee + ovfreight + ovdiscount ELSE 0 END) AS ledger_balance, " +
  "MAX(2) AS definition, " +
  "SUM(CASE WHEN type = 10 THEN ovamount ELSE 0 END) AS lifetime_invoiced, " +
  "MIN(CASE WHEN type = 10 THEN trandate END) AS first_invoice_date, " +
  "MAX(CASE WHEN type = 10 THEN trandate END) AS last_invoice_date, " +
  "MAX(CASE WHEN type = 12 THEN trandate END) AS last_receipt_date " +
  "FROM debtortrans LEFT JOIN paymentterms pt ON pt.termsindicator = debtortrans.payterms GROUP BY debtorno"

fn deployed(app) {
  let c = db_connect(setting("ASQL_HOST", "127.0.0.1"), int(setting("ASQL_PORT", "3307")), setting("ASQL_USER", "erp"),
                     setting("ASQL_PASSWORD", ""), setting("ASQL_DB", "km"))
  if not c.ok { return "cannot reach ASQL: " + c.error }
  let have = db_query(c, "SHOW THINGS", [])
  if not have.ok {
    db_close(c)
    return "SHOW THINGS: " + have.error
  }
  for r in have.records {
    if r.thing == THING {
      // present: keep it when it is this definition (definition = 2); otherwise drop it and build this one
      let cur = db_query(c, "SHOW THING " + THING, [])
      if cur.ok and len(cur.records) > 0 and str(cur.records[0]?.definition) == "2" {
        db_close(c)
        print(THING + ": present, " + str(r.things) + " customers")
        return true
      }
      let d = db_query(c, "DROP THING " + THING, [])
      if not d.ok {
        db_close(c)
        return THING + ": cannot drop the old definition: " + d.error
      }
      print(THING + ": old definition dropped")
    }
  }
  let r = db_query(c, "CREATE THING " + THING + " KEY debtorno READS debtortrans, paymentterms AS " + QUERY, [])
  db_close(c)
  if not r.ok { return THING + ": " + r.error }
  print(THING + ": created")
  return true
}
