// Post-deploy hook: the ASQL Things in lib/things.gr (customer balances, customer sales) are created on first
// deploy and left in place after; one whose definition changed is dropped and built again. service.gr reads them
// for /v1/customers, and runs their query for just the page's customers while one is missing or still building.

import "lib/things.gr"

fn setting(name, fallback) {
  let v = getenv(name)
  if v != nil and v != "" { return v }
  let f = getenv(name + "_FILE")
  if f != nil and f != "" { return trim(read_file(f)) }
  return fallback
}

// One Thing: keep it when it holds this definition, else drop the old one and create it. true or an error text.
fn ensure_thing(c, present, name, definition, create_sql) {
  if present[name] != nil {
    let cur = db_query(c, "SHOW THING " + name, [])
    if cur.ok and len(cur.records) > 0 and str(cur.records[0]?.definition) == definition {
      print(name + ": present, " + str(present[name]) + " customers")
      return true
    }
    let d = db_query(c, "DROP THING " + name, [])
    if not d.ok { return name + ": cannot drop the old definition: " + d.error }
    print(name + ": old definition dropped")
  }
  let r = db_query(c, create_sql, [])
  if not r.ok { return name + ": " + r.error }
  print(name + ": created")
  return true
}

fn deployed(app) {
  let c = db_connect(setting("ASQL_HOST", "127.0.0.1"), int(setting("ASQL_PORT", "3307")), setting("ASQL_USER", "erp"),
                     setting("ASQL_PASSWORD", ""), setting("ASQL_DB", "km"))
  if not c.ok { return "cannot reach ASQL: " + c.error }
  let have = db_query(c, "SHOW THINGS", [])
  if not have.ok {
    db_close(c)
    return "SHOW THINGS: " + have.error
  }
  let present = {}
  for r in have.records { present[str(r.thing)] = r.things }
  for t in CUSTOMER_THINGS {
    let ok = ensure_thing(c, present, t[0], t[1], t[2])
    if ok != true {
      db_close(c)
      return ok
    }
  }
  db_close(c)
  return true
}
