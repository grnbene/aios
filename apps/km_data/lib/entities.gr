// The entities the API serves, each a mapping from ERP columns to clean API names.
//
// fields:  [api name, SQL expression, type]   types: id, nid (numeric id: text out, numeric cursor), text, int, num, money, rate, date, datetime, bool
// key:     the API names that order the rows and make the paging cursor (unique together)
// date:    the SQL date column ?from= / ?to= filter on (optional)
// filters: ?name=value equality filters, API name -> SQL expression
// where:   a fixed condition (optional)
// enrich:  a function name in service.gr that adds fields to a page of rows (optional)

// The ERP's item cost (model/weberp/items.php getItem, getValuation): material + labour + overhead, or the last
// cost when that is zero.
let ITEM_COST = "CASE WHEN s.materialcost + s.labourcost + s.overheadcost = 0 THEN s.lastcost ELSE s.materialcost + s.labourcost + s.overheadcost END"

// Stock the ERP counts as on hand (items.php getItemStock): not the transfer warehouse, not the PO holding bin.
let COUNTS_ON_HAND = "(k.loccode <> (SELECT TransferWarehouse FROM companies LIMIT 1) AND k.bin <> COALESCE((SELECT confvalue FROM config WHERE confname = 'HoldingBin'), ''))"

// The ERP's discounted line amount (the stocktrans view, migrations/stocktrans_decimal_line_math.sql): the price
// rounded to cents, less its discount rounded to cents, times the quantity, rounded to cents. A missing discount
// (stockmoves.discountpercent is nullable: seven $0 lines of March 2026) is no discount, so the line is 0, not null.
fn line_amount_sql(price, disc, qty) {
  let p = "ROUND(CAST(" + price + " AS DECIMAL(20,6)), 2)"
  let unit = "ROUND(" + p + " - ROUND(" + p + " * ROUND(CAST(COALESCE(" + disc + ", 0) AS DECIMAL(20,10)), 4), 2), 2)"
  return "ROUND(" + unit + " * CAST(" + qty + " AS DECIMAL(20,6)), 2)"
}

// A write-off credit note (creditorders.options credit_type 'writeoff') carries a stock line and its reversal; the
// printed credit note shows only the positive line (controller/apir/documents/credits.php), so the API does too.
let NOT_WRITEOFF_REVERSAL = "NOT (m.type = 11 AND m.qty < 0 AND m.transno IN (SELECT invoiceno FROM creditorders WHERE options LIKE '%\"credit_type\":\"writeoff\"%'))"

let TXN_TOTAL = "(t.ovamount + t.ovgst + t.ovfee + t.ovfreight + t.ovdiscount)"

fn txn_fields() {
  return [
    ["transaction_id", "t.id", "nid"],
    ["document_no", "t.transno", "id"],
    ["customer_id", "t.debtorno", "id"],
    ["location_id", "t.branchcode", "id"],
    ["date", "t.trandate", "date"],
    ["due_date", "t.duedate", "date"],
    ["period", "t.prd", "int"],
    ["order_id", "t.order_", "id"],
    ["reference", "t.reference", "text"],
    ["price_list_id", "t.tpe", "id"],
    ["salesperson_id", "t.salesperson", "id"],
    ["payment_terms_id", "t.payterms", "id"],
    ["subtotal", "t.ovamount", "money"],
    ["tax", "t.ovgst", "money"],
    ["freight", "t.ovfreight", "money"],
    ["fees", "t.ovfee", "money"],
    ["discount", "t.ovdiscount", "money"],
    ["total", TXN_TOTAL, "money"],
    ["amount_applied", "t.alloc", "money"],
    ["open_amount", TXN_TOTAL + " - t.alloc", "money"],
    ["settled", "t.settled", "bool"],
    ["exchange_rate", "t.rate", "num"],
    ["note", "t.invtext", "text"],
    ["created_at", "t.inputdate", "datetime"]
  ]
}

let ENTITIES = {
  "customers": {
    "description": "Customer accounts: name, address, terms, credit status, balance and invoice dates.",
    "from": "debtorsmaster d LEFT JOIN debtortype ty ON ty.typeid = d.typeid LEFT JOIN holdreasons h ON h.reasoncode = d.holdreason LEFT JOIN paymentterms pt ON pt.termsindicator = d.paymentterms LEFT JOIN salestypes st ON st.typeabbrev = d.salestype",
    "key": ["customer_id"],
    "filters": {"customer_id": "d.debtorno", "parent_customer_id": "d.parentdebtorno"},
    "enrich": "customer_balances",
    "fields": [
      ["customer_id", "d.debtorno", "id"],
      ["customer_name", "d.name", "text"],
      ["address_line1", "d.address1", "text"],
      ["address_line2", "d.address2", "text"],
      ["city", "d.address3", "text"],
      ["region", "d.address4", "text"],
      ["postal_code", "d.address5", "text"],
      ["country", "d.address6", "text"],
      ["customer_type_id", "d.typeid", "id"],
      ["customer_type", "ty.typename", "text"],
      ["currency", "d.currcode", "id"],
      ["price_list_id", "d.salestype", "id"],
      ["price_list", "st.sales_type", "text"],
      ["customer_since", "d.clientsince", "date"],
      ["hold_reason_id", "d.holdreason", "id"],
      ["hold_reason", "h.reasondescription", "text"],
      ["on_hold", "h.dissallowinvoices", "bool"],
      ["payment_terms_id", "d.paymentterms", "id"],
      ["payment_terms", "pt.terms", "text"],
      ["credit_limit", "d.creditlimit", "money"],
      ["discount_rate", "d.discount", "rate"],
      ["tax_ref", "d.taxref", "text"],
      ["parent_customer_id", "d.parentdebtorno", "id"],
      ["invoice_email", "d.invoiceemailaddress", "text"],
      ["license_no", "d.cosm_license", "text"],
      ["license_expires", "d.licExpDate", "date"],
      ["email_statements", "d.emailstatement = 'Y'", "bool"],
      ["print_statements", "d.edireference = 'Y'", "bool"],
      ["email_invoices", "d.ediinvoices", "bool"],
      ["refused_email", "d.refusedemail", "bool"],
      ["quote_email", "d.quote_email", "text"],
      ["signed_contract", "d.signed_mor", "text"],
      ["price_list2_id", "d.salestype2", "id"],
      ["discount_level", "d.price_type", "text"],
      ["prompt_payment_discount", "d.pymtdiscount", "rate"],
      ["commission_rate", "d.commpct", "num"],
      ["target_potential", "d.targetpotential", "money"],
      ["estimated_potential", "d.estimatedpotential", "money"],
      ["po_required", "d.customerpoline", "bool"],
      ["ar_interest_rate", "d.arintrate", "rate"],
      ["aboriginal", "d.aboriginal", "bool"],
      ["has_web_account", "d.hasprofile", "bool"],
      ["is_active", "d.isactive", "bool"]
    ],
    "extra": [
      ["balance", "money"], ["ledger_balance", "money"], ["lifetime_invoiced", "money"], ["first_invoice_date", "date"],
      ["last_invoice_date", "date"], ["last_receipt_date", "date"], ["last_receipt_amount", "money"],
      ["total_spend", "money"], ["first_purchase_date", "date"], ["last_purchase_date", "date"], ["months_active", "int"],
      ["avg_monthly_sales", "money"], ["avg_monthly_units", "num"], ["units_sold", "num"], ["units_returned", "num"],
      ["return_rate", "rate"], ["avg_invoice_last_365", "money"], ["invoices_last_365", "int"],
      ["top_brand_1", "text"], ["top_brand_2", "text"], ["top_brand_3", "text"],
      ["sales_mtd", "money"], ["sales_ytd", "money"], ["sales_last_year_ytd", "money"], ["sales_last_year", "money"],
      ["sales_last_12_months", "money"],
      ["aging_future", "money"], ["aging_current", "money"], ["aging_0_29", "money"], ["aging_30_59", "money"],
      ["aging_60_89", "money"], ["aging_90_plus", "money"],
      ["main_location_id", "id"], ["location_count", "int"], ["salesperson_id", "id"], ["salesperson_name", "text"],
      ["phone", "text"], ["email", "text"], ["contact_name", "text"], ["area_id", "id"], ["area", "text"],
      ["territory_id", "id"], ["territory", "text"],
      ["open_orders", "int"], ["open_quotes", "int"], ["last_web_login", "datetime"], ["reward_points", "int"],
      ["clubs", "text"]
    ]
  },

  "customer_contacts": {
    "description": "The contacts on each customer account (the Contacts list on the ERP's customer card).",
    "from": "custcontacts c",
    "key": ["contact_id"],
    "filters": {"customer_id": "c.debtorno"},
    "fields": [
      ["contact_id", "c.contid", "nid"],
      ["customer_id", "c.debtorno", "id"],
      ["name", "c.contactname", "text"],
      ["role", "c.role", "text"],
      ["roles", "c.serialized_roles", "text"],
      ["phone", "c.phoneno", "text"],
      ["email", "c.email", "text"],
      ["note", "c.notes", "text"]
    ]
  },

  "customer_clubs": {
    "description": "Club and loyalty programs each customer has joined (the Clubs Joined on the ERP's customer card).",
    "from": "clubs_joined j LEFT JOIN clubs c ON c.id = j.clubid",
    "key": ["membership_id"],
    "filters": {"customer_id": "j.cust_id"},
    "fields": [
      ["membership_id", "j.id", "nid"],
      ["customer_id", "j.cust_id", "id"],
      ["location_id", "j.branchcode", "id"],
      ["club_id", "j.clubid", "id"],
      ["club", "c.club", "text"],
      ["club_name_on_join", "j.club_joined", "text"],
      ["level", "j.club_level", "text"],
      ["member_no", "j.accountid", "text"]
    ]
  },

  "customer_notes": {
    "description": "Notes kept on each customer account (the Notes on the ERP's customer card).",
    "from": "custnotes n",
    "key": ["note_id"], "date": "n.notedate",
    "filters": {"customer_id": "n.debtorno"},
    "fields": [
      ["note_id", "n.noteid", "nid"],
      ["customer_id", "n.debtorno", "id"],
      ["date", "n.notedate", "date"],
      ["code", "n.note_code", "text"],
      ["topic", "n.notetopic", "text"],
      ["priority", "n.priority", "text"],
      ["note", "n.note", "text"],
      ["entered_by", "n.noteuserid", "text"],
      ["created_at", "n.date_added", "datetime"]
    ]
  },

  "customer_locations": {
    "description": "Ship-to locations (branches) of each customer.",
    "from": "custbranch b LEFT JOIN salesman s ON s.salesmancode = b.salesman LEFT JOIN areas a ON a.areacode = b.area LEFT JOIN shippers sh ON sh.shipper_id = b.defaultshipvia LEFT JOIN territory tr ON tr.territory_id = b.territory_id",
    "key": ["customer_id", "location_id"],
    "filters": {"customer_id": "b.debtorno", "salesperson_id": "b.salesman"},
    "fields": [
      ["customer_id", "b.debtorno", "id"],
      ["location_id", "b.branchcode", "id"],
      ["location_name", "b.brname", "text"],
      ["address_line1", "b.braddress1", "text"],
      ["address_line2", "b.braddress2", "text"],
      ["city", "b.braddress3", "text"],
      ["region", "b.braddress4", "text"],
      ["postal_code", "b.braddress5", "text"],
      ["country", "b.braddress6", "text"],
      ["latitude", "b.lat", "num"],
      ["longitude", "b.lng", "num"],
      ["phone", "b.phoneno", "text"],
      ["phone_alt", "b.phoneno_alt", "text"],
      ["phone_alt2", "b.altphone1", "text"],
      ["phone_alt3", "b.altphone2", "text"],
      ["mail_address_line1", "b.brpostaddr1", "text"],
      ["mail_address_line2", "b.brpostaddr2", "text"],
      ["mail_city", "b.brpostaddr3", "text"],
      ["mail_region", "b.brpostaddr4", "text"],
      ["mail_postal_code", "b.brpostaddr5", "text"],
      ["mail_country", "b.brpostaddr6", "text"],
      ["fax", "b.faxno", "text"],
      ["email", "b.email", "text"],
      ["contact_name", "b.contactname", "text"],
      ["salesperson_id", "b.salesman", "id"],
      ["salesperson_name", "s.salesmanname", "text"],
      ["area_id", "b.area", "id"],
      ["area", "a.areadescription", "text"],
      ["territory_id", "b.territory_id", "id"],
      ["territory", "tr.territory_name", "text"],
      ["warehouse_id", "b.defaultlocation", "id"],
      ["ship_via_id", "b.defaultshipvia", "id"],
      ["ship_via", "sh.shippername", "text"],
      ["tax_group_id", "b.taxgroupid", "id"],
      ["tax_ref", "b.tax_ref", "text"],
      ["route", "b.route", "text"],
      ["price_level", "b.pricelevel", "text"],
      ["special_instructions", "b.specialinstructions", "text"],
      ["disabled", "b.disabletrans", "bool"],
      ["created_at", "b.branch_created", "datetime"]
    ]
  },

  "sales_orders": {
    "description": "Sales order headers, quotes included (is_quote).",
    "from": "salesorders o LEFT JOIN order_status os ON os.order_status_id = o.orderstatusid AND os.language_id = 1 " +
            "LEFT JOIN debtorsmaster d ON d.debtorno = o.debtorno LEFT JOIN custbranch b ON b.debtorno = o.debtorno AND b.branchcode = o.branchcode " +
            "LEFT JOIN salesman s ON s.salesmancode = o.salesperson LEFT JOIN shippers sh ON sh.shipper_id = o.shipvia " +
            "LEFT JOIN locations lc ON lc.loccode = o.fromstkloc",
    "key": ["order_id"],
    "date": "o.orddate",
    "filters": {"customer_id": "o.debtorno", "salesperson_id": "o.salesperson", "is_quote": "o.quotation", "status_id": "o.orderstatusid", "invoice_no": "o.invoiceno"},
    "enrich": "order_totals",
    "fields": [
      ["order_id", "o.orderno", "nid"],
      ["customer_id", "o.debtorno", "id"],
      ["customer_name", "d.name", "text"],
      ["location_id", "o.branchcode", "id"],
      ["location_name", "b.brname", "text"],
      ["order_date", "o.orddate", "date"],
      ["requested_date", "o.deliverydate", "date"],
      ["is_quote", "o.quotation", "bool"],
      ["customer_po", "o.customerref", "text"],
      ["buyer_name", "o.buyername", "text"],
      ["salesperson_id", "o.salesperson", "id"],
      ["salesperson_name", "s.salesmanname", "text"],
      ["salesperson2_id", "o.salesperson2", "id"],
      ["warehouse_id", "o.fromstkloc", "id"],
      ["warehouse_name", "lc.locationname", "text"],
      ["ship_via_id", "o.shipvia", "id"],
      ["ship_via", "sh.shippername", "text"],
      ["payment_terms_id", "o.payterms", "id"],
      ["price_list_id", "o.ordertype", "id"],
      ["placed_from", "o.placedfrom", "id"],
      ["quote_no", "o.quoteno", "id"],
      ["confirmed_date", "o.confirmeddate", "date"],
      ["packing_slip_printed", "o.printedpackingslip", "bool"],
      ["payment_status", "o.payment_status", "int"],
      ["coupon", "o.coupon_used", "text"],
      ["additional_charge", "o.additionalcharge", "money"],
      ["additional_charge_text", "o.additionaltext", "text"],
      ["freight", "o.freightcost", "money"],
      ["status_id", "o.orderstatusid", "id"],
      ["status", "os.name", "text"],
      ["is_cancelled", "o.orderstatusid = 90", "bool"],
      ["invoice_no", "o.invoiceno", "id"],
      ["ship_to_name", "o.deliverto", "text"],
      ["ship_to_line1", "o.deladd1", "text"],
      ["ship_to_line2", "o.deladd2", "text"],
      ["ship_to_city", "o.deladd3", "text"],
      ["ship_to_region", "o.deladd4", "text"],
      ["ship_to_postal_code", "o.deladd5", "text"],
      ["ship_to_country", "o.deladd6", "text"],
      ["contact_phone", "o.contactphone", "text"],
      ["contact_email", "o.contactemail", "text"],
      ["invoice_note", "o.comments", "text"],
      ["dispatch_note", "o.notes", "text"],
      ["sales_note", "o.salesnotes", "text"],
      ["entered_by", "o.enteredby", "text"],
      ["taken_by", "o.takenby", "text"],
      ["created_at", "o.date_created", "datetime"],
      ["updated_at", "o.date_updated", "datetime"]
    ],
    "extra": [
      ["line_count", "int"], ["units_ordered", "num"], ["units_invoiced", "num"], ["lines_subtotal", "money"],
      ["open_subtotal", "money"], ["subtotal", "money"], ["shipping", "money"], ["tax", "money"], ["total", "money"]
    ]
  },

  "sales_order_lines": {
    "description": "The lines of every sales order and quote.",
    "from": "salesorderdetails l",
    "key": ["order_id", "line_no"],
    "filters": {"order_id": "l.orderno", "sku": "l.stkcode"},
    "fields": [
      ["order_id", "l.orderno", "nid"],
      ["line_no", "l.orderlineno", "int"],
      ["sku", "l.stkcode", "id"],
      ["description", "l.itemdesc", "text"],
      ["qty_ordered", "l.quantity", "num"],
      ["qty_invoiced", "l.qtyinvoiced", "num"],
      ["qty_outstanding", "CASE WHEN l.completed = 0 AND l.quantity > l.qtyinvoiced THEN l.quantity - l.qtyinvoiced ELSE 0 END", "num"],
      ["unit_price", "l.unitprice", "money"],
      ["discount_rate", "l.discountpercent", "rate"],
      ["line_amount", line_amount_sql("l.unitprice", "l.discountpercent", "l.quantity"), "money"],
      ["open_amount", line_amount_sql("l.unitprice", "l.discountpercent", "CASE WHEN l.completed = 0 AND l.quantity > l.qtyinvoiced THEN l.quantity - l.qtyinvoiced ELSE 0 END"), "money"],
      ["list_price", "l.listprice", "money"],
      ["taxable", "l.taxable IN ('Yes', 'Y')", "bool"],
      ["fee", "l.fetcharge", "money"],
      ["parent_line_no", "l.parentlineno", "int"],
      ["completed", "l.completed", "bool"],
      ["dispatched_at", "l.actualdispatchdate", "datetime"],
      ["due_date", "l.itemdue", "date"],
      ["customer_po_line", "l.poline", "text"],
      ["note", "l.narrative", "text"],
      ["line_notes", "l.notes", "text"]
    ]
  },

  "invoices": {
    "description": "Customer invoices, one row per invoice.",
    "from": "debtortrans t", "where": "t.type = 10",
    "key": ["transaction_id"], "date": "t.trandate",
    "filters": {"customer_id": "t.debtorno", "salesperson_id": "t.salesperson", "order_id": "t.order_"},
    "fields": txn_fields()
  },

  "credit_notes": {
    "description": "Customer credit notes, one row per credit note. Amounts are negative.",
    "from": "debtortrans t", "where": "t.type = 11",
    "key": ["transaction_id"], "date": "t.trandate",
    "filters": {"customer_id": "t.debtorno", "salesperson_id": "t.salesperson", "order_id": "t.order_"},
    "fields": txn_fields()
  },

  "payments": {
    "description": "Customer payments received, one row per receipt. Amounts are negative: they reduce the account.",
    "from": "debtortrans t", "where": "t.type = 12",
    "key": ["transaction_id"], "date": "t.trandate",
    "filters": {"customer_id": "t.debtorno"},
    "fields": txn_fields()
  },

  "customer_transactions": {
    "description": "The whole customer ledger: invoices, credit notes, receipts and adjustments together, with type_id telling them apart.",
    "from": "debtortrans t LEFT JOIN systypes sy ON sy.typeid = t.type",
    "key": ["transaction_id"], "date": "t.trandate",
    "filters": {"customer_id": "t.debtorno", "type_id": "t.type"},
    "fields": concat([["type_id", "t.type", "int"], ["type", "sy.typename", "text"]], txn_fields())
  },

  "invoice_lines": {
    "description": "The lines of every invoice and credit note as printed on it: item, quantity, price, discount and cost.",
    "from": "stockmoves m", "where": "m.type IN (10, 11) AND m.show_on_inv_crds = 1 AND " + NOT_WRITEOFF_REVERSAL,
    "key": ["line_id"], "date": "m.trandate",
    "filters": {"customer_id": "m.debtorno", "sku": "m.stockid", "document_no": "m.transno"},
    "fields": [
      ["line_id", "m.stkmoveno", "nid"],
      ["type_id", "m.type", "int"],
      ["document_no", "m.transno", "id"],
      ["customer_id", "m.debtorno", "id"],
      ["location_id", "m.branchcode", "id"],
      ["warehouse_id", "m.loccode", "id"],
      ["date", "m.trandate", "date"],
      ["period", "m.prd", "int"],
      ["sku", "m.stockid", "id"],
      ["qty", "-m.qty", "num"],
      ["unit_price", "m.price", "money"],
      ["discount_rate", "m.discountpercent", "rate"],
      ["line_amount", line_amount_sql("m.price", "m.discountpercent", "-m.qty"), "money"],
      ["unit_cost", "m.standardcost", "money"],
      ["order_line_no", "m.orderlineref", "int"],
      ["reference", "m.reference", "text"],
      ["note", "m.narrative", "text"]
    ]
  },

  "allocations": {
    "description": "How receipts and credit notes were applied to invoices: each side's type, document number and date. Allocations go back to 1999 but the ledger starts in December 2019, so on older allocations the from_ and to_ document fields are empty.",
    "from": "custallocns c LEFT JOIN debtortrans fa ON fa.id = c.transid_allocfrom LEFT JOIN debtortrans ta ON ta.id = c.transid_allocto " +
            "LEFT JOIN systypes fs ON fs.typeid = fa.type LEFT JOIN systypes ts ON ts.typeid = ta.type",
    "key": ["allocation_id"], "date": "c.datealloc",
    "filters": {
      "customer_id": "fa.debtorno", "from_transaction_id": "c.transid_allocfrom", "to_transaction_id": "c.transid_allocto",
      "from_document_no": "fa.transno", "to_document_no": "ta.transno", "from_type_id": "fa.type", "to_type_id": "ta.type"
    },
    "fields": [
      ["allocation_id", "c.id", "nid"],
      ["date", "c.datealloc", "date"],
      ["amount", "c.amt", "money"],
      ["customer_id", "fa.debtorno", "id"],
      ["from_transaction_id", "c.transid_allocfrom", "id"],
      ["from_type_id", "fa.type", "int"],
      ["from_type", "fs.typename", "text"],
      ["from_document_no", "fa.transno", "id"],
      ["from_date", "fa.trandate", "date"],
      ["from_reference", "fa.reference", "text"],
      ["from_total", "(fa.ovamount + fa.ovgst + fa.ovfee + fa.ovfreight + fa.ovdiscount)", "money"],
      ["to_transaction_id", "c.transid_allocto", "id"],
      ["to_type_id", "ta.type", "int"],
      ["to_type", "ts.typename", "text"],
      ["to_document_no", "ta.transno", "id"],
      ["to_date", "ta.trandate", "date"],
      ["to_due_date", "ta.duedate", "date"],
      ["to_customer_id", "ta.debtorno", "id"],
      ["to_total", "(ta.ovamount + ta.ovgst + ta.ovfee + ta.ovfreight + ta.ovdiscount)", "money"],
      ["applied_by", "c.userid", "text"]
    ]
  },

  "receivables": {
    "description": "Every open customer item (anything not fully paid or applied), aged on today's date against its due date.",
    "from": "debtortrans t LEFT JOIN systypes sy ON sy.typeid = t.type",
    "where": "ABS(" + TXN_TOTAL + " - t.alloc) > 0.005",
    "key": ["transaction_id"], "date": "t.trandate",
    "filters": {"customer_id": "t.debtorno", "salesperson_id": "t.salesperson"},
    "enrich": "aging",
    "fields": [
      ["transaction_id", "t.id", "nid"],
      ["type_id", "t.type", "int"],
      ["type", "sy.typename", "text"],
      ["document_no", "t.transno", "id"],
      ["customer_id", "t.debtorno", "id"],
      ["location_id", "t.branchcode", "id"],
      ["date", "t.trandate", "date"],
      ["due_date", "t.duedate", "date"],
      ["salesperson_id", "t.salesperson", "id"],
      ["order_id", "t.order_", "id"],
      ["reference", "t.reference", "text"],
      ["total", TXN_TOTAL, "money"],
      ["amount_applied", "t.alloc", "money"],
      ["open_amount", TXN_TOTAL + " - t.alloc", "money"]
    ],
    "extra": [["days_overdue", "int"], ["aging_bucket", "text"]]
  },

  "salespeople": {
    "description": "Sales reps.",
    "from": "salesman s",
    "key": ["salesperson_id"],
    "fields": [
      ["salesperson_id", "s.salesmancode", "id"],
      ["name", "s.salesmanname", "text"],
      ["phone", "s.smantel", "text"],
      ["email", "s.smaneamil", "text"],
      ["is_current", "s.current", "bool"],
      ["manager", "s.manager", "text"],
      ["territory_id", "s.territory_id", "id"],
      ["warehouse_id", "s.defaultloc", "id"],
      ["commission_rate", "s.commissionrate1", "rate"],
      ["commission_breakpoint", "s.breakpoint", "money"],
      ["commission_rate_above", "s.commissionrate2", "rate"]
    ]
  },

  "vendors": {
    "description": "Vendors (suppliers). Bank details are not included.",
    "from": "suppliers v LEFT JOIN paymentterms pt ON pt.termsindicator = v.paymentterms",
    "key": ["vendor_id"],
    "fields": [
      ["vendor_id", "v.supplierid", "id"],
      ["vendor_name", "v.suppname", "text"],
      ["address_line1", "v.address1", "text"],
      ["address_line2", "v.address2", "text"],
      ["city", "v.address3", "text"],
      ["region", "v.address4", "text"],
      ["postal_code", "v.address5", "text"],
      ["country", "v.address6", "text"],
      ["currency", "v.currcode", "id"],
      ["vendor_since", "v.suppliersince", "date"],
      ["payment_terms_id", "v.paymentterms", "id"],
      ["payment_terms", "pt.terms", "text"],
      ["phone", "v.telephone", "text"],
      ["email", "v.email", "text"],
      ["website", "v.url", "text"],
      ["tax_ref", "v.taxref", "text"],
      ["last_payment_amount", "v.lastpaid", "money"],
      ["last_payment_date", "v.lastpaiddate", "date"],
      ["is_active", "v.active", "bool"]
    ]
  },

  "vendor_transactions": {
    "description": "The vendor ledger: vendor invoices (type_id 20), credits (21), payments (22) and adjustments.",
    "from": "supptrans p LEFT JOIN systypes sy ON sy.typeid = p.type LEFT JOIN suppliers v ON v.supplierid = p.supplierno",
    "key": ["transaction_id"], "date": "p.trandate",
    "filters": {"vendor_id": "p.supplierno", "type_id": "p.type"},
    "fields": [
      ["transaction_id", "p.id", "nid"],
      ["type_id", "p.type", "int"],
      ["type", "sy.typename", "text"],
      ["document_no", "p.transno", "id"],
      ["vendor_id", "p.supplierno", "id"],
      ["vendor_reference", "p.suppreference", "text"],
      ["date", "p.trandate", "date"],
      ["due_date", "p.duedate", "date"],
      ["currency", "v.currcode", "id"],
      ["subtotal", "p.ovamount", "money"],
      ["tax", "p.ovgst", "money"],
      ["fees", "p.ovfee", "money"],
      ["total", "p.ovamount + p.ovgst + p.ovfee", "money"],
      ["amount_applied", "p.alloc", "money"],
      ["open_amount", "p.ovamount + p.ovgst + p.ovfee - p.alloc", "money"],
      ["settled", "p.settled", "bool"],
      ["on_hold", "p.hold", "bool"],
      ["exchange_rate", "p.rate", "num"],
      ["note", "p.transtext", "text"],
      ["created_at", "p.inputdate", "datetime"]
    ]
  },

  "items": {
    "description": "Products, with category and brand.",
    "from": "stockmaster s LEFT JOIN stockcategory c ON c.categoryid = s.categoryid LEFT JOIN product_types ptp ON ptp.label = s.mbflag",
    "key": ["sku"],
    "filters": {"sku": "s.stockid", "category_id": "s.categoryid"},
    "enrich": "item_extras",
    "fields": [
      ["sku", "s.stockid", "id"],
      ["description", "s.description", "text"],
      ["category_id", "s.categoryid", "id"],
      ["category", "c.categorydescription", "text"],
      ["product_line_id", "s.lineid", "id"],
      ["units", "s.units", "text"],
      ["item_type", "s.mbflag", "id"],
      ["item_type_name", "ptp.description", "text"],
      ["reduces_stock", "ptp.reducesstock", "bool"],
      ["unit_cost", ITEM_COST, "money"],
      ["last_cost", "s.lastcost", "money"],
      ["last_cost_update", "s.lastcostupdate", "date"],
      ["discontinued", "s.discontinued", "bool"],
      ["enabled", "s.enabled", "bool"],
      ["barcode", "s.barcode", "text"],
      ["mfg_part_no", "s.mfgpart", "text"],
      ["gross_weight", "s.grossweight", "num"],
      ["net_weight", "s.netweight", "num"],
      ["volume", "s.volume", "num"],
      ["tax_category_id", "s.taxcatid", "id"],
      ["created_at", "s.date_created", "datetime"]
    ],
    "extra": [["brand_id", "id"], ["brand", "text"], ["qty_on_hand", "num"], ["qty_on_open_orders", "num"], ["qty_on_open_pos", "num"]]
  },

  "item_prices": {
    "description": "Price list entries. A customer_id or location_id set means a customer-specific price.",
    "from": "prices p",
    "key": ["sku", "price_list_id", "currency", "customer_id", "location_id", "start_date", "end_date"],
    "filters": {"sku": "p.stockid", "price_list_id": "p.typeabbrev"},
    "fields": [
      ["sku", "p.stockid", "id"],
      ["price_list_id", "p.typeabbrev", "id"],
      ["currency", "p.currabrev", "id"],
      ["customer_id", "p.debtorno", "id"],
      ["location_id", "p.branchcode", "id"],
      ["start_date", "p.startdate", "date"],
      ["end_date", "p.enddate", "date"],
      ["price", "p.price", "money"],
      ["updated_at", "p.priceupdated", "datetime"]
    ]
  },

  "inventory_levels": {
    "description": "Stock on hand per warehouse and bin.",
    "from": "locstock k",
    "key": ["warehouse_id", "sku", "bin"],
    "filters": {"warehouse_id": "k.loccode", "sku": "k.stockid"},
    "fields": [
      ["warehouse_id", "k.loccode", "id"],
      ["sku", "k.stockid", "id"],
      ["bin", "k.bin", "text"],
      ["qty_on_hand", "k.quantity", "num"],
      ["counts_as_on_hand", COUNTS_ON_HAND, "bool"],
      ["reorder_level", "k.reorderlevel", "num"],
      ["min_qty", "k.minimum", "num"],
      ["max_qty", "k.maximum", "num"],
      ["last_received", "k.daterec", "datetime"]
    ]
  },

  "inventory_movements": {
    "description": "Every stock movement: sales, receipts, transfers and adjustments.",
    "from": "stockmoves m LEFT JOIN systypes sy ON sy.typeid = m.type",
    "key": ["movement_id"], "date": "m.trandate",
    "filters": {"sku": "m.stockid", "warehouse_id": "m.loccode", "type_id": "m.type"},
    "fields": [
      ["movement_id", "m.stkmoveno", "nid"],
      ["type_id", "m.type", "int"],
      ["type", "sy.typename", "text"],
      ["document_no", "m.transno", "id"],
      ["date", "m.trandate", "date"],
      ["period", "m.prd", "int"],
      ["sku", "m.stockid", "id"],
      ["warehouse_id", "m.loccode", "id"],
      ["qty", "m.qty", "num"],
      ["qty_after", "m.newqoh", "num"],
      ["unit_price", "m.price", "money"],
      ["unit_cost", "m.standardcost", "money"],
      ["customer_id", "m.debtorno", "id"],
      ["location_id", "m.branchcode", "id"],
      ["reference", "m.reference", "text"],
      ["user_id", "m.userid", "text"]
    ]
  },

  "purchase_orders": {
    "description": "Purchase order headers.",
    "from": "purchorders po LEFT JOIN po_status ps ON ps.status_id = po.status_id LEFT JOIN suppliers v ON v.supplierid = po.supplierno",
    "key": ["po_id"], "date": "po.orddate",
    "filters": {"vendor_id": "po.supplierno", "status_id": "po.status_id"},
    "fields": [
      ["po_id", "po.orderno", "nid"],
      ["vendor_id", "po.supplierno", "id"],
      ["order_date", "po.orddate", "date"],
      ["warehouse_id", "po.intostocklocation", "id"],
      ["status_id", "po.status_id", "id"],
      ["status", "ps.name", "text"],
      ["is_closed", "ps.pocompleted", "bool"],
      ["currency", "v.currcode", "id"],
      ["requested_by", "po.initiator", "text"],
      ["requisition_no", "po.requisitionno", "text"],
      ["delivery_date", "po.deliverydate", "date"],
      ["arrived_at", "po.datearrived", "datetime"],
      ["exchange_rate", "po.rate", "num"],
      ["payment_terms_id", "po.paymentterms", "id"],
      ["vendor_contact", "po.suppliercontact", "text"],
      ["vendor_invoice_no", "po.invoicenumber", "text"],
      ["comments", "po.comments", "text"]
    ]
  },

  "purchase_order_lines": {
    "description": "Purchase order lines.",
    "from": "purchorderdetails pl LEFT JOIN purchorders po ON po.orderno = pl.orderno LEFT JOIN suppliers v ON v.supplierid = po.supplierno",
    "key": ["po_line_id"],
    "filters": {"po_id": "pl.orderno", "sku": "pl.itemcode"},
    "fields": [
      ["po_line_id", "pl.podetailitem", "nid"],
      ["po_id", "pl.orderno", "id"],
      ["sku", "pl.itemcode", "id"],
      ["description", "pl.itemdescription", "text"],
      ["vendor_part_no", "pl.suppliers_partno", "text"],
      ["qty_ordered", "pl.quantityord", "num"],
      ["qty_received", "pl.quantityrecd", "num"],
      ["qty_invoiced", "pl.qtyinvoiced", "num"],
      ["currency", "v.currcode", "id"],
      ["unit_price", "pl.unitprice", "money"],
      ["unit_cost", "pl.stdcostunit", "money"],
      ["delivery_date", "pl.deliverydate", "date"],
      ["gl_account", "pl.glcode", "id"],
      ["completed", "pl.completed", "bool"]
    ]
  },

  "receipts": {
    "description": "Goods received against purchase order lines.",
    "from": "grns g",
    "key": ["receipt_id"], "date": "g.deliverydate",
    "filters": {"po_id": "g.poorderno", "vendor_id": "g.supplierid", "sku": "g.itemcode"},
    "fields": [
      ["receipt_id", "g.grnno", "nid"],
      ["batch_no", "g.grnbatch", "id"],
      ["po_id", "g.poorderno", "id"],
      ["po_line_id", "g.podetailitem", "id"],
      ["vendor_id", "g.supplierid", "id"],
      ["sku", "g.itemcode", "id"],
      ["description", "g.itemdescription", "text"],
      ["qty_received", "g.qtyrecd", "num"],
      ["qty_invoiced", "g.quantityinv", "num"],
      ["unit_cost", "g.stdcostunit", "money"],
      ["received_date", "g.deliverydate", "date"],
      ["vendor_reference", "g.supplieref", "text"],
      ["created_at", "g.added_date", "datetime"]
    ]
  }
}

// The small reference tables, served together by /v1/lookups.
let LOOKUPS = {
  "warehouses": ["SELECT loccode AS id, locationname AS name, deladd3 AS city, deladd4 AS region FROM locations ORDER BY loccode", ["id", "name", "city", "region"]],
  "payment_terms": ["SELECT termsindicator AS id, terms AS name, daysbeforedue AS days_before_due, dayinfollowingmonth AS day_in_following_month FROM paymentterms ORDER BY termsindicator", ["id", "name", "days_before_due", "day_in_following_month"]],
  "price_lists": ["SELECT typeabbrev AS id, sales_type AS name FROM salestypes ORDER BY typeabbrev", ["id", "name"]],
  "categories": ["SELECT categoryid AS id, categorydescription AS name FROM stockcategory ORDER BY categoryid", ["id", "name"]],
  "brands": ["SELECT manufacturer_id AS id, name, mfg_code AS code FROM manufacturer ORDER BY manufacturer_id", ["id", "name", "code"]],
  "areas": ["SELECT areacode AS id, areadescription AS name FROM areas ORDER BY areacode", ["id", "name"]],
  "territories": ["SELECT territory_id AS id, territory_name AS name FROM territory ORDER BY territory_id", ["id", "name"]],
  "hold_reasons": ["SELECT reasoncode AS id, reasondescription AS name FROM holdreasons ORDER BY reasoncode", ["id", "name"]],
  "customer_types": ["SELECT typeid AS id, typename AS name FROM debtortype ORDER BY typeid", ["id", "name"]],
  "ship_via": ["SELECT shipper_id AS id, shippername AS name FROM shippers ORDER BY shipper_id", ["id", "name"]],
  "currencies": ["SELECT currabrev AS id, currency AS name, rate FROM currencies ORDER BY currabrev", ["id", "name", "rate"]],
  "po_statuses": ["SELECT status_id AS id, name, pocompleted AS closes_po FROM po_status ORDER BY status_id", ["id", "name", "closes_po"]],
  "item_types": ["SELECT label AS id, description AS name, reducesstock AS reduces_stock FROM product_types ORDER BY label", ["id", "name", "reduces_stock"]],
  "transaction_types": ["SELECT typeid AS id, typename AS name FROM systypes ORDER BY typeid", ["id", "name"]]
}

// The order the documentation lists the entities in, by area.
let ENTITY_GROUPS = [
  ["Customers", ["customers", "customer_locations", "customer_contacts", "customer_clubs", "customer_notes"]],
  ["Sales", ["sales_orders", "sales_order_lines"]],
  ["Receivables", ["invoices", "credit_notes", "payments", "customer_transactions", "invoice_lines", "allocations", "receivables"]],
  ["Salespeople", ["salespeople"]],
  ["Inventory", ["items", "item_prices", "inventory_levels", "inventory_movements"]],
  ["Vendors and purchasing", ["vendors", "vendor_transactions", "purchase_orders", "purchase_order_lines", "receipts"]]
]

// What a field means where its name does not say it all: "entity.field" first, then "field" for every entity.
let FIELD_NOTES = {
  "customer_id": "The customer account number.",
  "location_id": "The customer's ship-to location (branch) code; with customer_id it identifies a location.",
  "warehouse_id": "A KM warehouse (lookups: warehouses).",
  "salesperson_id": "A sales rep (salespeople).",
  "price_list_id": "A price list (lookups: price_lists).",
  "payment_terms_id": "Payment terms (lookups: payment_terms).",
  "ship_via_id": "A carrier (lookups: ship_via).",
  "territory_id": "A sales territory (lookups: territories).",
  "area_id": "A sales area (lookups: areas).",
  "type_id": "The ERP transaction type (lookups: transaction_types): 10 invoice, 11 credit note, 12 receipt, 20 vendor invoice, 21 vendor credit, 22 vendor payment.",
  "document_no": "The document number as printed (invoice, credit note or receipt number); unique within a type_id.",
  "transaction_id": "The ledger row's unique id.",
  "period": "The ERP accounting period number.",
  "discount_rate": "A fraction: 0.10 is 10%. 1 on a sales line is a free-goods line.",
  "exchange_rate": "Rate to the home currency (CAD); 1 for CAD.",
  "note": "Free text entered on the document.",
  "created_at": "When the row was entered.",
  "customers.balance": "What the customer owes: the sum of their open items (receivables), as the ERP's aged analysis buckets and statements total it. Positive is owed to KM.",
  "customers.ledger_balance": "Every document on the account added up, as the Balance column on the ERP's customer aging shows it. Equal to balance unless the account's allocation records are inconsistent.",
  "customers.lifetime_invoiced": "All invoices ever, before tax and freight.",
  "customers.hold_reason": "The account's credit status (lookups: hold_reasons).",
  "customers.on_hold": "True when the hold reason stops new invoices (any reason but Good History).",
  "customers.credit_limit": "Credit limit in CAD.",
  "customers.parent_customer_id": "The head-office account this customer rolls up to, if any.",
  "customers.license_no": "The customer's cosmetology licence number.",
  "customers.is_active": "False when the account has been closed.",
  "customers.email_statements": "Statements are emailed (the card's Email Statement).",
  "customers.print_statements": "Statements are printed and mailed (the card's Print Statement).",
  "customers.email_invoices": "Invoices are emailed (the card's Email Invoice).",
  "customers.refused_email": "The customer has asked for no email (the card's REFUSED EMAIL).",
  "customers.signed_contract": "Whether the customer signed KM's contract (Yes / No).",
  "customers.price_list2_id": "A second price list (lookups: price_lists), when the account has one.",
  "customers.discount_level": "The account's discount level (the card's Discount Level).",
  "customers.prompt_payment_discount": "Prompt-payment discount, a fraction.",
  "customers.commission_rate": "The account's commission rate as the ERP stores it (the card's Commission Rate).",
  "customers.target_potential": "Sales potential set as a target on the account (the card's Target Potential).",
  "customers.estimated_potential": "Estimated sales potential (the card's Est Potential).",
  "customers.last_receipt_amount": "The latest payment's amount (the card's Last Paid).",
  "customers.total_spend": "Every printed invoice and credit line, net of credits, after line discounts, before tax and freight (the card's Total Spend). Kept up to date by the ASQL Thing kmdata_customer_sales.",
  "customers.first_purchase_date": "The first invoice line's date.",
  "customers.last_purchase_date": "The latest invoice line's date. A credit note is not a purchase (the ERP card's Last Purchase counts credits too).",
  "customers.months_active": "Calendar months with at least one invoice or credit line.",
  "customers.avg_monthly_sales": "total_spend / months_active (the card's Avg Monthly Sales).",
  "customers.avg_monthly_units": "Units sold less units returned, / months_active (the card's Avg Monthly Qty).",
  "customers.units_sold": "Units invoiced, all time.",
  "customers.units_returned": "Units credited back, all time.",
  "customers.return_rate": "units_returned / units_sold (the card's Return %, as a fraction).",
  "customers.avg_invoice_last_365": "Average invoice before tax and freight over the last 365 days (the card's Avg Order L365).",
  "customers.invoices_last_365": "Invoices in the last 365 days.",
  "customers.top_brand_1": "The brand with the most units bought in the last 365 days (the card's Most Purchased Brands); top_brand_2 and top_brand_3 follow.",
  "customers.po_required": "The customer requires a PO number on each order line.",
  "customers.ar_interest_rate": "Interest charged on overdue balances, a fraction (0.02 is 2%).",
  "customers.aboriginal": "Indigenous tax-exempt status on the account (debtorsmaster.aboriginal).",
  "customers.has_web_account": "The customer has a web store account.",
  "customers.sales_mtd": "Sales this month to today, on the total_spend basis (net of credits, before tax and freight).",
  "customers.sales_ytd": "Sales 1 January to today.",
  "customers.sales_last_year_ytd": "Sales last year from 1 January to this day last year: the comparison for sales_ytd.",
  "customers.sales_last_year": "Sales in all of last year.",
  "customers.sales_last_12_months": "Sales from the day after this day last year to today.",
  "customers.aging_future": "Open amount due in more than 30 days. The six aging_ fields add up to balance, as /v1/receivables buckets each item.",
  "customers.aging_current": "Open amount due within 30 days, or with no due date (open credits and unapplied payments, negative, usually land here).",
  "customers.aging_0_29": "Open amount 0-29 days past due.",
  "customers.aging_30_59": "Open amount 30-59 days past due.",
  "customers.aging_60_89": "Open amount 60-89 days past due.",
  "customers.aging_90_plus": "Open amount 90 or more days past due.",
  "customers.main_location_id": "The account's main ship-to: the location coded as the account number, else its lowest location code. salesperson, phone, email, contact_name, area and territory are that location's.",
  "customers.location_count": "Ship-to locations on the account (customer_locations).",
  "customers.salesperson_id": "The rep on the main ship-to (salespeople); each location can have its own (customer_locations).",
  "customers.open_orders": "Orders with a line not yet completed, cancelled orders left out (the card's Open Orders count).",
  "customers.open_quotes": "Quotes with a line not yet completed (the card's Open Quotes count).",
  "customers.last_web_login": "When the customer last logged in to the web store.",
  "customers.reward_points": "Loyalty points balance (earned less spent). KM's ERP has the loyalty program switched off (LoyaltyPointsActive 0), so its card shows 0.",
  "customers.clubs": "Clubs joined, as 'club: member number', comma-separated (customer_clubs has one row each).",
  "customer_locations.mail_address_line1": "The location's mailing address, where it differs from the ship-to address (the mail_ fields).",
  "customer_contacts.roles": "The contact's roles as the ERP stores them (JSON).",
  "customer_notes.code": "The note's kind (ORDER, CREDIT, ...).",
  "sales_orders.price_list_id": "The price list the order was priced from (lookups: price_lists).",
  "sales_orders.placed_from": "Where the order was entered, as the ERP codes it (4 is online).",
  "sales_orders.quote_no": "The quote the order came from.",
  "sales_orders.taken_by": "The ERP user who last edited the order.",
  "sales_orders.sales_note": "Internal sales note.",
  "sales_orders.additional_charge": "An extra charge added to the order (additional_charge_text says what); not in total.",
  "sales_orders.line_count": "Lines on the order.",
  "sales_orders.lines_subtotal": "Every line's qty_ordered x discounted price, before tax (sales_order_lines.line_amount added up).",
  "sales_orders.open_subtotal": "What is not yet invoiced on open lines, before tax (the ERP's Open Orders list).",
  "sales_orders.subtotal": "The subtotal saved with the order when it was last saved (the ERP's Order Inquiry); null if none was saved.",
  "sales_orders.shipping": "Shipping saved with the order.",
  "sales_orders.tax": "Tax saved with the order, every tax line added.",
  "sales_orders.total": "The total saved with the order: subtotal + shipping + tax.",
  "sales_order_lines.qty_outstanding": "Not yet invoiced on an open line; 0 once the line is completed.",
  "sales_order_lines.open_amount": "qty_outstanding x discounted price, before tax.",
  "sales_order_lines.fee": "A per-unit fee charged on the line (the ERP's FET charge).",
  "sales_order_lines.parent_line_no": "The line this one belongs to (a kit's component), if any.",
  "customer_locations.disabled": "True when no new orders may be taken for this location.",
  "customer_locations.warehouse_id": "The warehouse this location ships from by default.",
  "customer_locations.price_level": "The location's own price level, when it differs from the account's.",
  "sales_orders.is_quote": "True for a quotation that is not (yet) an order.",
  "sales_orders.requested_date": "The delivery date asked for.",
  "sales_orders.customer_po": "The customer's purchase order reference.",
  "sales_orders.invoice_note": "The note printed on the invoice.",
  "sales_orders.dispatch_note": "Note for the warehouse and delivery.",
  "sales_orders.invoice_no": "The invoice number once invoiced (also invoices.document_no).",
  "sales_orders.status_id": "The order's workflow status (status names it).",
  "sales_orders.is_cancelled": "True for a cancelled order (status 90).",
  "sales_order_lines.line_amount": "qty_ordered x discounted unit price, before tax, rounded as the ERP rounds it (unit price and its discount to cents first).",
  "sales_order_lines.qty_invoiced": "How much of the line has been invoiced so far; the rest is open or back-ordered.",
  "sales_order_lines.completed": "True once the line is closed (fully invoiced or cancelled).",
  "invoices.subtotal": "Goods before tax, freight and fees (net of line discounts).",
  "invoices.total": "subtotal + tax + freight + fees + discount: the document's amount on the customer's account (the ERP's ledger and aged analysis).",
  "invoices.amount_applied": "How much of the total has been paid or credited (allocations).",
  "invoices.open_amount": "total - amount_applied: still owed.",
  "invoices.order_id": "The sales order the invoice came from.",
  "credit_notes.total": "Negative: what the credit takes off the account, including any discount adjustment (the printed credit note leaves that adjustment out).",
  "payments.total": "Negative: the receipt's amount as it reduces the account.",
  "invoice_lines.qty": "Units sold; negative on a credit note.",
  "invoice_lines.line_amount": "qty x discounted unit price, before tax, rounded as the invoice rounds it; an invoice's lines add up to its subtotal.",
  "invoice_lines.unit_cost": "The item's cost when it was invoiced.",
  "invoice_lines.document_no": "The invoice or credit note number (invoices.document_no).",
  "invoice_lines.order_line_no": "The sales order line it came from (sales_order_lines.line_no).",
  "allocations.amount": "The amount applied. Negative when an earlier application was reversed (almost always a receipt taken back off an invoice).",
  "allocations.customer_id": "The account of the receipt or credit note applied.",
  "allocations.from_transaction_id": "The receipt or credit note applied (customer_transactions.transaction_id).",
  "allocations.from_type_id": "What was applied: 12 receipt, 11 credit note, or another ledger type (lookups: transaction_types).",
  "allocations.from_document_no": "The receipt or credit note number as printed (with from_type_id, payments.document_no or credit_notes.document_no).",
  "allocations.from_date": "The date of the receipt or credit note.",
  "allocations.from_reference": "The receipt's reference (cheque or payment reference).",
  "allocations.from_total": "The receipt's or credit note's whole amount (negative), of which amount is one application.",
  "allocations.to_transaction_id": "The document it was applied to, usually an invoice (customer_transactions.transaction_id).",
  "allocations.to_type_id": "What it was applied to: 10 invoice, or another ledger type (lookups: transaction_types).",
  "allocations.to_document_no": "The invoice number as printed (with to_type_id, invoices.document_no).",
  "allocations.to_date": "The invoice's date.",
  "allocations.to_due_date": "The invoice's due date.",
  "allocations.to_customer_id": "The account of the invoice; the same as customer_id except on the rare cross-account application.",
  "allocations.to_total": "The invoice's whole amount, of which amount is one payment.",
  "allocations.applied_by": "The ERP user who made the allocation.",
  "receivables.days_overdue": "Days past the due date as of today; negative before it is due.",
  "receivables.aging_bucket": "The ERP's aged-analysis bucket: future (due in more than 30 days), current (due within 30 days, or no due date), 0_29, 30_59, 60_89 or 90_plus days past due.",
  "salespeople.is_current": "False for reps no longer active.",
  "salespeople.commission_rate": "Commission as a fraction, up to commission_breakpoint; commission_rate_above after it.",
  "items.item_type": "The ERP item type code; item_type_name says what it is (B Purchased covers almost every item).",
  "items.reduces_stock": "False for kits and internal items, which carry no stock of their own.",
  "items.qty_on_hand": "Units on hand across warehouses, as the ERP's item screen counts it: not the transfer warehouse, not the PO holding bin. (The ERP's valuation report does count the holding bin; inventory_levels has every bin.)",
  "items.qty_on_open_orders": "Units on open sales orders not yet invoiced (quotes and drop-ship orders excluded).",
  "items.qty_on_open_pos": "Units on open purchase orders not yet received.",
  "items.unit_cost": "The ERP's cost: weighted average cost, or the last cost when there is no average.",
  "items.last_cost": "The cost before the most recent receipt changed it.",
  "items.brand": "The item's brand (lookups: brands).",
  "item_prices.price_list_id": "A1 is the ERP's price list (lookups: price_lists) and the one orders are priced from. R1, ST and C1 rows exist in the data but no ERP screen or order uses them.",
  "item_prices.customer_id": "Empty for a list price; set for a price only that customer gets.",
  "item_prices.end_date": "9999-12-31 means open-ended.",
  "inventory_levels.qty_on_hand": "Units in that warehouse and bin. Warehouse 01 is the 3PL (PGS): its quantity is what PGS reports as available, refreshed every 15 minutes.",
  "inventory_levels.counts_as_on_hand": "False for the transfer warehouse and the PO holding bin, which the ERP leaves out of on-hand.",
  "inventory_movements.qty": "Signed: positive into the warehouse, negative out.",
  "inventory_movements.qty_after": "Stock on hand in that warehouse after the movement.",
  "inventory_movements.unit_price": "Selling price on a sale or credit; the PO price in the vendor's currency on a purchase receipt (type 25).",
  "inventory_movements.unit_cost": "Cost in CAD at the time of the movement.",
  "vendor_transactions.total": "Positive for an invoice, negative for a payment or credit.",
  "vendor_transactions.currency": "The vendor's currency; every amount on the row is in it.",
  "purchase_orders.status": "The PO's workflow status (lookups: po_statuses).",
  "purchase_orders.is_closed": "True once the PO is completed, cancelled or rejected.",
  "purchase_order_lines.unit_price": "Price in the vendor's currency (currency).",
  "purchase_order_lines.unit_cost": "Cost in CAD.",
  "receipts.qty_invoiced": "How much of the receipt the vendor has invoiced.",
  "receipts.unit_cost": "Cost in CAD at receipt."
}

fn field_note(ename, field) {
  let n = FIELD_NOTES[ename + "." + field]
  if n != nil { return n }
  return FIELD_NOTES[field]
}
