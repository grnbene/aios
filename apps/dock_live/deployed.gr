// Post-deploy hook: creates or replaces the dock_bay Thing in this machine's ASQL (things/dock_bay.gr,
// each built beside its old version and swapped in when its first pass is done, so the screens keep reading the
// old one meanwhile).

fn setting(name, fallback) {
  let v = getenv(name)
  if v != nil and v != "" { return v }
  let f = getenv(name + "_FILE")
  if f != nil and f != "" { return trim(read_file(f)) }
  return fallback
}

let THINGS = [
  {"name": "dock_bay", "key": "bay",
   "reads": "loadingbays, trucks, dispatch, custbranch, salesorderdetails, stockmaster, pickingfreeze, tagalong, product_types"}
]

fn deployed(app) {
  let c = db_connect(setting("DB_HOST", "127.0.0.1"), int(setting("DB_PORT", "3307")), setting("DB_USER", "root"),
                     setting("DB_PASSWORD", ""), setting("DB_NAME", "versioneight"))
  if not c.ok { return "cannot reach ASQL: " + c.error }
  let have = db_query(c, "SHOW THINGS", [])
  let things = {}
  if have.ok { for r in have.records { things[r.thing] = true } }
  for t in THINGS {
    let verb = has(things, t.name) ? "CREATE OR REPLACE THING" : "CREATE THING"
    let r = db_query(c, verb + " " + t.name + " GRAIN KEY " + t.key + " READS " + t.reads + " AS ?", [app_program("things/" + t.name + ".gr")])
    if not r.ok { db_close(c); return t.name + ": " + r.error }
    print(t.name + ": " + (has(things, t.name) ? "replaced in place" : "created") + ", " + str(r.affected_rows) + " things")
  }
  // dock_pick (one per pick row) is gone: it held the engine's Things lock ~450 times a minute
  if has(things, "dock_pick") {
    let d = db_query(c, "DROP THING dock_pick", [])
    print("dock_pick: " + (d.ok ? "dropped" : "not dropped: " + d.error))
  }
  db_close(c)
  return true
}
