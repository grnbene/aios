// A bin measured and checked from photos alone (apps/bin_capacity/lib/bins.gr): a rack's 1200 x 1000 x 900 mm bin
// is drawn in 3D (r3d_draw) with the marker on the beam under it and photographed from known cameras. Its width,
// height and depth come back from one photo and one tap on the floor's back corner; later photos, with no tapping,
// say whether something is in it against its photo when it was empty.
import { bins_geometry, bins_occupancy } from "../../apps/bin_capacity/lib/bins.gr"

fn check(c, msg) { assert_true(c, msg) }
import { rack, camera_of, photo, seen, bin_truth } from "lib/bin_scene.gr"
let T = bin_truth()
let BW = T.w
let BH = T.h
let BD = T.d
let F = T.F
let empty = rack(false)
let cfg = {"marker_mm": 150.0}
let A = camera_of([250.0, -1900.0, 650.0], [600.0, 400.0, 450.0])
let shot = photo(A, empty)
let opening = [seen(A, [0.0, 0.0, BH]), seen(A, [BW, 0.0, BH]), seen(A, [BW, 0.0, 0.0]), seen(A, [0.0, 0.0, 0.0])]
let back = seen(A, [0.0, BD, 0.0])

// ---- one photo, one tap: the lens from the opening's right angles ----
let g = bins_geometry(shot, opening, back, cfg, nil)
print(format("lens from the photo itself: {:.1f} x {:.1f} x {:.1f} mm (focal {:.0f} px against {:.0f}, corners within {:.2f} px)", g.width_mm, g.height_mm, g.depth_mm, g.camera.focal, F, g.rms_px))
check(abs(g.camera.focal - F) / F < 0.02, format("the lens found from the photo: {:.0f} px against {:.0f}", g.camera.focal, F))
check(abs(g.width_mm - BW) / BW < 0.01 and abs(g.height_mm - BH) / BH < 0.01, format("the opening: {:.1f} x {:.1f} mm", g.width_mm, g.height_mm))
check(abs(g.depth_mm - BD) / BD < 0.02, format("the depth from one tap: {:.1f} mm of 900", g.depth_mm))
// ---- the lens known (the phone's EXIF) ----
let g2 = bins_geometry(shot, opening, back, cfg, F)
check(abs(g2.depth_mm - BD) / BD < 0.015 and abs(g2.width_mm - BW) / BW < 0.01, format("with the lens known: {:.1f} x {:.1f} x {:.1f} mm", g2.width_mm, g2.height_mm, g2.depth_mm))
check(g.focal_from == "rectangle" and g2.focal_from == "photo", "it says where the lens came from")
// a tap in front of the bin is refused, not turned into a depth
check(!try_call(bins_geometry, shot, opening, seen(A, [600.0, -300.0, 0.0]), cfg, F).ok, "a tap on the floor in front of the bin is refused")

// ---- what is in it: later photos from elsewhere, no tapping, against its photo when empty ----
let B = camera_of([800.0, -1700.0, 500.0], [600.0, 400.0, 450.0])
let C = camera_of([-150.0, -2100.0, 900.0], [600.0, 400.0, 450.0])
for pair in [["from the right and lower", B], ["from the left and higher", C]] {
  let still = bins_occupancy(photo(pair[1], empty), g.camera.focal, shot, g.camera, g, cfg)
  check(still.changed < 0.05, format("empty again, {}: {:.3f} of the opening changed ({:.2f} compared)", pair[0], still.changed, still.compared))
  let full = bins_occupancy(photo(pair[1], rack(true)), g.camera.focal, shot, g.camera, g, cfg)
  // the stack's front is 640 x 900 of the 1200 x 1000 opening (0.48); from the side its top and flank show too
  check(full.changed > 0.4 and full.changed < 0.75, format("four tires in it, {}: {:.3f} of the opening changed", pair[0], full.changed))
}
print("PASS: test_bin_photo")
