let n = 0
for t in table {
  for kind in ["decimal", "real"] {
    let x = kind == "decimal" ? decimal(t[0]) : real(decimal(t[0]))
    let got = t[1] == 0 ? str(round(x, t[2])) : str(round(x, t[1], t[2]))
    let want = t[1] == 0 ? str(int(decimal(t[3]))) : t[3]
    check(got == want, kind + " " + t[0] + " to " + str(t[1]) + " " + t[2] + ": " + got + ", wanted " + want)
    n += 1
  }
}
check(n == 2268, "every case ran")

// the three agree on the classic traps, as reals and as decimals
for x in [2.675e0, 1.005e0, 0.125e0, 8.345e0, 1.45e0, decimal("2.675"), decimal("1.005")] {
  let r = str(round(x, 2))
  check(number_format(x, 2) == r and format("{:.2f}", x) == r, str(x) + ": round " + r + ", number_format " + number_format(x, 2) + ", format " + format("{:.2f}", x))
}
check(round(2.675e0, 2) == decimal("2.68") and round(1.005e0, 2) == decimal("1.01"), "a real rounds as it prints, not as its binary digits")
check(str(round(2.5, 2)) == "2.50" and str(round(7, 2)) == "7.00", "round to places writes them all")
check(type(round(2.5)) == "int" and type(round(2.5, 1)) == "decimal", "no places: an int; places: a decimal")
check(round(1234.5, -2) == 1200 and round(-1250, -2) == -1300 and round(1250, -2, "half_even") == 1200, "places below 0")
check(format("{:.2f}", -0.004e0) == "0.00" and number_format(-0.004e0, 2) == "0.00", "never -0.00")
check(format("{:.1%}", 0.1234e0) == "12.3%" and format("{:.0%}", decimal("0.125")) == "13%", "{:%}: times 100, exactly")
check(str(round(5e-324, 2, "up")) == "0.01" and str(round(-5e-324, 2, "floor")) == "-0.01" and str(round(5e-324, 2)) == "0.00", "a tiny real still rounds by its mode")
check(!try_call(round, 1e300).ok, "a real past 64 bits does not round to an int")
check(!try_call(round, 2.5, 2, "nearest").ok, "an unknown mode is an error")
check(format("{:.2f}", 1e300 * 1e300) == "inf", "inf formats as inf")
// a real computed by arithmetic rounds from its 15 significant digits: the binary noise past them does not decide it
let noisy = 1.55e0 * 0.3e0   // 0.46499999999999997
check(str(round(noisy, 2)) == "0.47" and format("{:.2f}", noisy) == "0.47" and number_format(noisy, 2) == "0.47", "1.55 x 0.3 rounds to 0.47 (shortest digits said 0.46)")
check(str(decimal(noisy)) == "0.46499999999999997", "decimal() still converts what the real is")
check(format("{:.1%}", 0.1234e0) == "12.3%", "{:%} of a real")
// aa's invoices 130442126 and 130442531, line by line as the ERP's PHP computes them, in reals
fn line(price, disc, qty) { return round(round(round(price, 2) - round(round(price, 2) * round(disc, 4), 2), 2) * qty, 2) }
check(line(6.5e0, 0.25e0, -1) + line(9.09e0, 0.25e0, -1) == -11.69, "invoice 130442126: 11.69")
check(line(35.79e0, 0.1e0, -1) + line(28.25e0, 0.1e0, 1) == -6.79, "invoice 130442531: 6.79")
print("PASS: test_rounding")
