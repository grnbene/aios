// / is exact: an int when it divides evenly, a decimal when the quotient ends, the exact fraction when it does not.
// (1 / 3) * 3 is 1, where a quotient cut to 12 places gives 0.999999999999 and 2 / 3 * 3 gives 2.000000000001.
fn check(c, msg) { assert_true(c, msg) }

fn run(where) {
  check(7 / 2 == 3.5 and str(7 / 2) == "3.5" and type(7 / 2) == "decimal", where + ": 7 / 2 is 3.5, exactly")
  check(10 / 2 == 5 and type(10 / 2) == "int", where + ": 10 / 2 is the int 5")
  check(str(10 / 4) == "2.5" and str(decimal("10.00") / 4) == "2.50", where + ": an exact quotient keeps the places it needs")
  check((1 / 3) * 3 == 1 and str((1 / 3) * 3) == "1", where + ": (1 / 3) * 3 is 1")
  check(2 / 3 * 3 == 2 and 10 / 3 * 3 == 10, where + ": 2 / 3 * 3 is 2")
  check(1 / 3 + 1 / 3 + 1 / 3 == 1 and 1 / 3 + 1 / 6 == 0.5 and str(1 / 3 + 1 / 6) == "0.5", where + ": fractions add exactly")
  check(str(1 / 3) == "0.333333333333" and str(2 / 3) == "0.666666666667" and str(1 / 7) == "0.142857142857", where + ": a fraction prints to 12 places")
  check(str(-1 / 3) == "-0.333333333333" and -1 / 3 < 0, where + ": negative")
  check(1 / 3 > 0.333333333333 and 1 / 3 < 0.333333333334 and 1 / 3 != 0.333333333333, where + ": comparisons are exact")
  check(22 / 7 > 3.142857142857 and 22 / 7 < 3.142857142858, where + ": 22/7 between its 12-place neighbours")
  check(str(round(2 / 3, 2)) == "0.67" and str(round(1 / 3, 5, "up")) == "0.33334" and str(round(-1 / 3, 1, "floor")) == "-0.4", where + ": a fraction rounds exactly")
  check(format("{:.20f}", 1 / 3) == "0.33333333333333333333" and number_format(2 / 3, 4) == "0.6667", where + ": and formats exactly")
  check(int(7 / 3) == 2 and int(-7 / 3) == -2 and floor(-7 / 3) == -3 and ceil(7 / 3) == 3, where + ": int, floor, ceil of a fraction")
  check((7 / 3) % 1 == 1 / 3 and (1 / 3) % (1 / 6) == 0, where + ": % of fractions")
  check(dec_div(1, 3, 4) == decimal("0.3333") and dec_div(2, 3, 2) == decimal("0.67"), where + ": dec_div rounds the exact quotient once")
  check(type(real(1 / 3)) == "real" and real(1 / 3) == 1e0 / 3, where + ": real() of a fraction is its nearest real")
  check(type((1 / 3) * 1.5e0) == "real", where + ": with a real: a real")
  check(!try_call(fn () { return 1 / 0 }).ok and !try_call(fn () { return (1 / 3) / 0 }).ok, where + ": division by zero is an error")
  let big = 1000000000000000000000000000000   // 10^30 as a decimal (past 64 bits)
  check(big / 7 * 7 == big, where + ": a big quotient is still exact")
  let x = pow(10, 20)
  for i in 0..76 { x = x / 3 }   // 3^76 > 10^36: the fraction becomes a decimal at 30 places, and goes on
  check(type(x) == "decimal" and str(x) == "0.000000000000000054800515179602", where + ": past 10^36 a fraction rounds to 30 places, it does not fail: " + str(x))
  let gone = 1
  for i in 0..80 { gone = gone / 3 }
  check(gone == 0, where + ": and what is under half of the 30th place is 0")
  check(json_stringify(1 / 3) == "0.333333333333", where + ": JSON writes a fraction to its printed places")
}

run("top level")
fn inside() { run("in a function") }
inside()
let f = fn () { run("in a closure") }
f()
print("PASS: test_division")
