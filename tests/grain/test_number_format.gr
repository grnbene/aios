# number_format(v [, places [, dec_point [, thousands_sep]]]) answers as PHP 7.4's number_format(), and as the
# sticker feed's own nf() (written in grain before the builtin; kept here as the reference) for every value tried.
fn check(c, msg) { assert_true(c, msg) }
fn eq(got, want, what) { check(got == want, what + ": got " + str(got) + ", want " + str(want)) }

# PHP 7.4's answers
eq(number_format(1234.5), "1,235", "default places and separator")
eq(number_format(1234.5678, 2), "1,234.57", "two places")
eq(number_format(1234.5678, 2, ",", " "), "1 234,57", "a point and a separator of its own")
eq(number_format(1234567.891, 2, ".", ""), "1234567.89", "no separator")
eq(number_format(0.5), "1", "half rounds away from zero")
eq(number_format(-0.5), "-1", "negative half")
eq(number_format(-0.4), "0", "a zero has no sign")
eq(number_format(-0.001, 2), "0.00", "a zero has no sign, with places")
eq(number_format(1.005, 2), "1.01", "15-digit pre-rounding")
eq(number_format(0.285, 2), "0.29", "15-digit pre-rounding (0.285)")
eq(number_format(1000000000000000), "1,000,000,000,000,000", "groups all the way up")
eq(number_format(-1234567), "-1,234,567", "negative groups")
eq(number_format(999.999, 2), "1,000.00", "rounds up into a new group")
eq(number_format(5, 3), "5.000", "pads places")
eq(number_format(12.3456, -2), "12", "places below 0 count as 0")
eq(number_format(decimal("19.995"), 2), "20.00", "a decimal")
eq(number_format("12abc", 1), "12.0", "a string by the number it starts with")
eq(number_format(" 7.25"), "7", "leading space")
eq(number_format("abc"), nil, "a string with no number")
eq(number_format(nil), "0", "nil is 0")
eq(number_format(false, 1), "0.0", "false is 0")
eq(number_format(true), "1", "true is 1")
let bad = pcall(fn () { return number_format([1]) })
check(not bad.ok, "a list is refused")

# the feed's nf(), as it was written in grain: the builtin must give the same text for every value
fn nf_dec_old(v, places) {
  let d = decimal(0)
  if v == true { d = decimal(1) }
  else if v != nil and v != false {
    if type(v) == "string" {
      let p = decimal_prefix(v)
      if p == nil { return nil }
      d = p.d
    } else {
      d = decimal(v)
    }
  }
  return decimal(round_sig(d, 15), places)
}
fn nf_old(v, places) {
  let d = nf_dec_old(v, places)
  return d == nil ? nil : str(d)
}
let vals = [nil, true, false, 0, -0.0, "", "x", "0.0000", "12.5abc", "-3", " 4.5", "1e3", ".5", "-.5"]
for i in 0..2000 {
  push(vals, i * 0.005)
  push(vals, -i * 0.0125)
  push(vals, i * 1234.5678)
  push(vals, str(i * 0.335))
  push(vals, decimal(i) / decimal(7))
}
let n = 0
for v in vals {
  for p in [0, 1, 2, 4] {
    let want = nf_old(v, p)
    let got = number_format(v, p, ".", "")
    if got != want { check(false, "nf(" + str(v) + ", " + str(p) + "): builtin " + str(got) + ", nf " + str(want)) }
    n = n + 1
  }
}
check(n > 40000, "compared " + str(n))
print("number_format ok")
